{
  "name": "lowlandtech-components-app",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "npx @tailwindcss/cli -i ../Styles/app.css -o css/app.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ../Styles/app.css -o css/app.css --watch",
    "visual:capture:chadcn": "node ./visual/capture-chadcn.mjs",
    "visual:capture:local": "node ./visual/capture-local.mjs",
    "visual:capture:local:dark": "node ./visual/capture-local-dark.mjs",
    "visual:compare": "node ./visual/compare.mjs",
    "visual:test": "npm run visual:capture:chadcn; npm run visual:capture:local; npm run visual:compare"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@tailwindcss/postcss": "^4.2.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.54.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.2.1"
  }
}
