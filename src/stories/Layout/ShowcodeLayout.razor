@namespace LowlandTech.Components.Stories.Layout
@inherits LayoutComponentBase
@inject ShowcodeState State
@inject NavigationManager Nav
@implements IDisposable

<HeadContent>
    <link rel="stylesheet" href="_content/LowlandTech.Components.Stories/css/stories.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components.Stories/css/sonner.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components.Stories/css/rtl.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components/css/property-grid.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</HeadContent>

<PopoverProvider />
<SidebarProvider class="group/sidebar-wrapper flex h-svh min-h-0 w-full overflow-hidden">
    <ShowcodeNav />
    <SidebarInset class="min-h-0">
        <header class="flex h-12 shrink-0 items-center justify-between border-b border-border px-4 bg-background">
            <div class="flex items-center gap-2">
                <SidebarTrigger class="-ml-1">
                    <Icon Name="panel-left" Size="16" />
                    <span class="sr-only">Toggle Sidebar</span>
                </SidebarTrigger>
                @if (State.Current is not null)
                {
                    <button type="button"
                            class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
                            @onclick="ShowAllComponents">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                        All Components
                    </button>
                }
            </div>
            @if (State.Current is null)
            {
                <span class="text-xs text-muted-foreground">
                    @StoryRegistry.GetAll().Count() components
                    &middot; @StoryRegistry.Root.Children.Count groups
                    &middot; Click any element to explore
                </span>
            }
            <ThemeToggle />
        </header>
        <main class="min-h-0 flex-1 overflow-y-auto bg-background">
            <div class="min-h-full">
                @Body
            </div>
        </main>
    </SidebarInset>
</SidebarProvider>

@code {
    private void ShowAllComponents()
    {
        State.ShowTable();
        Nav.NavigateTo("/admin/components");
    }

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= Refresh;
}
