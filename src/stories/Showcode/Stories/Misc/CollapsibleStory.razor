@attribute [DisplayName("Misc/Collapsible")]
@inherits StoryComponent

<StoryCard Title="Collapsible"
           Description="Collapsible states demonstrate default toggle and card-embedded compositions."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<CollapsibleDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "CollapsibleDefaultExample.razor",
                    "Showcode/Examples/Misc/Collapsible/CollapsibleDefaultExample.razor")
            ]),
        new(
            "card",
            "In a card",
            @<CollapsibleCardExample />,
            [
                StorySourceRegistry.CodeTab(
                    "card-razor",
                    "CollapsibleCardExample.razor",
                    "Showcode/Examples/Misc/Collapsible/CollapsibleCardExample.razor")
            ])
    ];
}
