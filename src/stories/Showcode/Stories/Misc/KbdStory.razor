@attribute [DisplayName("Misc/Kbd")]
@inherits StoryComponent

<StoryCard Title="Kbd"
           Description="Kbd states demonstrate modifier keys, shortcut combos, and size variants."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "modifiers",
            "Modifier keys",
            @<KbdModifiersExample />,
            [
                StorySourceRegistry.CodeTab(
                    "modifiers-razor",
                    "KbdModifiersExample.razor",
                    "Showcode/Examples/Misc/Kbd/KbdModifiersExample.razor")
            ]),
        new(
            "shortcuts",
            "Shortcut combos",
            @<KbdShortcutsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "shortcuts-razor",
                    "KbdShortcutsExample.razor",
                    "Showcode/Examples/Misc/Kbd/KbdShortcutsExample.razor")
            ]),
        new(
            "sizes",
            "Sizes",
            @<KbdSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "KbdSizesExample.razor",
                    "Showcode/Examples/Misc/Kbd/KbdSizesExample.razor")
            ])
    ];
}
