@attribute [DisplayName("Feedback/Sonner")]
@inherits StoryComponent

<StoryCard Title="Sonner"
           Description="Sonner displays toast notifications with types, descriptions, positioning, and auto-dismiss."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "types",
            "Types",
            @<SonnerTypesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "types-razor",
                    "SonnerTypesExample.razor",
                    "Showcode/Examples/Feedback/Sonner/SonnerTypesExample.razor")
            ]),
        new(
            "descriptions",
            "With description",
            @<SonnerDescriptionsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "descriptions-razor",
                    "SonnerDescriptionsExample.razor",
                    "Showcode/Examples/Feedback/Sonner/SonnerDescriptionsExample.razor")
            ]),
        new(
            "non-dismissible",
            "Non-dismissible",
            @<SonnerNonDismissibleExample />,
            [
                StorySourceRegistry.CodeTab(
                    "non-dismissible-razor",
                    "SonnerNonDismissibleExample.razor",
                    "Showcode/Examples/Feedback/Sonner/SonnerNonDismissibleExample.razor")
            ]),
        new(
            "top-position",
            "Top position",
            @<SonnerTopPositionExample />,
            [
                StorySourceRegistry.CodeTab(
                    "top-position-razor",
                    "SonnerTopPositionExample.razor",
                    "Showcode/Examples/Feedback/Sonner/SonnerTopPositionExample.razor")
            ])
    ];
}
