        new("default", "Default", @<WorkQueueDefaultExample />, [
            StorySourceRegistry.CodeTab("default-razor", "WorkQueueDefaultExample.razor", "Showcode/Examples/Work/WorkQueue/WorkQueueDefaultExample.razor")
        ])
    ];
}
