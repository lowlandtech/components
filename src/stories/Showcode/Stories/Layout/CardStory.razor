@attribute [DisplayName("Layout/Card")]
@inherits StoryComponent

<StoryCard Title="Card"
           Description="Card states demonstrate standard sections, footer actions, and header-side actions."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "basic",
            "Basic",
            @<CardBasicExample />,
            [
                StorySourceRegistry.CodeTab(
                    "basic-razor",
                    "CardBasicExample.razor",
                    "Showcode/Examples/Layout/Card/CardBasicExample.razor")
            ]),
        new(
            "with-footer",
            "With footer",
            @<CardWithFooterExample />,
            [
                StorySourceRegistry.CodeTab(
                    "footer-razor",
                    "CardWithFooterExample.razor",
                    "Showcode/Examples/Layout/Card/CardWithFooterExample.razor")
            ]),
        new(
            "with-action",
            "With action",
            @<CardWithActionExample />,
            [
                StorySourceRegistry.CodeTab(
                    "action-razor",
                    "CardWithActionExample.razor",
                    "Showcode/Examples/Layout/Card/CardWithActionExample.razor")
            ]),
        new(
            "outlined",
            "Outlined",
            @<CardOutlinedExample />,
            [
                StorySourceRegistry.CodeTab(
                    "outlined-razor",
                    "CardOutlinedExample.razor",
                    "Showcode/Examples/Layout/Card/CardOutlinedExample.razor")
            ]),
        new(
            "elevation",
            "Elevation",
            @<CardElevationExample />,
            [
                StorySourceRegistry.CodeTab(
                    "elevation-razor",
                    "CardElevationExample.razor",
                    "Showcode/Examples/Layout/Card/CardElevationExample.razor")
            ]),
        new(
            "square",
            "Square",
            @<CardSquareExample />,
            [
                StorySourceRegistry.CodeTab(
                    "square-razor",
                    "CardSquareExample.razor",
                    "Showcode/Examples/Layout/Card/CardSquareExample.razor")
            ]),
        new(
            "mode-menu",
            "Mode menu",
            @<CardWithModeMenuExample />,
            [
                StorySourceRegistry.CodeTab(
                    "mode-menu-razor",
                    "CardWithModeMenuExample.razor",
                    "Showcode/Examples/Layout/Card/CardWithModeMenuExample.razor")
            ])
    ];
}
