            ]),
        new(
            "ide",
            "IDE",
            @<AppLayoutIdeExample />,
            [
                StorySourceRegistry.CodeTab(
                    "ide-razor",
                    "AppLayoutIdeExample.razor",
                    "Showcode/Examples/Layout/AppLayout/AppLayoutIdeExample.razor")
            ])
    ];
