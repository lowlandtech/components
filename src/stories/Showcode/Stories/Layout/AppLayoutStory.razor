@attribute [DisplayName("Layout/App Layout")]
@inherits StoryComponent

<StoryCard Title="App Layout"
           Description="One shell template whose Grid slots react to an enum scenario from AppLayoutSession."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "workspace",
            "Workspace",
            @<AppLayoutWorkspaceExample />,
            [
                StorySourceRegistry.CodeTab(
                    "workspace-razor",
                    "AppLayoutWorkspaceExample.razor",
                    "Showcode/Examples/Layout/AppLayout/AppLayoutWorkspaceExample.razor")
            ]),
        new(
            "documentation",
            "Documentation",
            @<AppLayoutDocumentationExample />,
            [
                StorySourceRegistry.CodeTab(
                    "documentation-razor",
                    "AppLayoutDocumentationExample.razor",
                    "Showcode/Examples/Layout/AppLayoutDocumentationExample.razor")
            ]),
        new(
            "focus",
            "Focus",
            @<AppLayoutFocusExample />,
            [
                StorySourceRegistry.CodeTab(
                    "focus-razor",
                    "AppLayoutFocusExample.razor",
                    "Showcode/Examples/Layout/AppLayout/AppLayoutFocusExample.razor")
            ]),
        new(
            "studio",
            "Studio",
            @<AppLayoutStudioExample />,
            [
                StorySourceRegistry.CodeTab(
                    "studio-razor",
                    "AppLayoutStudioExample.razor",
                    "Showcode/Examples/Layout/AppLayout/AppLayoutStudioExample.razor")
            ]),
        new(
            "kiosk",
            "Kiosk",
