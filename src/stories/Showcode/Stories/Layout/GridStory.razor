@attribute [DisplayName("Layout/Grid")]
@inherits StoryComponent

<StoryCard Title="Grid"
           Description="A 12-column responsive grid system with breakpoint-aware span control and Block flex/stack helpers."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "responsive",
            "Responsive columns",
            @<GridResponsiveExample />,
            [
                StorySourceRegistry.CodeTab(
                    "responsive-razor",
                    "GridResponsiveExample.razor",
                    "Showcode/Examples/Layout/Grid/GridResponsiveExample.razor")
            ]),
        new(
            "mixed-spans",
            "Mixed spans",
            @<GridMixedSpansExample />,
            [
                StorySourceRegistry.CodeTab(
                    "mixed-razor",
                    "GridMixedSpansExample.razor",
                    "Showcode/Examples/Layout/Grid/GridMixedSpansExample.razor")
            ]),
        new(
            "block-stack",
            "Block & Stack",
            @<GridBlockStackExample />,
            [
                StorySourceRegistry.CodeTab(
                    "block-razor",
                    "GridBlockStackExample.razor",
                    "Showcode/Examples/Layout/Grid/GridBlockStackExample.razor")
            ])
    ];
}
