@attribute [DisplayName("Layout/Resizable")]
@inherits StoryComponent

<StoryCard Title="Resizable"
           Description="Resizable states demonstrate horizontal, vertical, grip-handle, and multi-panel split layouts."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "horizontal",
            "Horizontal",
            @<ResizableHorizontalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "horizontal-razor",
                    "ResizableHorizontalExample.razor",
                    "Showcode/Examples/Layout/Resizable/ResizableHorizontalExample.razor")
            ]),
        new(
            "vertical",
            "Vertical",
            @<ResizableVerticalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "vertical-razor",
                    "ResizableVerticalExample.razor",
                    "Showcode/Examples/Layout/Resizable/ResizableVerticalExample.razor")
            ]),
        new(
            "with-handle",
            "With handle",
            @<ResizableWithHandleExample />,
            [
                StorySourceRegistry.CodeTab(
                    "with-handle-razor",
                    "ResizableWithHandleExample.razor",
                    "Showcode/Examples/Layout/Resizable/ResizableWithHandleExample.razor")
            ]),
        new(
            "three-panels",
            "Three panels",
            @<ResizableThreePanelsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "three-panels-razor",
                    "ResizableThreePanelsExample.razor",
                    "Showcode/Examples/Layout/Resizable/ResizableThreePanelsExample.razor")
            ]),
        new(
            "reveal-on-hover",
            "Reveal on hover",
            @<ResizableRevealOnHoverExample />,
            [
                StorySourceRegistry.CodeTab(
                    "reveal-on-hover-razor",
                    "ResizableRevealOnHoverExample.razor",
                    "Showcode/Examples/Layout/Resizable/ResizableRevealOnHoverExample.razor")
            ])
    ];
}
