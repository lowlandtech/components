@attribute [DisplayName("Layout/Sidebar")]
@inherits StoryComponent

<StoryCard Title="Sidebar"
           Description="A collapsible navigation sidebar with groups, sub-menus, badges, and controlled open state."
           DefaultState="docs-preview"
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "docs-preview",
            "Docs preview",
            @<SidebarDocsPreviewExample />,
            [
                StorySourceRegistry.CodeTab(
                    "docs-preview-razor",
                    "SidebarDocsPreviewExample.razor",
                    "Showcode/Examples/Layout/Sidebar/SidebarDocsPreviewExample.razor")
            ]),
        new(
            "basic",
            "Basic",
            @<SidebarBasicExample />,
            [
                StorySourceRegistry.CodeTab(
                    "basic-razor",
                    "SidebarBasicExample.razor",
                    "Showcode/Examples/Layout/Sidebar/SidebarBasicExample.razor")
            ]),
        new(
            "brand",
            "Brand",
            @<SidebarBrandExample />,
            [
                StorySourceRegistry.CodeTab(
                    "brand-razor",
                    "SidebarBrandExample.razor",
                    "Showcode/Examples/Layout/Sidebar/SidebarBrandExample.razor")
            ]),
        new(
            "active-badge",
            "Active & Badge",
            @<SidebarActiveBadgeExample />,
            [
                StorySourceRegistry.CodeTab(
                    "active-badge-razor",
                    "SidebarActiveBadgeExample.razor",
                    "Showcode/Examples/Layout/Sidebar/SidebarActiveBadgeExample.razor")
            ]),
        new(
            "sub-menu",
            "Sub-menu",
            @<SidebarSubMenuExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sub-menu-razor",
                    "SidebarSubMenuExample.razor",
                    "Showcode/Examples/Layout/Sidebar/SidebarSubMenuExample.razor")
            ]),
        new(
            "controlled",
            "Controlled open",
            @<SidebarControlledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "controlled-razor",
                    "SidebarControlledExample.razor",
                    "Showcode/Examples/Layout/Sidebar/SidebarControlledExample.razor")
            ]),
        new(
            "resizable",
            "Resizable (hover reveal)",
            @<SidebarResizableExample />,
            [
                StorySourceRegistry.CodeTab(
                    "resizable-razor",
                    "SidebarResizableExample.razor",
                    "Showcode/Examples/Layout/Sidebar/SidebarResizableExample.razor")
            ])
    ];
}
