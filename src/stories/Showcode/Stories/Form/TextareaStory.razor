@attribute [DisplayName("Form/Textarea")]
@inherits StoryComponent

<StoryCard Title="Textarea"
           Description="Textarea states demonstrate default, labeled, disabled, read-only, and invalid multiline fields."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<TextareaDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "TextareaDefaultExample.razor",
                    "Showcode/Examples/Form/Textarea/TextareaDefaultExample.razor")
            ]),
        new(
            "with-label",
            "With label",
            @<TextareaWithLabelExample />,
            [
                StorySourceRegistry.CodeTab(
                    "label-razor",
                    "TextareaWithLabelExample.razor",
                    "Showcode/Examples/Form/Textarea/TextareaWithLabelExample.razor")
            ]),
        new(
            "states",
            "States",
            @<TextareaStatesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "states-razor",
                    "TextareaStatesExample.razor",
                    "Showcode/Examples/Form/Textarea/TextareaStatesExample.razor")
            ])
    ];
}
