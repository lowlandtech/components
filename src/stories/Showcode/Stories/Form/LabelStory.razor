@attribute [DisplayName("Form/Label")]
@inherits StoryComponent

<StoryCard Title="Label"
           Description="Label states demonstrate field association, required markers, disabled labels, and helper descriptions."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<LabelDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "LabelDefaultExample.razor",
                    "Showcode/Examples/Form/Label/LabelDefaultExample.razor")
            ]),
        new(
            "required",
            "Required",
            @<LabelRequiredExample />,
            [
                StorySourceRegistry.CodeTab(
                    "required-razor",
                    "LabelRequiredExample.razor",
                    "Showcode/Examples/Form/Label/LabelRequiredExample.razor")
            ]),
        new(
            "description",
            "Description",
            @<LabelDescriptionExample />,
            [
                StorySourceRegistry.CodeTab(
                    "description-razor",
                    "LabelDescriptionExample.razor",
                    "Showcode/Examples/Form/Label/LabelDescriptionExample.razor")
            ]),
        new(
            "disabled",
            "Disabled",
            @<LabelDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "LabelDisabledExample.razor",
                    "Showcode/Examples/Form/Label/LabelDisabledExample.razor")
            ])
    ];
}
