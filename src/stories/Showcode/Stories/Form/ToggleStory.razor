@attribute [DisplayName("Form/Toggle")]
@inherits StoryComponent

<StoryCard Title="Toggle"
           Description="Toggle states demonstrate variants, sizes, icon composition, and pressed state."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "variants",
            "Variants",
            @<ToggleVariantsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "variants-razor",
                    "ToggleVariantsExample.razor",
                    "Showcode/Examples/Form/Toggle/ToggleVariantsExample.razor")
            ]),
        new(
            "sizes",
            "Sizes",
            @<ToggleSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "ToggleSizesExample.razor",
                    "Showcode/Examples/Form/Toggle/ToggleSizesExample.razor")
            ]),
        new(
            "with-icon",
            "With icon",
            @<ToggleWithIconExample />,
            [
                StorySourceRegistry.CodeTab(
                    "icon-razor",
                    "ToggleWithIconExample.razor",
                    "Showcode/Examples/Form/Toggle/ToggleWithIconExample.razor")
            ])
    ];
}
