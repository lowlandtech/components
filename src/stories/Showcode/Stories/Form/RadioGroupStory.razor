@attribute [DisplayName("Form/Radio Group")]
@inherits StoryComponent

<StoryCard Title="Radio Group"
           Description="RadioGroup states demonstrate vertical, horizontal, disabled, and choice-card selection layouts."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "vertical",
            "Vertical",
            @<RadioGroupVerticalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "vertical-razor",
                    "RadioGroupVerticalExample.razor",
                    "Showcode/Examples/Form/RadioGroup/RadioGroupVerticalExample.razor")
            ]),
        new(
            "horizontal",
            "Horizontal",
            @<RadioGroupHorizontalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "horizontal-razor",
                    "RadioGroupHorizontalExample.razor",
                    "Showcode/Examples/Form/RadioGroup/RadioGroupHorizontalExample.razor")
            ]),
        new(
            "disabled",
            "Disabled",
            @<RadioGroupDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "RadioGroupDisabledExample.razor",
                    "Showcode/Examples/Form/RadioGroup/RadioGroupDisabledExample.razor")
            ]),
        new(
            "choice-card",
            "Choice card",
            @<RadioGroupChoiceCardExample />,
            [
                StorySourceRegistry.CodeTab(
                    "choice-card-razor",
                    "RadioGroupChoiceCardExample.razor",
                    "Showcode/Examples/Form/RadioGroup/RadioGroupChoiceCardExample.razor")
            ])
    ];
}
