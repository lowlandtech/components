@attribute [DisplayName("Form/Select")]
@inherits StoryComponent

<StoryCard Title="Select"
           Description="Select states demonstrate default dropdown, grouped items, trigger sizes, and disabled/invalid affordances."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<SelectDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "SelectDefaultExample.razor",
                    "Showcode/Examples/Form/Select/SelectDefaultExample.razor")
            ]),
        new(
            "groups",
            "With groups",
            @<SelectGroupsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "groups-razor",
                    "SelectGroupsExample.razor",
                    "Showcode/Examples/Form/Select/SelectGroupsExample.razor")
            ]),
        new(
            "sizes",
            "Sizes",
            @<SelectSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "SelectSizesExample.razor",
                    "Showcode/Examples/Form/Select/SelectSizesExample.razor")
            ]),
        new(
            "states",
            "States",
            @<SelectStatesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "states-razor",
                    "SelectStatesExample.razor",
                    "Showcode/Examples/Form/Select/SelectStatesExample.razor")
            ])
    ];
}
