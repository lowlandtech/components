@attribute [DisplayName("RepositoryApp/RepositoryBlock")]
@inherits StoryComponent

<StoryCard Title="RepositoryBlock"
           Description="Gitea-style repository home page with file tree, file list, submenu tabs, sidebar, and clone panel."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new("default", "Default", @<RepositoryAppDefaultExample />, [
            StorySourceRegistry.CodeTab("default-razor", "RepositoryAppDefaultExample.razor", "Showcode/Examples/RepositoryApp/RepositoryAppDefaultExample.razor")
        ])
    ];
}
