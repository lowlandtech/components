@attribute [DisplayName("Overlay/Drawer")]
@inherits StoryComponent

<StoryCard Title="Drawer"
           Description="A slide-in panel with toggle trigger, directional animation, and optional overlay."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "right",
            "Right (default)",
            @<DrawerRightExample />,
            [
                StorySourceRegistry.CodeTab(
                    "right-razor",
                    "DrawerRightExample.razor",
                    "Showcode/Examples/Overlay/Drawer/DrawerRightExample.razor")
            ]),
        new(
            "left",
            "Left direction",
            @<DrawerLeftExample />,
            [
                StorySourceRegistry.CodeTab(
                    "left-razor",
                    "DrawerLeftExample.razor",
                    "Showcode/Examples/Overlay/Drawer/DrawerLeftExample.razor")
            ]),
        new(
            "overlay",
            "With overlay",
            @<DrawerOverlayExample />,
            [
                StorySourceRegistry.CodeTab(
                    "overlay-razor",
                    "DrawerOverlayExample.razor",
                    "Showcode/Examples/Overlay/Drawer/DrawerOverlayExample.razor")
            ])
    ];
}
