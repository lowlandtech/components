@attribute [DisplayName("Overlay/Alert Dialog")]
@inherits StoryComponent

<StoryCard Title="Alert Dialog"
           Description="Alert dialog interrupts the user with a critical confirmation that requires a decision."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "destructive",
            "Destructive",
            @<AlertDialogDestructiveExample />,
            [
                StorySourceRegistry.CodeTab(
                    "destructive-razor",
                    "AlertDialogDestructiveExample.razor",
                    "Showcode/Examples/Overlay/AlertDialog/AlertDialogDestructiveExample.razor")
            ]),
        new(
            "continue",
            "Continue",
            @<AlertDialogContinueExample />,
            [
                StorySourceRegistry.CodeTab(
                    "continue-razor",
                    "AlertDialogContinueExample.razor",
                    "Showcode/Examples/Overlay/AlertDialog/AlertDialogContinueExample.razor")
            ]),
        new(
            "overlay-close",
            "Overlay close",
            @<AlertDialogOverlayCloseExample />,
            [
                StorySourceRegistry.CodeTab(
                    "overlay-close-razor",
                    "AlertDialogOverlayCloseExample.razor",
                    "Showcode/Examples/Overlay/AlertDialog/AlertDialogOverlayCloseExample.razor")
            ])
    ];
}
