@attribute [DisplayName("Navigation/TreeView")]
@inherits StoryComponent

<StoryCard Title="TreeView"
           Description="TreeView displays hierarchical data with expandable nodes, selection, and checkboxes."
           DesignComponentType="typeof(TreeViewDesigner)"
           States="@States" />

@code {
    private const string FileItemSource = "Showcode/Examples/Navigation/TreeView/TreeViewFileItem.cs";
    private const string SampleDataSource = "Showcode/Examples/Navigation/TreeView/TreeViewSampleData.cs";

    private IReadOnlyList<StoryCard.State> States =>
    [
        new(
            "default",
            "Default (Custom Template)",
            @<TreeViewCustomTemplateExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "TreeViewCustomTemplateExample.razor",
                    "Showcode/Examples/Navigation/TreeView/TreeViewCustomTemplateExample.razor"),
                SharedModelTab("default-file-item"),
                SharedDataTab("default-data")
            ]),

        new(
            "default-template",
            "Default Template",
            @<TreeViewDefaultTemplateExample />,
            [
                StorySourceRegistry.CodeTab(
                    "template-razor",
                    "TreeViewDefaultTemplateExample.razor",
                    "Showcode/Examples/Navigation/TreeView/TreeViewDefaultTemplateExample.razor"),
                SharedModelTab("template-file-item"),
                SharedDataTab("template-data")
            ]),

        new(
            "selection",
            "Single Selection",
            @<TreeViewSelectionExample />,
            [
                StorySourceRegistry.CodeTab(
                    "selection-razor",
                    "TreeViewSelectionExample.razor",
                    "Showcode/Examples/Navigation/TreeView/TreeViewSelectionExample.razor"),
                SharedModelTab("selection-file-item"),
                SharedDataTab("selection-data")
            ]),

        new(
            "checkbox",
            "Checkboxes",
            @<TreeViewCheckboxExample />,
            [
                StorySourceRegistry.CodeTab(
                    "checkbox-razor",
                    "TreeViewCheckboxExample.razor",
                    "Showcode/Examples/Navigation/TreeView/TreeViewCheckboxExample.razor"),
                SharedModelTab("checkbox-file-item"),
                SharedDataTab("checkbox-data")
            ]),

        new(
            "tristate",
            "Tri-State Checkboxes",
            @<TreeViewTriStateExample />,
            [
                StorySourceRegistry.CodeTab(
                    "tristate-razor",
                    "TreeViewTriStateExample.razor",
                    "Showcode/Examples/Navigation/TreeView/TreeViewTriStateExample.razor"),
                SharedModelTab("tristate-file-item"),
                SharedDataTab("tristate-data")
            ])
    ];

    private static StoryCard.CodeTab SharedModelTab(string value) =>
        StorySourceRegistry.CodeTab(value, "TreeViewFileItem.cs", FileItemSource, "csharp");

    private static StoryCard.CodeTab SharedDataTab(string value) =>
        StorySourceRegistry.CodeTab(value, "TreeViewSampleData.cs", SampleDataSource, "csharp");
}
