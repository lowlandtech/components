@attribute [DisplayName("Session/SessionContextExplorer")]
@inherits StoryComponent

<StoryCard Title="SessionContextExplorer"
           Description="Session context node explorer for projecting and pinning application entities into the active session."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<SessionContextExplorerDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "SessionContextExplorerDefaultExample.razor",
                    "Showcode/Examples/Session/SessionContextExplorer/SessionContextExplorerDefaultExample.razor")
            ]),
        new(
            "pinned",
            "Pinned",
            @<SessionContextExplorerPinnedExample />,
            [
                StorySourceRegistry.CodeTab(
                    "pinned-razor",
                    "SessionContextExplorerPinnedExample.razor",
                    "Showcode/Examples/Session/SessionContextExplorer/SessionContextExplorerPinnedExample.razor")
            ])
    ];
}
