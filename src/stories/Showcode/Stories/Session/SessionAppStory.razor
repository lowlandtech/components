@attribute [DisplayName("Session/SessionBlock")]
@inherits StoryComponent

<StoryCard Title="SessionBlock"
           Description="Working composed session surface with sessions, context projection, pins, context blocks, turns, and command submit."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<SessionBlockDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "SessionBlockDefaultExample.razor",
                    "Showcode/Examples/Session/SessionBlock/SessionBlockDefaultExample.razor")
            ]),
        new(
            "test-mode",
            "Test Mode",
            @<SessionBlockTestModeExample />,
            [
                StorySourceRegistry.CodeTab(
                    "test-mode-razor",
                    "SessionBlockTestModeExample.razor",
                    "Showcode/Examples/Session/SessionBlock/SessionBlockTestModeExample.razor")
            ]),
        new(
            "variants",
            "Variants",
            @<SessionBlockVariantsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "variants-razor",
                    "SessionBlockVariantsExample.razor",
                    "Showcode/Examples/Session/SessionBlock/SessionBlockVariantsExample.razor")
            ]),
        new(
            "standalone",
            "Standalone",
            @<SessionBlockStandaloneExample />,
            [
                StorySourceRegistry.CodeTab(
                    "standalone-razor",
                    "SessionBlockStandaloneExample.razor",
                    "Showcode/Examples/Session/SessionBlock/SessionBlockStandaloneExample.razor")
            ])
    ];
}
