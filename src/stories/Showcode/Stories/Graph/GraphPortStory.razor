@attribute [DisplayName("Graph/Port")]
@inherits StoryComponent

<StoryCard Title="GraphPort"
           Description="A connection port rendered as a small SVG circle on the perimeter of a node. Input ports are hollow; output ports are filled with the primary colour."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "types",
            "Input / Output",
            @<GraphPortTypesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "types-razor",
                    "GraphPortTypesExample.razor",
                    "Showcode/Examples/Graph/GraphPort/GraphPortTypesExample.razor")
            ]),
        new(
            "labeled",
            "Labeled",
            @<GraphPortLabeledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "labeled-razor",
                    "GraphPortLabeledExample.razor",
                    "Showcode/Examples/Graph/GraphPort/GraphPortLabeledExample.razor")
            ]),
        new(
            "multi-port",
            "Multi-port",
            @<GraphPortMultiPortExample />,
            [
                StorySourceRegistry.CodeTab(
                    "multi-razor",
                    "GraphPortMultiPortExample.razor",
                    "Showcode/Examples/Graph/GraphPort/GraphPortMultiPortExample.razor")
            ])
    ];
}
