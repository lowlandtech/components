@attribute [DisplayName("Graph/Node")]
@inherits StoryComponent

<StoryCard Title="GraphNode"
           Description="A labelled node rendered as an SVG rect. Supports five colour variants, an optional subtitle, and a selected-state ring. Must be placed inside a GraphCanvas."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "variants",
            "Variants",
            @<GraphNodeVariantsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "variants-razor",
                    "GraphNodeVariantsExample.razor",
                    "Showcode/Examples/Graph/GraphNode/GraphNodeVariantsExample.razor")
            ]),
        new(
            "with-subtitle",
            "With subtitle",
            @<GraphNodeWithSubtitleExample />,
            [
                StorySourceRegistry.CodeTab(
                    "subtitle-razor",
                    "GraphNodeWithSubtitleExample.razor",
                    "Showcode/Examples/Graph/GraphNode/GraphNodeWithSubtitleExample.razor")
            ]),
        new(
            "selected",
            "Selected",
            @<GraphNodeSelectedExample />,
            [
                StorySourceRegistry.CodeTab(
                    "selected-razor",
                    "GraphNodeSelectedExample.razor",
                    "Showcode/Examples/Graph/GraphNode/GraphNodeSelectedExample.razor")
            ])
    ];
}
