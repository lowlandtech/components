@attribute [DisplayName("Graph/Edge")]
@inherits StoryComponent

<StoryCard Title="GraphEdge"
           Description="A path connecting two points — supports bezier, straight, and step routing with optional arrowheads and labels. The arrowhead references a marker defined in the parent GraphCanvas."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "bezier",
            "Bezier",
            @<GraphEdgeBezierExample />,
            [
                StorySourceRegistry.CodeTab(
                    "bezier-razor",
                    "GraphEdgeBezierExample.razor",
                    "Showcode/Examples/Graph/GraphEdge/GraphEdgeBezierExample.razor")
            ]),
        new(
            "straight",
            "Straight",
            @<GraphEdgeStraightExample />,
            [
                StorySourceRegistry.CodeTab(
                    "straight-razor",
                    "GraphEdgeStraightExample.razor",
                    "Showcode/Examples/Graph/GraphEdge/GraphEdgeStraightExample.razor")
            ]),
        new(
            "step",
            "Step",
            @<GraphEdgeStepExample />,
            [
                StorySourceRegistry.CodeTab(
                    "step-razor",
                    "GraphEdgeStepExample.razor",
                    "Showcode/Examples/Graph/GraphEdge/GraphEdgeStepExample.razor")
            ]),
        new(
            "labeled",
            "Labeled",
            @<GraphEdgeLabeledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "labeled-razor",
                    "GraphEdgeLabeledExample.razor",
                    "Showcode/Examples/Graph/GraphEdge/GraphEdgeLabeledExample.razor")
            ]),
        new(
            "variants",
            "Variants",
            @<GraphEdgeVariantsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "variants-razor",
                    "GraphEdgeVariantsExample.razor",
                    "Showcode/Examples/Graph/GraphEdge/GraphEdgeVariantsExample.razor")
            ]),
        new(
            "waypoints",
            "Waypoints",
            @<GraphEdgeWaypointsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "waypoints-razor",
                    "GraphEdgeWaypointsExample.razor",
                    "Showcode/Examples/Graph/GraphEdge/GraphEdgeWaypointsExample.razor")
            ])
    ];
}
