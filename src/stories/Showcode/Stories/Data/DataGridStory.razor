@attribute [DisplayName("Data/DataGrid")]
@inherits StoryComponent

<StoryCard Title="DataGrid"
           Description="DataGrid states demonstrate filterable paged rows, empty templates, loading templates, multi-sort, detail rows, header/footer templates, density, and selection."
           States="@States" />

@code {
    private const string OrderRowSource = "Showcode/Examples/Data/DataGrid/OrderRow.cs";
    private const string CustomerInfoSource = "Showcode/Examples/Data/DataGrid/CustomerInfo.cs";
    private const string SampleDataSource = "Showcode/Examples/Data/DataGrid/DataGridSampleData.cs";

    private IReadOnlyList<StoryCard.State> States => [
        new(
            "orders",
            "Orders",
            @<DataGridOrdersExample />,
            [
                StorySourceRegistry.CodeTab(
                    "orders-razor",
                    "DataGridOrdersExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridOrdersExample.razor"),
                SharedModelTab("orders-model"),
                SharedCustomerInfoTab("orders-info"),
                SharedDataTab("orders-data")
            ]),
        new(
            "multi-sort",
            "Multi Sort",
            @<DataGridMultiSortExample />,
            [
                StorySourceRegistry.CodeTab(
                    "multi-sort-razor",
                    "DataGridMultiSortExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridMultiSortExample.razor"),
                SharedModelTab("multi-sort-model"),
                SharedCustomerInfoTab("multi-sort-info"),
                SharedDataTab("multi-sort-data")
            ]),
        new(
            "detail",
            "Detail Rows",
            @<DataGridDetailExample />,
            [
                StorySourceRegistry.CodeTab(
                    "detail-razor",
                    "DataGridDetailExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridDetailExample.razor"),
                SharedModelTab("detail-model"),
                SharedCustomerInfoTab("detail-info"),
                SharedDataTab("detail-data")
            ]),
        new(
            "header-footer",
            "Header & Footer Templates",
            @<DataGridHeaderFooterExample />,
            [
                StorySourceRegistry.CodeTab(
                    "header-footer-razor",
                    "DataGridHeaderFooterExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridHeaderFooterExample.razor"),
                SharedModelTab("header-footer-model"),
                SharedCustomerInfoTab("header-footer-info"),
                SharedDataTab("header-footer-data")
            ]),
        new(
            "density",
            "Density & Grid Lines",
            @<DataGridDensityExample />,
            [
                StorySourceRegistry.CodeTab(
                    "density-razor",
                    "DataGridDensityExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridDensityExample.razor"),
                SharedModelTab("density-model"),
                SharedCustomerInfoTab("density-info"),
                SharedDataTab("density-data")
            ]),
        new(
            "empty-text",
            "Empty Text",
            @<DataGridEmptyTextExample />,
            [
                StorySourceRegistry.CodeTab(
                    "empty-text-razor",
                    "DataGridEmptyTextExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridEmptyTextExample.razor"),
                SharedModelTab("empty-text-model"),
                SharedCustomerInfoTab("empty-text-info"),
                SharedDataTab("empty-text-data")
            ]),
        new(
            "empty",
            "Empty",
            @<DataGridEmptyExample />,
            [
                StorySourceRegistry.CodeTab(
                    "empty-razor",
                    "DataGridEmptyExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridEmptyExample.razor"),
                SharedModelTab("empty-model"),
                SharedCustomerInfoTab("empty-info"),
                SharedDataTab("empty-data")
            ]),
        new(
            "loading",
            "Loading",
            @<DataGridLoadingExample />,
            [
                StorySourceRegistry.CodeTab(
                    "loading-razor",
                    "DataGridLoadingExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridLoadingExample.razor"),
                SharedModelTab("loading-model"),
                SharedCustomerInfoTab("loading-info"),
                SharedDataTab("loading-data")
            ]),
        new(
            "pager",
            "Pager",
            @<DataGridPagerExample />,
            [
                StorySourceRegistry.CodeTab(
                    "pager-razor",
                    "DataGridPagerExample.razor",
                    "Showcode/Examples/Data/DataGrid/DataGridPagerExample.razor"),
                SharedModelTab("pager-model"),
                SharedCustomerInfoTab("pager-info"),
                SharedDataTab("pager-data")
            ])
    ];

    private static StoryCard.CodeTab SharedModelTab(string value) =>
        StorySourceRegistry.CodeTab(value, "OrderRow.cs", OrderRowSource, "csharp");

    private static StoryCard.CodeTab SharedCustomerInfoTab(string value) =>
        StorySourceRegistry.CodeTab(value, "CustomerInfo.cs", CustomerInfoSource, "csharp");

    private static StoryCard.CodeTab SharedDataTab(string value) =>
        StorySourceRegistry.CodeTab(value, "DataGridSampleData.cs", SampleDataSource, "csharp");
}
