@attribute [DisplayName("Data/DataForm")]
@inherits StoryComponent

<StoryCard Title="DataForm"
           Description="DataForm states demonstrate model binding, layout modes, read-only rendering, and validation integration."
           States="@States" />

@code {
    private const string CustomerModelSource = "Showcode/Examples/Data/DataForm/CustomerModel.cs";
    private const string CustomerStatusSource = "Showcode/Examples/Data/DataForm/CustomerStatus.cs";

    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<DataFormDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "DataFormDefaultExample.razor",
                    "Showcode/Examples/Data/DataForm/DataFormDefaultExample.razor"),
                SharedModelTab("default-model"),
                SharedEnumTab("default-enum")
            ]),
        new(
            "grid",
            "Grid Layout",
            @<DataFormGridExample />,
            [
                StorySourceRegistry.CodeTab(
                    "grid-razor",
                    "DataFormGridExample.razor",
                    "Showcode/Examples/Data/DataForm/DataFormGridExample.razor"),
                SharedModelTab("grid-model"),
                SharedEnumTab("grid-enum")
            ]),
        new(
            "readonly",
            "Read Only",
            @<DataFormReadOnlyExample />,
            [
                StorySourceRegistry.CodeTab(
                    "readonly-razor",
                    "DataFormReadOnlyExample.razor",
                    "Showcode/Examples/Data/DataForm/DataFormReadOnlyExample.razor"),
                SharedModelTab("readonly-model"),
                SharedEnumTab("readonly-enum")
            ]),
        new(
            "validation",
            "Validation",
            @<DataFormValidationExample />,
            [
                StorySourceRegistry.CodeTab(
                    "validation-razor",
                    "DataFormValidationExample.razor",
                    "Showcode/Examples/Data/DataForm/DataFormValidationExample.razor"),
                SharedModelTab("validation-model"),
                SharedEnumTab("validation-enum")
            ]),
        new(
            "templates",
            "Templates",
            @<DataFormTemplatesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "templates-razor",
                    "DataFormTemplatesExample.razor",
                    "Showcode/Examples/Data/DataForm/DataFormTemplatesExample.razor"),
                SharedModelTab("templates-model"),
                SharedEnumTab("templates-enum")
            ]),
        new(
            "editors",
            "All Editors",
            @<DataFormEditorsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "editors-razor",
                    "DataFormEditorsExample.razor",
                    "Showcode/Examples/Data/DataForm/DataFormEditorsExample.razor"),
                SharedModelTab("editors-model"),
                SharedEnumTab("editors-enum")
            ])
    ];

    private static StoryCard.CodeTab SharedModelTab(string value) =>
        StorySourceRegistry.CodeTab(value, "CustomerModel.cs", CustomerModelSource, "csharp");

    private static StoryCard.CodeTab SharedEnumTab(string value) =>
        StorySourceRegistry.CodeTab(value, "CustomerStatus.cs", CustomerStatusSource, "csharp");
}
