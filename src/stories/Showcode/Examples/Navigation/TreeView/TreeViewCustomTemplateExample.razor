@namespace LowlandTech.Components.Stories.Showcode.Examples.Navigation

<div class="w-full max-w-sm rounded-lg border border-border p-4">
    <TreeView TItem="TreeViewFileItem"
              Items="TreeViewSampleData.RootItems"
              GetChildren="f => f.Children"
              GetKey="f => f.Id"
              HasChildren="f => f.Children.Count > 0"
              class="space-y-1">
        <ItemTemplate Context="ctx">
            <div class="flex items-center gap-2 rounded px-2 py-1 hover:bg-muted"
                 style="padding-left: @(ctx.Depth * 16 + 8)px">
                @if (ctx.HasChildren)
                {
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="transition-transform @(ctx.IsExpanded ? "rotate-90" : "")">
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                }
                else
                {
                    <span class="w-3.5"></span>
                }
                <Icon Name="@TreeViewSampleData.GetIcon(ctx.Item)" Size="14" />
                <span class="text-sm">@ctx.Item.Name</span>
            </div>
        </ItemTemplate>
    </TreeView>
</div>
