@namespace LowlandTech.Components.Stories.Showcode.Examples.Layout

<div class="h-96 w-full border border-border rounded-lg overflow-hidden flex">
    <SidebarProvider DefaultOpen="true">
        <Sidebar>
            <SidebarHeader>
                <SidebarBrand LogoSrc="_content/LowlandTech.Components/img/session-block-logo.svg" LogoAlt="MyApp" Title="MyApp" />
            </SidebarHeader>
            <SidebarContent>
                <SidebarGroup>
                    <SidebarGroupLabel>Navigation</SidebarGroupLabel>
                    <SidebarGroupContent>
                        <SidebarMenu>
                            <SidebarMenuItem>
                                <SidebarMenuButton>Dashboard</SidebarMenuButton>
                            </SidebarMenuItem>
                            <SidebarMenuItem>
                                <SidebarMenuButton>Projects</SidebarMenuButton>
                            </SidebarMenuItem>
                            <SidebarMenuItem>
                                <SidebarMenuButton>Reports</SidebarMenuButton>
                            </SidebarMenuItem>
                        </SidebarMenu>
                    </SidebarGroupContent>
                </SidebarGroup>
                <SidebarGroup>
                    <SidebarGroupLabel>Account</SidebarGroupLabel>
                    <SidebarGroupContent>
                        <SidebarMenu>
                            <SidebarMenuItem>
                                <SidebarMenuButton>Profile</SidebarMenuButton>
                            </SidebarMenuItem>
                            <SidebarMenuItem>
                                <SidebarMenuButton>Settings</SidebarMenuButton>
                            </SidebarMenuItem>
                        </SidebarMenu>
                    </SidebarGroupContent>
                </SidebarGroup>
            </SidebarContent>
            <SidebarFooter>
                <span class="px-2 text-xs text-muted-foreground">© 2025 MyApp</span>
            </SidebarFooter>
        </Sidebar>
        <SidebarInset>
            <header class="flex h-10 shrink-0 items-center gap-2 border-b px-4">
                <SidebarTrigger class="h-7 w-7"><Icon Name="panel-left" Size="16" /></SidebarTrigger>
                <span class="text-sm font-medium">Dashboard</span>
            </header>
            <div class="p-4">
                <p class="text-sm text-muted-foreground">Main content area. Click the trigger to collapse the sidebar.</p>
            </div>
        </SidebarInset>
    </SidebarProvider>
</div>
