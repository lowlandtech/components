@namespace LowlandTech.Components.Stories.Showcode.Examples.Layout

<div class="w-full">
    <div class="min-h-[22rem] w-full overflow-hidden rounded-md border border-border">
        <AppLayout Scenario="AppLayoutScenario.Studio"
                   TopBar="@TopBar"
                   Sidebar="@Sidebar"
                   Main="@Main"
                   Aside="@Aside"
                   Footer="@Footer" />
    </div>
</div>

@code {
    private RenderFragment TopBar => @<div class="flex items-center justify-between gap-3">
        <div class="font-semibold">LowlandTech</div>
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
            <span>Scenario</span>
            <span class="rounded-md border border-border px-2 py-1">Studio</span>
        </div>
    </div>;

    private RenderFragment Sidebar => @<nav class="space-y-1 p-3 text-sm">
        <a class="block rounded-md bg-sidebar-accent px-3 py-2 font-medium text-sidebar-accent-foreground">Dashboard</a>
        <a class="block rounded-md px-3 py-2 text-sidebar-foreground/80">Projects</a>
        <a class="block rounded-md px-3 py-2 text-sidebar-foreground/80">Reports</a>
        <a class="block rounded-md px-3 py-2 text-sidebar-foreground/80">Settings</a>
    </nav>;

    private RenderFragment Main => @<main class="space-y-4">
        <div class="grid gap-3 md:grid-cols-3">
            <div class="rounded-md border border-border bg-card p-4">
                <div class="text-xs text-muted-foreground">Revenue</div>
                <div class="mt-1 text-2xl font-semibold">$48.2k</div>
            </div>
            <div class="rounded-md border border-border bg-card p-4">
                <div class="text-xs text-muted-foreground">Open work</div>
                <div class="mt-1 text-2xl font-semibold">37</div>
            </div>
            <div class="rounded-md border border-border bg-card p-4">
                <div class="text-xs text-muted-foreground">Deploys</div>
                <div class="mt-1 text-2xl font-semibold">12</div>
            </div>
        </div>
        <section class="rounded-md border border-border bg-card p-4">
            <h3 class="font-semibold">Main content</h3>
            <p class="mt-2 text-sm text-muted-foreground">
                The same body content can stay mounted while the session switches the shell scenario.
            </p>
        </section>
    </main>;

    private RenderFragment Aside => @<aside class="space-y-3 text-sm">
        <div class="font-semibold">On this page</div>
        <a class="block text-muted-foreground">Overview</a>
        <a class="block text-muted-foreground">Activity</a>
        <a class="block text-muted-foreground">Resources</a>
    </aside>;

    private RenderFragment Footer => @<div class="flex items-center justify-between text-xs text-muted-foreground">
        <span>Studio status</span>
        <span>All changes saved</span>
    </div>;
}
