@namespace LowlandTech.Components.Stories.Showcode.Examples.Graph

<GraphCanvas Width="420" Height="200">
    @* default *@
    <GraphNode X="40"  Y="22"  Title="Node A" />
    <GraphNode X="260" Y="22"  Title="Node B" />
    <GraphEdge X1="160" Y1="44" X2="260" Y2="44" Routing="straight" />
    @* dashed *@
    <GraphNode X="40"  Y="88"  Title="Node C" />
    <GraphNode X="260" Y="88"  Title="Node D" />
    <GraphEdge X1="160" Y1="110" X2="260" Y2="110" Routing="straight" Variant="dashed" />
    @* highlighted *@
    <GraphNode X="40"  Y="154" Title="Node E" Variant="primary" />
    <GraphNode X="260" Y="154" Title="Node F" Variant="primary" />
    <GraphEdge X1="160" Y1="176" X2="260" Y2="176" Routing="straight" Variant="highlighted" />
</GraphCanvas>
