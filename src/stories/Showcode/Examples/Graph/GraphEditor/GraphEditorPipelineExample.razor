@namespace LowlandTech.Components.Stories.Showcode.Examples.Graph

<GraphEditor Diagram="@_diagram" Width="540" Height="220" />

@code {
    private readonly GraphDiagram _diagram = BuildPipeline();

    private static GraphDiagram BuildPipeline()
    {
        var d = new GraphDiagram();

        var input   = d.AddNode(new GraphNodeModel(40,  88) { Title = "Input",   Variant = "primary" });
        var process = d.AddNode(new GraphNodeModel(210, 88) { Title = "Process" });
        var output  = d.AddNode(new GraphNodeModel(380, 88) { Title = "Output",  Variant = "success" });

        d.AddEdge(input.AddPort(GraphPortAlignment.Right),   process.AddPort(GraphPortAlignment.Left));
        d.AddEdge(process.AddPort(GraphPortAlignment.Right), output.AddPort(GraphPortAlignment.Left));

        return d;
    }
}
