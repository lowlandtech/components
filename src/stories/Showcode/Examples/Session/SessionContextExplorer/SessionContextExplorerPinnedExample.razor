@namespace LowlandTech.Components.Stories.Showcode.Examples.Session

<SessionContextExplorer RootNodes="_nodes"
                        State="_state" />

@code {
    private static readonly SessionNodeInput _workspaces = new("workspaces", "workspaces.header", "Workspaces", "NodeBlock");
    private static readonly SessionNodeInput _setupCi = new("setup-ci", "workitem", "Set up CI", "NodeBlock");

    private readonly IReadOnlyList<SessionContextNode> _nodes =
    [
        new(_workspaces, [new(_setupCi)])
    ];

    private readonly SessionUiState _state =
        SessionUiReducer.Reduce(
            SessionUiReducer.Reduce(SessionUiDefaults.Empty, new ProjectSessionContext(_setupCi)),
            new PinSessionContext(new SessionContextProjectionModel(_setupCi)));
}
