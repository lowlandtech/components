@namespace LowlandTech.Components.Stories.Showcode.Examples.Session

<SessionBlock Variant="none"
                HasSidebar="true"
                IsTest="true"
                ContextNodes="_contextNodes"
                Class="h-full w-full"
                PageOverlayContainerClass="page-overlay-container absolute inset-0 z-40 flex h-full w-full flex-col bg-background"
                AppOverlayContainerClass="session-block-overlay absolute inset-0 z-50 flex h-full w-full flex-col overflow-hidden rounded-none bg-background gap-0 py-0" />

@code {
    private readonly IReadOnlyList<SessionContextNode> _contextNodes =
    [
        new(
            new SessionNodeInput("workspaces", "workspaces.header", "Workspaces", "NodeBlock"),
            [
                new SessionContextNode(new SessionNodeInput("foundry", "workspace", "Foundry", "NodeBlock"), IsLoaded: true),
                new SessionContextNode(new SessionNodeInput("acme", "workspace", "Acme", "NodeBlock"), IsLoaded: true)
            ],
            IsLoaded: false),
        new(
            new SessionNodeInput("flows", "flow.header", "Flows", "NodeBlock"),
            [
                new SessionContextNode(new SessionNodeInput("onboarding", "flow", "Onboarding", "NodeBlock"), IsLoaded: true),
                new SessionContextNode(new SessionNodeInput("approval", "flow", "Approval", "NodeBlock"), IsLoaded: true)
            ],
            IsLoaded: false),
        new(
            new SessionNodeInput("workitems", "workitems.header", "Workitems", "NodeBlock"),
            [
                new SessionContextNode(new SessionNodeInput("setup-ci", "workitem", "Set up CI", "NodeBlock"), IsLoaded: true),
                new SessionContextNode(new SessionNodeInput("write-docs", "workitem", "Write docs", "NodeBlock"), IsLoaded: true)
            ],
            IsLoaded: false)
    ];
}
