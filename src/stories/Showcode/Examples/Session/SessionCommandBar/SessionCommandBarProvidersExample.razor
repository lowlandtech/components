@namespace LowlandTech.Components.Stories.Showcode.Examples.Session
@inject IAgentSelectionService AgentSelection

<div class="min-h-80 bg-background p-6">
    <SessionCommandBar SelectedNode="_node"
                       Value="_value"
                       ValueChanged="value => _value = value"
                       Placeholder="Type /providers or /models..." />

    <p class="mt-4 text-xs text-muted-foreground">
        Active: @AgentSelection.CurrentSelection.ProviderKey / @AgentSelection.CurrentSelection.ModelKey
    </p>
</div>

@code {
    private readonly SessionNodeInput _node = new("orders", "session", "Orders");
    private string _value = "/providers";
}
