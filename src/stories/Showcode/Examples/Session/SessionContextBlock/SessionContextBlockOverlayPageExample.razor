@namespace LowlandTech.Components.Stories.Showcode.Examples.Session

<div class="h-80 w-full overflow-hidden rounded-md border border-border">
    <SessionContextBlock Block="_block" Mode="@SessionContextBlock.ModeOverlayPage">
        <div class="rounded-md border border-border bg-muted/20 p-3">
            <p class="text-sm font-medium">Invoice approval</p>
            <p class="mt-1 text-xs text-muted-foreground">OverlayPage fills the page body container.</p>
        </div>
    </SessionContextBlock>
</div>

@code {
    private readonly SessionContextBlockModel _block = new(
        "context-block:invoice-approval",
        new("invoice-approval", "invoice", "Invoice approval", "InvoiceBlock"),
        "Amount: EUR 4,200; Status: pending finance approval");
}
