@namespace LowlandTech.Components.Stories.Showcode.Examples.Form

<div class="space-y-3">
    <div class="flex items-center gap-3">
        <Switch id="sw1" IsChecked="false" />
        <Label For="sw1">Off</Label>
    </div>
    <div class="flex items-center gap-3">
        <Switch id="sw2" IsChecked="true" />
        <Label For="sw2">On</Label>
    </div>
    <div class="flex items-center gap-3">
        <Switch id="sw3" Disabled="true" />
        <Label For="sw3" Disabled="true">Disabled</Label>
    </div>
</div>
