@namespace LowlandTech.Components.Stories.Showcode.Examples.Misc
@implements IDisposable
@inject ComponentThemeService ThemeService

<div class="flex gap-4 flex-wrap">
    <ThemeProvider Id="tp-a" Theme="Ocean"
                   Class="flex-1 min-w-64 rounded-xl border p-4 bg-background text-foreground">
        <div class="flex items-center justify-between mb-3">
            <Badge>@Label("tp-a")</Badge>
            <ThemeToggle AriaLabel="Cycle theme" />
        </div>
        <div class="space-y-2">
            <p class="text-sm font-medium">Ocean boundary</p>
            <p class="text-xs text-muted-foreground">Tokens are scoped to this element's subtree. Toggling cycles only this provider.</p>
            <div class="flex gap-2 pt-1">
                <Button Variant="default" Size="sm">Primary</Button>
                <Button Variant="outline" Size="sm">Outline</Button>
            </div>
        </div>
    </ThemeProvider>

    <ThemeProvider Id="tp-b" Theme="Rose"
                   Class="flex-1 min-w-64 rounded-xl border p-4 bg-background text-foreground">
        <div class="flex items-center justify-between mb-3">
            <Badge>@Label("tp-b")</Badge>
            <ThemeToggle AriaLabel="Cycle theme" />
        </div>
        <div class="space-y-2">
            <p class="text-sm font-medium">Rose boundary</p>
            <p class="text-xs text-muted-foreground">Independent theme state. Cycling here does not affect the adjacent provider.</p>
            <div class="flex gap-2 pt-1">
                <Button Variant="default" Size="sm">Primary</Button>
                <Button Variant="outline" Size="sm">Outline</Button>
            </div>
        </div>
    </ThemeProvider>
</div>

@code {
    protected override void OnInitialized() =>
        ThemeService.ThemeChanged += OnChanged;

    public void Dispose() =>
        ThemeService.ThemeChanged -= OnChanged;

    private void OnChanged(string _) => StateHasChanged();

    private string Label(string providerId) =>
        ThemeService.GetNameForProvider(providerId) ?? "—";
}
