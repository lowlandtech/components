@namespace LowlandTech.Components.Stories.Showcode.Examples.Data

<Card class="w-full max-w-sm">
    <CardHeader>
        <CardTitle>Header Slot</CardTitle>
        <CardDescription>Custom header above the rows.</CardDescription>
    </CardHeader>
    <CardContent>
        <PropertyGrid TField="PropertyField"
                      Items="_fields"
                      LabelSelector="f => f.Label">
            <Header>
                <h3 class="text-sm font-semibold">User Details</h3>
            </Header>
            <EditorTemplate Context="field">
                <Input Value="@field.Value" />
            </EditorTemplate>
        </PropertyGrid>
    </CardContent>
</Card>

@code {
    private readonly IReadOnlyList<PropertyField> _fields =
    [
        new("Name", "Ada Lovelace"),
        new("Email", "ada@example.com")
    ];
}
