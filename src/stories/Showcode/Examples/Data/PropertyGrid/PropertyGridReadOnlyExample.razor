@namespace LowlandTech.Components.Stories.Showcode.Examples.Data

<Card class="w-full max-w-sm">
    <CardHeader>
        <CardTitle>Read Only</CardTitle>
        <CardDescription>Some rows greyed out via IsReadOnlySelector.</CardDescription>
    </CardHeader>
    <CardContent>
        <PropertyGrid TField="PropertyField"
                      Items="_fields"
                      LabelSelector="f => f.Label"
                      IsReadOnlySelector="f => f.IsReadOnly">
            <EditorTemplate Context="field">
                <Input Value="@field.Value" />
            </EditorTemplate>
        </PropertyGrid>
    </CardContent>
</Card>

@code {
    private readonly IReadOnlyList<PropertyField> _fields =
    [
        new("Name", "Ada Lovelace", IsReadOnly: false),
        new("ID", "usr-1042", IsReadOnly: true),
        new("Created", "2026-01-15", IsReadOnly: true)
    ];
}
