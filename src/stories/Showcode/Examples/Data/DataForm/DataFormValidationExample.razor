    <CardHeader>
        <CardTitle>Validation</CardTitle>
        <CardDescription>Form with validation rules and submit handling.</CardDescription>
    </CardHeader>
    <CardContent>
        <DataForm Model="_model" ValidateOnSubmit="true" OnValidSubmit="HandleValid" OnInvalidSubmit="HandleInvalid" />
    </CardContent>
</Card>

@code {
    private readonly CustomerModel _model = new() { Name = "", Email = "not-an-email", CreditLimit = 20000 };

    private void HandleValid(EditContext ctx) { }
    private void HandleInvalid(EditContext ctx) { }
}
