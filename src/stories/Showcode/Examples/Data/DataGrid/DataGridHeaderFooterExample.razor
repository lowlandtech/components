@namespace LowlandTech.Components.Stories.Showcode.Examples.Data

<div class="p-1">
    <DataGrid TItem="OrderRow" Items="@DataGridSampleData.Orders" PageSize="3">
        <Columns>
            <DataGridColumn TItem="OrderRow" Property="OrderNumber" Title="Order">
                <HeaderTemplate>
                    <span class="font-bold text-primary">📦 Order</span>
                </HeaderTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="OrderRow" Property="Customer.Name" Title="Customer" />
            <DataGridColumn TItem="OrderRow" Property="Total" Title="Total" FormatString="C0" />
        </Columns>
        <FooterTemplate>
            <div class="flex justify-between text-sm font-medium">
                <span>@DataGridSampleData.Orders.Count orders</span>
                <span>@DataGridSampleData.Orders.Sum(o => o.Total).ToString("C0")</span>
            </div>
        </FooterTemplate>
    </DataGrid>
</div>
