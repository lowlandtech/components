@namespace LowlandTech.Components.Stories.Showcode.Examples.Overlay
@inject LowlandTech.Components.Popover.IPopoverService PopoverService
@implements IDisposable

<PopoverProvider />

@code {
    protected override void OnInitialized()
    {
        PopoverService.OnChanged += OnPopoverChanged;
    }

    private void OnPopoverChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PopoverService.OnChanged -= OnPopoverChanged;
    }
}
