@namespace LowlandTech.Components.Stories.Showcode.Examples.Overlay

<TooltipProvider>
    <Tooltip Delay="1000" DelayHide="500">
        <TooltipTrigger>
            <Button Variant="outline">Delayed tooltip</Button>
        </TooltipTrigger>
        <TooltipContent>
            <p>Shows after 1s, hides after 500ms</p>
        </TooltipContent>
    </Tooltip>
</TooltipProvider>
