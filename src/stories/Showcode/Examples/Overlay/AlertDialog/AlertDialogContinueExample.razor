@namespace LowlandTech.Components.Stories.Showcode.Examples.Overlay

<AlertDialog>
    <AlertDialogTrigger>
        <Button Variant="outline">Continue</Button>
    </AlertDialogTrigger>
    <AlertDialogContent>
        <AlertDialogHeader>
            <AlertDialogTitle>Continue with changes?</AlertDialogTitle>
            <AlertDialogDescription>This will apply all pending changes to your account. You can review them later in Settings.</AlertDialogDescription>
        </AlertDialogHeader>
        <AlertDialogFooter>
            <AlertDialogCancel>Go back</AlertDialogCancel>
            <AlertDialogAction>Continue</AlertDialogAction>
        </AlertDialogFooter>
    </AlertDialogContent>
</AlertDialog>
