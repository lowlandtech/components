@namespace LowlandTech.Components.Stories.Showcode.Examples.Overlay

<AlertDialog>
    <AlertDialogTrigger>
        <Button Variant="secondary">Click overlay to close</Button>
    </AlertDialogTrigger>
    <AlertDialogContent CloseOnOverlayClick="true">
        <AlertDialogHeader>
            <AlertDialogTitle>Click outside</AlertDialogTitle>
            <AlertDialogDescription>This dialog closes when you click the overlay background.</AlertDialogDescription>
        </AlertDialogHeader>
        <AlertDialogFooter>
            <AlertDialogCancel>Close</AlertDialogCancel>
        </AlertDialogFooter>
    </AlertDialogContent>
</AlertDialog>
