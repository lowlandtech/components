@namespace LowlandTech.Components.Stories.Pages
@inject ShowcodeState State
@inject NavigationManager Nav

<div class="flex h-[calc(100dvh-9rem)] min-h-0 items-stretch gap-2 overflow-x-auto overflow-y-hidden px-6 pb-6" style="padding-top: 2rem;">
        @foreach (var group in _groups)
        {
            var colors = GetGroupColors(group.Name);
            <div class="flex min-h-0 flex-col gap-1.5" style="flex: 1 0 0; min-width: 88px;">
                <div class="@colors.Header rounded-md px-1 py-1.5 text-center">
                    <span class="text-[10px] font-bold uppercase tracking-widest leading-none">@group.Name</span>
                </div>
                <div class="min-h-0 flex-1 space-y-1.5 overflow-y-auto pr-1">
                    @foreach (var story in group.Stories)
                    {
                        var num = _nums[(group.Name, story.Name)];
                        <button type="button"
                                class="@colors.Cell flex w-full cursor-pointer flex-col items-center gap-0.5 rounded-md border px-1.5 pt-1.5 pb-2 text-center transition-all focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                                @onclick="() => SelectAndNavigate(story)">
                            <div class="flex items-center justify-between w-full">
                                <span class="text-[9px] font-mono leading-none opacity-40 select-none">@num</span>
                                <Icon Paths="@GetIconPaths(story.Name)" Size="16" class="shrink-0 opacity-60 transition-opacity" />
                            </div>
                            <span class="text-[15px] font-bold leading-tight tracking-tight select-none">@GetAbbrev(story.Name)</span>
                            <span class="text-[9px] leading-tight opacity-60 select-none w-full truncate">@story.Name</span>
                        </button>
                    }
                </div>
            </div>
        }
</div>

@code {
    [Parameter] public string BasePath { get; set; } = "/admin/components";

    private static readonly string[] GroupOrder = ["Blocks", "Data", "Feedback", "Form", "Layout", "Misc", "Navigation", "Overlay", "Session", "Graph", "Work"];

    private List<StoryGroup> _groups = [];
    private int _total;
    private Dictionary<(string, string), int> _nums = new();

    private void SelectAndNavigate(StoryMetadata story)
    {
        State.Select(story);
        Nav.NavigateTo($"{BasePath.TrimEnd('/')}/{story.RouteSlug}");
    }

    protected override void OnInitialized()
    {
        _groups = StoryRegistry.Root.Children
            .OrderBy(g => Array.IndexOf(GroupOrder, g.Name) is var i && i >= 0 ? i : 99)
            .ToList();
        _total = _groups.Sum(g => g.Stories.Count);
        var n = 1;
        foreach (var g in _groups)
            foreach (var s in g.Stories)
                _nums[(g.Name, s.Name)] = n++;
    }

