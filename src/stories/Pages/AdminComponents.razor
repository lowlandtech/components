@namespace LowlandTech.Components.Stories.Pages
@page "/admin/components"
@page "/admin/components/{Component}"
@attribute [PluginPage(Label = "Components", Icon = "layers", Group = "UI", Order = 10)]
@inject ShowcodeState State
@implements IDisposable

<PageTitle>TinyComponents</PageTitle>

@if (State.Current is not null)
{
    <div class="p-2.5 pt-0">
        <DynamicComponent Type="@State.Current.Type" />
    </div>
}
else
{
    <Home />
}

@code {
    [Parameter] public string? Component { get; set; }

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Component))
        {
            State.ShowTable();
            return;
        }

        var story = StoryRegistry.GetByRouteSlug(Component) ?? StoryRegistry.GetBySlug(Component);
        if (story is not null)
        {
            State.Select(story);
            return;
        }

        State.ShowTable();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= Refresh;
}
