@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="dynamic-node-block"
     data-node-id="@Context?.Id"
     data-node-type="@Context?.NodeTypeKey"
     data-view-mode="@ViewMode"
     data-form-mode="@FormMode"
     data-mode="@Mode"
     class="@RootClass">
    @if (IsGridView)
    {
        <div data-slot="dynamic-node-grid" class="flex h-full min-h-0 flex-col gap-3">
            <div class="flex shrink-0 items-center gap-2">
                <Input Type="search"
                       Value="@_filterText"
                       ValueChanged="HandleSearchChanged"
                       OnKeyUp="HandleSearchKeyUp"
                       Placeholder="@L("CreateCommandPlaceholder")"
                       class="min-w-0 flex-1" />
                <Button data-action="add"
                        Size="@ButtonSize.Sm"
                        OnClick="HandleAddAsync">
                    <Icon Name="plus" Size="14" />
                    @L("MenuNew")
                </Button>
            </div>

            <DataGrid TItem="object"
                      Class="min-h-0 flex-1"
                      Items="@FilteredItems"
                      AllowPaging="true"
                      AlwaysShowPager="true"
                      PageSize="@_pageSize"
                      PageSizeChanged="HandlePageSizeChanged"
                      PageIndex="@_pageIndex"
                      PageIndexChanged="HandlePageChanged"
                      SelectionMode="DataGridSelectionMode.Single"
                      SelectedItemChanged="HandleGridSelectionAsync"
                      ItemKey="GetItemKey">
                <EmptyTemplate>
                    <span class="text-sm text-muted-foreground">@L("NoSections")</span>
                </EmptyTemplate>
                <Columns>
                    @GridColumns
                </Columns>
            </DataGrid>
        </div>
    }
    else if (DisplayModel is not null && Fields.Count > 0)
    {
        @switch (Presentation)
        {
            case "workspace":
                <div data-slot="dynamic-workspace-presentation" class="@GetPresentationContainerClass()">
                    <div data-slot="dynamic-node-content" class="@GetPresentationContentClass("space-y-4")">
                        <Alert>
                            <AlertTitle class="flex items-center justify-between gap-3">
                                <span>@Context?.Label</span>
                                <Badge Variant="secondary">@GetDisplayValue("Region")</Badge>
                            </AlertTitle>
                            <AlertDescription class="mt-2 font-mono text-xs">
                                @GetDisplayValue("Slug")
                            </AlertDescription>
                        </Alert>
                        @FormContent
                    </div>
                    <div data-slot="dynamic-node-actions" class="@GetPresentationFooterClass(false)">
                        @FormActions
                    </div>
                </div>
                break;

            case "flow":
                <div data-slot="dynamic-flow-presentation" class="@GetPresentationContainerClass()">
                    <div data-slot="dynamic-node-content" class="@GetPresentationContentClass("space-y-4")">
                        <Alert>
                            <AlertTitle class="flex items-center justify-between gap-3">
                                <span>@Context?.Label</span>
                                <Badge Variant="@FlowStatusVariant">@GetDisplayValue("IsEnabled")</Badge>
                            </AlertTitle>
                            <AlertDescription class="mt-2 font-mono text-xs">
                                @GetDisplayValue("Trigger")
                            </AlertDescription>
                        </Alert>
                        <Progress Value="@FlowProgress" />
                        @FormContent
                    </div>
                    <div data-slot="dynamic-node-actions" class="@GetPresentationFooterClass(false)">
                        @FormActions
                    </div>
                </div>
                break;

            case "workitem":
                <div data-slot="dynamic-workitem-presentation" class="@GetPresentationContainerClass()">
                    <div data-slot="dynamic-node-content" class="@GetPresentationContentClass("space-y-4")">
                        <Alert>
                            <AlertTitle class="flex items-center justify-between gap-3">
                                <span class="flex min-w-0 items-center gap-3">
                                    <Avatar Size="sm">
                                        <AvatarFallback>@Initials</AvatarFallback>
                                    </Avatar>
                                    <span class="truncate">@Context?.Label</span>
                                </span>
                                <Badge Variant="@PriorityVariant">@GetDisplayValue("Priority")</Badge>
                            </AlertTitle>
                            <AlertDescription class="mt-1">
                                @GetDisplayValue("Assignee")
                            </AlertDescription>
                        </Alert>
                        <Progress Value="@WorkitemProgress" />
                        @FormContent
                    </div>
                    <div data-slot="dynamic-node-actions" class="@GetPresentationFooterClass(false)">
                        @FormActions
                    </div>
                </div>
                break;

            default:
                <div data-slot="dynamic-default-presentation" class="@GetPresentationContainerClass()">
                    <div data-slot="dynamic-node-content" class="@GetPresentationContentClass("space-y-4")">
                        <div class="rounded-md border border-border bg-muted/20 p-3">
                            <p class="text-sm font-medium">@Context?.Label</p>
                            <p class="mt-1 text-xs text-muted-foreground">
                                <span class="font-mono">@Context?.NodeTypeKey</span>
                            </p>
                        </div>
                        @FormContent
                    </div>
                    <div data-slot="dynamic-node-actions" class="@GetPresentationFooterClass(false)">
                        @FormActions
                    </div>
                </div>
                break;
        }
    }
</div>
