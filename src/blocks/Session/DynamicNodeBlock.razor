@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="dynamic-node-block"
     data-node-id="@Context?.Id"
     data-node-type="@Context?.NodeTypeKey"
     class="space-y-4">
    <div class="rounded-md border border-border bg-muted/20 p-3">
        <p class="text-sm font-medium">@Context?.Label</p>
        <p class="mt-1 text-xs text-muted-foreground">
            Node type: <span class="font-mono">@Context?.NodeTypeKey</span>
        </p>
    </div>

    @if (Fields.Count > 0)
    {
        <div data-slot="dynamic-node-form" class="grid gap-3 sm:grid-cols-2">
            @foreach (var field in Fields)
            {
                <label class="flex flex-col gap-1.5 text-xs font-medium text-muted-foreground">
                    <span>@field.Label</span>
                    <input data-field-input="@field.Key"
                           value="@GetValue(field.Key)"
                           readonly="@field.IsReadOnly"
                           class="flex h-8 rounded-md border border-input bg-background px-2 text-sm text-foreground outline-none transition-colors focus-visible:ring-1 focus-visible:ring-ring disabled:opacity-50"
                           @oninput="e => SetFieldAsync(field, e.Value)" />
                </label>
            }
        </div>
    }
</div>
