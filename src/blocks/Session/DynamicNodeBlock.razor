@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="dynamic-node-block"
     data-node-id="@Context?.Id"
     data-node-type="@Context?.NodeTypeKey"
     data-view-mode="@ViewMode"
     data-form-mode="@FormMode"
     class="space-y-4">
    @if (IsGridView)
    {
        <div data-slot="dynamic-node-grid" class="space-y-3">
            <div class="flex items-center gap-2">
                <Input Type="search"
                       Value="@_filterText"
                       ValueChanged="HandleSearchChanged"
                       OnKeyUp="HandleSearchKeyUp"
                       Placeholder="@L("CreateCommandPlaceholder")"
                       class="min-w-0 flex-1" />
                <Badge Variant="secondary">@FilteredItems.Count</Badge>
            </div>

            <DataGrid TItem="object"
                      Items="@FilteredItems"
                      AllowPaging="true"
                      PageSize="@PageSize"
                      PageIndex="@_pageIndex"
                      PageIndexChanged="HandlePageChanged"
                      SelectionMode="DataGridSelectionMode.Single"
                      SelectedItemChanged="HandleGridSelectionAsync"
                      ItemKey="GetItemKey">
                <EmptyTemplate>
                    <span class="text-sm text-muted-foreground">@L("NoSections")</span>
                </EmptyTemplate>
                <Columns>
                    @GridColumns
                </Columns>
            </DataGrid>
        </div>
    }
    else if (DisplayModel is not null && Fields.Count > 0)
    {
        @switch (Presentation)
        {
            case "workspace":
                <Card data-slot="dynamic-workspace-presentation" Variant="outlined" class="overflow-hidden">
                    <CardHeader>
                        <CardTitle>@Context?.Label</CardTitle>
                        <CardDescription>
                            <span class="flex flex-wrap gap-2">
                                <Badge Variant="secondary">@GetDisplayValue("Region")</Badge>
                                <Badge Variant="outline">@GetDisplayValue("Slug")</Badge>
                            </span>
                        </CardDescription>
                    </CardHeader>
                    <Separator />
                    <CardContent class="pt-4">
                        @FormContent
                    </CardContent>
                    <CardFooter class="justify-end gap-2 border-t border-border">
                        @FormActions
                    </CardFooter>
                </Card>
                break;

            case "flow":
                <div data-slot="dynamic-flow-presentation" class="space-y-4">
                    <Alert>
                        <AlertTitle class="flex items-center justify-between gap-3">
                            <span>@Context?.Label</span>
                            <Badge Variant="@FlowStatusVariant">@GetDisplayValue("IsEnabled")</Badge>
                        </AlertTitle>
                        <AlertDescription class="mt-2 font-mono text-xs">
                            @GetDisplayValue("Trigger")
                        </AlertDescription>
                    </Alert>
                    <Progress Value="@FlowProgress" />
                    @FormContent
                    <div class="flex justify-end gap-2">
                        @FormActions
                    </div>
                </div>
                break;

            case "workitem":
                <Card data-slot="dynamic-workitem-presentation" Variant="outlined">
                    <CardHeader class="grid-cols-[auto_1fr_auto] gap-3">
                        <Avatar Size="sm">
                            <AvatarFallback>@Initials</AvatarFallback>
                        </Avatar>
                        <div class="min-w-0">
                            <CardTitle>@Context?.Label</CardTitle>
                            <CardDescription>@GetDisplayValue("Assignee")</CardDescription>
                        </div>
                        <Badge Variant="@PriorityVariant">@GetDisplayValue("Priority")</Badge>
                    </CardHeader>
                    <CardContent class="space-y-4">
                        <Progress Value="@WorkitemProgress" />
                        <Separator />
                        @FormContent
                    </CardContent>
                    <CardFooter class="justify-end gap-2 border-t border-border">
                        @FormActions
                    </CardFooter>
                </Card>
                break;

            default:
                <div class="rounded-md border border-border bg-muted/20 p-3">
                    <p class="text-sm font-medium">@Context?.Label</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        <span class="font-mono">@Context?.NodeTypeKey</span>
                    </p>
                </div>
                @FormContent
                <div class="flex justify-end gap-2">
                    @FormActions
                </div>
                break;
        }
    }
</div>
