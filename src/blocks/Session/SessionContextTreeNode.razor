@namespace LowlandTech.Components
@inherits TinyComponentBase

<div>
    <div class="group flex items-center gap-1 rounded-sm hover:bg-muted/60 data-[projected=true]:bg-primary/10"
         style="padding-left: @(Math.Max(0, Depth) * 0.75 + 0.5)rem;"
         data-projected="@(Projection?.Node.Id == Item.Node.Id ? "true" : "false")">
        <button type="button"
                data-slot="session-context-node"
                data-node-id="@Item.Node.Id"
                class="flex min-h-8 flex-1 items-center justify-start gap-2 px-2 py-1 text-left text-sm font-normal"
                @onclick="ProjectAsync"
                @ondblclick="PinAsync">
            @if (ShowChevron)
            {
                <span class="inline-flex h-3 w-3 shrink-0 cursor-pointer items-center justify-center"
                      @onclick:stopPropagation
                      @onclick="ToggleExpand">
                    <Icon Name="chevron-right" Size="12" class="@GetChevronClass()" />
                </span>
            }
            else
            {
                <span class="inline-flex h-3 w-3 shrink-0"></span>
            }

            @if (!string.IsNullOrEmpty(NodeIcon))
            {
                <Icon Paths="@NodeIcon" Size="14" class="shrink-0 text-muted-foreground" />
            }

            <span class="min-w-0 flex-1 truncate" title="@Item.Node.NodeTypeKey">@Item.Node.Label</span>
        </button>
        <span class="inline-flex items-center gap-0.5">
            @if (IsHeader)
            {
                <button type="button"
                        class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-sm text-muted-foreground hover:bg-muted hover:text-foreground"
                        data-slot="session-context-node-create"
                        data-node-id="@Item.Node.Id"
                        title="@L("MenuNew")"
                        @onclick="HandleCreateAsync"
                        @onclick:stopPropagation>
                    <Icon Paths="@Icons.Plus" Size="12" />
                </button>
            }
            <span id="popover-anchor-@PopoverId" class="inline-flex">
                <button type="button"
                        class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-sm text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100 focus:opacity-100"
                        data-testid="session-context-node-menu-trigger"
                        data-node-id="@Item.Node.Id"
                        title="@L("Options")"
                        @onclick="ToggleMenuAsync">
                    <Icon Paths="@Icons.EllipsisVertical" Size="12" />
                </button>
            </span>
        </span>
    </div>
    @if (_isExpanded)
    {
        @foreach (var (child, i) in VisibleChildren.Select((node, idx) => (node, idx)))
        {
            <SessionContextTreeNode Item="child"
                                    Depth="@(Depth + 1)"
                                    Index="i"
                                    SiblingCount="@VisibleChildren.Count"
                                    Projection="Projection"
                                    Pins="Pins"
                                    OnProject="OnProject"
                                    OnNavigateToPin="OnNavigateToPin"
                                    OnPin="OnPin"
                                    OnNodeNew="OnNodeNew"
                                    OnNodeRename="OnNodeRename"
                                    OnNodeMoveUp="OnNodeMoveUp"
                                    OnNodeMoveDown="OnNodeMoveDown"
                                    OnNodeDelete="OnNodeDelete"
                                    OnExpand="OnExpand" />
        }
    }

    <SessionContextTreeNodeDeleteDialog @bind-IsOpen="_showDeleteDialog"
                                        Node="Item.Node"
                                        @bind-SkipConfirmation="_skipDeleteConfirmation"
                                        OnConfirm="ConfirmDeleteAsync"
                                        OnCancel="CancelDeleteAsync" />
</div>