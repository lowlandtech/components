@namespace LowlandTech.Components
@inherits TinyComponentBase

<Card data-slot="session-context-block"
      id="@Block.Id"
      data-block-id="@Block.Id"
      data-mode="@NormalizedMode"
      Variant="outlined"
      Elevation="0"
    style="padding-block:0;"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    <CardHeader class="border-b border-border bg-muted/30 px-3 py-2">
        <CardTitle class="truncate text-xs font-semibold">@Block.Context.Label</CardTitle>
        <CardAction class="row-span-1 flex items-center gap-2">
            @if (IsPinned)
            {
                <Badge Variant="secondary" Size="sm" class="gap-1 pl-1.5 pr-1">
                    <Icon Name="pin" Size="9" />
                    <span>Pinned</span>
                    <button type="button"
                            class="inline-flex h-3.5 w-3.5 items-center justify-center rounded-sm text-current opacity-70 transition-opacity hover:opacity-100 hover:bg-background/20 focus:outline-none"
                            data-testid="session-context-block-unpin"
                            title="Unpin"
                            @onclick="UnpinAsync">
                        <Icon Name="x" Size="9" />
                    </button>
                </Badge>
            }
            else
            {
                <Badge Variant="outline" Size="sm">@Block.Context.NodeTypeKey</Badge>
            }
            <CardModeMenu Mode="@NormalizedMode" ModeChanged="OnModeChangedAsync" />
        </CardAction>
    </CardHeader>

    @if (ShowsContent)
    {
        <CardContent class="@GetContentClass()">
            @if (ResolvedComponentType is not null)
            {
                <DynamicComponent Type="@ResolvedComponentType" Parameters="@GetParameters()" />
            }
            else if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                <p class="text-muted-foreground">@GetFallbackText()</p>
            }
        </CardContent>
    }
</Card>
