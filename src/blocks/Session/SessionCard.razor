@namespace LowlandTech.Components
@inherits TinyComponentBase

<Card data-slot="session-card"
      data-node-id="@Node.Id"
      data-mode="@EffectiveMode"
      Mode="@CardMode"
    style="padding-block:0;"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    <CardHeader class="border-b border-border bg-muted/30 px-3 py-2">
        <div class="flex items-center gap-2">
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-sm bg-primary/10 text-[10px] font-semibold text-primary">@Initials</span>
            <span class="truncate text-xs font-semibold">@Node.Label</span>
        </div>
        <CardAction class="flex items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(Status))
            {
                <Badge Variant="@StatusVariant">@Status</Badge>
            }
            <CardModeMenu Mode="@EffectiveMode"
                         ModeChanged="OnModeChangedAsync"
                         TitleTooltip="@L("ViewOptions")"
                         ViewLabel="@L("View")"
                         NormalLabel="@L("Normal")"
                         MinimizedLabel="@L("Minimized")"
                         MaximizedLabel="@L("Maximized")"
                         PageOverlayLabel="@L("PageOverlay")"
                         AppOverlayLabel="@L("AppOverlay")" />
        </CardAction>
    </CardHeader>

    @if (EffectiveMode != Card.ModeMinimized && EffectiveMode != Card.ModeOverlayPage)
    {
        <CardContent class="space-y-2 p-3 text-sm">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }

            @if (Actions.Count > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var action in Actions)
                    {
                        <button type="button"
                                data-slot="session-card-action"
                                data-action-key="@action.Key"
                                class="inline-flex h-8 items-center rounded-md border border-input bg-background px-3 text-xs font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                                @onclick="() => SelectActionAsync(action)">
                            @action.Label
                        </button>
                    }
                </div>
            }
        </CardContent>
    }
</Card>
