@namespace LowlandTech.Components
@inherits TinyComponentBase

<section data-slot="session-settings" class="@GetClass()" @attributes="AdditionalAttributes">
    <aside class="w-44 shrink-0 border-r border-border bg-sidebar/30 px-3 py-4">
        <nav class="space-y-1" aria-label="Settings sections">
            <button type="button"
                    data-testid="session-settings-api-keys-tab"
                    data-active="@(_section == SettingsSection.ApiKeys ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.ApiKeys)"
                    @onclick="() => _section = SettingsSection.ApiKeys">
                @L("ApiKeys")
            </button>
            <button type="button"
                    data-testid="session-settings-activity-tab"
                    data-active="@(_section == SettingsSection.Activity ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.Activity)"
                    @onclick="() => _section = SettingsSection.Activity">
                @L("Activity")
            </button>
            @if (Outbox is not null || OutboxContent is not null)
            {
                <button type="button"
                        data-testid="session-settings-outbox-tab"
                        data-active="@(_section == SettingsSection.Outbox ? "true" : "false")"
                        class="@GetNavButtonClass(SettingsSection.Outbox)"
                        @onclick="() => _section = SettingsSection.Outbox">
                    @L("Outbox")
                </button>
            }
        </nav>
    </aside>

    <div class="min-w-0 flex-1 overflow-y-auto px-6 py-5">
        @if (_section == SettingsSection.Activity)
        {
            <div data-slot="session-settings-activity" class="min-h-0">
                @ActivityContent
            </div>
        }
        else if (_section == SettingsSection.Outbox)
        {
            <div data-slot="session-settings-outbox" class="min-h-0">
                @if (OutboxContent is not null)
                {
                    @OutboxContent
                }
                else if (Outbox is not null)
                {
                    <SessionOutboxList Outbox="Outbox" class="min-h-0 flex-1" />
                }
            </div>
        }
        else
        {
            <div data-slot="session-settings-api-keys" class="mx-auto max-w-5xl">
                <header class="flex flex-wrap items-start justify-between gap-4">
                    <div class="space-y-1">
                        <h2 class="text-sm font-semibold text-foreground">@L("ApiKeysTitle")</h2>
                        <p class="max-w-[60ch] text-sm text-muted-foreground">
                            @L("ApiKeysDescription")
                        </p>
                    </div>
                    <button type="button"
                            data-testid="session-settings-create-api-key"
                            class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50"
                            disabled="@_isBusy"
                            @onclick="CreateKeyAsync">
                        @L("CreateApiKey")
                    </button>
                </header>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div data-testid="session-settings-api-key-error"
                         class="mt-4 rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive">
                        @_error
                    </div>
                }

                @if (_issued is not null)
                {
                    <div data-testid="session-settings-api-key-secret"
                         class="mt-4 rounded-md border border-primary/40 bg-primary/5 px-3 py-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="min-w-0">
                            <p class="text-sm font-semibold text-foreground">@L("CopyKeyNow")</p>
                            <p class="text-xs text-muted-foreground">@L("KeyNotShownAgain")</p>
                            </div>
                            <button type="button"
                                    data-testid="session-settings-dismiss-secret"
                                    class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted"
                                    @onclick="DismissIssuedSecret">
                                @L("Dismiss")
                            </button>
                        </div>
                        <code class="mt-3 block break-all rounded-md border border-border bg-background px-2 py-2 font-mono text-xs text-foreground">
                            @_issued.Secret
                        </code>
                    </div>
                }

                <div class="mt-8 overflow-hidden border-t border-border">
                    <div class="grid grid-cols-[minmax(10rem,1.2fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_6rem] border-b border-border px-4 py-2 text-xs uppercase tracking-wide text-muted-foreground">
                        <span>@L("Name")</span>
                        <span>@L("Key")</span>
                        <span>@L("CreatedBy")</span>
                        <span class="text-right">@L("Action")</span>
                    </div>

                    @if (_isLoading)
                    {
                        <div data-testid="session-settings-api-keys-loading" class="px-4 py-6 text-sm text-muted-foreground">
                            @L("LoadingKeys")
                        </div>
                    }
                    else if (_keys.Count == 0)
                    {
                        <div data-testid="session-settings-api-keys-empty" class="px-4 py-6 text-sm text-muted-foreground">
                            @L("NoApiKeysYet")
                        </div>
                    }
                    else
                    {
                        @foreach (var key in _keys)
                        {
                            <div class="grid grid-cols-[minmax(10rem,1.2fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_6rem] items-center border-b border-border px-4 py-3 text-sm"
                                 data-testid="session-settings-api-key-row"
                                 data-key-id="@key.Id">
                                <div class="min-w-0">
                                    <p class="truncate font-semibold text-foreground">@key.Name</p>
                                    @if (key.IsRevoked)
                                    {
                                        <p class="text-xs text-muted-foreground">@L("Revoked")</p>
                                    }
                                </div>
                                <code class="truncate font-mono text-xs text-muted-foreground">@key.KeyPreview</code>
                                <span class="truncate text-xs text-muted-foreground">@key.CreatedBy</span>
                                <button type="button"
                                        data-testid="session-settings-revoke-api-key"
                                        class="justify-self-end rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
                                        disabled="@(_isBusy || key.IsRevoked)"
                                        @onclick="() => RevokeKeyAsync(key.Id)">
                                    @L("Remove")
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>
