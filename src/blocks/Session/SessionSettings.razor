@namespace LowlandTech.Components
@inherits TinyComponentBase

<section data-slot="session-settings" class="@GetClass()" @attributes="AdditionalAttributes">
    <aside class="w-44 shrink-0 border-r border-border bg-sidebar/30 px-3 py-4">
        <nav class="space-y-1" aria-label="Settings sections">
            <button type="button"
                    data-testid="session-settings-node-types-tab"
                    data-active="@(_section == SettingsSection.NodeTypes ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.NodeTypes)"
                    @onclick="() => _section = SettingsSection.NodeTypes">
                NodeTypes
            </button>
            <button type="button"
                    data-testid="session-settings-edge-types-tab"
                    data-active="@(_section == SettingsSection.EdgeTypes ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.EdgeTypes)"
                    @onclick="() => _section = SettingsSection.EdgeTypes">
                EdgeTypes
            </button>
            <button type="button"
                    data-testid="session-settings-api-keys-tab"
                    data-active="@(_section == SettingsSection.ApiKeys ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.ApiKeys)"
                    @onclick="() => _section = SettingsSection.ApiKeys">
                @L("ApiKeys")
            </button>
            <button type="button"
                    data-testid="session-settings-activity-tab"
                    data-active="@(_section == SettingsSection.Activity ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.Activity)"
                    @onclick="() => _section = SettingsSection.Activity">
                @L("Activity")
            </button>
            @if (Outbox is not null || OutboxContent is not null)
            {
                <button type="button"
                        data-testid="session-settings-outbox-tab"
                        data-active="@(_section == SettingsSection.Outbox ? "true" : "false")"
                        class="@GetNavButtonClass(SettingsSection.Outbox)"
                        @onclick="() => _section = SettingsSection.Outbox">
                    @L("Outbox")
                </button>
            }
        </nav>
    </aside>

    <div class="min-w-0 flex-1 overflow-y-auto">
        @if (_section == SettingsSection.Activity)
        {
            <div data-slot="session-settings-activity" class="min-h-0">
                @ActivityContent
            </div>
        }
        else if (_section == SettingsSection.NodeTypes)
        {
            <ExplorerLayout SplitterStorageKey="session-settings-node-types-panel-width"
                            DefaultWidth="760"
                            MinWidth="520"
                            MaxWidth="960"
                            HeightClass="h-full"
                            data-page="session-node-types"
                            data-state-status="@(SettingsState.IsLoading ? "loading" : "ready")"
                            data-view="@_nodeTypeView">
                <ListHeader>
                    <div class="workitems-list-header flex h-9 w-full items-center justify-between px-3">
                        <span class="workitems-list-header-title text-xs font-semibold">NodeTypes</span>
                        <span class="workitems-list-header-count text-[10px] text-muted-foreground">@FilteredNodeTypes.Count total</span>
                    </div>
                </ListHeader>

                <ListContent>
                    <div class="workitems-list-pane flex h-full min-h-0 flex-col overflow-hidden" data-testid="session-settings-node-types-list-slot">
                        <div class="workitems-list-toolbar flex flex-wrap items-center gap-3">
                            <div class="workitems-search-wrapper min-w-[220px] flex-1">
                                <Input Type="search"
                                       Placeholder="Search node types..."
                                       data-testid="session-settings-node-type-search"
                                       Value="@_nodeTypeFilter"
                                       ValueChanged="OnNodeTypeFilterChanged" />
                            </div>
                            <Button Variant="@ButtonVariant.Default"
                                    Size="@ButtonSize.IconSm"
                                    class="workitem-quick-add"
                                    data-testid="session-settings-create-node-type"
                                    disabled="@SettingsState.IsBusy"
                                    OnClick="BeginCreateNodeType"
                                    title="Create NodeType"
                                    aria-label="Create NodeType">
                                <span aria-hidden="true">+</span>
                            </Button>
                        </div>

                        <div class="workitems-grid-scroll min-h-0 flex-1 overflow-y-auto">
                            <DataGrid TItem="SessionNodeTypeDefinition"
                                      data-testid="session-settings-node-types-grid"
                                      Items="FilteredNodeTypes"
                                      IsLoading="@SettingsState.IsLoading"
                                      AllowPaging="false"
                                      SelectionMode="DataGridSelectionMode.Single"
                                      SelectedItem="SelectedNodeType"
                                      ItemKey="nodeType => nodeType.Id"
                                      SelectedItemChanged="nodeType => { if (nodeType is not null) SelectNodeType(nodeType); return Task.CompletedTask; }">
                                <EmptyTemplate>
                                    <span class="workitems-grid-empty-filtered">No NodeTypes match this search.</span>
                                </EmptyTemplate>
                                <Columns>
                                    <DataGridColumn TItem="SessionNodeTypeDefinition" Property="Label" Title="Label" Class="workitems-title-cell">
                                        <Template Context="nodeType">
                                            <div data-testid="session-settings-node-type-row" data-node-type-key="@nodeType.Key" class="min-w-0">
                                                <span class="block truncate font-medium">@nodeType.Label</span>
                                                <code class="block truncate font-mono text-[10px] text-muted-foreground">@nodeType.Key</code>
                                                <span class="sr-only">@(nodeType.IsStatic ? "Static" : "Dynamic")</span>
                                                @if (nodeType.IsStatic)
                                                {
                                                    <button type="button"
                                                            class="sr-only"
                                                            data-testid="session-settings-edit-node-type"
                                                            disabled>
                                                        Edit
                                                    </button>
                                                }
                                            </div>
                                        </Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SessionNodeTypeDefinition" Property="BlockComponent" Title="Block">
                                        <Template Context="nodeType">@(nodeType.BlockComponent ?? "none")</Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SessionNodeTypeDefinition" Property="Icon" Title="Icon">
                                        <Template Context="nodeType">@(nodeType.Icon ?? "none")</Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SessionNodeTypeDefinition" Property="IsStatic" Title="Status">
                                        <Template Context="nodeType">@(nodeType.IsStatic ? "Static" : "Dynamic")</Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SessionNodeTypeDefinition" Title="Actions" Sortable="false" Filterable="false" TextAlign="DataGridTextAlign.End" Class="workitems-actions-cell">
                                        <Template Context="nodeType">
                                            <div class="workitems-actions flex items-center justify-end gap-0.5">
                                                <button type="button"
                                                        class="workitem-action-view btn btn-ghost btn-icon-sm"
                                                        @onclick="() => SelectNodeType(nodeType)"
                                                        @onclick:stopPropagation="true"
                                                        title="View">
                                                    <Icon Name="eye" Size="16" />
                                                </button>
                                                <button type="button"
                                                        class="workitem-action-edit btn btn-ghost btn-icon-sm"
                                                        data-testid="session-settings-edit-node-type"
                                                        disabled="@nodeType.IsStatic"
                                                        @onclick="() => BeginEditNodeType(nodeType)"
                                                        @onclick:stopPropagation="true"
                                                        title="Edit">
                                                    <Icon Name="pencil" Size="16" />
                                                </button>
                                            </div>
                                        </Template>
                                    </DataGridColumn>
                                </Columns>
                            </DataGrid>
                        </div>
                    </div>
                </ListContent>

                <DetailContent>
                    <div class="workitems-detail-pane flex h-full flex-col" data-testid="session-settings-node-types-detail-slot">
                        @if (SelectedNodeType is null && !IsNodeTypeFormOpen)
                        {
                            <div class="workitems-detail-empty flex h-full items-center justify-center text-sm text-muted-foreground">
                                Select a NodeType to inspect its descriptor.
                            </div>
                        }
                        else
                        {
                            <div class="workitems-detail-header flex h-9 items-center justify-between gap-4 border-b border-border px-3" data-testid="session-settings-node-type-detail-header">
                                <div class="workitems-detail-title-wrapper min-w-0">
                                    <h2 class="workitems-detail-title">@GetNodeTypePanelTitle()</h2>
                                </div>
                                <button type="button" class="btn btn-ghost btn-icon-sm" @onclick="CancelNodeTypeEdit" title="Close">
                                    <Icon Name="x" Size="16" />
                                </button>
                            </div>

                            <div class="workitems-detail-content flex-1 overflow-y-auto">
                                @if (IsNodeTypeFormOpen)
                                {
                                    <div data-testid="session-settings-node-type-form" class="workitem-form-panel flex flex-col gap-4 p-4">
                                        <div class="space-y-1">
                                            <Label>Key</Label>
                                            <Input Type="text" data-testid="session-settings-node-type-key-input" Value="@_nodeTypeForm.Key" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { Key = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Label</Label>
                                            <Input Type="text" data-testid="session-settings-node-type-label-input" Value="@_nodeTypeForm.Label" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { Label = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Icon</Label>
                                            <Input Type="text" data-testid="session-settings-node-type-icon-input" Value="@_nodeTypeForm.Icon" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { Icon = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Block</Label>
                                            <Input Type="text" data-testid="session-settings-node-type-block-input" Value="@_nodeTypeForm.BlockComponent" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { BlockComponent = v ?? string.Empty }" />
                                        </div>
                                        <label class="inline-flex items-center gap-2 text-sm text-muted-foreground">
                                            <input type="checkbox" checked="@_nodeTypeForm.IsHeader" @onchange="e => _nodeTypeForm = _nodeTypeForm with { IsHeader = e.Value is true }" />
                                            Header
                                        </label>
                                        <label class="inline-flex items-center gap-2 text-sm text-muted-foreground">
                                            <input type="checkbox" checked="@_nodeTypeForm.IsLeaf" @onchange="e => _nodeTypeForm = _nodeTypeForm with { IsLeaf = e.Value is true }" />
                                            Leaf
                                        </label>
                                    </div>
                                }
                                else if (SelectedNodeType is not null)
                                {
                                    var selected = SelectedNodeType!;
                                    <div class="workitem-view-detail p-4">
                                        <dl class="grid gap-4">
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Label</dt>
                                                <dd class="font-medium">@selected.Label</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Key</dt>
                                                <dd><code class="font-mono text-xs">@selected.Key</code></dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Block</dt>
                                                <dd>@(selected.BlockComponent ?? "none")</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Icon</dt>
                                                <dd>@(selected.Icon ?? "none")</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Status</dt>
                                                <dd>@(selected.IsStatic ? "Static descriptor" : "Dynamic")</dd>
                                            </div>
                                        </dl>
                                    </div>
                                }
                            </div>

                            <div class="workitems-detail-footer mt-auto flex shrink-0 items-center justify-end gap-2 border-t border-border px-3 py-2 text-xs" data-testid="session-settings-node-type-detail-footer">
                                @if (IsNodeTypeFormOpen)
                                {
                                    <Button Variant="@ButtonVariant.Secondary" Size="@ButtonSize.Sm" OnClick="CancelNodeTypeEdit">Cancel</Button>
                                    <Button Variant="@ButtonVariant.Default" Size="@ButtonSize.Sm" data-testid="session-settings-save-node-type" OnClick="SaveNodeType">Save</Button>
                                }
                                else if (SelectedNodeType is not null)
                                {
                                    <Button Variant="@ButtonVariant.Default"
                                            Size="@ButtonSize.Sm"
                                            data-testid="session-settings-edit-selected-node-type"
                                            disabled="@SelectedNodeType.IsStatic"
                                            OnClick="() => BeginEditNodeType(SelectedNodeType)">Edit</Button>
                                }
                            </div>
                        }
                    </div>
                </DetailContent>
            </ExplorerLayout>
        }
        else if (_section == SettingsSection.EdgeTypes)
        {
            <ExplorerLayout SplitterStorageKey="session-settings-edge-types-panel-width"
                            DefaultWidth="760"
                            MinWidth="520"
                            MaxWidth="960"
                            HeightClass="h-full"
                            data-page="session-edge-types"
                            data-state-status="@(SettingsState.IsLoading ? "loading" : "ready")"
                            data-view="@_edgeTypeView">
                <ListHeader>
                    <div class="workitems-list-header flex h-9 w-full items-center justify-between px-3">
                        <span class="workitems-list-header-title text-xs font-semibold">EdgeTypes</span>
                        <span class="workitems-list-header-count text-[10px] text-muted-foreground">@FilteredEdgeTypes.Count total</span>
                    </div>
                </ListHeader>

                <ListContent>
                    <div class="workitems-list-pane flex h-full min-h-0 flex-col overflow-hidden" data-testid="session-settings-edge-types-list-slot">
                        <div class="workitems-list-toolbar flex flex-wrap items-center gap-3">
                            <div class="workitems-search-wrapper min-w-[220px] flex-1">
                                <Input Type="search"
                                       Placeholder="Search edge types..."
                                       data-testid="session-settings-edge-type-search"
                                       Value="@_edgeTypeFilter"
                                       ValueChanged="OnEdgeTypeFilterChanged" />
                            </div>
                            <Button Variant="@ButtonVariant.Default"
                                    Size="@ButtonSize.IconSm"
                                    class="workitem-quick-add"
                                    data-testid="session-settings-create-edge-type"
                                    disabled="@SettingsState.IsBusy"
                                    OnClick="BeginCreateEdgeType"
                                    title="Create EdgeType"
                                    aria-label="Create EdgeType">
                                <span aria-hidden="true">+</span>
                            </Button>
                        </div>

                        <div class="workitems-grid-scroll min-h-0 flex-1 overflow-y-auto">
                            <DataGrid TItem="SessionEdgeTypeDefinition"
                                      data-testid="session-settings-edge-types-grid"
                                      Items="FilteredEdgeTypes"
                                      IsLoading="@SettingsState.IsLoading"
                                      AllowPaging="false"
                                      SelectionMode="DataGridSelectionMode.Single"
                                      SelectedItem="SelectedEdgeType"
                                      ItemKey="edgeType => edgeType.Id"
                                      SelectedItemChanged="edgeType => { if (edgeType is not null) SelectEdgeType(edgeType); return Task.CompletedTask; }">
                                <EmptyTemplate>
                                    <span class="workitems-grid-empty-filtered">No EdgeTypes match this search.</span>
                                </EmptyTemplate>
                                <Columns>
                                    <DataGridColumn TItem="SessionEdgeTypeDefinition" Property="Label" Title="Label" Class="workitems-title-cell">
                                        <Template Context="edgeType">
                                            <div data-testid="session-settings-edge-type-row" data-edge-type-key="@edgeType.Key" class="min-w-0">
                                                <span class="block truncate font-medium">@edgeType.Label</span>
                                                <code class="block truncate font-mono text-[10px] text-muted-foreground">@edgeType.Key</code>
                                            </div>
                                        </Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SessionEdgeTypeDefinition" Property="SourceNodeTypeKey" Title="Source" />
                                    <DataGridColumn TItem="SessionEdgeTypeDefinition" Property="TargetNodeTypeKey" Title="Target" />
                                    <DataGridColumn TItem="SessionEdgeTypeDefinition" Property="Intent" Title="Intent">
                                        <Template Context="edgeType">@(edgeType.Intent ?? "none")</Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SessionEdgeTypeDefinition" Property="IsStatic" Title="Status">
                                        <Template Context="edgeType">@(edgeType.IsStatic ? "Static" : "Dynamic")</Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SessionEdgeTypeDefinition" Title="Actions" Sortable="false" Filterable="false" TextAlign="DataGridTextAlign.End" Class="workitems-actions-cell">
                                        <Template Context="edgeType">
                                            <div class="workitems-actions flex items-center justify-end gap-0.5">
                                                <button type="button"
                                                        class="workitem-action-view btn btn-ghost btn-icon-sm"
                                                        @onclick="() => SelectEdgeType(edgeType)"
                                                        @onclick:stopPropagation="true"
                                                        title="View">
                                                    <Icon Name="eye" Size="16" />
                                                </button>
                                                <button type="button"
                                                        class="workitem-action-edit btn btn-ghost btn-icon-sm"
                                                        data-testid="session-settings-edit-edge-type"
                                                        disabled="@edgeType.IsStatic"
                                                        @onclick="() => BeginEditEdgeType(edgeType)"
                                                        @onclick:stopPropagation="true"
                                                        title="Edit">
                                                    <Icon Name="pencil" Size="16" />
                                                </button>
                                            </div>
                                        </Template>
                                    </DataGridColumn>
                                </Columns>
                            </DataGrid>
                        </div>
                    </div>
                </ListContent>

                <DetailContent>
                    <div class="workitems-detail-pane flex h-full flex-col" data-testid="session-settings-edge-types-detail-slot">
                        @if (SelectedEdgeType is null && !IsEdgeTypeFormOpen)
                        {
                            <div class="workitems-detail-empty flex h-full items-center justify-center text-sm text-muted-foreground">
                                Select an EdgeType to inspect its descriptor.
                            </div>
                        }
                        else
                        {
                            <div class="workitems-detail-header flex h-9 items-center justify-between gap-4 border-b border-border px-3" data-testid="session-settings-edge-type-detail-header">
                                <div class="workitems-detail-title-wrapper min-w-0">
                                    <h2 class="workitems-detail-title">@GetEdgeTypePanelTitle()</h2>
                                </div>
                                <button type="button" class="btn btn-ghost btn-icon-sm" @onclick="CancelEdgeTypeEdit" title="Close">
                                    <Icon Name="x" Size="16" />
                                </button>
                            </div>

                            <div class="workitems-detail-content flex-1 overflow-y-auto">
                                @if (IsEdgeTypeFormOpen)
                                {
                                    <div data-testid="session-settings-edge-type-form" class="workitem-form-panel flex flex-col gap-4 p-4">
                                        <div class="space-y-1">
                                            <Label>Key</Label>
                                            <Input Type="text" data-testid="session-settings-edge-type-key-input" Value="@_edgeTypeForm.Key" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Key = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Label</Label>
                                            <Input Type="text" data-testid="session-settings-edge-type-label-input" Value="@_edgeTypeForm.Label" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Label = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Source NodeType</Label>
                                            <Input Type="text" data-testid="session-settings-edge-type-source-input" Value="@_edgeTypeForm.SourceNodeTypeKey" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { SourceNodeTypeKey = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Target NodeType</Label>
                                            <Input Type="text" data-testid="session-settings-edge-type-target-input" Value="@_edgeTypeForm.TargetNodeTypeKey" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { TargetNodeTypeKey = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Intent</Label>
                                            <Input Type="text" data-testid="session-settings-edge-type-intent-input" Value="@_edgeTypeForm.Intent" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Intent = v ?? string.Empty }" />
                                        </div>
                                        <div class="space-y-1">
                                            <Label>Tool</Label>
                                            <Input Type="text" data-testid="session-settings-edge-type-tool-input" Value="@_edgeTypeForm.Tool" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Tool = v ?? string.Empty }" />
                                        </div>
                                    </div>
                                }
                                else if (SelectedEdgeType is not null)
                                {
                                    var selected = SelectedEdgeType!;
                                    <div class="workitem-view-detail p-4">
                                        <dl class="grid gap-4">
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Label</dt>
                                                <dd class="font-medium">@selected.Label</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Key</dt>
                                                <dd><code class="font-mono text-xs">@selected.Key</code></dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Source</dt>
                                                <dd>@selected.SourceNodeTypeKey</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Target</dt>
                                                <dd>@selected.TargetNodeTypeKey</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Intent</dt>
                                                <dd>@(selected.Intent ?? "none")</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Tool</dt>
                                                <dd>@(selected.Tool ?? "none")</dd>
                                            </div>
                                            <div>
                                                <dt class="text-sm text-muted-foreground">Status</dt>
                                                <dd>@(selected.IsStatic ? "Static descriptor" : "Dynamic")</dd>
                                            </div>
                                        </dl>
                                    </div>
                                }
                            </div>

                            <div class="workitems-detail-footer mt-auto flex shrink-0 items-center justify-end gap-2 border-t border-border px-3 py-2 text-xs" data-testid="session-settings-edge-type-detail-footer">
                                @if (IsEdgeTypeFormOpen)
                                {
                                    <Button Variant="@ButtonVariant.Secondary" Size="@ButtonSize.Sm" OnClick="CancelEdgeTypeEdit">Cancel</Button>
                                    <Button Variant="@ButtonVariant.Default" Size="@ButtonSize.Sm" data-testid="session-settings-save-edge-type" OnClick="SaveEdgeType">Save</Button>
                                }
                                else if (SelectedEdgeType is not null)
                                {
                                    <Button Variant="@ButtonVariant.Default"
                                            Size="@ButtonSize.Sm"
                                            data-testid="session-settings-edit-selected-edge-type"
                                            disabled="@SelectedEdgeType.IsStatic"
                                            OnClick="() => BeginEditEdgeType(SelectedEdgeType)">Edit</Button>
                                }
                            </div>
                        }
                    </div>
                </DetailContent>
            </ExplorerLayout>
        }
        else if (_section == SettingsSection.Outbox)
        {
            <div data-slot="session-settings-outbox" class="min-h-0">
                @if (OutboxContent is not null)
                {
                    @OutboxContent
                }
                else if (Outbox is not null)
                {
                    <SessionOutboxList Outbox="Outbox" class="min-h-0 flex-1" />
                }
            </div>
        }
        else
        {
            <div data-slot="session-settings-api-keys" class="mx-auto max-w-5xl">
                <header class="flex flex-wrap items-start justify-between gap-4">
                    <div class="space-y-1">
                        <h2 class="text-sm font-semibold text-foreground">@L("ApiKeysTitle")</h2>
                        <p class="max-w-[60ch] text-sm text-muted-foreground">
                            @L("ApiKeysDescription")
                        </p>
                    </div>
                    <button type="button"
                            data-testid="session-settings-create-api-key"
                            class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50"
                            disabled="@SettingsState.IsBusy"
                            @onclick="CreateKeyAsync">
                        @L("CreateApiKey")
                    </button>
                </header>

                @if (!string.IsNullOrWhiteSpace(SettingsState.Error))
                {
                    <div data-testid="session-settings-api-key-error"
                         class="mt-4 rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive">
                        @SettingsState.Error
                    </div>
                }

                @if (SettingsState.IssuedClientKey is not null)
                {
                    <div data-testid="session-settings-api-key-secret"
                         class="mt-4 rounded-md border border-primary/40 bg-primary/5 px-3 py-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="min-w-0">
                            <p class="text-sm font-semibold text-foreground">@L("CopyKeyNow")</p>
                            <p class="text-xs text-muted-foreground">@L("KeyNotShownAgain")</p>
                            </div>
                            <button type="button"
                                    data-testid="session-settings-dismiss-secret"
                                    class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted"
                                    @onclick="DismissIssuedSecret">
                                @L("Dismiss")
                            </button>
                        </div>
                        <code class="mt-3 block break-all rounded-md border border-border bg-background px-2 py-2 font-mono text-xs text-foreground">
                            @SettingsState.IssuedClientKey.Secret
                        </code>
                    </div>
                }

                <div class="mt-8 overflow-hidden border-t border-border">
                    <div class="grid grid-cols-[minmax(10rem,1.2fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_6rem] border-b border-border px-4 py-2 text-xs uppercase tracking-wide text-muted-foreground">
                        <span>@L("Name")</span>
                        <span>@L("Key")</span>
                        <span>@L("CreatedBy")</span>
                        <span class="text-right">@L("Action")</span>
                    </div>

                    @if (SettingsState.IsLoading)
                    {
                        <div data-testid="session-settings-api-keys-loading" class="px-4 py-6 text-sm text-muted-foreground">
                            @L("LoadingKeys")
                        </div>
                    }
                    else if (SettingsState.ClientKeys.Count == 0)
                    {
                        <div data-testid="session-settings-api-keys-empty" class="px-4 py-6 text-sm text-muted-foreground">
                            @L("NoApiKeysYet")
                        </div>
                    }
                    else
                    {
                        @foreach (var key in SettingsState.ClientKeys)
                        {
                            <div class="grid grid-cols-[minmax(10rem,1.2fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_6rem] items-center border-b border-border px-4 py-3 text-sm"
                                 data-testid="session-settings-api-key-row"
                                 data-key-id="@key.Id">
                                <div class="min-w-0">
                                    @if (string.Equals(_editingKeyId, key.Id, StringComparison.Ordinal))
                                    {
                                        <input data-testid="session-settings-api-key-name-input"
                                               class="h-8 w-full rounded-md border border-border bg-background px-2 text-sm text-foreground"
                                               value="@_editingName"
                                               @oninput="e => _editingName = e.Value?.ToString() ?? string.Empty" />
                                    }
                                    else
                                    {
                                        <p class="truncate font-semibold text-foreground">@key.Name</p>
                                    }
                                    @if (key.IsRevoked)
                                    {
                                        <p class="text-xs text-muted-foreground">@L("Revoked")</p>
                                    }
                                </div>
                                <code class="truncate font-mono text-xs text-muted-foreground">@key.KeyPreview</code>
                                <span class="truncate text-xs text-muted-foreground">@key.CreatedBy</span>
                                <div class="flex justify-end gap-1">
                                    @if (string.Equals(_editingKeyId, key.Id, StringComparison.Ordinal))
                                    {
                                        <button type="button"
                                                data-testid="session-settings-save-api-key"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
                                                disabled="@(SettingsState.IsBusy || key.IsRevoked)"
                                                @onclick="() => RenameKeyAsync(key)">
                                            @L("MenuRename")
                                        </button>
                                        <button type="button"
                                                data-testid="session-settings-cancel-api-key-rename"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted"
                                                @onclick="CancelRename">
                                            @L("DeleteNodeCancel")
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                data-testid="session-settings-rename-api-key"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
                                                disabled="@(SettingsState.IsBusy || key.IsRevoked)"
                                                @onclick="() => BeginRename(key)">
                                            @L("MenuRename")
                                        </button>
                                        <button type="button"
                                                data-testid="session-settings-revoke-api-key"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
                                                disabled="@(SettingsState.IsBusy || key.IsRevoked)"
                                                @onclick="() => RevokeKeyAsync(key.Id)">
                                            @L("Remove")
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>
