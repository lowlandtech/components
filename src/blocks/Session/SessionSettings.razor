@namespace LowlandTech.Components
@inherits TinyComponentBase

<section data-slot="session-settings" class="@GetClass()" @attributes="AdditionalAttributes">
    <aside class="w-44 shrink-0 border-r border-border bg-sidebar/30 px-3 py-4">
        <nav class="space-y-1" aria-label="Settings sections">
            <button type="button"
                    data-testid="session-settings-api-keys-tab"
                    data-active="@(_section == SettingsSection.ApiKeys ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.ApiKeys)"
                    @onclick="() => _section = SettingsSection.ApiKeys">
                @L("ApiKeys")
            </button>
            <button type="button"
                    data-testid="session-settings-activity-tab"
                    data-active="@(_section == SettingsSection.Activity ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.Activity)"
                    @onclick="() => _section = SettingsSection.Activity">
                @L("Activity")
            </button>
            <button type="button"
                    data-testid="session-settings-node-types-tab"
                    data-active="@(_section == SettingsSection.NodeTypes ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.NodeTypes)"
                    @onclick="() => _section = SettingsSection.NodeTypes">
                NodeTypes
            </button>
            <button type="button"
                    data-testid="session-settings-edge-types-tab"
                    data-active="@(_section == SettingsSection.EdgeTypes ? "true" : "false")"
                    class="@GetNavButtonClass(SettingsSection.EdgeTypes)"
                    @onclick="() => _section = SettingsSection.EdgeTypes">
                EdgeTypes
            </button>
            @if (Outbox is not null || OutboxContent is not null)
            {
                <button type="button"
                        data-testid="session-settings-outbox-tab"
                        data-active="@(_section == SettingsSection.Outbox ? "true" : "false")"
                        class="@GetNavButtonClass(SettingsSection.Outbox)"
                        @onclick="() => _section = SettingsSection.Outbox">
                    @L("Outbox")
                </button>
            }
        </nav>
    </aside>

    <div class="min-w-0 flex-1 overflow-y-auto px-6 py-5">
        @if (_section == SettingsSection.Activity)
        {
            <div data-slot="session-settings-activity" class="min-h-0">
                @ActivityContent
            </div>
        }
        else if (_section == SettingsSection.NodeTypes)
        {
            <div data-slot="session-settings-node-types" class="workitem-block mx-auto flex max-w-5xl flex-col gap-3" data-view="@_nodeTypeView">
                <div class="workitem-block-toolbar flex items-center justify-between gap-2">
                    <div class="workitem-block-toolbar-inner flex flex-1 items-center gap-2">
                        <Input Type="search"
                               Placeholder="Search node types..."
                               data-testid="session-settings-node-type-search"
                               Value="@_nodeTypeFilter"
                               ValueChanged="OnNodeTypeFilterChanged" />
                    </div>
                    <Button Variant="@ButtonVariant.Default"
                            Size="@ButtonSize.IconSm"
                            data-testid="session-settings-create-node-type"
                            disabled="@SettingsState.IsBusy"
                            OnClick="BeginCreateNodeType"
                            title="Create NodeType"
                            aria-label="Create NodeType">+</Button>
                </div>

                @if (FilteredNodeTypes.Count == 0)
                {
                    <div class="workitem-block-empty rounded-md border border-dashed border-border px-4 py-6 text-center text-xs text-muted-foreground">
                        No NodeTypes match this search.
                    </div>
                }
                else
                {
                    <div class="workitem-block-list flex flex-col gap-1">
                        @foreach (var nodeType in FilteredNodeTypes)
                        {
                            <div data-testid="session-settings-node-type-row"
                                 data-node-type-key="@nodeType.Key"
                                 class="workitem-block-list-item flex items-center gap-2 rounded border border-border bg-card px-2 py-1.5 text-sm hover:bg-muted/50 @(string.Equals(_selectedNodeTypeId, nodeType.Id, StringComparison.Ordinal) ? "ring-1 ring-primary" : "")">
                                <button type="button"
                                        class="min-w-0 flex flex-1 items-center justify-between gap-2 text-left"
                                        @onclick="() => SelectNodeType(nodeType)">
                                    <span class="min-w-0">
                                        <span class="block truncate font-medium">@nodeType.Label</span>
                                        <code class="block truncate font-mono text-[10px] text-muted-foreground">@nodeType.Key</code>
                                    </span>
                                    <span class="shrink-0 text-[10px] uppercase tracking-wide text-muted-foreground">
                                        @(nodeType.IsStatic ? "Static" : "Dynamic")
                                    </span>
                                </button>
                                <Button Variant="@ButtonVariant.Outline"
                                        Size="@ButtonSize.Sm"
                                        data-testid="session-settings-edit-node-type"
                                        disabled="@nodeType.IsStatic"
                                        OnClick="() => BeginEditNodeType(nodeType)">Edit</Button>
                            </div>
                        }
                    </div>
                }

                @if (SelectedNodeType is not null && !IsNodeTypeFormOpen)
                {
                    var selected = SelectedNodeType!;
                    <div class="workitem-block-detail flex flex-col gap-3 rounded-md border border-border p-3">
                        <div class="workitem-block-detail-header flex items-center justify-between gap-2">
                            <h3 class="text-sm font-semibold">@selected.Label</h3>
                            <span class="rounded-md border border-border px-2 py-1 text-[10px] uppercase tracking-wide text-muted-foreground">
                                @(selected.IsStatic ? "Static" : "Dynamic")
                            </span>
                        </div>
                        <div class="workitem-block-view flex flex-col gap-2 text-xs">
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Key</span><code class="font-mono">@selected.Key</code></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Block</span><span>@(selected.BlockComponent ?? "none")</span></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Icon</span><span>@(selected.Icon ?? "none")</span></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Header</span><span>@selected.IsHeader</span></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Leaf</span><span>@selected.IsLeaf</span></div>
                        </div>
                        <div class="workitem-block-view-actions flex items-center justify-end gap-2">
                            <Button Variant="@ButtonVariant.Default"
                                    Size="@ButtonSize.Sm"
                                    data-testid="session-settings-edit-selected-node-type"
                                    disabled="@selected.IsStatic"
                                    OnClick="() => BeginEditNodeType(selected)">Edit</Button>
                        </div>
                    </div>
                }

                @if (IsNodeTypeFormOpen)
                {
                    <div data-testid="session-settings-node-type-form"
                         class="workitem-block-detail flex flex-col gap-3 rounded-md border border-border p-3">
                        <div class="workitem-block-detail-header flex items-center justify-between gap-2">
                            <h3 class="text-sm font-semibold">@(_nodeTypeView == "create" ? "Create NodeType" : "Edit NodeType")</h3>
                        </div>
                        <div class="workitem-block-form flex flex-col gap-2 text-xs">
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Key</label>
                                <Input Type="text" data-testid="session-settings-node-type-key-input" Value="@_nodeTypeForm.Key" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { Key = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Label</label>
                                <Input Type="text" data-testid="session-settings-node-type-label-input" Value="@_nodeTypeForm.Label" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { Label = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Icon</label>
                                <Input Type="text" data-testid="session-settings-node-type-icon-input" Value="@_nodeTypeForm.Icon" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { Icon = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Block</label>
                                <Input Type="text" data-testid="session-settings-node-type-block-input" Value="@_nodeTypeForm.BlockComponent" ValueChanged="v => _nodeTypeForm = _nodeTypeForm with { BlockComponent = v ?? string.Empty }" />
                            </div>
                            <label class="inline-flex items-center gap-2 text-muted-foreground">
                                <input type="checkbox" checked="@_nodeTypeForm.IsHeader" @onchange="e => _nodeTypeForm = _nodeTypeForm with { IsHeader = e.Value is true }" />
                                Header
                            </label>
                            <label class="inline-flex items-center gap-2 text-muted-foreground">
                                <input type="checkbox" checked="@_nodeTypeForm.IsLeaf" @onchange="e => _nodeTypeForm = _nodeTypeForm with { IsLeaf = e.Value is true }" />
                                Leaf
                            </label>
                        </div>
                        <div class="workitem-block-form-actions flex items-center justify-end gap-2">
                            <Button Variant="@ButtonVariant.Secondary" Size="@ButtonSize.Sm" OnClick="CancelNodeTypeEdit">Cancel</Button>
                            <Button Variant="@ButtonVariant.Default" Size="@ButtonSize.Sm" data-testid="session-settings-save-node-type" OnClick="SaveNodeType">Save</Button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_section == SettingsSection.EdgeTypes)
        {
            <div data-slot="session-settings-edge-types" class="workitem-block mx-auto flex max-w-5xl flex-col gap-3" data-view="@_edgeTypeView">
                <div class="workitem-block-toolbar flex items-center justify-between gap-2">
                    <div class="workitem-block-toolbar-inner flex flex-1 items-center gap-2">
                        <Input Type="search"
                               Placeholder="Search edge types..."
                               data-testid="session-settings-edge-type-search"
                               Value="@_edgeTypeFilter"
                               ValueChanged="OnEdgeTypeFilterChanged" />
                    </div>
                    <Button Variant="@ButtonVariant.Default"
                            Size="@ButtonSize.IconSm"
                            data-testid="session-settings-create-edge-type"
                            disabled="@SettingsState.IsBusy"
                            OnClick="BeginCreateEdgeType"
                            title="Create EdgeType"
                            aria-label="Create EdgeType">+</Button>
                </div>

                @if (FilteredEdgeTypes.Count == 0)
                {
                    <div class="workitem-block-empty rounded-md border border-dashed border-border px-4 py-6 text-center text-xs text-muted-foreground">
                        No EdgeTypes match this search.
                    </div>
                }
                else
                {
                    <div class="workitem-block-list flex flex-col gap-1">
                        @foreach (var edgeType in FilteredEdgeTypes)
                        {
                            <div data-testid="session-settings-edge-type-row"
                                 data-edge-type-key="@edgeType.Key"
                                 class="workitem-block-list-item flex items-center gap-2 rounded border border-border bg-card px-2 py-1.5 text-sm hover:bg-muted/50 @(string.Equals(_selectedEdgeTypeId, edgeType.Id, StringComparison.Ordinal) ? "ring-1 ring-primary" : "")">
                                <button type="button"
                                        class="min-w-0 flex flex-1 items-center justify-between gap-2 text-left"
                                        @onclick="() => SelectEdgeType(edgeType)">
                                    <span class="min-w-0">
                                        <span class="block truncate font-medium">@edgeType.Label</span>
                                        <code class="block truncate font-mono text-[10px] text-muted-foreground">@edgeType.Key</code>
                                    </span>
                                    <span class="shrink-0 text-[10px] uppercase tracking-wide text-muted-foreground">
                                        @(edgeType.Intent ?? "edge")
                                    </span>
                                </button>
                                <Button Variant="@ButtonVariant.Outline"
                                        Size="@ButtonSize.Sm"
                                        data-testid="session-settings-edit-edge-type"
                                        disabled="@edgeType.IsStatic"
                                        OnClick="() => BeginEditEdgeType(edgeType)">Edit</Button>
                            </div>
                        }
                    </div>
                }

                @if (SelectedEdgeType is not null && !IsEdgeTypeFormOpen)
                {
                    var selected = SelectedEdgeType!;
                    <div class="workitem-block-detail flex flex-col gap-3 rounded-md border border-border p-3">
                        <div class="workitem-block-detail-header flex items-center justify-between gap-2">
                            <h3 class="text-sm font-semibold">@selected.Label</h3>
                            <span class="rounded-md border border-border px-2 py-1 text-[10px] uppercase tracking-wide text-muted-foreground">
                                @(selected.IsStatic ? "Static" : "Dynamic")
                            </span>
                        </div>
                        <div class="workitem-block-view flex flex-col gap-2 text-xs">
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Key</span><code class="font-mono">@selected.Key</code></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Source</span><span>@selected.SourceNodeTypeKey</span></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Target</span><span>@selected.TargetNodeTypeKey</span></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Intent</span><span>@(selected.Intent ?? "none")</span></div>
                            <div class="flex justify-between gap-3"><span class="text-muted-foreground">Tool</span><span>@(selected.Tool ?? "none")</span></div>
                        </div>
                        <div class="workitem-block-view-actions flex items-center justify-end gap-2">
                            <Button Variant="@ButtonVariant.Default"
                                    Size="@ButtonSize.Sm"
                                    data-testid="session-settings-edit-selected-edge-type"
                                    disabled="@selected.IsStatic"
                                    OnClick="() => BeginEditEdgeType(selected)">Edit</Button>
                        </div>
                    </div>
                }

                @if (IsEdgeTypeFormOpen)
                {
                    <div data-testid="session-settings-edge-type-form"
                         class="workitem-block-detail flex flex-col gap-3 rounded-md border border-border p-3">
                        <div class="workitem-block-detail-header flex items-center justify-between gap-2">
                            <h3 class="text-sm font-semibold">@(_edgeTypeView == "create" ? "Create EdgeType" : "Edit EdgeType")</h3>
                        </div>
                        <div class="workitem-block-form flex flex-col gap-2 text-xs">
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Key</label>
                                <Input Type="text" data-testid="session-settings-edge-type-key-input" Value="@_edgeTypeForm.Key" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Key = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Label</label>
                                <Input Type="text" data-testid="session-settings-edge-type-label-input" Value="@_edgeTypeForm.Label" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Label = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Source NodeType</label>
                                <Input Type="text" data-testid="session-settings-edge-type-source-input" Value="@_edgeTypeForm.SourceNodeTypeKey" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { SourceNodeTypeKey = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Target NodeType</label>
                                <Input Type="text" data-testid="session-settings-edge-type-target-input" Value="@_edgeTypeForm.TargetNodeTypeKey" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { TargetNodeTypeKey = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Intent</label>
                                <Input Type="text" data-testid="session-settings-edge-type-intent-input" Value="@_edgeTypeForm.Intent" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Intent = v ?? string.Empty }" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-muted-foreground">Tool</label>
                                <Input Type="text" data-testid="session-settings-edge-type-tool-input" Value="@_edgeTypeForm.Tool" ValueChanged="v => _edgeTypeForm = _edgeTypeForm with { Tool = v ?? string.Empty }" />
                            </div>
                        </div>
                        <div class="workitem-block-form-actions flex items-center justify-end gap-2">
                            <Button Variant="@ButtonVariant.Secondary" Size="@ButtonSize.Sm" OnClick="CancelEdgeTypeEdit">Cancel</Button>
                            <Button Variant="@ButtonVariant.Default" Size="@ButtonSize.Sm" data-testid="session-settings-save-edge-type" OnClick="SaveEdgeType">Save</Button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_section == SettingsSection.Outbox)
        {
            <div data-slot="session-settings-outbox" class="min-h-0">
                @if (OutboxContent is not null)
                {
                    @OutboxContent
                }
                else if (Outbox is not null)
                {
                    <SessionOutboxList Outbox="Outbox" class="min-h-0 flex-1" />
                }
            </div>
        }
        else
        {
            <div data-slot="session-settings-api-keys" class="mx-auto max-w-5xl">
                <header class="flex flex-wrap items-start justify-between gap-4">
                    <div class="space-y-1">
                        <h2 class="text-sm font-semibold text-foreground">@L("ApiKeysTitle")</h2>
                        <p class="max-w-[60ch] text-sm text-muted-foreground">
                            @L("ApiKeysDescription")
                        </p>
                    </div>
                    <button type="button"
                            data-testid="session-settings-create-api-key"
                            class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50"
                            disabled="@SettingsState.IsBusy"
                            @onclick="CreateKeyAsync">
                        @L("CreateApiKey")
                    </button>
                </header>

                @if (!string.IsNullOrWhiteSpace(SettingsState.Error))
                {
                    <div data-testid="session-settings-api-key-error"
                         class="mt-4 rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive">
                        @SettingsState.Error
                    </div>
                }

                @if (SettingsState.IssuedClientKey is not null)
                {
                    <div data-testid="session-settings-api-key-secret"
                         class="mt-4 rounded-md border border-primary/40 bg-primary/5 px-3 py-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="min-w-0">
                            <p class="text-sm font-semibold text-foreground">@L("CopyKeyNow")</p>
                            <p class="text-xs text-muted-foreground">@L("KeyNotShownAgain")</p>
                            </div>
                            <button type="button"
                                    data-testid="session-settings-dismiss-secret"
                                    class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted"
                                    @onclick="DismissIssuedSecret">
                                @L("Dismiss")
                            </button>
                        </div>
                        <code class="mt-3 block break-all rounded-md border border-border bg-background px-2 py-2 font-mono text-xs text-foreground">
                            @SettingsState.IssuedClientKey.Secret
                        </code>
                    </div>
                }

                <div class="mt-8 overflow-hidden border-t border-border">
                    <div class="grid grid-cols-[minmax(10rem,1.2fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_6rem] border-b border-border px-4 py-2 text-xs uppercase tracking-wide text-muted-foreground">
                        <span>@L("Name")</span>
                        <span>@L("Key")</span>
                        <span>@L("CreatedBy")</span>
                        <span class="text-right">@L("Action")</span>
                    </div>

                    @if (SettingsState.IsLoading)
                    {
                        <div data-testid="session-settings-api-keys-loading" class="px-4 py-6 text-sm text-muted-foreground">
                            @L("LoadingKeys")
                        </div>
                    }
                    else if (SettingsState.ClientKeys.Count == 0)
                    {
                        <div data-testid="session-settings-api-keys-empty" class="px-4 py-6 text-sm text-muted-foreground">
                            @L("NoApiKeysYet")
                        </div>
                    }
                    else
                    {
                        @foreach (var key in SettingsState.ClientKeys)
                        {
                            <div class="grid grid-cols-[minmax(10rem,1.2fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_6rem] items-center border-b border-border px-4 py-3 text-sm"
                                 data-testid="session-settings-api-key-row"
                                 data-key-id="@key.Id">
                                <div class="min-w-0">
                                    @if (string.Equals(_editingKeyId, key.Id, StringComparison.Ordinal))
                                    {
                                        <input data-testid="session-settings-api-key-name-input"
                                               class="h-8 w-full rounded-md border border-border bg-background px-2 text-sm text-foreground"
                                               value="@_editingName"
                                               @oninput="e => _editingName = e.Value?.ToString() ?? string.Empty" />
                                    }
                                    else
                                    {
                                        <p class="truncate font-semibold text-foreground">@key.Name</p>
                                    }
                                    @if (key.IsRevoked)
                                    {
                                        <p class="text-xs text-muted-foreground">@L("Revoked")</p>
                                    }
                                </div>
                                <code class="truncate font-mono text-xs text-muted-foreground">@key.KeyPreview</code>
                                <span class="truncate text-xs text-muted-foreground">@key.CreatedBy</span>
                                <div class="flex justify-end gap-1">
                                    @if (string.Equals(_editingKeyId, key.Id, StringComparison.Ordinal))
                                    {
                                        <button type="button"
                                                data-testid="session-settings-save-api-key"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
                                                disabled="@(SettingsState.IsBusy || key.IsRevoked)"
                                                @onclick="() => RenameKeyAsync(key)">
                                            @L("MenuRename")
                                        </button>
                                        <button type="button"
                                                data-testid="session-settings-cancel-api-key-rename"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted"
                                                @onclick="CancelRename">
                                            @L("DeleteNodeCancel")
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                data-testid="session-settings-rename-api-key"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
                                                disabled="@(SettingsState.IsBusy || key.IsRevoked)"
                                                @onclick="() => BeginRename(key)">
                                            @L("MenuRename")
                                        </button>
                                        <button type="button"
                                                data-testid="session-settings-revoke-api-key"
                                                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
                                                disabled="@(SettingsState.IsBusy || key.IsRevoked)"
                                                @onclick="() => RevokeKeyAsync(key.Id)">
                                            @L("Remove")
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>
