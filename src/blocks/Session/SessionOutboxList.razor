@namespace LowlandTech.Components
@inherits TinyComponentBase

<section data-slot="session-outbox-list" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (Outbox is null || Outbox.Entries.Count == 0)
    {
        <div class="flex h-full min-h-48 items-center justify-center text-xs text-muted-foreground">
            @L("OutboxEmpty")
        </div>
    }
    else
    {
        <div class="divide-y divide-border">
            <div class="grid grid-cols-[minmax(6rem,1fr)_minmax(6rem,1fr)_6rem] border-b border-border px-2 py-1.5 text-[10px] uppercase tracking-wide text-muted-foreground">
                <span>@L("OutboxType")</span>
                <span>@L("OutboxPayload")</span>
                <span class="text-right">@L("OutboxCreatedAt")</span>
            </div>
            @foreach (var entry in Outbox.Entries.Reverse())
            {
                <div class="grid grid-cols-[minmax(6rem,1fr)_minmax(6rem,1fr)_6rem] items-start gap-2 px-2 py-2 text-xs"
                     data-slot="session-outbox-entry"
                     data-outbox-type="@entry.Type">
                    <span class="truncate font-medium text-foreground">@GetDisplayType(entry.Type)</span>
                    <pre class="overflow-auto text-[10px] text-muted-foreground">@SerializePayload(entry.Payload)</pre>
                    <span class="text-right text-[10px] text-muted-foreground">@entry.CreatedAt.ToString("HH:mm:ss.fff")</span>
                </div>
            }
        </div>
    }
</section>
