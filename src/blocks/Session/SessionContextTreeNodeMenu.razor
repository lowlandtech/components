@namespace LowlandTech.Components
@inherits TinyComponentBase

<div class="node-menu-backdrop" @onclick="CloseAsync" @onclick:stopPropagation></div>
<div class="node-menu relative z-10"
     data-slot="session-context-node-menu"
     role="menu"
     @onclick:stopPropagation>
    @if (CreateEdges.Count > 0)
    {
        <div class="node-menu-item-wrap @(_isNewSubmenuOpen ? "open" : string.Empty)"
             @onmouseenter="OpenNewSubmenu"
             @onmouseleave="ScheduleCloseNewSubmenu">
            <button type="button"
                    class="node-menu-item node-menu-submenu-toggle"
                    data-testid="session-context-node-new-submenu"
                    data-state="@(_isNewSubmenuOpen ? "open" : "closed")"
                    aria-haspopup="menu"
                    aria-expanded="@_isNewSubmenuOpen.ToString().ToLowerInvariant()"
                    role="menuitem"
                    @onclick="ToggleNewSubmenuAsync">
                <span class="flex items-center gap-2">
                    <Icon Paths="@Icons.Plus" Size="12" /> @L("MenuNew")
                </span>
                <Icon Name="chevron-right" Size="12" class="text-muted-foreground" />
            </button>
            <div class="node-menu-submenu-flyout"
                 data-slot="session-context-node-submenu"
                 data-state="@(_isNewSubmenuOpen ? "open" : "closed")"
                 data-side="right"
                 role="menu"
                 @onmouseenter="OpenNewSubmenu"
                 @onmouseleave="ScheduleCloseNewSubmenu">
                @foreach (var edge in CreateEdges)
                {
                    var targetLabel = edge.TargetDescriptor?.Label ?? edge.Label;
                    <button type="button"
                            class="node-menu-item"
                            data-testid="session-context-node-new-item"
                            data-edge-key="@edge.EdgeKey"
                            role="menuitem"
                            @onclick="() => NewAsync(edge)">
                        @targetLabel
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        @* No "New" button when there are no create edges — leaf nodes
           return empty from BuildOutgoingEdges, and non-leaf nodes with
           zero create edges have nothing meaningful to create. *@
    }
    <button type="button" class="node-menu-item" @onclick="RenameAsync">
        <Icon Paths="@Icons.Pencil" Size="12" /> @L("MenuRename")
    </button>
    <div class="node-menu-separator"></div>
    <button type="button" class="node-menu-item session-context-node-pin" @onclick="PinAsync">
        <Icon Paths="@Icons.Pin" Size="12" /> @L("MenuPin")
    </button>
    @if (CanAddToList)
    {
        <button type="button"
                class="node-menu-item"
                data-testid="session-context-node-add-to-list"
                @onclick="AddToListAsync">
            <Icon Paths="@Icons.List" Size="12" /> @L("MenuAddToList")
        </button>
    }
    <button type="button" class="node-menu-item" disabled="@(!CanMoveUp)" @onclick="MoveUpAsync">
        <Icon Paths="@Icons.ChevronUp" Size="12" /> @L("MenuMoveUp")
    </button>
    <button type="button" class="node-menu-item" disabled="@(!CanMoveDown)" @onclick="MoveDownAsync">
        <Icon Paths="@Icons.ChevronDown" Size="12" /> @L("MenuMoveDown")
    </button>
    <div class="node-menu-separator"></div>
    <button type="button" class="node-menu-item text-destructive" @onclick="DeleteAsync">
        <Icon Paths="@Icons.Trash" Size="12" /> @L("MenuDelete")
    </button>
</div>
