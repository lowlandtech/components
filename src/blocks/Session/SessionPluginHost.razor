@namespace LowlandTech.Components

<div data-slot="session-plugin-host" class="flex h-full min-h-0 flex-col overflow-hidden">
    @if (_isCollapsed)
    {
        <button type="button"
                data-slot="session-plugin-host-expand"
                class="p-2 text-left text-sm hover:bg-accent"
                @onclick="ExpandAsync">
            @ExpandLabel
        </button>
    }
    else
    {
        <div data-slot="session-plugin-host-tabs" class="flex gap-1 border-b border-border p-1">
            @foreach (var plugin in _visiblePlugins)
            {
                <button type="button"
                        data-slot="session-plugin-tab"
                        data-plugin-key="@plugin.Key"
                        class="@GetTabClass(plugin) px-2 py-1 text-xs"
                        @onclick="() => SelectAsync(plugin.Key)">
                    @plugin.Label
                    @if (!string.IsNullOrWhiteSpace(plugin.Badge))
                    {
                        <span data-slot="session-plugin-tab-badge" class="ml-1 rounded-full bg-primary px-1.5 text-primary-foreground">
                            @plugin.Badge
                        </span>
                    }
                </button>
            }

            @if (_visiblePlugins.Count == 0)
            {
                <span data-slot="session-plugin-host-empty" class="px-2 py-1 text-xs text-muted-foreground">
                    @EmptyLabel
                </span>
            }
        </div>

        <div data-slot="session-plugin-host-panel" class="min-h-0 flex-1 overflow-auto p-2">
            @if (_activePlugin is not null && _renderErrors.TryGetValue(_activePlugin.Key, out var error))
            {
                <div data-slot="session-plugin-panel-error" class="text-sm text-destructive">
                    @error
                </div>
            }
            else if (_activePlugin is not null && _activeRender is not null)
            {
                <ErrorBoundary>
                    <ChildContent>
                        @_activeRender
                    </ChildContent>
                    <ErrorContent>
                        @SetRenderError(_activePlugin.Key)
                        <div data-slot="session-plugin-panel-error" class="text-sm text-destructive">
                            @PanelFailedLabel
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </div>
    }
</div>

