@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="session-command-bar" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (_activeSlashCommand is not null)
    {
        <div class="absolute bottom-full left-0 z-50 mb-2 w-full overflow-hidden rounded-lg border border-border bg-popover text-popover-foreground shadow-lg"
             data-slot="session-command-menu"
             data-command="@_activeSlashCommand">
            @if (_activeSlashCommand == ProvidersCommand)
            {
                <div class="border-b border-border px-3 py-2 text-xs font-medium text-muted-foreground">/providers</div>
                <div class="max-h-64 overflow-y-auto p-1">
                    @foreach (var provider in AgentSelection.Providers)
                    {
                        <button type="button"
                                class="@GetPickerItemClass(provider.Key == AgentSelection.CurrentSelection.ProviderKey)"
                                data-slot="session-provider-option"
                                data-provider="@provider.Key"
                                @onclick="() => SelectProviderAsync(provider)">
                            <span>@provider.Label</span>
                            @if (provider.Key == AgentSelection.CurrentSelection.ProviderKey)
                            {
                                <span class="text-xs text-primary">Active</span>
                            }
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="border-b border-border px-3 py-2">
                    <div class="text-xs font-medium text-muted-foreground">/models</div>
                    <div class="mt-0.5 text-xs">@ActiveProvider.Label</div>
                </div>
                <div class="max-h-56 overflow-y-auto p-1">
                    @foreach (var model in ActiveProvider.Models)
                    {
                        <button type="button"
                                class="@GetPickerItemClass(model.Key == AgentSelection.CurrentSelection.ModelKey)"
                                data-slot="session-model-option"
                                data-model="@model.Key"
                                @onclick="() => SelectModelAsync(model)">
                            <span>@model.Label</span>
                            @if (model.Key == AgentSelection.CurrentSelection.ModelKey)
                            {
                                <span class="text-xs text-primary">Active</span>
                            }
                        </button>
                    }
                </div>
                @if (ActiveProvider.RequiresApiKey)
                {
                    <div class="border-t border-border p-2">
                        <label class="mb-1 block text-xs text-muted-foreground" for="session-provider-api-key">API key</label>
                        <input id="session-provider-api-key"
                               type="password"
                               autocomplete="off"
                               value="@_draftApiKey"
                               placeholder="Paste API key"
                               data-slot="session-provider-api-key"
                               class="h-8 w-full rounded-md border border-input bg-background px-2 text-xs outline-none focus:ring-1 focus:ring-ring"
                               @oninput="HandleApiKeyInput" />
                        <button type="button"
                                class="mt-2 h-8 w-full rounded-md bg-primary px-3 text-xs font-medium text-primary-foreground"
                                data-slot="session-provider-api-key-save"
                                @onclick="SaveApiKeyAsync">
                            Save key
                        </button>
                    </div>
                }
            }
        </div>
    }

    @if (SelectedNode is not null)
    {
        <div class="session-command-bar-context flex items-center gap-1.5 px-2 pt-2 text-xs" data-testid="session-command-context">
            <span class="inline-flex items-center gap-1 rounded bg-primary px-2 py-0.5 font-medium text-primary-foreground"
                  data-node-type="@GetContextNodeTypeKey()"
                  data-transition-key="@GetTransitionKey()">
                @GetContextNodeTypeKey()
            </span>
        </div>
    }

    <textarea data-slot="session-command-input"
              data-testid="session-command-input"
              rows="@Rows"
              value="@Value"
              placeholder="@Placeholder"
              disabled="@Disabled"
              class="w-full resize-none border-0 bg-transparent px-3 pt-3 pb-1 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-0 focus-visible:outline-none focus-visible:ring-0"
              @oninput="HandleInput"
              @onkeydown="HandleKeyDown"></textarea>

    <div class="flex items-center justify-between gap-2 px-2 pb-2 pt-1">
        <div class="flex min-w-0 flex-wrap items-center gap-1" data-testid="session-agent-types">
            @foreach (var agent in AgentTypes)
            {
                var isActive = IsAgentActive(agent);
                <button type="button"
                        data-slot="session-agent-type"
                        data-agent-type="@agent.Key"
                        data-active="@(isActive ? "true" : "false")"
                        disabled="@agent.Disabled"
                        title="@agent.Tooltip"
                        class="@GetAgentClass(agent, isActive)"
                        @onclick="() => SelectAgentAsync(agent)">
                    @agent.Label
                </button>
            }
            <Select Value="@_selectionValue"
                    ValueChanged="HandleSelectionChangeAsync"
                    class="max-w-48"
                    data-slot="session-completion-selection">
                <SelectTrigger class="h-8 max-w-48 gap-1 rounded-md border border-border px-2 text-xs text-muted-foreground hover:bg-muted">
                    <SelectValue Placeholder="Model" />
                </SelectTrigger>
                <SelectContent>
                    @foreach (var provider in AgentSelection.Providers)
                    {
                        <SelectGroup>
                            <SelectLabel>@provider.Label</SelectLabel>
                            @foreach (var model in provider.Models)
                            {
                                <SelectItem Value="@($"{provider.Key}{ValueSeparator}{model.Key}")">@model.Label</SelectItem>
                            }
                        </SelectGroup>
                    }
                </SelectContent>
            </Select>
        </div>

        <button type="button"
                data-slot="session-command-submit"
                data-testid="session-command-submit"
                disabled="@(Disabled || IsBusy || SelectedNode is null || string.IsNullOrWhiteSpace(CurrentInput))"
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary text-primary-foreground transition-opacity hover:bg-primary/90 disabled:opacity-40"
                title="@SubmitTitle"
                @onclick="() => SubmitAsync()">
            @if (IsBusy)
            {
                <Spinner Size="14" class="animate-spin" data-testid="session-command-busy-loader" />
            }
            else
            {
                <Icon Paths="<path d='m22 2-7 20-4-9-9-4Z'/><path d='M22 2 11 13'/>" Size="14" />
            }
        </button>
    </div>
</div>
