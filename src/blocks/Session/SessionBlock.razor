@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="session-block" data-variant="@Variant" class="@GetClass()" style="@GetStyle()" @attributes="AdditionalAttributes">
    @if (HasSidebar)
    {
        <div class="relative h-full min-h-0 w-full">
        <Resizable @key="IsStandaloneSidebarOpen" PersistKey="@ResizablePersistKey">
            @if (IsStandaloneSidebarOpen)
            {
            <ResizablePanel DefaultSize="@(SidebarWidth ?? (HasActiveSession ? 16 : 24))" MinSize="16" MaxSize="38" Id="session-block-sidebar-panel" class="h-full">
                <SidebarProvider Open="@_isStandaloneSidebarOpen" OpenChanged="HandleStandaloneSidebarOpenChanged" Width="100%" class="h-full min-h-0">
                    <Sidebar Collapsible="offcanvas" class="@GetLeftSidebarClass()">
                            <div class="flex h-full min-h-0 w-full flex-1 flex-col overflow-hidden"
                             style="@(IsNoneVariant ? "padding:10px 4px 10px 10px;" : "padding:10px;")"
                             data-slot="session-block-left-sidebar">
                            <section class="flex h-full min-h-0 w-full flex-1 flex-col overflow-hidden rounded-lg border border-border bg-background">
                            @if (HasActiveSession)
                            {
                                <SidebarHeader>
                                    <div class="flex items-center justify-between gap-2">
                                        <SidebarBrand LogoSrc="@LogoSrc" LogoAlt="@EffectiveTitle" Title="@EffectiveTitle" />
                                        <SidebarTrigger data-testid="session-block-sidebar-close" class="border border-border text-muted-foreground hover:bg-muted hover:text-foreground">
                                            <Icon Name="panel-left-close" Size="14" />
                                        </SidebarTrigger>
                                    </div>
                                </SidebarHeader>
                                <SidebarContent class="min-h-0 w-full flex-1">
                                    <SidebarGroup>
                                        <SidebarGroupContent>
                                            <SidebarMenu>
                                                <SidebarMenuItem>
                                                    <SidebarMenuButton class="text-xs" @onclick="ShowSessionsAsync">
                                                        <Icon Name="arrow-left" Size="14" />
                                                        <span class="sidebar-menu-text">@L("AllSessions")</span>
                                                    </SidebarMenuButton>
                                                </SidebarMenuItem>
                                            </SidebarMenu>
                                        </SidebarGroupContent>
                                    </SidebarGroup>
                                    <SidebarGroup class="min-h-0 w-full flex-1">
                                        <SidebarGroupLabel Class="justify-between"><span>@L("Context")</span><button type="button" data-slot="session-context-create" data-testid="session-context-create" class="inline-flex h-6 w-6 items-center justify-center rounded text-muted-foreground hover:bg-muted hover:text-foreground" title="@L("NewList")" @onclick="HandleContextCreateAsync"><Icon Name="plus" Size="12" /></button></SidebarGroupLabel>
                                        <SidebarGroupContent class="min-h-0 w-full flex-1 overflow-hidden">
                                            <SessionContextExplorer RootNodes="DisplayContextNodes"
                                                                    State="ViewState"
                                                                    Projection="ViewState.ContextProjection"
                                                                    Pins="@(ViewState.ContextPins ?? [])"
                                                                    OnProjected="HandleProjectedAsync"
                                                                    OnNavigateToPin="ScrollToPinnedContextAsync"
                                                                    OnPinned="HandlePinnedAsync"
                                                                    OnUnpinned="HandleUnpinnedAsync"
                                                                    OnNodeNew="HandleNodeNewAsync"
                                                                    OnNodeRename="HandleNodeRenameAsync"
                                                                    OnNodeDelete="HandleNodeDeleteAsync"
                                                                    OnAddToList="HandleAddToListAsync"
                                                                    OnLoadChildren="OnLoadChildrenRequested"
                                                                    ExpandedNodeIds="_expandedContextNodeIds"
                                                                    ShowHeader="false"
                                                                    HasFrame="false"
                                                                    class="min-h-0 flex-1" />
                                        </SidebarGroupContent>
                                    </SidebarGroup>
                                </SidebarContent>
                                <SidebarFooter class="w-full items-end">
                                    <button type="button"
                                            data-testid="session-block-settings-button"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                            @onclick="ShowSettingsPageAsync">
                                        <Icon Name="settings" Size="14" />
                                    </button>
                                </SidebarFooter>
                            }
                            else
                            {
                                <SidebarHeader>
                                    <div class="flex items-center justify-between gap-2">
                                        <SidebarBrand LogoSrc="@LogoSrc" LogoAlt="@EffectiveTitle" Title="@EffectiveTitle" />
                                        <SidebarTrigger data-testid="session-block-sidebar-close" class="border border-border text-muted-foreground hover:bg-muted hover:text-foreground">
                                            <Icon Name="panel-left-close" Size="14" />
                                        </SidebarTrigger>
                                    </div>
                                </SidebarHeader>
                                <SidebarContent class="min-h-0 w-full flex-1">
                                    <SidebarGroup class="min-h-0 w-full flex-1">
                                        <SidebarGroupLabel Class="justify-between"><span>@L("Sessions")</span><button type="button" data-slot="session-list-create" data-testid="session-list-create" class="inline-flex h-6 w-6 items-center justify-center rounded text-muted-foreground hover:bg-muted hover:text-foreground" title="@L("NewSession")" @onclick="CreateSessionAsync"><Icon Name="plus" Size="12" /></button></SidebarGroupLabel>
                                        <SidebarGroupContent class="min-h-0 w-full flex-1 overflow-hidden">
                                            @if (DisplaySessions.Count == 0)
                                            {
                                                <div class="px-2 py-3 text-xs text-muted-foreground" data-slot="session-list-empty">
                                                    @L("NoSessionsYet")
                                                </div>
                                            }
                                            else
                                            {
                                                <div data-slot="session-list" class="flex h-full min-h-0 w-full flex-1 flex-col">
                                                    <SidebarMenu class="h-full w-full">
                                                        @foreach (var item in DisplaySessions)
                                                        {
                                                            var node = new SessionNodeInput(item.Id, item.NodeTypeKey, item.Label);
                                                            <SidebarMenuItem>
                                                                <SidebarMenuButton IsActive="@(CurrentSessionNode?.Id == node.Id)"
                                                                                   data-testid="session-list-item"
                                                                                   data-node-id="@node.Id"
                                                                                   data-selected="@(CurrentSessionNode?.Id == node.Id ? "true" : "false")"
                                                                                   @onclick="() => SelectSessionAsync(node)">
                                                                    @node.Label
                                                                    <SidebarMenuBadge data-testid="session-list-item-count"
                                                                                      data-node-id="@node.Id">@item.Count</SidebarMenuBadge>
                                                                </SidebarMenuButton>
                                                            </SidebarMenuItem>
                                                        }
                                                    </SidebarMenu>
                                                </div>
                                            }
                                        </SidebarGroupContent>
                                    </SidebarGroup>
                                </SidebarContent>
                                <SidebarFooter>
                                    <div data-slot="session-block-sidebar-footer-summary"
                                         class="sidebar-menu-text grid h-7 w-full grid-cols-2 items-center px-2 text-xs text-muted-foreground">
<span data-slot="session-block-sidebar-footer-page"
                                              class="w-full text-left">@L("PageLabel") 1 / 1</span>
                                        <span data-slot="session-block-sidebar-footer-rows"
                                              class="w-full text-right">@L("RowsLabel") 10</span>
                                    </div>
                                </SidebarFooter>
                            }
                            </section>
                        </div>
                    </Sidebar>
                </SidebarProvider>
            </ResizablePanel>
            <ResizableHandle WithHandle="true" RevealOnHover="true" Color="primary" class="relative z-20" />
            }
            <ResizablePanel DefaultSize="100" MinSize="35" Id="session-block-main-panel" Grow="true" class="h-full">
                <SidebarInset class="@GetSidebarInsetClass()">
                    <main class="relative flex h-full min-h-0 w-full flex-col gap-3 overflow-hidden"
                          style="@GetMainContentStyle(IsStandaloneSidebarOpen)"
                          data-slot="session-block-main-content">
                        @if (IsSettingsPage)
                        {
                            <SessionSettings class="min-h-0 flex-1"
                                             Outbox="SessionState.Outbox"
                                             StateService="SessionState"
                                             HeaderLeading="@(!IsStandaloneSidebarOpen ? SidebarOpenButton : null)"
                                             HeaderTrailing="@(!_isRightSidebarOpen ? RightSidebarOpenButton : null)">
                                <ActivityContent>
                                    <SessionEventLog Entries="AppState.EventLogEntries"
                                                     InitialStateJson="@SessionState.GetInitialEventLogStateJson()"
                                                     CurrentStateJson="@SessionState.GetCurrentEventLogStateJson()"
                                                     OnBackRequested="ShowFeedPageAsync"
                                                     OnClearRequested="ClearEventLogAsync"
                                                     class="min-h-0 flex-1" />
                                </ActivityContent>
                            </SessionSettings>
                        }
                        else if (IsEventLogPage)
                        {
                            <SessionEventLog Entries="AppState.EventLogEntries"
                                             InitialStateJson="@SessionState.GetInitialEventLogStateJson()"
                                             CurrentStateJson="@SessionState.GetCurrentEventLogStateJson()"
                                             OnBackRequested="ShowFeedPageAsync"
                                             OnClearRequested="ClearEventLogAsync"
                                             class="min-h-0 flex-1" />
                        }
                        else
                        {
                            <SessionContent State="ViewState"
                                            OpenNodes="ViewState.OpenNodes"
                                            SelectedNode="CurrentSessionNode"
                                            PinnableTabs="true"
                                            Flush="@HasMaximizedContent"
                                            PinnedTabIds="AppState.PinnedNodeIds"
                                            EmptyTitle="@L("EmptySessionTitle")"
                                            EmptyDescription="@L("EmptySessionDescription")"
                                            HeaderLeading="@(!IsStandaloneSidebarOpen ? SidebarOpenButton : null)"
                                            HeaderTrailing="@(!_isRightSidebarOpen ? RightSidebarOpenButton : null)"
                                            OnSelected="e => SelectSessionAsync(e.Node)"
                                            OnClosed="HandleTabClosedAsync"
                                            OnTabPinnedChanged="HandleTabPinnedChangedAsync"
                                            class="min-h-0 flex-1">
                            @if (IsContentLoading)
                            {
                                <div data-slot="session-content-loading"
                                     class="flex min-h-full flex-1 items-center justify-center"
                                     role="status"
                                     aria-label="@L("LoadingSessionContent")">
                                    <Spinner class="size-6" />
                                </div>
                            }
                            else if (MaximizedBlock is { } maximizedBlock)
                            {
                                <div class="flex h-full min-h-0"
                                     data-slot="session-block-maximized-block"
                                     data-block-id="@maximizedBlock.Id">
                                    <SessionContextBlock Block="maximizedBlock"
                                                         Mode="@SessionContextBlock.ModeMaximized"
                                                         IsPinned="@IsBlockPinned(maximizedBlock)"
                                                         PageOverlayContainerClass="@PageOverlayContainerClass"
                                                         AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                         HostHandlesPageOverlay="true"
                                                         OnIntentSelected="HandleNodeIntentSelectedAsync"
                                                         OnUnpin="@(() => UnpinBlockAsync(maximizedBlock))"
                                                         ModeChanged="@(mode => HandleBlockModeChangedAsync(maximizedBlock, mode))" />
                                </div>
                            }
                            else if (MaximizedCommand is { } maximizedCommand)
                            {
                                <div class="flex h-full min-h-0"
                                     data-slot="session-block-maximized-card"
                                     data-command-id="@maximizedCommand.Id">
                                    <SessionCard Node="CreateResponseNode(maximizedCommand)"
                                                 Initials="RS"
                                                 Mode="@SessionContextBlock.ModeMaximized"
                                                 Status="@GetResponseStatus(maximizedCommand)"
                                                 StatusVariant="@GetResponseStatusVariant(maximizedCommand)"
                                                 PageOverlayContainerClass="@PageOverlayContainerClass"
                                                 AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                 HostHandlesPageOverlay="true"
                                                 ModeChanged="@(mode => HandleCommandModeChangedAsync(maximizedCommand, mode))">
                                        <div class="space-y-2">
                                            <p class="rounded-md border border-border bg-background px-2 py-1.5 text-xs text-muted-foreground"
                                               data-slot="session-turn-prompt">
                                                @maximizedCommand.Input
                                            </p>
                                            <SessionMarkdown data-slot="session-turn-response-text"
                                                             data-streaming="@maximizedCommand.IsStreaming.ToString().ToLowerInvariant()"
                                                             IsStreaming="@maximizedCommand.IsStreaming"
                                                             Value="@CreateResponseDescription(maximizedCommand)" />
                                        </div>
                                    </SessionCard>
                                </div>
                            }
                            else
                            {
                                <div class="flex min-h-full shrink-0 flex-col space-y-3" data-slot="session-block-feed">
                                    @if (FeedItems.Count == 0)
                                    {
                                        <div class="flex flex-1 flex-col items-center justify-center py-24" data-slot="session-block-feed-empty">
                                            <div class="text-center">
                                                <Icon Paths="<path d='M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/><path d='M8 8h8M8 12h5'/>" Size="28" class="mx-auto text-muted-foreground" />
                                                <p class="mt-3 text-sm font-medium">@L("EmptyFeedTitle")</p>
                                                <p class="mt-1 text-xs text-muted-foreground">@L("EmptyFeedDescription")</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var item in FeedItems)
                                        {
                                            @if (item.Kind == SessionFeedItemKind.Response)
                                            {
                                                <div @key="item.Key"
                                                     id="@GetCommandTurnId(item.Command!)"
                                                     data-slot="session-block-turn-section">
                                                    <SessionCard Node="CreateResponseNode(item.Command!)"
                                                                 Initials="RS"
                                                                 Mode="@GetCommandMode(item.Command!)"
                                                                 Status="@GetResponseStatus(item.Command!)"
                                                                 StatusVariant="@GetResponseStatusVariant(item.Command!)"
                                                                 PageOverlayContainerClass="@PageOverlayContainerClass"
                                                                 AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                                 HostHandlesPageOverlay="true"
                                                                 ModeChanged="@(mode => HandleCommandModeChangedAsync(item.Command!, mode))">
                                                        <div class="space-y-2">
                                                            <p class="rounded-md border border-border bg-background px-2 py-1.5 text-xs text-muted-foreground"
                                                               data-slot="session-turn-prompt">
                                                                @item.Command!.Input
                                                            </p>
                                                            <SessionMarkdown data-slot="session-turn-response-text"
                                                                             data-streaming="@item.Command.IsStreaming.ToString().ToLowerInvariant()"
                                                                             IsStreaming="@item.Command.IsStreaming"
                                                                             Value="@CreateResponseDescription(item.Command)" />
                                                        </div>
                                                    </SessionCard>
                                                </div>
                                            }
                                            else
                                            {
                                                <SessionContextBlock @key="item.Key"
                                                                     Block="item.Block!"
                                                                     Mode="@GetBlockMode(item.Block!)"
                                                                     IsPinned="@IsBlockPinned(item.Block!)"
                                                                     PageOverlayContainerClass="@PageOverlayContainerClass"
                                                                     AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                                     HostHandlesPageOverlay="true"
                                                                     OnIntentSelected="HandleNodeIntentSelectedAsync"
                                                                     OnUnpin="@(() => UnpinBlockAsync(item.Block!))"
                                                                     ModeChanged="@(mode => HandleBlockModeChangedAsync(item.Block!, mode))" />
                                            }
                                        }
                                    }
                                </div>
                            }
                            </SessionContent>

                            @if (_isCommandBarVisible)
                            {
                                <SessionCommandBar State="ViewState"
                                                   SelectedNode="CurrentCommandContextNode"
                                                   ActiveAgentTypeKey="@ViewState.ActiveAgentTypeKey"
                                                   AgentTypes="LocalizedAgentTypes"
                                                   Value="@ViewState.Input"
                                                   ValueChanged="SetInputAsync"
                                                   Placeholder="@GetCommandPlaceholder()"
                                                   SubmitTitle="@L("CommandSubmitTitle")"
                                                   OnAgentTypeSelected="e => SetAgentTypeAsync(e.AgentTypeKey)"
                                                   class="shrink-0"
                                                   OnSubmit="HandleSubmitAsync" />
                            }
                        }

                        @if (PageOverlayBlock is { } pageOverlayBlock)
                        {
                            <div class="@EffectivePageOverlayContainerClass"
                                 style="@GetPageOverlayContainerStyle(IsStandaloneSidebarOpen)"
                                 data-slot="session-block-page-overlay">
                                <SessionContextBlock Block="pageOverlayBlock"
                                                     Mode="@SessionContextBlock.ModeOverlayPage"
                                                     IsPinned="@IsBlockPinned(pageOverlayBlock)"
                                                     PageOverlayContainerClass="@PageOverlayContainerClass"
                                                     AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                     HostHandlesPageOverlay="true"
                                                     IsPageOverlayProjection="true"
                                                     OnIntentSelected="HandleNodeIntentSelectedAsync"
                                                     OnUnpin="@(() => UnpinBlockAsync(pageOverlayBlock))"
                                                     ModeChanged="@(mode => HandleBlockModeChangedAsync(pageOverlayBlock, mode))" />
                            </div>
                        }
                        else if (PageOverlayCommand is { } pageOverlayCommand)
                        {
                            <div class="@EffectivePageOverlayContainerClass"
                                 style="@GetPageOverlayContainerStyle(IsStandaloneSidebarOpen)"
                                 data-slot="session-block-page-overlay">
                                <SessionCard Node="CreateResponseNode(pageOverlayCommand)"
                                             Initials="RS"
                                             Mode="@SessionContextBlock.ModeOverlayPage"
                                             Status="@GetResponseStatus(pageOverlayCommand)"
                                             StatusVariant="@GetResponseStatusVariant(pageOverlayCommand)"
                                             PageOverlayContainerClass="@PageOverlayContainerClass"
                                             AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                             HostHandlesPageOverlay="true"
                                             IsPageOverlayProjection="true"
                                             ModeChanged="@(mode => HandleCommandModeChangedAsync(pageOverlayCommand, mode))">
                                    <div class="space-y-2">
                                        <p class="rounded-md border border-border bg-background px-2 py-1.5 text-xs text-muted-foreground"
                                           data-slot="session-turn-prompt">
                                            @pageOverlayCommand.Input
                                        </p>
                                        <SessionMarkdown data-slot="session-turn-response-text"
                                                         data-streaming="@pageOverlayCommand.IsStreaming.ToString().ToLowerInvariant()"
                                                         IsStreaming="@pageOverlayCommand.IsStreaming"
                                                         Value="@CreateResponseDescription(pageOverlayCommand)" />
                                    </div>
                                </SessionCard>
                            </div>
                        }
                    </main>
                </SidebarInset>
            </ResizablePanel>
            @if (_isRightSidebarOpen)
            {
            <ResizableHandle WithHandle="true" RevealOnHover="true" Color="primary" class="relative z-20" />
            <ResizablePanel DefaultSize="@(SidebarWidth ?? 16)" MinSize="12" MaxSize="100" Id="session-block-sections-panel" class="h-full">
                <aside class="@GetRightSidebarClass()"
                      data-slot="session-block-right-sidebar"
                      data-testid="session-block-right-sidebar">
                     <div data-slot="session-block-right-sidebar-body"
                          class="flex h-full min-h-0 min-w-0 w-full flex-1 flex-col"
                          style="@GetRightSidebarBodyStyle()">
                         <section class="flex min-h-0 min-w-0 w-full flex-1 flex-col overflow-hidden rounded-lg border border-border bg-background">
                             <header class="flex h-10 shrink-0 items-center gap-2 border-b border-border px-3"
                                     data-slot="session-block-sections-header">
                                 <span class="text-xs font-semibold">@L("Sections")</span>
                                <span class="ml-auto inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-[10px] font-semibold text-primary-foreground"
                                      data-testid="session-block-sections-count">
                                    @VisibleSections.Count
                                </span>
                                <button type="button"
                                        data-testid="session-block-right-sidebar-close"
                                        class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                        title="@L("CloseSections")"
                                        aria-label="@L("CloseSections")"
                                        @onclick="CloseRightSidebarAsync">
                                    <Icon Name="panel-right-close" Size="14" />
                                </button>
                            </header>
                            <div class="min-h-0 flex-1 overflow-y-auto py-1"
                                 data-slot="session-block-section-links">
                                @if (VisibleSections.Count == 0)
                                {
                                    <div class="px-3 py-3 text-xs text-muted-foreground">
                                        @L("NoSections")
                                    </div>
                                }
                                else
                                {
                                    @foreach (var section in VisibleSections)
                                    {
                                        <button type="button"
                                                class="group flex min-h-8 w-full items-center gap-2 px-3 py-1 text-left text-sm font-normal text-foreground transition-colors hover:bg-muted/60"
                                                data-testid="session-block-section-link"
                                                data-section-id="@section.Id"
                                                @onclick="() => ScrollSectionIntoViewAsync(section.Id)">
                                            <span class="min-w-0 flex-1 truncate">@section.Label</span>
                                            <span class="shrink-0 text-[10px] text-muted-foreground">@section.Kind</span>
                                        </button>
                                    }
                                }
                            </div>
                            <footer class="flex shrink-0 justify-start p-2">
                                <button type="button"
                                        data-testid="session-block-command-bar-toggle"
                                        class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-border bg-background text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                        title="@L("ToggleCommandBar")"
                                        @onclick="ToggleCommandBarAsync">
                                    <Icon Name="terminal" Size="12" />
                                </button>
                            </footer>
                        </section>
                    </div>
                </aside>
            </ResizablePanel>
            }
        </Resizable>
        </div>
    }
    else
    {
        <Resizable PersistKey="@ResizablePersistKey">
            <ResizablePanel DefaultSize="@(SidebarWidth ?? 24)" MinSize="16" MaxSize="38" Id="session-block-left-panel" class="h-full">
                   <aside class="@GetLeftPanelClass()"
                       data-slot="session-block-left-sidebar">
                    <div class="flex h-full min-h-0 w-full flex-1 flex-col"
                        data-slot="session-block-left-sidebar-body"
                        style="@(IsNoneVariant ? "padding:10px 4px 10px 10px;" : "padding:10px;")">
                        <div class="flex h-full min-h-0 w-full flex-1 flex-col overflow-hidden"
                            data-slot="session-block-left-sidebar">
                        @if (HasActiveSession)
                        {
                            <section class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-lg border border-border bg-background">
                                <header class="flex h-10 shrink-0 items-center gap-2 border-b border-border px-3">
                                    <button type="button"
                                            data-slot="session-block-sidebar-back"
                                            class="inline-flex h-7 items-center rounded-md border border-border pl-1 pr-2 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                            @onclick="ShowSessionsAsync">
                                        @L("Back")
                                    </button>
                                    <p class="min-w-0 flex-1 truncate text-xs">
                                        <span class="font-semibold">@L("ContextLabel")</span>
                                        <span class="ml-1 text-muted-foreground">@CurrentSessionNode?.Label</span>
                                    </p>
                                </header>

                                <SessionContextExplorer RootNodes="DisplayContextNodes"
                                                        State="ViewState"
                                                        Projection="ViewState.ContextProjection"
                                                        Pins="@(ViewState.ContextPins ?? [])"
                                                        OnProjected="HandleProjectedAsync"
                                                        OnPinned="HandlePinnedAsync"
                                                        OnUnpinned="HandleUnpinnedAsync"
                                                        OnNodeNew="HandleNodeNewAsync"
                                                        OnNodeRename="HandleNodeRenameAsync"
                                                        OnNodeDelete="HandleNodeDeleteAsync"
                                                        OnAddToList="HandleAddToListAsync"
                                                        OnLoadChildren="OnLoadChildrenRequested"
                                                        ExpandedNodeIds="_expandedContextNodeIds"
                                                        ShowHeader="false"
                                                        HasFrame="false"
                                                        class="min-h-0 flex-1 rounded-none" />
                            </section>
                        }
                        else
                        {
                            <SessionList Items="DisplaySessions"
                                         State="ViewState"
                                         SelectedNode="CurrentSessionNode"
                                         OnSelected="e => SelectSessionAsync(e.Node)"
                                         OnCreateRequested="_ => CreateSessionAsync()"
                                         class="min-h-0 flex-1" />
                        }
                        </div>
                    </div>
                </aside>
            </ResizablePanel>
            @if (!HasActiveSession)
            {
                <ResizableHandle WithHandle="true" RevealOnHover="true" Color="primary" class="relative z-20" />
            }
            <ResizablePanel DefaultSize="@(HasActiveSession ? 84 : 60)" MinSize="35" Id="session-block-main-panel" Grow="true" class="h-full">
                <main class="relative flex h-full min-h-0 w-full flex-col gap-3 overflow-hidden"
                      style="@GetMainContentStyle(!HasActiveSession)"
                      data-slot="session-block-main-content">
                    <SessionContent State="ViewState"
                                    OpenNodes="ViewState.OpenNodes"
                                    SelectedNode="CurrentSessionNode"
                                    PinnableTabs="true"
                                    Flush="@HasMaximizedContent"
                                    PinnedTabIds="AppState.PinnedNodeIds"
                                    EmptyTitle="@L("EmptySessionTitle")"
                                    EmptyDescription="@L("EmptySessionDescription")"
                                    HeaderTrailing="@(!_isRightSidebarOpen ? RightSidebarOpenButton : null)"
                                    OnSelected="e => SelectSessionAsync(e.Node)"
                                    OnClosed="HandleTabClosedAsync"
                                    OnTabPinnedChanged="HandleTabPinnedChangedAsync"
                                    class="min-h-0 flex-1">
                        @if (IsContentLoading)
                        {
                            <div data-slot="session-content-loading"
                                 class="flex min-h-full flex-1 items-center justify-center"
                                 role="status"
                                 aria-label="@L("LoadingSessionContent")">
                                <Spinner class="size-6" />
                            </div>
                        }
                        else if (MaximizedBlock is { } maximizedBlock)
                        {
                            <div class="flex h-full min-h-0"
                                 data-slot="session-block-maximized-block"
                                 data-block-id="@maximizedBlock.Id">
                                <SessionContextBlock Block="maximizedBlock"
                                                     Mode="@SessionContextBlock.ModeMaximized"
                                                     IsPinned="@IsBlockPinned(maximizedBlock)"
                                                     PageOverlayContainerClass="@PageOverlayContainerClass"
                                                     AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                     HostHandlesPageOverlay="true"
                                                     OnIntentSelected="HandleNodeIntentSelectedAsync"
                                                     OnUnpin="@(() => UnpinBlockAsync(maximizedBlock))"
                                                     ModeChanged="@(mode => HandleBlockModeChangedAsync(maximizedBlock, mode))" />
                            </div>
                        }
                        else if (MaximizedCommand is { } maximizedCommand)
                        {
                            <div class="flex h-full min-h-0"
                                 data-slot="session-block-maximized-card"
                                 data-command-id="@maximizedCommand.Id">
                                <SessionCard Node="CreateResponseNode(maximizedCommand)"
                                             Initials="RS"
                                             Mode="@SessionContextBlock.ModeMaximized"
                                             Status="@GetResponseStatus(maximizedCommand)"
                                             StatusVariant="@GetResponseStatusVariant(maximizedCommand)"
                                             PageOverlayContainerClass="@PageOverlayContainerClass"
                                             AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                             HostHandlesPageOverlay="true"
                                             ModeChanged="@(mode => HandleCommandModeChangedAsync(maximizedCommand, mode))">
                                    <div class="space-y-2">
                                        <p class="rounded-md border border-border bg-background px-2 py-1.5 text-xs text-muted-foreground"
                                           data-slot="session-turn-prompt">
                                            @maximizedCommand.Input
                                        </p>
                                        <SessionMarkdown data-slot="session-turn-response-text"
                                                         data-streaming="@maximizedCommand.IsStreaming.ToString().ToLowerInvariant()"
                                                         IsStreaming="@maximizedCommand.IsStreaming"
                                                         Value="@CreateResponseDescription(maximizedCommand)" />
                                    </div>
                                </SessionCard>
                            </div>
                        }
                        else
                        {
                            <div class="flex min-h-full shrink-0 flex-col space-y-3" data-slot="session-block-feed">
                                @if (FeedItems.Count == 0)
                                {
                                    <div class="flex flex-1 flex-col items-center justify-center py-24" data-slot="session-block-feed-empty">
                                        <div class="text-center">
                                            <Icon Paths="<path d='M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/><path d='M8 8h8M8 12h5'/>" Size="28" class="mx-auto text-muted-foreground" />
                                            <p class="mt-3 text-sm font-medium">@L("EmptyFeedTitle")</p>
                                            <p class="mt-1 text-xs text-muted-foreground">@L("EmptyFeedDescription")</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in FeedItems)
                                    {
                                        @if (item.Kind == SessionFeedItemKind.Response)
                                        {
                                            <div @key="item.Key"
                                                 id="@GetCommandTurnId(item.Command!)"
                                                 data-slot="session-block-turn-section">
                                                <SessionCard Node="CreateResponseNode(item.Command!)"
                                                             Initials="RS"
                                                             Mode="@GetCommandMode(item.Command!)"
                                                             Status="@GetResponseStatus(item.Command!)"
                                                             StatusVariant="@GetResponseStatusVariant(item.Command!)"
                                                             PageOverlayContainerClass="@PageOverlayContainerClass"
                                                             AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                             HostHandlesPageOverlay="true"
                                                             ModeChanged="@(mode => HandleCommandModeChangedAsync(item.Command!, mode))">
                                                    <div class="space-y-2">
                                                        <p class="rounded-md border border-border bg-background px-2 py-1.5 text-xs text-muted-foreground"
                                                           data-slot="session-turn-prompt">
                                                            @item.Command!.Input
                                                        </p>
                                                        <SessionMarkdown data-slot="session-turn-response-text"
                                                                         data-streaming="@item.Command.IsStreaming.ToString().ToLowerInvariant()"
                                                                         IsStreaming="@item.Command.IsStreaming"
                                                                         Value="@CreateResponseDescription(item.Command)" />
                                                    </div>
                                                </SessionCard>
                                            </div>
                                        }
                                        else
                                        {
                                            <SessionContextBlock @key="item.Key"
                                                                 Block="item.Block!"
                                                                 Mode="@GetBlockMode(item.Block!)"
                                                                 IsPinned="@IsBlockPinned(item.Block!)"
                                                                 PageOverlayContainerClass="@PageOverlayContainerClass"
                                                                 AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                                 HostHandlesPageOverlay="true"
                                                                 OnIntentSelected="HandleNodeIntentSelectedAsync"
                                                                 OnUnpin="@(() => UnpinBlockAsync(item.Block!))"
                                                                 ModeChanged="@(mode => HandleBlockModeChangedAsync(item.Block!, mode))" />
                                        }
                                    }
                                }
                            </div>
                        }
                    </SessionContent>

                    @if (_isCommandBarVisible)
                    {
                        <SessionCommandBar State="ViewState"
                                           SelectedNode="CurrentCommandContextNode"
                                           ActiveAgentTypeKey="@ViewState.ActiveAgentTypeKey"
                                           AgentTypes="LocalizedAgentTypes"
                                           Value="@ViewState.Input"
                                           ValueChanged="SetInputAsync"
                                           Placeholder="@GetCommandPlaceholder()"
                                           SubmitTitle="@L("CommandSubmitTitle")"
                                           OnAgentTypeSelected="e => SetAgentTypeAsync(e.AgentTypeKey)"
                                           class="shrink-0"
                                           OnSubmit="HandleSubmitAsync" />
                    }

                    @if (PageOverlayBlock is { } pageOverlayBlock)
                    {
                        <div class="@EffectivePageOverlayContainerClass"
                             style="@GetPageOverlayContainerStyle(!HasActiveSession)"
                             data-slot="session-block-page-overlay">
                            <SessionContextBlock Block="pageOverlayBlock"
                                                 Mode="@SessionContextBlock.ModeOverlayPage"
                                                 IsPinned="@IsBlockPinned(pageOverlayBlock)"
                                                 PageOverlayContainerClass="@PageOverlayContainerClass"
                                                 AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                                 HostHandlesPageOverlay="true"
                                                 IsPageOverlayProjection="true"
                                                 OnIntentSelected="HandleNodeIntentSelectedAsync"
                                                 OnUnpin="@(() => UnpinBlockAsync(pageOverlayBlock))"
                                                 ModeChanged="@(mode => HandleBlockModeChangedAsync(pageOverlayBlock, mode))" />
                        </div>
                    }
                    else if (PageOverlayCommand is { } pageOverlayCommand)
                    {
                        <div class="@EffectivePageOverlayContainerClass"
                             style="@GetPageOverlayContainerStyle(!HasActiveSession)"
                             data-slot="session-block-page-overlay">
                            <SessionCard Node="CreateResponseNode(pageOverlayCommand)"
                                         Initials="RS"
                                         Mode="@SessionContextBlock.ModeOverlayPage"
                                         Status="@GetResponseStatus(pageOverlayCommand)"
                                         StatusVariant="@GetResponseStatusVariant(pageOverlayCommand)"
                                         PageOverlayContainerClass="@PageOverlayContainerClass"
                                         AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                                         HostHandlesPageOverlay="true"
                                         IsPageOverlayProjection="true"
                                         ModeChanged="@(mode => HandleCommandModeChangedAsync(pageOverlayCommand, mode))">
                                <div class="space-y-2">
                                    <p class="rounded-md border border-border bg-background px-2 py-1.5 text-xs text-muted-foreground"
                                       data-slot="session-turn-prompt">
                                        @pageOverlayCommand.Input
                                    </p>
                                    <SessionMarkdown data-slot="session-turn-response-text"
                                                     data-streaming="@pageOverlayCommand.IsStreaming.ToString().ToLowerInvariant()"
                                                     IsStreaming="@pageOverlayCommand.IsStreaming"
                                                     Value="@CreateResponseDescription(pageOverlayCommand)" />
                                </div>
                            </SessionCard>
                        </div>
                    }
                </main>
            </ResizablePanel>
            @if (_isRightSidebarOpen)
            {
            <ResizableHandle WithHandle="true" RevealOnHover="true" Color="primary" class="z-10" />
            <ResizablePanel DefaultSize="@(SidebarWidth ?? 16)" MinSize="12" MaxSize="100" Id="session-block-sections-panel" class="h-full">
                <aside class="@GetRightSidebarClass()"
                      data-slot="session-block-right-sidebar"
                      data-testid="session-block-right-sidebar">
                    <div data-slot="session-block-right-sidebar-body"
                         class="flex h-full min-h-0 min-w-0 w-full flex-1 flex-col"
                         style="@GetRightSidebarBodyStyle()">
                        <section class="flex min-h-0 min-w-0 w-full flex-1 flex-col overflow-hidden rounded-lg border border-border bg-background">
                        <header class="flex h-10 shrink-0 items-center gap-2 border-b border-border px-3"
                                data-slot="session-block-sections-header">
                            <span class="text-xs font-semibold">@L("Sections")</span>
                            <span class="ml-auto inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-[10px] font-semibold text-primary-foreground"
                                  data-testid="session-block-sections-count">
                                @VisibleSections.Count
                            </span>
                            <button type="button"
                                    data-testid="session-block-right-sidebar-close"
                                    class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                    title="@L("CloseSections")"
                                    aria-label="@L("CloseSections")"
                                    @onclick="CloseRightSidebarAsync">
                                <Icon Name="panel-right-close" Size="14" />
                            </button>
                        </header>
                        <div class="min-h-0 flex-1 overflow-y-auto py-1"
                             data-slot="session-block-section-links">
                            @if (VisibleSections.Count == 0)
                            {
                                <div class="px-3 py-3 text-xs text-muted-foreground">
                                    @L("NoSections")
                                </div>
                            }
                            else
                            {
                                @foreach (var section in VisibleSections)
                                {
                                    <button type="button"
                                            class="group flex min-h-8 w-full items-center gap-2 px-3 py-1 text-left text-sm font-normal text-foreground transition-colors hover:bg-muted/60"
                                            data-testid="session-block-section-link"
                                            data-section-id="@section.Id"
                                            @onclick="() => ScrollSectionIntoViewAsync(section.Id)">
                                        <span class="min-w-0 flex-1 truncate">@section.Label</span>
                                        <span class="shrink-0 text-[10px] text-muted-foreground">@section.Kind</span>
                                    </button>
                                }
                            }
                        </div>
                        <footer class="flex shrink-0 justify-start p-2">
                            <button type="button"
                                    data-testid="session-block-command-bar-toggle"
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-border bg-background text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                    title="@L("ToggleCommandBar")"
                                    @onclick="ToggleCommandBarAsync">
                                <Icon Name="terminal" Size="12" />
                            </button>
                        </footer>
                        </section>
                    </div>
                </aside>
            </ResizablePanel>
            }
        </Resizable>
    }

    @if (AppOverlayBlock is { } appOverlayBlock)
    {
        <SessionContextBlock Block="appOverlayBlock"
                             Mode="@SessionContextBlock.ModeOverlayApp"
                             IsPinned="@IsBlockPinned(appOverlayBlock)"
                             PageOverlayContainerClass="@PageOverlayContainerClass"
                             AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                             HostHandlesPageOverlay="true"
                             OnIntentSelected="HandleNodeIntentSelectedAsync"
                             OnUnpin="@(() => UnpinBlockAsync(appOverlayBlock))"
                             ModeChanged="@(mode => HandleBlockModeChangedAsync(appOverlayBlock, mode))" />
    }
    else if (AppOverlayCommand is { } appOverlayCommand)
    {
        <SessionCard Node="CreateResponseNode(appOverlayCommand)"
                     Initials="RS"
                     Mode="@SessionContextBlock.ModeOverlayApp"
                     Status="@GetResponseStatus(appOverlayCommand)"
                     StatusVariant="@GetResponseStatusVariant(appOverlayCommand)"
                     PageOverlayContainerClass="@PageOverlayContainerClass"
                     AppOverlayContainerClass="@EffectiveAppOverlayContainerClass"
                     HostHandlesPageOverlay="true"
                     ModeChanged="@(mode => HandleCommandModeChangedAsync(appOverlayCommand, mode))">
            <div class="space-y-2">
                <p class="rounded-md border border-border bg-background px-2 py-1.5 text-xs text-muted-foreground"
                   data-slot="session-turn-prompt">
                    @appOverlayCommand.Input
                </p>
                <SessionMarkdown data-slot="session-turn-response-text"
                                 data-streaming="@appOverlayCommand.IsStreaming.ToString().ToLowerInvariant()"
                                 IsStreaming="@appOverlayCommand.IsStreaming"
                                 Value="@CreateResponseDescription(appOverlayCommand)" />
            </div>
        </SessionCard>
    }

    <SessionAddToListDialog @bind-IsOpen="_showAddToListDialog"
                            Node="_addToListNode ?? new SessionNodeInput(string.Empty, string.Empty, string.Empty)"
                            Lists="_addToListCandidates"
                            MemberListIds="_addToListMemberIds"
                            OnConfirm="ConfirmAddToListAsync"
                            OnCancel="CancelAddToListAsync" />
</div>
