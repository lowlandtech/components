@namespace LowlandTech.Components.Blocks
@inherits TinyComponentBase

<div class="@GetClass()" data-slot="register-panel" @attributes="AdditionalAttributes">
    <div class="mx-auto max-w-sm space-y-6">
        <div class="space-y-2 text-center">
            <h1 class="text-2xl font-bold">@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="text-muted-foreground">@Subtitle</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="rounded-md bg-destructive/15 p-3 text-sm text-destructive" data-testid="register-panel-error">
                @ErrorMessage
            </div>
        }
        <EditForm Model="@_credentials" OnSubmit="HandleSubmit" class="space-y-4">
            <div class="space-y-2">
                <Label For="reg-name">Full name</Label>
                <InputText id="reg-name" type="text" @bind-Value="_credentials.Name" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50" />
            </div>
            <div class="space-y-2">
                <Label For="reg-email">Email</Label>
                <InputText id="reg-email" type="email" @bind-Value="_credentials.Email" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50" />
            </div>
            <div class="space-y-2">
                <Label For="reg-password">Password</Label>
                <InputText id="reg-password" type="password" @bind-Value="_credentials.Password" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50" />
            </div>
            <Button Variant="@ButtonVariant.Default" class="w-full" type="submit">@SubmitText</Button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Create account";
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string SubmitText { get; set; } = "Create account";
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public EventCallback<RegisterCredentials> OnSubmit { get; set; }

    private RegisterCredentials _credentials = new();

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(_credentials);
    }

    private string GetClass()
    {
        var parts = new[] { "py-16 md:py-24", Class ?? string.Empty };
        return string.Join(" ", parts.Where(p => !string.IsNullOrEmpty(p)));
    }

    public record RegisterCredentials
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
