@namespace LowlandTech.Components.Blocks
@inherits TinyComponentBase

<div class="@GetClass()" data-slot="forgot-password-panel" @attributes="AdditionalAttributes">
    <div class="mx-auto max-w-sm space-y-6">
        <div class="space-y-2 text-center">
            <h1 class="text-2xl font-bold">@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="text-muted-foreground">@Subtitle</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="rounded-md bg-green-50 p-3 text-sm text-green-700" data-testid="forgot-password-success">
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="rounded-md bg-destructive/15 p-3 text-sm text-destructive" data-testid="forgot-password-error">
                @ErrorMessage
            </div>
        }
        <EditForm Model="@_model" OnSubmit="HandleSubmit" class="space-y-4">
            <div class="space-y-2">
                <Label For="fp-email">Email</Label>
                <InputText id="fp-email" type="email" @bind-Value="_model.Email" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50" />
            </div>
            <Button Variant="@ButtonVariant.Default" class="w-full" type="submit">@SubmitText</Button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Reset password";
    [Parameter] public string Subtitle { get; set; } = "Enter your email and we'll send you a reset link.";
    [Parameter] public string SubmitText { get; set; } = "Send reset link";
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public string SuccessMessage { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSubmit { get; set; }

    private ResetModel _model = new();

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(_model.Email);
    }

    private string GetClass()
    {
        var parts = new[] { "py-16 md:py-24", Class ?? string.Empty };
        return string.Join(" ", parts.Where(p => !string.IsNullOrEmpty(p)));
    }

    public class ResetModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
