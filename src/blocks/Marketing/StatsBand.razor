@namespace LowlandTech.Components.Blocks
@inherits TinyComponentBase

<section class="@GetClass()" data-slot="stats-band" @attributes="AdditionalAttributes">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        @if (!string.IsNullOrEmpty(Title))
        {
            <h2 class="text-2xl font-bold tracking-tight text-center mb-10">@Title</h2>
        }
        <div class="grid gap-8 @GetGridClass()">
            @foreach (var stat in Stats)
            {
                <div class="flex flex-col items-center text-center gap-2" data-testid="stats-band-item">
                    <span class="text-3xl sm:text-4xl font-bold tracking-tight">@stat.Value</span>
                    <span class="text-sm text-muted-foreground">@stat.Label</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<StatItem> Stats { get; set; } = [];
    [Parameter] public int? Columns { get; set; }

    private string GetClass()
    {
        var parts = new[] { "py-12 md:py-16", Class ?? string.Empty };
        return string.Join(" ", parts.Where(p => !string.IsNullOrEmpty(p)));
    }

    private string GetGridClass()
    {
        var cols = Columns ?? Math.Min(Stats.Count, 4);
        return cols switch
        {
            1 => "grid-cols-1",
            2 => "grid-cols-1 sm:grid-cols-2",
            3 => "grid-cols-1 sm:grid-cols-3",
            _ => "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
        };
    }

    public record StatItem(string Value, string Label);
}
