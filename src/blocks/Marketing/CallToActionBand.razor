@namespace LowlandTech.Components.Blocks
@inherits TinyComponentBase

<section class="@GetClass()" data-slot="cta-band" @attributes="AdditionalAttributes">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="space-y-6">
            @if (!string.IsNullOrEmpty(Overline))
            {
                <p class="text-sm font-medium text-muted-foreground tracking-wider uppercase">@Overline</p>
            }
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
                @Title
            </h2>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
                    @Subtitle
                </p>
            }
            @if (ChildContent is not null)
            {
                <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
                    @ChildContent
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string Overline { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;

    private string GetClass()
    {
        var parts = new[] { "py-16 md:py-20", Class ?? string.Empty };
        return string.Join(" ", parts.Where(p => !string.IsNullOrEmpty(p)));
    }
}
