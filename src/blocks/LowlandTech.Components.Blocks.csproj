<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>LowlandTech.Components.Blocks</PackageId>
    <Description>Reusable UI block library for the Foundry platform.</Description>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <!-- The resources of this package are embedded under two manifest names
         below, so the default glob is replaced by an explicit list. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.9" />
  </ItemGroup>

  <!--
    i18n: the manifest name of an embedded resource decides whether
    IStringLocalizer<T> resolves its strings.

    ResourceManagerStringLocalizerFactory asks for the full name of the type, so
    the resource of LowlandTech.Components.Blocks.SessionBlockStrings has to
    carry the manifest name
    "LowlandTech.Components.Blocks.SessionBlockStrings.resources".

    The name carries the namespace of the type and not the path of the file, so
    the LogicalName below names the type of the file and not the folder it sits
    in. The name of a culture resource carries its culture, because the
    ResourceManager looks a resource up in the satellite that carries the
    culture under the name of the resource with its culture, and the neutral
    resource of the type carries no culture at all.

    The English resource of every type is the neutral resource: it is named
    without a culture and the SDK embeds it in the assembly of the package
    itself, so a client that asks for a culture without a satellite of its own
    reads the English resource.

    A host that configures a resources path asks for another name: the path is
    inserted between the assembly and the type. The hosts of this workspace
    configure "Resources", so the package carries that name as well and no host
    style loses its labels.
  -->
  <ItemGroup>
    <ComponentsResource Include="Resources\**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Resources\**\*.resx" />
    <EmbeddedResource Include="@(ComponentsResource)">
      <LogicalName>$(AssemblyName).%(Filename).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The second copy of every resource carries the name a host asks for when it
    configures a resources path. It is a copy of the same file under its own
    path, because two embedded resources of one file cannot carry two manifest
    names: the SDK resolves one manifest name per file path.
  -->
  <Target Name="AddResourcesPathResources" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="@(ComponentsResource)"
          DestinationFiles="@(ComponentsResource->'$(IntermediateOutputPath)resources-path/%(Filename).resx')">
      <Output TaskParameter="CopiedFiles" ItemName="ComponentsResourceCopy" />
    </Copy>
    <ItemGroup>
      <EmbeddedResource Include="@(ComponentsResourceCopy)">
        <LogicalName>$(AssemblyName).Resources.%(Filename).resources</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\lib\LowlandTech.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="*.ncrunchproject" />
  </ItemGroup>

</Project>
