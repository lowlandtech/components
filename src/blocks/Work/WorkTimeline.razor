@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="work-timeline" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (History.Count == 0)
    {
        <div data-slot="work-timeline-empty" class="flex min-h-48 items-center justify-center rounded-lg border border-dashed border-border bg-card/40 px-6 py-10 text-center">
            <div class="flex max-w-sm flex-col items-center gap-2">
                <Icon Name="calendar" Size="28" Class="text-muted-foreground opacity-70" />
                <p class="text-sm font-semibold text-foreground">No timeline events yet</p>
                <p class="text-xs leading-relaxed text-muted-foreground">
                    State changes will appear here after this job is created, queued, processed, retried, or completed.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="relative">
            <div data-slot="work-timeline-line" class="absolute left-1.5 top-0 bottom-0 w-px bg-border"></div>
            @foreach (var entry in History.OrderBy(h => h.CreatedAt))
            {
                <div data-slot="work-timeline-item" class="relative mb-4 grid grid-cols-[0.75rem_minmax(0,1fr)] gap-3 last:mb-0">
                    <div class="relative flex items-center justify-center">
                        <div data-slot="work-timeline-dot" class="relative z-10 h-3 w-3 rounded-full border-2 bg-background @GetDotClass(entry.StateName)"></div>
                    </div>
                    <div data-slot="work-timeline-card" class="rounded-lg border bg-card p-3 shadow-sm">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-sm font-semibold @GetTextClass(entry.StateName)">@entry.StateName</span>
                            <span class="text-xs text-muted-foreground">@GetRelativeTime(entry.CreatedAt)</span>
                        </div>
                        @if (entry.DurationMs.HasValue)
                        {
                            <div class="mt-1 text-xs text-muted-foreground">
                                Duration: @(entry.DurationMs.Value)ms
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.Reason))
                        {
                            <div class="mt-2 text-xs text-muted-foreground">
                                @entry.Reason
                            </div>
                        }
                        @if (entry.Data is not null && entry.Data.Count > 0)
                        {
                            <div class="mt-2 overflow-x-auto rounded bg-muted/50 p-2">
                                <table class="text-xs">
                                    @foreach (var kvp in entry.Data)
                                    {
                                        <tr>
                                            <td class="pr-3 font-medium text-muted-foreground">@kvp.Key</td>
                                            <td class="font-mono text-foreground">@kvp.Value</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
