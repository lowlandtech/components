@namespace LowlandTech.Components
@inherits TinyComponentBase

<g data-slot="graph-node"
   transform="translate(@X, @Y)"
   data-design-mode="@DesignModeAttribute"
   data-design-selectable="@DesignSelectableAttribute"
   data-design-selected="@DesignSelectedAttribute"
   data-design-instance-id="@DesignInstanceIdAttribute"
   class="cn-graph-node @DesignModeClass"
   @attributes="AdditionalAttributes">
    <rect width="@Width" height="@Height" rx="6" class="@GetRectClass()" />
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <SvgText X="@(Width / 2)" Y="@(Height / 2 - 7)" Class="cn-graph-node-title">@Title</SvgText>
        <SvgText X="@(Width / 2)" Y="@(Height / 2 + 8)" Class="cn-graph-node-subtitle">@Subtitle</SvgText>
    }
    else
    {
        <SvgText X="@(Width / 2)" Y="@(Height / 2)" Class="cn-graph-node-title">@Title</SvgText>
    }
    @ChildContent
</g>
