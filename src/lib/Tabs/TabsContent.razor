@namespace LowlandTech.Components.Tabs
@inherits LtComponentBase

<div data-slot="tabs-content"
     data-state="@GetState()"
     data-orientation="@GetOrientation()"
     class="@GetClass()"
     role="tabpanel"
     id="@GetId()"
     aria-labelledby="@GetTriggerId()"
     tabindex="0"
     hidden="@(!IsActive)"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] private Tabs? Parent { get; set; }
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    
    private bool IsActive => Parent?.ActiveTab == Value;
    private string GetState() => IsActive ? "active" : "inactive";
    private string GetOrientation() => Parent?.Orientation ?? "horizontal";
    
    private string GetId() => $"tabs-content-{Value}";
    private string GetTriggerId() => $"tabs-trigger-{Value}";
    
    private string GetClass()
    {
        var baseClass = "cn-tabs-content mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
