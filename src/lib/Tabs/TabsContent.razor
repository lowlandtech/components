@namespace LowlandTech.Components
@inherits TinyComponentBase

@if (IsActive && !IsCollapsed)
{
    <div data-slot="tabs-content"
         data-state="@GetState()"
         data-orientation="@GetOrientation()"
         class="@GetClass()"
         role="tabpanel"
         id="@GetId()"
         aria-labelledby="@GetTriggerId()"
         tabindex="0"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private Tabs? Parent { get; set; }
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    
    private bool IsActive => Parent?.ActiveTab == Value;
    private bool IsCollapsed => Parent?.IsContentCollapsed == true;
    private string GetState() => IsActive ? "active" : "inactive";
    private string GetOrientation() => Parent?.EffectiveOrientation ?? "horizontal";
    
    private string GetId() => $"tabs-content-{Value}";
    private string GetTriggerId() => $"tabs-trigger-{Value}";
    
    private string GetClass()
    {
        var baseClass = "cn-tabs-content ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2";

        if (Parent?.HasGap == true)
        {
            baseClass += " " + Parent?.Placement switch
            {
                "bottom" => "mb-2",
                "left" => "ml-2",
                "right" => "mr-2",
                _ => "mt-2"
            };
        }

        if (Parent?.GapOutline == true)
        {
            baseClass += " border-l border-r border-border";
        }

        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
