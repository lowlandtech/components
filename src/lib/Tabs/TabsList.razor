@namespace LowlandTech.Components.Tabs
@inherits TinyComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (ShowScrollButtons && !IsVertical)
{
    <div data-slot="tabs-list-shell"
         data-orientation="@GetOrientation()"
         data-variant="@Variant"
         class="@GetShellClass()">
        @if (_isOverflowing)
        {
            <button data-slot="tabs-scroll-button"
                    data-direction="back"
                    type="button"
                    class="cn-tabs-scroll-button"
                    aria-label="Scroll tabs back"
                    @onclick="() => ScrollAsync(-1)">
                <Icon Paths="@Icons.ChevronLeft" Size="14" />
            </button>
        }

        <div data-slot="tabs-list-viewport" class="cn-tabs-list-viewport" @ref="_viewport">
            @RenderList()
        </div>

        @if (_isOverflowing)
        {
            <button data-slot="tabs-scroll-button"
                    data-direction="next"
                    type="button"
                    class="cn-tabs-scroll-button"
                    aria-label="Scroll tabs next"
                    @onclick="() => ScrollAsync(1)">
                <Icon Paths="@Icons.ChevronRight" Size="14" />
            </button>
        }
    </div>
}
else
{
    @RenderList()
}

@code {
    [CascadingParameter] private Tabs? Parent { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Align { get; set; } = "left";
    [Parameter] public bool Stretch { get; set; }
    [Parameter] public bool ShowScrollButtons { get; set; } = true;

    private ElementReference _viewport;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TabsList>? _dotNetRef;
    private bool _isOverflowing;
    
    private string GetOrientation() => Parent?.EffectiveOrientation ?? "horizontal";
    private bool IsVertical => GetOrientation() == "vertical";
    private string GetAlign() => Align.ToLowerInvariant() switch
    {
        "center" => "center",
        "right" or "end" => "right",
        _ => "left"
    };

    private RenderFragment RenderList() => @<CascadingValue Value="this">
        <div data-slot="tabs-list"
             data-orientation="@GetOrientation()"
             data-variant="@Variant"
             data-align="@GetAlign()"
             data-stretch="@Stretch.ToString().ToLowerInvariant()"
             class="@GetClass()"
             role="tablist"
             @onkeydown="HandleKeyDown"
             @attributes="AdditionalAttributes">
            @ChildContent
        </div>
    </CascadingValue>;

    private async Task ScrollAsync(int direction)
    {
        try
        {
            var module = await EnsureTabsModuleAsync();
            if (module is null)
                return;

            await module.InvokeVoidAsync("scrollBy", _viewport, direction * 180);
        }
        catch
        {
            // The buttons are progressive enhancement; overflow remains contained without JS.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ShowScrollButtons || IsVertical)
            return;

        try
        {
            var module = await EnsureTabsModuleAsync();
            if (module is null)
                return;

            _dotNetRef ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("observeOverflow", _viewport, _dotNetRef);
        }
        catch
        {
            // Server prerender/tests may not have JS; default to hidden controls.
        }
    }

    private async Task<IJSObjectReference?> EnsureTabsModuleAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/LowlandTech.Components/js/tabs.js");
        return _module;
    }

    [JSInvokable]
    public Task OnTabsOverflowChanged(bool isOverflowing)
    {
        if (_isOverflowing == isOverflowing)
            return Task.CompletedTask;

        _isOverflowing = isOverflowing;
        return InvokeAsync(StateHasChanged);
    }
    
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (Parent == null) return;
        
        var triggers = Parent.Triggers.Where(t => !t.Disabled).ToList();
        if (triggers.Count == 0) return;
        
        var currentIndex = Parent.FocusedTabIndex;
        var enabledIndices = Parent.Triggers
            .Select((t, i) => new { t, i })
            .Where(x => !x.t.Disabled)
            .Select(x => x.i)
            .ToList();
        
        var currentEnabledIndex = enabledIndices.IndexOf(currentIndex);
        if (currentEnabledIndex == -1) currentEnabledIndex = 0;
        
        switch (e.Key)
        {
            case "ArrowRight" when !IsVertical:
            case "ArrowDown" when IsVertical:
                var nextIndex = (currentEnabledIndex + 1) % enabledIndices.Count;
                Parent.FocusTab(enabledIndices[nextIndex]);
                break;
                
            case "ArrowLeft" when !IsVertical:
            case "ArrowUp" when IsVertical:
                var prevIndex = (currentEnabledIndex - 1 + enabledIndices.Count) % enabledIndices.Count;
                Parent.FocusTab(enabledIndices[prevIndex]);
                break;
                
            case "Home":
                if (enabledIndices.Count > 0)
                    Parent.FocusTab(enabledIndices[0]);
                break;
                
            case "End":
                if (enabledIndices.Count > 0)
                    Parent.FocusTab(enabledIndices[enabledIndices.Count - 1]);
                break;
                
            case "Enter":
            case " ":
                if (currentIndex >= 0 && currentIndex < Parent.Triggers.Count)
                {
                    var trigger = Parent.Triggers[currentIndex];
                    if (!trigger.Disabled)
                    {
                        Parent.ActivateTab(trigger.Value);
                    }
                }
                break;
        }
    }
    
    private string GetClass()
    {
        var isVertical = GetOrientation() == "vertical";
        var isLineVariant = IsVariant("line");
        var isIdeVariant = IsVariant("ide");

        var baseClass = isVertical
            ? "cn-tabs-list flex flex-col gap-1 p-1"
            : "cn-tabs-list inline-flex h-9 min-w-max items-center justify-start p-1 text-muted-foreground";

        if (!isVertical && Stretch)
            baseClass += " w-full";

        if (!isVertical)
            baseClass = baseClass.Replace("justify-start", GetJustifyClass());

        baseClass += isIdeVariant
            ? " cn-tabs-list-ide bg-transparent rounded-none gap-0 p-0 h-10"
            : isLineVariant
            ? (isVertical
                ? (Parent?.Placement == "right" ? " bg-transparent border-l rounded-none" : " bg-transparent border-r rounded-none")
                : " bg-transparent border-b rounded-none")
            : (isVertical ? " rounded-md bg-muted" : " rounded-lg bg-muted");

        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetJustifyClass() => GetAlign() switch
    {
        "center" => "justify-center",
        "right" => "justify-end",
        _ => "justify-start"
    };

    private string GetShellClass()
    {
        var baseClass = IsVariant("ide")
            ? "cn-tabs-list-shell flex w-full min-w-0 items-center"
            : "cn-tabs-list-shell flex w-full min-w-0 items-center gap-1";
        return IsVariant("ide") ? $"{baseClass} border-b bg-transparent" : baseClass;
    }

    private bool IsVariant(string value) =>
        string.Equals(Variant, value, StringComparison.OrdinalIgnoreCase);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unobserveOverflow", _viewport);
                await _module.DisposeAsync();
            }
            catch
            {
                // Ignore JS teardown races during component disposal.
            }
        }

        _dotNetRef?.Dispose();
    }
}
