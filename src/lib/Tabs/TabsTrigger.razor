@namespace LowlandTech.Components.Tabs
@inherits TinyComponentBase
@implements IDisposable

<div data-slot="tabs-trigger"
     data-state="@GetState()"
     data-orientation="@GetOrientation()"
     data-pinned="@Pinned.ToString().ToLowerInvariant()"
     data-closeable="@Closeable.ToString().ToLowerInvariant()"
     data-renameable="@Renameable.ToString().ToLowerInvariant()"
     disabled="@Disabled"
     class="@GetClass()"
     role="tab"
     id="@GetId()"
     tabindex="@GetTabIndex()"
     aria-selected="@IsActive.ToString().ToLower()"
     aria-disabled="@Disabled.ToString().ToLower()"
     aria-controls="@GetContentId()"
     draggable="@CanDrag.ToString().ToLowerInvariant()"
     @onclick="OnClick"
     @onkeydown="OnTriggerKeyDown"
     @ondblclick="BeginRename"
     @ondragstart="OnDragStart"
     @ondragover:preventDefault
     @ondrop="OnDrop"
     @attributes="AdditionalAttributes">
    @if (Pinnable || Pinned)
    {
        <button data-slot="tabs-pin-button"
                type="button"
                class="cn-tabs-trigger-action"
                aria-label="@GetPinLabel()"
                title="@GetPinLabel()"
                @onclick="OnPinClick"
                @onclick:stopPropagation>
            <Icon Paths="@Icons.Pin" Size="12" />
        </button>
    }

    @if (_isRenaming)
    {
        <input data-slot="tabs-rename-input"
               class="cn-tabs-rename-input"
               value="@_draftTitle"
               @onchange="OnRenameChanged"
               @onkeydown="OnRenameKeyDown"
               @onclick:stopPropagation />
    }
    else
    {
        <span data-slot="tabs-trigger-label" class="cn-tabs-trigger-label">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @DisplayTitle
            }
        </span>
    }

    @if (Closeable)
    {
        <button data-slot="tabs-close-button"
                type="button"
                class="cn-tabs-trigger-action"
                aria-label="@($"Close {DisplayTitle}")"
                title="@($"Close {DisplayTitle}")"
                @onclick="OnCloseClick"
                @onclick:stopPropagation>
            <Icon Paths="@Icons.X" Size="12" />
        </button>
    }
</div>

@code {
    [CascadingParameter] private Tabs? Parent { get; set; }
    [CascadingParameter] private TabsList? List { get; set; }
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Closeable { get; set; }
    [Parameter] public bool Pinned { get; set; }
    [Parameter] public bool Pinnable { get; set; }
    [Parameter] public bool Renameable { get; set; }
    [Parameter] public bool Draggable { get; set; }
    
    private bool IsActive => Parent?.ActiveTab == Value;
    private bool IsLineVariant => string.Equals(List?.Variant, "line", StringComparison.OrdinalIgnoreCase);
    private bool IsIdeVariant => string.Equals(List?.Variant, "ide", StringComparison.OrdinalIgnoreCase);
    private int TabIndex => Parent?.Triggers.IndexOf(this) ?? -1;
    private bool CanDrag => Draggable && !Disabled;
    private string DisplayTitle => string.IsNullOrWhiteSpace(Title) ? Value : Title!;
    private bool _isRenaming;
    private string _draftTitle = "";
    
    protected override void OnInitialized()
    {
        Parent?.RegisterTrigger(this);
    }
    
    public void Dispose()
    {
        Parent?.UnregisterTrigger(this);
    }
    
    private string GetState() => IsActive ? "active" : "inactive";
    private string GetOrientation() => Parent?.EffectiveOrientation ?? "horizontal";
    
    private string GetId() => $"tabs-trigger-{Value}";
    private string GetContentId() => $"tabs-content-{Value}";
    
    private int GetTabIndex()
    {
        if (Parent == null) return -1;
        // In automatic mode, the active tab is tabbable
        // In manual mode, the focused tab is tabbable
        if (Parent.KeyboardActivation == "automatic")
        {
            return IsActive ? 0 : -1;
        }
        else
        {
            return Parent.FocusedTabIndex == TabIndex ? 0 : -1;
        }
    }
    
    private void OnClick()
    {
        if (!Disabled)
            Parent?.ActivateTab(Value);
    }

    private void OnTriggerKeyDown(KeyboardEventArgs args)
    {
        if (!Disabled && (args.Key == "Enter" || args.Key == " "))
            Parent?.ActivateTab(Value);
    }

    private async Task OnCloseClick()
    {
        if (Parent is not null)
            await Parent.CloseTabAsync(Value);
    }

    private async Task OnPinClick()
    {
        if (Parent is not null)
            await Parent.TogglePinAsync(Value);
    }

    private void BeginRename()
    {
        if (Renameable && !Disabled)
        {
            _draftTitle = DisplayTitle;
            _isRenaming = true;
        }
    }

    private async Task OnRenameChanged(ChangeEventArgs args)
    {
        await CommitRenameAsync(args.Value?.ToString() ?? "");
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _isRenaming = false;
            return;
        }

        if (args.Key == "Enter")
            await CommitRenameAsync(_draftTitle);
    }

    private async Task CommitRenameAsync(string title)
    {
        _draftTitle = title;
        _isRenaming = false;
        if (Parent is not null)
            await Parent.RenameTabAsync(Value, title);
    }

    private void OnDragStart(DragEventArgs _)
    {
        if (CanDrag)
            Parent?.BeginDrag(Value);
    }

    private async Task OnDrop(DragEventArgs _)
    {
        if (CanDrag && Parent is not null)
            await Parent.DropOnTabAsync(Value);
    }

    private string GetPinLabel() => Pinned ? $"Unpin {DisplayTitle}" : $"Pin {DisplayTitle}";
    
    private string GetClass()
    {
        var isVertical = GetOrientation() == "vertical";
        var isLineVariant = IsLineVariant;
        var isIdeVariant = IsIdeVariant;
        
        var baseClass = isVertical
            ? "cn-tabs-trigger inline-flex cursor-default items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
            : "cn-tabs-trigger inline-flex cursor-default items-center justify-center whitespace-nowrap rounded-md px-3 py-1 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50";
        if (isIdeVariant)
            baseClass = "cn-tabs-trigger cn-tabs-trigger-ide inline-flex h-10 min-w-0 max-w-56 cursor-default items-center gap-1 whitespace-nowrap border-r border-border px-2 text-sm text-muted-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50";
        
        // For line variant, the active indicator is a primary-coloured bottom border
        // that sits flush with the TabsList's own `border-b`. `-mb-px` pulls the
        // trigger 1px down so its 2px border visually punches through the list's
        // 1px border at the active tab's position — the classic shadcn line-tab
        // pattern. `rounded-none` overrides the trigger base's `rounded-md` so
        // the bottom border draws a straight line, not rounded corners.
        if (IsActive && !isLineVariant)
            baseClass += isVertical
                ? " bg-background text-foreground shadow-sm"
                : " bg-background text-foreground shadow";
        else if (IsActive && isLineVariant)
        {
            if (isVertical)
            {
                var isRight = Parent?.Placement == "right";
                baseClass += isRight
                    ? " text-foreground border-l-2 border-primary -ml-px rounded-none"
                    : " text-foreground border-r-2 border-primary -mr-px rounded-none";
            }
            else
            {
                baseClass += " text-foreground border-b-2 border-primary -mb-px rounded-none";
            }
        }
        else if (IsActive && isIdeVariant)
            baseClass += " bg-background text-foreground border-t-2 border-t-primary";
        
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
