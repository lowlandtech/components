@namespace LowlandTech.Components.Tabs
@inherits TinyComponentBase

<CascadingValue Value="this">
    <div data-slot="tabs"
         data-placement="@Placement"
         data-orientation="@EffectiveOrientation"
         data-activation="@KeyboardActivation"
         data-tabs-mode="@(HasItems ? "dynamic" : "static")"
         data-design-mode="@DesignModeAttribute"
         data-design-selectable="@DesignSelectableAttribute"
         data-design-selected="@DesignSelectedAttribute"
         data-design-instance-id="@DesignInstanceIdAttribute"
         class="@GetClass()"
         style="@GetStyle()"
         @attributes="AdditionalAttributes">
        @if (HasItems)
        {
            <div data-slot="tabs-header" class="flex min-w-0 items-center @(HeaderLeading is null ? "gap-1" : null)">
                @if (HeaderLeading is not null)
                {
                    <div data-slot="tabs-header-leading" class="shrink-0">
                        @HeaderLeading
                    </div>
                }

                <TabsList Variant="@DynamicVariant"
                          Align="@DynamicListAlign"
                          Stretch="@DynamicListStretch"
                          ShowScrollButtons="@ShowScrollButtons"
                          Class="min-w-0 flex-1">
                    @foreach (var item in OrderedItems)
                    {
                        <TabsTrigger Value="@item.Value"
                                     Title="@item.Title"
                                     Disabled="@item.Disabled"
                                     Closeable="@item.Closeable"
                                     Pinned="@item.Pinned"
                                     Pinnable="@item.Pinnable"
                                     Renameable="@item.Renameable"
                                     Draggable="@item.Draggable" />
                    }
                </TabsList>

                @if (CanToggleContent)
                {
                    <button data-slot="tabs-collapse-button"
                            type="button"
                            class="cn-tabs-collapse-button inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                            aria-label="@CollapseButtonLabel"
                            aria-expanded="@((!IsContentCollapsed).ToString().ToLowerInvariant())"
                            title="@CollapseButtonLabel"
                            @onclick="ToggleContent">
                        <Icon Paths="@CollapseButtonIcon" Size="14" />
                    </button>
                }
            </div>

            @foreach (var item in OrderedItems)
            {
                <TabsContent Value="@item.Value" Class="@ContentClass">
                    @if (ItemContent is not null)
                    {
                        @ItemContent(item)
                    }
                </TabsContent>
            }
        }

        @ChildContent
    </div>
</CascadingValue>

@code {
    internal string EffectiveOrientation => Placement != "top"
        ? Placement switch { "left" or "right" => "vertical", _ => "horizontal" }
        : Orientation;

    internal string? ActiveTab { get; set; }
    internal bool IsContentCollapsed { get; private set; }
    internal int FocusedTabIndex { get; set; } = -1;
    internal List<TabsTrigger> Triggers { get; } = new();
    internal string? DraggedTabValue { get; private set; }
    private string? _appliedCollapsableMode;
    private bool _initialCollapsedApplied;
    private bool HasItems => Items is { Count: > 0 };
    private bool CanToggleContent => !string.IsNullOrWhiteSpace(IsCollapsable);
    private string CollapseButtonLabel => IsContentCollapsed ? "Expand" : "Collapse";
    private string CollapseButtonIcon => IsContentCollapsed
        ? """<path d="m9 18 6-6-6-6"/>"""
        : """<path d="m6 9 6 6 6-6"/>""";
    private IReadOnlyList<TabsItem> OrderedItems => Items is null
        ? []
        : [.. Items
            .Select((item, index) => new { item, index })
            .OrderByDescending(x => x.item.Pinned)
            .ThenBy(x => x.index)
            .Select(x => x.item)];
    
    protected override void OnInitialized()
    {
        base.OnInitialized();
        ActiveTab = ResolveActiveValue();
        ApplyCollapsableMode();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ActiveTab = ResolveActiveValue();
        ApplyCollapsableMode();

        if (!_initialCollapsedApplied && InitialIsContentCollapsed.HasValue)
        {
            _initialCollapsedApplied = true;
            IsContentCollapsed = InitialIsContentCollapsed.Value;
        }
    }

    private void ApplyCollapsableMode()
    {
        var mode = NormalizeCollapsableMode();
        if (mode == _appliedCollapsableMode)
            return;

        _appliedCollapsableMode = mode;
        if (!IsContentCollapsedChanged.HasDelegate)
            IsContentCollapsed = mode == "startclosed";
    }

    private string? NormalizeCollapsableMode()
    {
        if (string.IsNullOrWhiteSpace(IsCollapsable))
            return null;

        return IsCollapsable.Trim().ToLowerInvariant() switch
        {
            "startclosed" => "startclosed",
            "startopen" => "startopen",
            _ => "startopen"
        };
    }

    private void ToggleContent()
    {
        if (!CanToggleContent)
            return;

        IsContentCollapsed = !IsContentCollapsed;
        if (IsContentCollapsedChanged.HasDelegate)
            _ = IsContentCollapsedChanged.InvokeAsync(IsContentCollapsed);
    }

    private string? ResolveActiveValue()
    {
        if (!string.IsNullOrEmpty(Value))
            return Value;
        if (!string.IsNullOrEmpty(DefaultValue))
            return DefaultValue;
        return OrderedItems.FirstOrDefault(x => !x.Disabled)?.Value;
    }
    
    internal void RegisterTrigger(TabsTrigger trigger)
    {
        if (!Triggers.Contains(trigger))
        {
            Triggers.Add(trigger);
            if (FocusedTabIndex == -1 && trigger.Value == ActiveTab)
            {
                FocusedTabIndex = Triggers.Count - 1;
            }
        }
    }
    
    internal void UnregisterTrigger(TabsTrigger trigger)
    {
        Triggers.Remove(trigger);
    }
    
    internal void ActivateTab(string value)
    {
        ActiveTab = value;
        var index = Triggers.FindIndex(t => t.Value == value);
        if (index >= 0)
        {
            FocusedTabIndex = index;
        }
        if (ValueChanged.HasDelegate)
            _ = ValueChanged.InvokeAsync(value);
        StateHasChanged();
    }

    internal async Task CloseTabAsync(string value)
    {
        if (Items is null)
            return;

        var item = Items.FirstOrDefault(x => x.Value == value);
        if (item is null || !item.Closeable)
            return;

        var oldItems = Items.ToList();
        var nextItems = oldItems.Where(x => x.Value != value).ToList();
        if (ActiveTab == value)
        {
            var oldIndex = oldItems.FindIndex(x => x.Value == value);
            var nextActive = nextItems.Skip(Math.Max(0, oldIndex - 1)).FirstOrDefault(x => !x.Disabled)
                ?? nextItems.LastOrDefault(x => !x.Disabled);
            ActiveTab = nextActive?.Value;
            await ValueChanged.InvokeAsync(ActiveTab);
        }

        await ItemsChanged.InvokeAsync(nextItems);
        await TabClosed.InvokeAsync(item);
        StateHasChanged();
    }

    internal async Task TogglePinAsync(string value)
    {
        if (Items is null)
            return;

        var item = Items.FirstOrDefault(x => x.Value == value);
        if (item is null || !item.Pinnable)
            return;

        var updated = item with { Pinned = !item.Pinned };
        var nextItems = Items.Select(x => x.Value == value ? updated : x).ToList();
        await ItemsChanged.InvokeAsync(nextItems);
        await TabPinnedChanged.InvokeAsync(updated);
        StateHasChanged();
    }

    internal async Task RenameTabAsync(string value, string title)
    {
        if (Items is null)
            return;

        var item = Items.FirstOrDefault(x => x.Value == value);
        if (item is null || !item.Renameable)
            return;

        var trimmedTitle = title.Trim();
        if (string.IsNullOrEmpty(trimmedTitle) || trimmedTitle == item.Title)
            return;

        var updated = item with { Title = trimmedTitle };
        var nextItems = Items.Select(x => x.Value == value ? updated : x).ToList();
        await ItemsChanged.InvokeAsync(nextItems);
        await TabRenamed.InvokeAsync(new TabsRenameEventArgs(value, item.Title, trimmedTitle));
        StateHasChanged();
    }

    internal void BeginDrag(string value)
    {
        DraggedTabValue = value;
    }

    internal async Task DropOnTabAsync(string targetValue)
    {
        if (Items is null || string.IsNullOrEmpty(DraggedTabValue) || DraggedTabValue == targetValue)
            return;

        var nextItems = Items.ToList();
        var oldIndex = nextItems.FindIndex(x => x.Value == DraggedTabValue);
        var newIndex = nextItems.FindIndex(x => x.Value == targetValue);
        if (oldIndex < 0 || newIndex < 0)
            return;

        var dragged = nextItems[oldIndex];
        nextItems.RemoveAt(oldIndex);
        if (oldIndex < newIndex)
            newIndex--;
        nextItems.Insert(newIndex, dragged);

        await ItemsChanged.InvokeAsync(nextItems);
        await TabReordered.InvokeAsync(new TabsReorderEventArgs(dragged.Value, targetValue, oldIndex, newIndex));
        DraggedTabValue = null;
        StateHasChanged();
    }
    
    internal void FocusTab(int index)
    {
        if (index >= 0 && index < Triggers.Count)
        {
            FocusedTabIndex = index;
            if (KeyboardActivation == "automatic")
            {
                var trigger = Triggers[index];
                if (!trigger.Disabled)
                {
                    ActivateTab(trigger.Value);
                }
            }
            StateHasChanged();
        }
    }
    
    private string GetClass()
    {
        var baseClass = Placement switch
        {
            "bottom" => "cn-tabs flex flex-col-reverse",
            "left" => "cn-tabs flex flex-row",
            "right" => "cn-tabs flex flex-row-reverse",
            _ => "cn-tabs flex flex-col"
        };
        var result = string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
        return $"{result} {DesignModeClass}".Trim();
    }

    private string? GetStyle()
    {
        var gapSize = ResolveGapSize();
        return string.IsNullOrWhiteSpace(gapSize) ? null : $"gap: {gapSize};";
    }

    private string? ResolveGapSize()
    {
        if (!string.IsNullOrWhiteSpace(GapSize))
            return GapSize;

        return HasGap ? "10px" : null;
    }
}
