@namespace LowlandTech.Components.Command
@inherits LtComponentBase

<div data-slot="command-group" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Heading))
    {
        <div class="px-3 py-2 text-xs font-medium text-muted-foreground">@Heading</div>
    }
    <div class="px-1">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Heading { get; set; }

    private string GetClass()
    {
        var baseClass = "overflow-hidden text-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
