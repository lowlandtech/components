@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="command-list" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "max-h-[340px] scroll-py-2 overflow-x-hidden overflow-y-auto overscroll-contain";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
