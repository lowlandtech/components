@namespace LowlandTech.Components.Command
@inherits LtComponentBase

<div data-slot="command" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "flex flex-col bg-popover text-popover-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
