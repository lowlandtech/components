@namespace LowlandTech.Components.Command
@inherits TinyComponentBase

<div data-slot="command-empty" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        <span>No results found.</span>
    }
</div>

@code {
    private string GetClass()
    {
        var baseClass = "py-6 text-center text-sm";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
