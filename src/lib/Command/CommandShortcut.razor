@namespace LowlandTech.Components.Command
@inherits LtComponentBase

<span data-slot="command-shortcut" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private string GetClass()
    {
        var baseClass = "ml-auto text-xs tracking-widest text-muted-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
