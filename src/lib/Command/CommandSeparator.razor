@namespace LowlandTech.Components.Command
@inherits LtComponentBase

<div data-slot="command-separator" class="@GetClass()" @attributes="AdditionalAttributes">
</div>

@code {
    private string GetClass()
    {
        var baseClass = "h-px bg-border mx-3 my-1";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
