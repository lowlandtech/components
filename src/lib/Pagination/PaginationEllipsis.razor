@namespace LowlandTech.Components.Pagination
@inherits TinyComponentBase

<span data-slot="pagination-ellipsis"
      aria-hidden="true"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /><circle cx="5" cy="12" r="1" />
    </svg>
    <span class="sr-only">More pages</span>
</span>

@code {
    private string GetClass()
    {
        var baseClass = "cn-pagination-ellipsis flex items-center justify-center";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
