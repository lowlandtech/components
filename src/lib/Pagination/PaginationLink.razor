@namespace LowlandTech.Components.Pagination
@inherits LtComponentBase

<a data-slot="pagination-link"
   data-active="@(IsActive ? "true" : null)"
   aria-current="@(IsActive ? "page" : null)"
   class="@GetClass()"
   @onclick="OnClick"
   @onclick:preventDefault
   @attributes="AdditionalAttributes">
    @ChildContent
</a>

@code {
    [CascadingParameter] private Pagination? Parent { get; set; }
    
    /// <summary>
    /// Whether this is the active page.
    /// </summary>
    [Parameter] public bool IsActive { get; set; }
    
    /// <summary>
    /// The page number this link represents (for page number links).
    /// </summary>
    [Parameter] public int? Page { get; set; }
    
    /// <summary>
    /// Whether this is a previous page link.
    /// </summary>
    [Parameter] public bool IsPrevious { get; set; }
    
    /// <summary>
    /// Whether this is a next page link.
    /// </summary>
    [Parameter] public bool IsNext { get; set; }
    
    private async Task OnClick()
    {
        if (Parent == null) return;
        
        if (IsPrevious)
        {
            await Parent.GoToPrevious();
        }
        else if (IsNext)
        {
            await Parent.GoToNext();
        }
        else if (Page.HasValue)
        {
            await Parent.GoToPage(Page.Value);
        }
    }
    
    private string GetClass()
    {
        var baseClass = IsActive
            ? "cn-pagination-link inline-flex items-center justify-center rounded-md border border-input bg-background px-3 py-2 text-sm font-medium cursor-pointer"
            : "cn-pagination-link inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium hover:bg-accent cursor-pointer";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
