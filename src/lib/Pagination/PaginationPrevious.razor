@namespace LowlandTech.Components
@inherits TinyComponentBase

<a data-slot="pagination-previous"
   aria-label="Go to previous page"
   class="@GetClass()"
   @onclick="OnClick"
   @onclick:preventDefault
   @attributes="AdditionalAttributes">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="inline-start" class="cn-rtl-flip mr-2">
        <path d="m15 18-6-6 6-6" />
    </svg>
    <span class="cn-pagination-previous-text hidden sm:block">@Text</span>
</a>

@code {
    [CascadingParameter] private Pagination? Parent { get; set; }
    
    /// <summary>
    /// The text to display.
    /// </summary>
    [Parameter] public string Text { get; set; } = "Previous";
    
    private async Task OnClick()
    {
        if (Parent != null)
        {
            await Parent.GoToPrevious();
        }
    }
    
    private string GetClass()
    {
        var baseClass = "cn-pagination-previous inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium hover:bg-accent cursor-pointer";
        if (Parent?.Page <= 1)
        {
            baseClass += " pointer-events-none opacity-50";
        }
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
