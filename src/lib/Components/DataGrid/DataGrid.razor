@namespace LowlandTech.Components.Components.DataGrid
@typeparam TItem
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<CascadingValue Value="this" IsFixed="false">
    @if (Columns != null)
    {
        @Columns
    }
    @if (ChildContent != null)
    {
        @ChildContent
    }

    @if (HeaderTemplate != null)
    {
        @HeaderTemplate
    }

    @if (Data != null && Data.Any())
    {
        @if (AllowPaging && (PagerPosition == PagerPosition.Top || PagerPosition == PagerPosition.TopAndBottom))
        {
            @RenderPager()
        }

        <table class="@GetTableClasses()" @attributes="AdditionalAttributes">
            <thead>
                <tr>
                    @if (ShowSelectColumn && SelectionMode == SelectionMode.Multiple)
                    {
                        <th class="select-column">
                            <input type="checkbox" checked="@AreAllRowsSelected()" @onchange="HandleSelectAllChange" />
                        </th>
                    }
                    @foreach (var column in _columns)
                    {
                        <th class="@column.GetAlignmentClass()" @onclick="@(e => HandleHeaderClick(column, e))">
                            @column.Title
                            @if (AllowSorting && column.Sortable)
                            {
                                var sortDir = GetColumnSortDirection(column);
                                var sortPriority = GetColumnSortPriority(column);
                                <span class="sort-indicator" data-sort-direction="@sortDir.ToString().ToLower()">
                                    @if (sortDir == SortDirection.Ascending)
                                    {
                                        <text>▲</text>
                                    }
                                    else if (sortDir == SortDirection.Descending)
                                    {
                                        <text>▼</text>
                                    }
                                    @if (AllowMultiColumnSorting && sortPriority > 0 && _sortDescriptors.Count > 1)
                                    {
                                        <span class="sort-priority">@sortPriority</span>
                                    }
                                </span>
                            }
                        </th>
                    }
                </tr>
                @if (AllowFiltering && FilterMode == FilterMode.Simple)
                {
                    <tr class="filter-row">
                        @if (ShowSelectColumn && SelectionMode == SelectionMode.Multiple)
                        {
                            <th class="select-column"></th>
                        }
                        @foreach (var column in _columns)
                        {
                            <th class="@column.GetAlignmentClass()">
                                @if (column.Filterable && !string.IsNullOrEmpty(column.Property))
                                {
                                    <input type="text" 
                                           class="filter-input" 
                                           placeholder="Filter..." 
                                           @onchange="@(e => HandleFilterChange(column.Property!, e))" />
                                }
                            </th>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                @foreach (var item in GetPagedData())
                {
                    <tr class="@GetRowClass(item)" @onclick="@(() => HandleRowClick(item))">
                        @if (ShowSelectColumn && SelectionMode == SelectionMode.Multiple)
                        {
                            <td class="select-column">
                                <input type="checkbox" checked="@IsRowSelected(item)" @onchange="@(e => HandleCheckboxChange(item, e))" @onclick:stopPropagation />
                            </td>
                        }
                        @foreach (var column in _columns)
                        {
                            <td class="@column.GetAlignmentClass()">
                                @if (column.Template != null)
                                {
                                    @column.Template(item)
                                }
                                else
                                {
                                    @column.GetValue(item)
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (AllowPaging && (PagerPosition == PagerPosition.Bottom || PagerPosition == PagerPosition.TopAndBottom))
        {
            @RenderPager()
        }
    }
    else
    {
        <div class="@GetEmptyStateClasses()">
            @if (EmptyTemplate != null)
            {
                @EmptyTemplate
            }
            else
            {
                <p>No data available</p>
            }
        </div>
    }
</CascadingValue>
