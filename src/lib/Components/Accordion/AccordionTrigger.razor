@namespace LowlandTech.Components.Components.Accordion
@inherits ComponentBase

<button type="button"
        class="accordion-trigger"
        disabled="ParentItem?.Disabled"
        @onclick="HandleClick">
    @ChildContent
    <svg class="accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6" />
    </svg>
</button>
