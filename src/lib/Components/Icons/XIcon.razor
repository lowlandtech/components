@namespace LowlandTech.Components.Components.Icons

<svg xmlns="http://www.w3.org/2000/svg" width="@Width" height="@Height" viewBox="0 0 24 24" fill="none" stroke="@Stroke" stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" class="@Class">
  <path d="M18 6 6 18"></path>
  <path d="m6 6 12 12"></path>
</svg>

@code {
    [Parameter]
