@namespace LowlandTech.Components.Components.Select

<button type="button" 
        class="@GetClasses()" 
        @onclick="HandleClick"
        disabled="@IsDisabled"
        @attributes="AdditionalAttributes">
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        <span>@DisplayValue</span>
    }
    <svg xmlns="http://www.w3.org/2000/svg" 
         width="16" 
         height="16" 
         viewBox="0 0 24 24" 
         fill="none" 
         stroke="currentColor" 
         stroke-width="2" 
         stroke-linecap="round" 
         stroke-linejoin="round"
         class="select-trigger-icon">
        <path d="m6 9 6 6 6-6"/>
    </svg>
</button>
