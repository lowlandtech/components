@namespace LowlandTech.Components.Components.Sidebar
@using Microsoft.AspNetCore.Components
@using LowlandTech.Components.Separator

<Separator data-slot="sidebar-separator"
           data-sidebar="separator"
           Class="@Classes"
           AdditionalAttributes="@AdditionalAttributes" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string Classes => LowlandTech.Components.Utilities.CssClassUtils.Merge(
        "bg-sidebar-border",
        "mx-2",
        "w-auto",
        Class
    );
}
