@namespace LowlandTech.Components.Components.Sidebar
@using Microsoft.AspNetCore.Components

<button data-slot="sidebar-menu-action"
        data-sidebar="menu-action"
        type="button"
        class="@Classes"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public bool ShowOnHover { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string Classes
    {
        get
        {
            var baseClasses = LowlandTech.Components.Utilities.CssClassUtils.Merge(
                "text-sidebar-foreground",
                "ring-sidebar-ring",
                "hover:bg-sidebar-accent",
                "hover:text-sidebar-accent-foreground",
                "peer-hover/menu-button:text-sidebar-accent-foreground",
                "absolute",
                "top-1.5",
                "right-1",
                "flex",
                "aspect-square",
                "w-5",
                "items-center",
                "justify-center",
                "rounded-md",
                "p-0",
                "outline-hidden",
                "transition-transform",
                "group-data-[collapsible=icon]:hidden",
                "peer-data-[size=default]/menu-button:top-1.5",
                "peer-data-[size=lg]/menu-button:top-2.5",
                "peer-data-[size=sm]/menu-button:top-1",
                "after:absolute",
                "after:-inset-2",
                "focus-visible:ring-2",
                "md:after:hidden",
                "[&>svg]:size-4",
                "[&>svg]:shrink-0"
            );

            var hoverClasses = ShowOnHover
                ? LowlandTech.Components.Utilities.CssClassUtils.Merge(
                    "peer-data-active/menu-button:text-sidebar-accent-foreground",
                    "group-focus-within/menu-item:opacity-100",
                    "group-hover/menu-item:opacity-100",
                    "aria-expanded:opacity-100",
                    "md:opacity-0"
                )
                : null;

            return LowlandTech.Components.Utilities.CssClassUtils.Merge(baseClasses, hoverClasses, Class);
        }
    }
}
