@namespace LowlandTech.Components.Sidebar
@inherits LtComponentBase

<button data-slot="sidebar-menu-sub-trigger"
        type="button"
        aria-expanded="@(IsExpanded.ToString().ToLowerInvariant())"
        class="sidebar-menu-sub-trigger @Class"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg"
         width="24"
         height="24"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         class="sidebar-menu-sub-trigger-chevron @(IsExpanded ? "rotated" : "")"
         aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
</button>
