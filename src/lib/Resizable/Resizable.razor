@namespace LowlandTech.Components
@inherits TinyComponentBase
@inject IJSRuntime JS

<CascadingValue Value="this">
    <div data-slot="resizable-panel-group"
         data-orientation="@Direction"
         class="@GetClass()"
         @ref="_element"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public string Direction { get; set; } = "horizontal";

    /// <summary>
    /// Key used to persist panel sizes to localStorage. When set, sizes survive reloads.
    /// </summary>
    [Parameter] public string? PersistKey { get; set; }

    /// <summary>
    /// CSS classes applied to every child <see cref="ResizableHandle"/>.
    /// Useful for adding consistent margin/padding (e.g. <c>py-4</c>) so the
    /// handle rail aligns with padded panel content.
    /// </summary>
    [Parameter] public string? HandleClass { get; set; }

    /// <summary>
    /// Callback fired when any panel is resized.
    /// </summary>
    [Parameter] public EventCallback<ResizeEventArgs> OnResize { get; set; }

    /// <summary>
    /// Callback fired when resize operation starts.
    /// </summary>
    [Parameter] public EventCallback<ResizeEventArgs> OnResizeStart { get; set; }

    /// <summary>
    /// Callback fired when resize operation ends.
    /// </summary>
    [Parameter] public EventCallback<ResizeEventArgs> OnResizeEnd { get; set; }

    internal List<ResizablePanel> Panels { get; } = new();
    internal List<ResizableHandle> Handles { get; } = new();

    private Dictionary<string, int>? _restoredSizes;
    private bool _isRestored;

    internal ResizableHandle? ActiveHandle { get; set; }
    internal bool IsResizing { get; private set; }

    internal void RegisterPanel(ResizablePanel panel)
    {
        if (!Panels.Contains(panel))
            Panels.Add(panel);

        if (_isRestored && _restoredSizes?.TryGetValue(panel.PanelId, out var size) == true)
        {
            panel.UpdateSize(size);
        }
    }

    internal void UnregisterPanel(ResizablePanel panel)
    {
        Panels.Remove(panel);
    }

    internal void RegisterHandle(ResizableHandle handle)
    {
        if (!Handles.Contains(handle))
            Handles.Add(handle);
    }

    internal void UnregisterHandle(ResizableHandle handle)
    {
        Handles.Remove(handle);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(PersistKey))
        {
            await RestoreSizesAsync();
        }
    }

    internal async Task NotifyResizeAsync(ResizablePanel panel, int newSize)
    {
        var args = new ResizeEventArgs
        {
            PanelId = panel.PanelId,
            Size = newSize,
            Direction = Direction
        };

        await OnResize.InvokeAsync(args);
    }

    internal async Task NotifyResizeStartAsync(ResizablePanel panel)
    {
        IsResizing = true;
        var args = new ResizeEventArgs
        {
            PanelId = panel.PanelId,
            Size = panel.CurrentSize,
            Direction = Direction
        };

        await OnResizeStart.InvokeAsync(args);
    }

    internal async Task NotifyResizeEndAsync(ResizablePanel panel)
    {
        IsResizing = false;
        var args = new ResizeEventArgs
        {
            PanelId = panel.PanelId,
            Size = panel.CurrentSize,
            Direction = Direction
        };

        await OnResizeEnd.InvokeAsync(args);
    }

    /// <summary>
    /// Persists current panel sizes to localStorage when PersistKey is set.
    /// </summary>
    internal async Task PersistSizesAsync()
    {
        if (string.IsNullOrEmpty(PersistKey))
            return;

        try
        {
            var sizes = Panels.ToDictionary(p => p.PanelId, p => p.CurrentSize);
            var json = JsonSerializer.Serialize(sizes, ComponentsJsonContext.Default.DictionaryStringInt32);
            await JS.InvokeVoidAsync("localStorage.setItem", $"resizable:{PersistKey}", json);
        }
        catch
        {
            // Ignore storage errors (e.g., private browsing)
        }
    }

    private async Task RestoreSizesAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", $"resizable:{PersistKey}");
            if (string.IsNullOrEmpty(json))
            {
                _isRestored = true;
                return;
            }

            var sizes = JsonSerializer.Deserialize(json, ComponentsJsonContext.Default.DictionaryStringInt32);
            if (sizes is null)
            {
                _isRestored = true;
                return;
            }

            _restoredSizes = sizes;

            foreach (var panel in Panels)
            {
                if (sizes.TryGetValue(panel.PanelId, out var size))
                {
                    await panel.SetSizeAsync(size);
                }
            }

            _isRestored = true;
            StateHasChanged();
        }
        catch
        {
            // Ignore storage errors
        }
    }

    /// <summary>
    /// Sets the size of a panel by its ID (imperative API).
    /// </summary>
    public async Task SetPanelSizeAsync(string panelId, int size)
    {
        var panel = Panels.FirstOrDefault(p => p.PanelId == panelId);
        if (panel != null)
        {
            await panel.SetSizeAsync(size);
            await PersistSizesAsync();
        }
    }

    /// <summary>
    /// Gets the current size of a panel by its ID.
    /// </summary>
    public int GetPanelSize(string panelId)
    {
        var panel = Panels.FirstOrDefault(p => p.PanelId == panelId);
        return panel?.CurrentSize ?? 0;
    }

    private string GetClass()
    {
        var isHorizontal = Direction == "horizontal";
        var baseClass = isHorizontal
            ? "cn-resizable-panel-group flex h-full w-full flex-row"
            : "cn-resizable-panel-group flex h-full w-full flex-col";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
