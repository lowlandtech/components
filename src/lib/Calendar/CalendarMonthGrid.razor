@namespace LowlandTech.Components.Calendar

<div data-slot="calendar-month-grid" class="cn-calendar-month-grid p-2">
    <div class="grid grid-cols-3 gap-1">
        @for (var month = 1; month <= 12; month++)
        {
            var m = month;
            var isCurrent = m == Calendar.CurrentMonth.Month;
            var isSelected = Calendar.SelectedDate.HasValue && Calendar.SelectedDate.Value.Month == m && Calendar.SelectedDate.Value.Year == Calendar.CurrentMonth.Year;
            <button type="button"
                    data-slot="calendar-month-button"
                    data-month="@m"
                    data-current="@isCurrent"
                    data-selected="@isSelected"
                    class="cn-calendar-month-button relative isolate z-10 flex h-10 items-center justify-center rounded text-sm font-normal transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:opacity-50 disabled:cursor-not-allowed @GetClass(isCurrent, isSelected)"
                    @onclick="() => Calendar.SelectMonth(m)">
                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m)
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public required Calendar Calendar { get; set; }

    private static string GetClass(bool isCurrent, bool isSelected)
    {
        if (isSelected)
            return "bg-primary text-primary-foreground";
        if (isCurrent)
            return "bg-accent text-accent-foreground";
        return "";
    }
}
