@namespace LowlandTech.Components.Calendar

<div data-slot="calendar-navigation" class="cn-calendar-header flex items-center justify-between px-2 py-1">
    <div class="flex items-center gap-1">
        <button type="button" 
                data-slot="calendar-nav-prev-year"
                class="cn-calendar-nav-button cn-calendar-nav-prev-year p-1 hover:bg-muted rounded"
                @onclick="OnPreviousYear">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip">
                <path d="m11 17-5-5 5-5" />
                <path d="m18 17-5-5 5-5" />
            </svg>
        </button>
        <button type="button" 
                data-slot="calendar-nav-prev"
                class="cn-calendar-nav-button cn-calendar-nav-prev p-1 hover:bg-muted rounded"
                @onclick="OnPreviousMonth">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip">
                <path d="m15 18-6-6 6-6" />
            </svg>
        </button>
    </div>
    
    <span data-slot="calendar-caption" class="cn-calendar-caption font-medium">
        @CurrentMonth.ToString("MMMM yyyy")
    </span>
    
    <div class="flex items-center gap-1">
        <button type="button" 
                data-slot="calendar-nav-next"
                class="cn-calendar-nav-button cn-calendar-nav-next p-1 hover:bg-muted rounded"
                @onclick="OnNextMonth">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip">
                <path d="m9 18 6-6-6-6" />
            </svg>
        </button>
        <button type="button" 
                data-slot="calendar-nav-next-year"
                class="cn-calendar-nav-button cn-calendar-nav-next-year p-1 hover:bg-muted rounded"
                @onclick="OnNextYear">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip">
                <path d="m13 17 5-5-5-5" />
                <path d="m6 17 5-5-5-5" />
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter] public DateTime CurrentMonth { get; set; }
    [Parameter] public EventCallback OnPreviousMonth { get; set; }
    [Parameter] public EventCallback OnNextMonth { get; set; }
    [Parameter] public EventCallback OnPreviousYear { get; set; }
    [Parameter] public EventCallback OnNextYear { get; set; }
}
