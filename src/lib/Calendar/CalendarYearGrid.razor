@namespace LowlandTech.Components

<div data-slot="calendar-year-grid" class="cn-calendar-year-grid p-2">
    <div class="grid grid-cols-4 gap-1">
        @for (var year = Calendar.YearPickerStart; year <= Calendar.YearPickerEnd; year++)
        {
            var y = year;
            var isCurrent = y == DateTime.Today.Year;
            var isSelected = Calendar.SelectedDate.HasValue && Calendar.SelectedDate.Value.Year == y;
            <button type="button"
                    data-slot="calendar-year-button"
                    data-year="@y"
                    data-current="@isCurrent"
                    data-selected="@isSelected"
                    class="cn-calendar-year-button relative isolate z-10 flex h-10 items-center justify-center rounded text-sm font-normal transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:opacity-50 disabled:cursor-not-allowed @GetClass(isCurrent, isSelected)"
                    @onclick="() => Calendar.SelectYear(y)">
                @y
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public required Calendar Calendar { get; set; }

    private static string GetClass(bool isCurrent, bool isSelected)
    {
        if (isSelected)
            return "bg-primary text-primary-foreground";
        if (isCurrent)
            return "bg-accent text-accent-foreground";
        return "";
    }
}
