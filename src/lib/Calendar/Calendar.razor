@namespace LowlandTech.Components.Calendar
@inherits LtComponentBase

<div data-slot="calendar"
     class="cn-calendar group/calendar bg-background @Class"
     @attributes="AdditionalAttributes">
    
    <CalendarNavigation 
        CurrentMonth="CurrentMonth"
        ShowMonthDropdown="ShowMonthDropdown"
        ShowYearDropdown="ShowYearDropdown"
        OnPreviousMonth="PreviousMonth"
        OnNextMonth="NextMonth"
        OnPreviousYear="PreviousYear"
        OnNextYear="NextYear"
        OnMonthSelected="GoToMonthNumber"
        OnYearSelected="GoToYear" />
    
    <CalendarGrid 
        Calendar="this"
        Mode="Mode"
        ShowOutsideDays="ShowOutsideDays" />
    
    @ChildContent
</div>
