@namespace LowlandTech.Components.Textarea
@inherits LtComponentBase

<textarea data-slot="textarea"
          class="@GetClass()"
          rows="@Rows"
          placeholder="@Placeholder"
          disabled="@Disabled"
          readonly="@ReadOnly"
          @oninput="HandleInput"
          @attributes="AdditionalAttributes">@Value</textarea>

@code {
    private string GetClass()
    {
        var baseClass = "cn-textarea flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }
}
