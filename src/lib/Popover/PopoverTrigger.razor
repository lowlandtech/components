@namespace LowlandTech.Components
@inherits TinyComponentBase

<button data-slot="popover-trigger"
        class="@GetClass()"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [CascadingParameter] private Popover? Parent { get; set; }

    private void OnClick()
    {
        Parent?.Toggle();
    }

    private string GetClass()
    {
        var baseClass = "cn-popover-trigger select-none";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
