@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="item-media"
     data-variant="@Variant"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// The variant of the media.
    /// </summary>
    [Parameter] public string Variant { get; set; } = "default";

    private string GetClass()
    {
        var baseClass = "cn-item-media flex shrink-0 items-center justify-center [&_svg]:pointer-events-none";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
