@namespace LowlandTech.Components.Dialog
@inherits LtComponentBase

<div data-slot="dialog-footer"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-dialog-footer flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
