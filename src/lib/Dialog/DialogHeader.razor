@namespace LowlandTech.Components.Dialog
@inherits TinyComponentBase

<div data-slot="dialog-header"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-dialog-header flex flex-col space-y-1.5 text-center sm:text-left";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
