@namespace LowlandTech.Components.Dialog
@inherits LtComponentBase

@if (Parent?.IsOpen == true)
{
    <div data-slot="dialog-overlay"
         class="cn-dialog-overlay fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
         @onclick="OnOverlayClick">
    </div>
    <div data-slot="dialog-content"
         class="@GetClass()"
         role="dialog"
         aria-modal="true"
         @attributes="AdditionalAttributes">
        @ChildContent
        <button data-slot="dialog-close"
                class="cn-dialog-close absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none"
                @onclick="OnClose">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span class="sr-only">Close</span>
        </button>
    </div>
}

@code {
    [CascadingParameter] private Dialog? Parent { get; set; }
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    private void OnOverlayClick()
    {
        if (CloseOnOverlayClick)
            Parent?.Close();
    }

    private void OnClose()
    {
        Parent?.Close();
    }

    private string GetClass()
    {
        var baseClass = "cn-dialog-content fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg duration-200 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%] sm:rounded-lg";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
