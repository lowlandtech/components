@namespace LowlandTech.Components
@typeparam TItem

@{
    var key = Parent.GetItemKey(Item);
    var hasChildren = Parent.NodeHasChildren(Item);
    var expanded = Parent.IsItemExpanded(Item);
    var selected = Parent.IsItemSelected(Item);
    var checkedState = Parent.IsItemChecked(Item);
    var indeterminate = Parent.IsIndeterminate(Item);
    var focused = Parent.IsItemFocused(Item);
    var matchesFilter = Parent.MatchesFilter(Item);

    var ctx = new TreeNodeContext<TItem>
    {
        Item = Item,
        Key = key,
        Depth = Depth,
        IsExpanded = expanded,
        HasChildren = hasChildren,
        IsSelected = selected,
        IsChecked = checkedState,
        IsIndeterminate = indeterminate,
        IsDisabled = false,
        IsFocused = focused,
        ToggleExpand = () => Parent.ToggleExpand(Item),
        Select = () => Parent.SelectNode(Item),
        ToggleCheck = () => Parent.ToggleCheck(Item)
    };
}

<div data-tree-node="@key"
     data-depth="@Depth"
     class="@GetNodeClass(ctx)"
     aria-expanded="@(hasChildren ? expanded.ToString().ToLowerInvariant() : null)"
     aria-selected="@((selected && Parent.SelectionMode != TreeViewSelectionMode.None).ToString().ToLowerInvariant())"
     tabindex="@(focused ? 0 : -1)"
     @onclick="HandleClick"
     @ondblclick="HandleDoubleClick"
     @ondblclick:stopPropagation>

    @if (Parent.ItemTemplate != null)
    {
        @Parent.ItemTemplate(ctx)
    }
    else
    {
        <div class="lt-tree-node-row" style="padding-left: @(Depth * 16)px">
            @if (hasChildren)
            {
                <button type="button"
                        class="lt-tree-node-toggle"
                        @onclick:stopPropagation
                        @onclick="ctx.ToggleExpand"
                        aria-label="@(expanded ? "Collapse" : "Expand")">
                    <svg class="lt-tree-node-toggle-icon @(expanded ? "expanded" : "")" viewBox="0 0 24 24" width="14" height="14">
                        <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
            else
            {
                <span class="lt-tree-node-toggle-placeholder"></span>
            }

            @if (Parent.CheckMode != TreeViewCheckMode.None)
            {
                <input type="checkbox"
                       class="lt-tree-node-checkbox"
                       checked="@checkedState"
                       data-indeterminate="@(indeterminate ? "true" : "false")"
                       @onclick:stopPropagation
                       @onchange="() => ctx.ToggleCheck()" />
            }

            @if (Parent.BodyContent != null)
            {
                @Parent.BodyContent(ctx)
            }
            else
            {
                <span class="lt-tree-node-label">@GetDisplayText()</span>
            }
        </div>
    }
</div>

@if (expanded && hasChildren)
{
    @foreach (var child in Parent.GetChildren(Item))
    {
        if (string.IsNullOrWhiteSpace(Parent.FilterQuery) || Parent.IsVisibleInFilter(child))
        {
            <TreeNode TItem="TItem"
                      Item="child"
                      Depth="@(Depth + 1)"
                      Parent="this.Parent" />
        }
    }
}

@code {
    [Parameter, EditorRequired] public TItem Item { get; set; } = default!;
    [Parameter] public int Depth { get; set; }
    [Parameter, EditorRequired] public TreeView<TItem> Parent { get; set; } = default!;

    private string GetNodeClass(TreeNodeContext<TItem> ctx)
    {
        var classes = new List<string> { "lt-tree-node" };
        if (ctx.IsSelected && Parent.SelectionMode != TreeViewSelectionMode.None)
            classes.Add("lt-tree-node-selected");
        if (ctx.IsFocused)
            classes.Add("lt-tree-node-focused");
        if (Parent.Hover)
            classes.Add("lt-tree-node-hoverable");
        return string.Join(" ", classes);
    }

    private string GetDisplayText()
    {
        return Parent.GetText?.Invoke(Item) ?? Item?.ToString() ?? string.Empty;
    }

    private void HandleClick(MouseEventArgs e)
    {
        Parent.FocusNode(Item);

        // When a custom ItemTemplate is used there is no dedicated toggle button,
        // so a single click on the row should toggle expansion for nodes with children.
        if (Parent.ItemTemplate != null && Parent.NodeHasChildren(Item))
        {
            Parent.ToggleExpand(Item);
        }

        if (Parent.SelectionMode != TreeViewSelectionMode.None)
        {
            Parent.SelectNode(Item);
        }
    }

    private void HandleDoubleClick(MouseEventArgs e)
    {
        // Double-click expands/collapses the default template (which has a dedicated toggle button
        // for single-click; double-clicking the row is a secondary expansion affordance).
        // When a custom ItemTemplate is used, single-click already handles expansion, so
        // double-click must not fire a second toggle.
        if (Parent.ItemTemplate == null && Parent.NodeHasChildren(Item))
        {
            Parent.FocusNode(Item);
            Parent.ToggleExpand(Item);
        }
    }
}
