@namespace LowlandTech.Components
@typeparam TItem
@inherits TinyComponentBase

@{
    var rootStyle = new List<string>();
    if (!string.IsNullOrEmpty(Width)) rootStyle.Add($"width:{Width}");
    if (!string.IsNullOrEmpty(MaxHeight)) rootStyle.Add($"max-height:{MaxHeight};overflow-y:auto");
}

<div data-slot="tree-view"
     class="lt-tree-view @GetRootClass()"
     style="@(string.Join(";", rootStyle))"
     tabindex="0"
     data-design-mode="@DesignModeAttribute"
     data-design-selectable="@DesignSelectableAttribute"
     data-design-selected="@DesignSelectedAttribute"
     data-design-instance-id="@DesignInstanceIdAttribute"
     @attributes="AdditionalAttributes"
     @onclick="HandleTreeViewClick"
     @onkeydown="HandleKeyDown"
     @onkeydown:preventDefault="true">

    @if (!Items.Any())
    {
        @if (EmptyContent != null)
        {
            @EmptyContent
        }
    }
    else
    {
        @foreach (var item in Items)
        {
            if (string.IsNullOrWhiteSpace(FilterQuery) || IsVisibleInFilter(item))
            {
                <TreeNode TItem="TItem"
                          Item="item"
                          Depth="0"
                          Parent="this" />
            }
        }
    }
</div>

@code {
    private string GetRootClass()
    {
        var classes = new List<string>();
        if (Dense) classes.Add("lt-tree-view-dense");
        if (Hover) classes.Add("lt-tree-view-hover");
        if (!string.IsNullOrEmpty(Class)) classes.Add(Class);
        if (!string.IsNullOrEmpty(DesignModeClass)) classes.Add(DesignModeClass);
        return string.Join(" ", classes);
    }

    private Task HandleTreeViewClick(MouseEventArgs _) => SelectInDesignModeAsync();
}
