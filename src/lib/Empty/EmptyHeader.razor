@namespace LowlandTech.Components.Empty
@inherits LtComponentBase

<div data-slot="empty-header"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        const string baseClass = "cn-empty-header flex max-w-sm flex-col items-center";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
