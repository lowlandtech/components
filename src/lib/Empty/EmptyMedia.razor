@namespace LowlandTech.Components.Empty
@inherits LtComponentBase

<div data-slot="empty-icon"
     data-variant="@VariantValue"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public string? Variant { get; set; }

    private string VariantValue => string.IsNullOrWhiteSpace(Variant) ? "default" : Variant!;

    private string GetClass()
    {
        var variantClass = VariantValue == "icon" ? "cn-empty-media-icon" : "cn-empty-media-default";
        var baseClass = $"cn-empty-media flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0 {variantClass}";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
