
@namespace LowlandTech.Components.Empty
@inherits TinyComponentBase

<div data-slot="empty"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        const string baseClass = "cn-empty flex w-full min-w-0 flex-1 flex-col items-center justify-center text-center text-balance";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}