@namespace LowlandTech.Components.Combobox
@inherits LtComponentBase

@if (Parent?.IsOpen == true)
{
    <div data-slot="combobox-content"
         class="@GetClass()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private Combobox? Parent { get; set; }

    private string GetClass()
    {
        var baseClass = "cn-combobox-content cn-combobox-content-logical cn-menu-target cn-menu-translucent group/combobox-content relative max-h-(--available-height) w-(--anchor-width) max-w-(--available-width) min-w-[calc(var(--anchor-width)+--spacing(7))] origin-(--transform-origin) data-[chips=true]:min-w-(--anchor-width)";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
