@namespace LowlandTech.Components.Combobox
@inherits LtComponentBase

<div data-slot="combobox-item"
     class="@GetClass()"
     @onclick="OnClick"
     @attributes="AdditionalAttributes">
    @ChildContent
    @if (IsSelected)
    {
        <span class="cn-combobox-item-indicator">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-combobox-item-indicator-icon pointer-events-none">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </span>
    }
</div>

@code {
    [CascadingParameter] private Combobox? Parent { get; set; }

    /// <summary>
    /// The value of the combobox item.
    /// </summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>
    /// Whether the item is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    private bool IsSelected => Parent?.Value == Value;

    private async Task OnClick()
    {
        if (!Disabled && Value != null)
        {
            await Parent?.SelectItem(Value)!;
        }
    }

    private string GetClass()
    {
        var baseClass = "cn-combobox-item relative flex w-full cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
