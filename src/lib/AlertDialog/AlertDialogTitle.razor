@namespace LowlandTech.Components.AlertDialog
@inherits LtComponentBase

<h2 data-slot="alert-dialog-title"
    class="@GetClass()"
    @attributes="AdditionalAttributes">
    @ChildContent
</h2>

@code {
    private string GetClass()
    {
        var baseClass = "cn-alert-dialog-title text-lg font-semibold leading-none tracking-tight";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
