@namespace LowlandTech.Components.AlertDialog
@inherits LtComponentBase

<p data-slot="alert-dialog-description"
   class="@GetClass()"
   @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    private string GetClass()
    {
        var baseClass = "cn-alert-dialog-description text-sm text-muted-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
