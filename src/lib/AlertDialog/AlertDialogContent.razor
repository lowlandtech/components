@namespace LowlandTech.Components.AlertDialog
@inherits TinyComponentBase

@if (Parent?.IsOpen == true)
{
    <div data-slot="alert-dialog-overlay"
         class="cn-alert-dialog-overlay fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
         @onclick="OnOverlayClick">
    </div>
    <div data-slot="alert-dialog-content"
         class="@GetClass()"
         role="alertdialog"
         aria-modal="true"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private AlertDialog? Parent { get; set; }

    /// <summary>
    /// Whether to close the dialog when clicking the overlay.
    /// </summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = false;

    private void OnOverlayClick()
    {
        if (CloseOnOverlayClick)
            Parent?.Close();
    }

    private string GetClass()
    {
        var baseClass = "cn-alert-dialog-content fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg duration-200 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%] sm:rounded-lg";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
