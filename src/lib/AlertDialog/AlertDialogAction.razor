@namespace LowlandTech.Components.AlertDialog
@inherits LtComponentBase

<div data-slot="alert-dialog-action"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-alert-dialog-action";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
