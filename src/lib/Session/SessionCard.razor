@namespace LowlandTech.Components.Session
@using LowlandTech.Components.Badge
@using LowlandTech.Components.Card
@inherits TinyComponentBase
@inject IPageOverlayService PageOverlay

<Card data-slot="session-card"
      data-node-id="@Node.Id"
      Mode="@_mode"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    <CardHeader class="border-b border-border bg-muted/30 px-3 py-2">
        <div class="flex items-center gap-2">
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-sm bg-primary/10 text-[10px] font-semibold text-primary">@Initials</span>
            <span class="truncate text-xs font-semibold">@Node.Label</span>
        </div>
        <CardAction class="flex items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(Status))
            {
                <Badge Variant="@StatusVariant">@Status</Badge>
            }
            <CardModeMenu Mode="@_mode" ModeChanged="OnModeChangedAsync" />
        </CardAction>
    </CardHeader>

    @if (_mode != Card.ModeMinimized && _mode != Card.ModeOverlayPage)
    {
        <CardContent class="space-y-2 p-3 text-sm">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }

            @if (Actions.Count > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var action in Actions)
                    {
                        <button type="button"
                                data-slot="session-card-action"
                                data-action-key="@action.Key"
                                class="inline-flex h-8 items-center rounded-md border border-input bg-background px-3 text-xs font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                                @onclick="() => SelectActionAsync(action)">
                            @action.Label
                        </button>
                    }
                </div>
            }
        </CardContent>
    }
</Card>

@code {
    [Parameter, EditorRequired] public SessionNodeInput Node { get; set; } = new("session-card", "session-card", "Session card");
    [Parameter] public string Initials { get; set; } = "AI";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public string StatusVariant { get; set; } = "outline";
    [Parameter] public IReadOnlyList<SessionCardAction> Actions { get; set; } = [];
    [Parameter] public EventCallback<SessionCardActionSelected> OnActionSelected { get; set; }

    private string _mode = Card.ModeNormal;

    private string GetClass()
    {
        var baseClass = _mode switch
        {
            Card.ModeMaximized => "flex flex-1 w-full flex-col gap-0 overflow-hidden py-0",
            Card.ModeOverlayPage => "w-full gap-0 overflow-hidden py-0 opacity-60",
            _ => "w-full gap-0 overflow-hidden py-0"
        };
        return string.IsNullOrWhiteSpace(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private async Task OnModeChangedAsync(string mode)
    {
        if (mode == Card.ModeOverlayPage)
        {
            PageOverlay.Set(BuildOverlayFragment(), Node.Label);
        }
        else if (_mode == Card.ModeOverlayPage)
        {
            PageOverlay.Clear();
        }
        _mode = mode;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private RenderFragment BuildOverlayFragment() => __builder =>
    {
        <div class="flex flex-1 flex-col">
            <div class="flex items-center justify-between border-b border-border bg-muted/30 px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="inline-flex h-5 w-5 items-center justify-center rounded-sm bg-primary/10 text-[10px] font-semibold text-primary">@Initials</span>
                    <span class="text-sm font-semibold">@Node.Label</span>
                </div>
                <div class="flex items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(Status))
                    {
                        <Badge Variant="@StatusVariant">@Status</Badge>
                    }
                    <button type="button"
                            class="inline-flex h-5 w-5 items-center justify-center rounded-sm text-muted-foreground hover:text-foreground"
                            title="Restore"
                            @onclick="() => OnModeChangedAsync(Card.ModeNormal)">
                        <Icon Paths="@Icons.ChevronDown" Size="12" />
                    </button>
                </div>
            </div>
            <div class="min-h-0 flex-1 overflow-auto p-4">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p>@Description</p>
                }
                @if (Actions.Count > 0)
                {
                    <div class="mt-4 flex flex-wrap gap-2">
                        @foreach (var action in Actions)
                        {
                            <button type="button"
                                    class="inline-flex h-8 items-center rounded-md border border-input bg-background px-3 text-xs font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                                    @onclick="() => SelectActionAsync(action)">
                                @action.Label
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    };

    private async Task SelectActionAsync(SessionCardAction action)
    {
        await action.OnSelected.InvokeAsync(Node);
        await OnActionSelected.InvokeAsync(new SessionCardActionSelected(Node, action.Key));
    }
}
