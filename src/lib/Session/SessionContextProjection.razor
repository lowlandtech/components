@namespace LowlandTech.Components.Session
@inherits TinyComponentBase

@if (Projection is not null)
{
    <div data-slot="session-context-projection" class="@GetClass()" @attributes="AdditionalAttributes">
        <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase text-muted-foreground">Projection</p>
            <p class="truncate text-sm font-medium">@Projection.Node.Label</p>
            <p class="truncate text-xs text-muted-foreground">@Projection.Node.NodeTypeKey</p>
        </div>

        <Button Variant="outline"
                Size="sm"
                data-slot="session-context-projection-pin"
                data-testid="session-context-projection-pin"
                class="shrink-0 border-primary/60 text-primary hover:bg-primary/10"
                title="@PinTitle"
                OnClick="@PinAsync">
            <Icon Name="pin" Size="13" />
            Pin
        </Button>
    </div>
}
