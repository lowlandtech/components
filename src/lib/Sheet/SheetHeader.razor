@namespace LowlandTech.Components.Sheet
@inherits LtComponentBase

<div data-slot="sheet-header" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "flex flex-col space-y-2 text-center sm:text-left";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
