@namespace LowlandTech.Components.Sheet
@inherits TinyComponentBase

<div data-slot="sheet-footer" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
