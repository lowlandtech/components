@namespace LowlandTech.Components.HoverCard
@inherits LtComponentBase

<div data-slot="hover-card-content"
     data-side="@SideValue"
     data-align="@AlignValue"
     class="@CssClass"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public string? Side { get; set; }
    [Parameter] public string? Align { get; set; }

    private string SideValue => string.IsNullOrWhiteSpace(Side) ? "bottom" : Side!;
    private string AlignValue => string.IsNullOrWhiteSpace(Align) ? "center" : Align!;

    private string CssClass
    {
        get
        {
            const string baseClass =
                "cn-hover-card-content cn-hover-card-content-logical z-50 origin-(--transform-origin) " +
                "outline-hidden absolute invisible opacity-0 " +
                "group-hover/hover-card:visible group-hover/hover-card:opacity-100 transition-[opacity,visibility]";
            return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
        }
    }
}
