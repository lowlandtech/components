@namespace LowlandTech.Components
@inherits TinyComponentBase

<span data-slot="hover-card-trigger"
      class="@CssClass"
      @onmouseenter="OnMouseEnter"
      @onmouseleave="OnMouseLeave"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    [CascadingParameter] private HoverCard? ParentHoverCard { get; set; }

    private string CssClass
    {
        get
        {
            const string baseClass = "cn-hover-card-trigger inline-block";
            return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
        }
    }

    private async Task OnMouseEnter()
    {
        if (ParentHoverCard != null)
        {
            await ParentHoverCard.OpenAsync();
        }
    }

    private async Task OnMouseLeave()
    {
        if (ParentHoverCard != null)
        {
            await ParentHoverCard.CloseAsync();
        }
    }
}
