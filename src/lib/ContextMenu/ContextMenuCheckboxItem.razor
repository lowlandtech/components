@namespace LowlandTech.Components.ContextMenu
@inherits LtComponentBase

<div data-slot="context-menu-checkbox-item"
     data-state="@(Checked ? "checked" : "unchecked")"
     role="menuitemcheckbox"
     aria-checked="@Checked.ToString().ToLowerInvariant()"
     class="@GetClass()"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span data-slot="context-menu-checkbox-indicator" class="mr-2 inline-flex w-4 items-center justify-center" aria-hidden="true">
        @if (Checked)
        {
            <span>✓</span>
        }
    </span>
    @ChildContent
</div>

@code {
    [CascadingParameter] private ContextMenu? Parent { get; set; }

    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    private async Task HandleClick()
    {
        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
        if (Parent != null)
        {
            await Parent.Close();
        }
        StateHasChanged();
    }

    private string GetClass()
    {
        var baseClass = "cn-context-menu-checkbox-item group/context-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}