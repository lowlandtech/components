@namespace LowlandTech.Components.ContextMenu
@inherits LtComponentBase

<div data-slot="context-menu-separator"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-context-menu-separator";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
