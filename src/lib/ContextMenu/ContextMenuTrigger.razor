@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="context-menu-trigger"
     class="@GetClass()"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] private ContextMenu? Parent { get; set; }

    private async Task OnContextMenu(MouseEventArgs e)
    {
        if (Parent != null)
        {
            // Use offset coordinates (relative to trigger element) for backward compatibility
            await Parent.OpenAt(e.OffsetX, e.OffsetY);
        }
    }

    private string GetClass()
    {
        var baseClass = "cn-context-menu-trigger select-none";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
