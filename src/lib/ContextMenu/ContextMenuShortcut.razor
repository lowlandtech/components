@namespace LowlandTech.Components.ContextMenu
@inherits LtComponentBase

<span data-slot="context-menu-shortcut"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private string GetClass()
    {
        var baseClass = "ml-auto pl-2 text-xs tracking-widest text-muted-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
