@namespace LowlandTech.Components
@inherits TinyComponentBase

<CascadingValue Value="this">
    <div data-slot="context-menu-radio-group"
         role="group"
         class="@GetClass()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    internal bool IsSelected(string? value) => string.Equals(Value, value, StringComparison.Ordinal);

    internal async Task SelectAsync(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }

    private string GetClass()
    {
        var baseClass = "cn-context-menu-radio-group";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}