@namespace LowlandTech.Components.ContextMenu
@inherits LtComponentBase

@if (Parent?.IsOpen == true)
{
    @if (Parent.Modal)
    {
        <div data-slot="context-menu-overlay"
             data-state="@GetDataState()"
             class="cn-context-menu-overlay fixed inset-0 z-50 bg-transparent"
             @onclick="OnOverlayClick">
        </div>
    }

    <div data-slot="context-menu-content"
          data-state="@GetDataState()"
          class="@GetClass()"
          style="@GetStyle()"
          @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private ContextMenu? Parent { get; set; }

    /// <summary>
    /// Whether to close the menu when clicking on the overlay.
    /// </summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    private async Task OnOverlayClick()
    {
        if (CloseOnOverlayClick && Parent != null)
        {
            await Parent.Close();
        }
    }

    private string GetDataState() => Parent?.IsOpen == true ? "open" : "closed";

    private string GetClass()
    {
        var baseClass = "cn-context-menu-content cn-context-menu-content-logical cn-menu-target cn-menu-translucent z-50 max-h-(--available-height) origin-(--transform-origin) overflow-x-hidden overflow-y-auto outline-hidden";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetStyle()
    {
        if (Parent == null) return "";
        return $"position: fixed; left: {Parent.Position.X}px; top: {Parent.Position.Y}px;";
    }
}
