@namespace LowlandTech.Components
@inherits TinyComponentBase

@if (Parent?.IsOpen == true)
{
    @if (Parent.Modal && !Parent.Portal)
    {
        <div data-slot="context-menu-overlay"
             data-state="@GetDataState()"
             class="cn-context-menu-overlay fixed inset-0 z-50 bg-transparent"
             @onclick="OnOverlayClick">
        </div>
    }

    <div data-slot="context-menu-content"
          data-state="@GetDataState()"
          class="@GetClass()"
          style="@GetCombinedStyle()"
          @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private ContextMenu? Parent { get; set; }

    /// <summary>
    /// Whether to close the menu when clicking on the overlay.
    /// </summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    protected override void OnInitialized()
    {
        Parent?.SetMenuContent(ChildContent);
    }

    protected override void OnParametersSet()
    {
        Parent?.SetMenuContent(ChildContent);
    }

    private async Task OnOverlayClick()
    {
        if (CloseOnOverlayClick && Parent != null)
        {
            await Parent.Close();
        }
    }

    private string GetDataState() => Parent?.IsOpen == true ? "open" : "closed";

    private string GetClass()
    {
        var baseClass = "cn-context-menu-content z-50 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md outline-hidden animate-in fade-in-0 zoom-in-95 duration-100";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetStyle()
    {
        if (Parent == null) return "";
        return $"position: absolute; left: {Parent.Position.X}px; top: {Parent.Position.Y}px;";
    }

    private string GetCombinedStyle()
    {
        var portalHide = Parent?.Portal == true ? "visibility:hidden;" : "";
        return portalHide + GetStyle();
    }
}
