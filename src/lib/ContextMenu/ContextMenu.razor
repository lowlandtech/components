@namespace LowlandTech.Components
@inherits TinyComponentBase

<CascadingValue Value="this">
    <div data-slot="context-menu"
         data-state="@GetDataState()"
         class="@GetClass()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// Whether the context menu is open.
    /// </summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>
    /// Event callback when IsOpen changes.
    /// </summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Whether to use modal mode (traps focus, blocks interaction outside).
    /// Default is true for context menus.
    /// </summary>
    [Parameter] public bool Modal { get; set; } = true;

    /// <summary>
    /// Whether to render the menu content in a portal at body level.
    /// Default is false (will be implemented when Portal component is available).
    /// </summary>
    [Parameter] public bool Portal { get; set; } = false;

    /// <summary>
    /// The position of the context menu.
    /// </summary>
    internal (double X, double Y) Position { get; set; }

    /// <summary>
    /// Opens the context menu at the specified position.
    /// </summary>
    internal async Task OpenAt(double x, double y)
    {
        Position = (x, y);
        IsOpen = true;
        await IsOpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    /// <summary>
    /// Closes the context menu.
    /// </summary>
    internal async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    private string GetDataState() => IsOpen ? "open" : "closed";

    private string GetClass()
    {
        var baseClass = "cn-context-menu relative";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
