@namespace LowlandTech.Components.ContextMenu
@inherits LtComponentBase

<div data-slot="context-menu-radio-item"
     data-state="@(IsChecked ? "checked" : "unchecked")"
     role="menuitemradio"
     aria-checked="@IsChecked.ToString().ToLowerInvariant()"
     class="@GetClass()"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span data-slot="context-menu-radio-indicator" class="mr-2 inline-flex w-4 items-center justify-center" aria-hidden="true">
        @if (IsChecked)
        {
            <span>●</span>
        }
    </span>
    @ChildContent
</div>

@code {
    [CascadingParameter] private ContextMenuRadioGroup? ParentGroup { get; set; }
    [CascadingParameter] private ContextMenu? ParentMenu { get; set; }

    [Parameter] public string? Value { get; set; }

    private bool IsChecked => ParentGroup?.IsSelected(Value) == true;

    private async Task HandleClick()
    {
        if (ParentGroup != null)
        {
            await ParentGroup.SelectAsync(Value);
        }

        if (ParentMenu != null)
        {
            await ParentMenu.Close();
        }
    }

    private string GetClass()
    {
        var baseClass = "cn-context-menu-radio-item group/context-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}