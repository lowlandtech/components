@namespace LowlandTech.Components.Kbd
@inherits TinyComponentBase

<span data-slot="kbd-group"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private string GetClass()
    {
        var baseClass = "cn-kbd-group inline-flex items-center gap-1 [&>*+*]:before:mx-1 [&>*+*]:before:content-['+']";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
