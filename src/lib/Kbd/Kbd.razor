@namespace LowlandTech.Components.Kbd
@inherits LtComponentBase

<kbd data-slot="kbd"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</kbd>

@code {
    private string GetClass()
    {
        var baseClass = "cn-kbd pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground opacity-100";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
