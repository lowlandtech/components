@namespace LowlandTech.Components.Table
@inherits TinyComponentBase

<tr data-slot="table-row"
    class="@GetClass()"
    @attributes="AdditionalAttributes">
    @ChildContent
</tr>

@code {
    private string GetClass()
    {
        var baseClass = "cn-table-row has-aria-expanded:bg-muted/50";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
