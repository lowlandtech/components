@namespace LowlandTech.Components.Icon
@inherits LtComponentBase

<svg data-slot="icon"
     xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="@ViewBox"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@GetClass()"
     aria-hidden="@(string.IsNullOrEmpty(Label) ? "true" : null)"
     aria-label="@Label"
     role="@(string.IsNullOrEmpty(Label) ? null : "img")"
     @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Name))
    {
        @((MarkupString)GetIconPath())
    }
    else
    {
        @((MarkupString)(Paths ?? string.Empty))
    }
</svg>

@code {
    /// <summary>The name of the icon to render from the built-in icon set.</summary>
    [Parameter] public string? Name { get; set; }
    
    /// <summary>SVG path data. Alternative to using Name.</summary>
    [Parameter] public string? Paths { get; set; }
    
    /// <summary>Width and height in pixels. Default: 20.</summary>
    [Parameter] public int Size { get; set; } = 20;
    
    /// <summary>SVG viewBox. Default: "0 0 24 24".</summary>
    [Parameter] public string ViewBox { get; set; } = "0 0 24 24";
    
    /// <summary>SVG stroke-width. Default: 2.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 2;
    
    /// <summary>Accessible label. When set, renders aria-label and role="img".</summary>
    [Parameter] public string? Label { get; set; }
    
    private string GetClass()
    {
        var baseClass = "cn-icon shrink-0";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
    
    private string GetIconPath()
    {
        return Name?.ToLower() switch
        {
            "check" => "<polyline points=\"20 6 9 17 4 12\"></polyline>",
            "chevron-down" => "<polyline points=\"6 9 12 15 18 9\"></polyline>",
            "chevron-up" => "<polyline points=\"18 15 12 9 6 15\"></polyline>",
            "chevron-left" => "<polyline points=\"15 18 9 12 15 6\"></polyline>",
            "chevron-right" => "<polyline points=\"9 18 15 12 9 6\"></polyline>",
            "x" or "close" => "<line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>",
            "search" => "<circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>",
            "menu" => "<line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>",
            "plus" => "<line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>",
            "minus" => "<line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>",
            "home" => "<path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline>",
            "user" => "<path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle>",
            "settings" => "<circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path>",
            "bell" => "<path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"></path><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"></path>",
            "calendar" => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line>",
            "trash" => "<polyline points=\"3 6 5 6 21 6\"></polyline><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>",
            "edit" or "pencil" => "<path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path><path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path>",
            "copy" => "<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>",
            _ => ""
        };
    }
}
