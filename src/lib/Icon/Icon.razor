@namespace LowlandTech.Components.Icon
@inherits TinyComponentBase

<svg data-slot="icon"
     xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="@ViewBox"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@GetClass()"
     aria-hidden="@(string.IsNullOrEmpty(Label) ? "true" : null)"
     aria-label="@Label"
     role="@(string.IsNullOrEmpty(Label) ? null : "img")"
     @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Name))
    {
        @((MarkupString)GetIconPath())
    }
    else
    {
        @((MarkupString)(Paths ?? string.Empty))
    }
</svg>

@code {
    /// <summary>The name of the icon to render from the built-in icon set.</summary>
    [Parameter] public string? Name { get; set; }
    
    /// <summary>SVG path data. Alternative to using Name.</summary>
    [Parameter] public string? Paths { get; set; }
    
    /// <summary>Width and height in pixels. Default: 20.</summary>
    [Parameter] public int Size { get; set; } = 20;
    
    /// <summary>SVG viewBox. Default: "0 0 24 24".</summary>
    [Parameter] public string ViewBox { get; set; } = "0 0 24 24";
    
    /// <summary>SVG stroke-width. Default: 2.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 2;
    
    /// <summary>Accessible label. When set, renders aria-label and role="img".</summary>
    [Parameter] public string? Label { get; set; }
    
    private string GetClass()
    {
        var baseClass = "cn-icon shrink-0";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
    
    private string GetIconPath()
