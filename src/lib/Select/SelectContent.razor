@namespace LowlandTech.Components.Select
@inherits LtComponentBase

@if (Parent?.IsOpen == true)
{
    <div data-slot="select-content"
         class="@GetClass()"
         @attributes="AdditionalAttributes">
        <div class="cn-select-list">
            @ChildContent
        </div>
    </div>
}

@code {
    [CascadingParameter] private Select? Parent { get; set; }

    private string GetClass()
    {
        // Anchored simply via top-full + min-w-full off the trigger. The
        // original Radix port used CSS custom properties --available-height /
        // --anchor-width / --transform-origin written by an anchor-positioning
        // JS pass that doesn't exist here, so the popover effectively had
        // no size or placement. Plain top-full is good enough for in-row
        // selects in the Properties panel.
        var baseClass = "cn-select-content absolute z-50 top-full left-0 mt-1 min-w-full max-h-60 overflow-x-hidden overflow-y-auto rounded-md border border-input bg-popover text-popover-foreground shadow-md p-1";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
