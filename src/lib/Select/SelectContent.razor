@namespace LowlandTech.Components.Select
@inherits TinyComponentBase

@* Items are always rendered (hidden) so SelectItem.OnParametersSet fires
   on first load and registers value→text in the parent's lookup map.
   The visible popover is only shown when the select is open. *@
<div hidden style="display:none">
    @ChildContent
</div>

@if (Parent?.IsOpen == true)
{
    <div data-slot="select-content"
         data-state="open"
         data-side="@Side"
         class="@GetClass()"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @attributes="AdditionalAttributes">
        <div class="cn-select-list">
            @ChildContent
        </div>
    </div>
}

@code {
    [CascadingParameter] private Select? Parent { get; set; }

    [Parameter] public string Side { get; set; } = "bottom";

    private string GetClass()
    {
        var sideClass = string.Equals(Side, "top", StringComparison.OrdinalIgnoreCase) ? "bottom-full mb-1" : "top-full mt-1";
        var baseClass = $"cn-select-content absolute z-50 {sideClass} left-0 min-w-full max-h-60 overflow-x-hidden overflow-y-auto rounded-md border border-input bg-popover text-popover-foreground shadow-md p-1";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
