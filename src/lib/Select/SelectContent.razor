@namespace LowlandTech.Components
@inherits TinyComponentBase

@* Items are always rendered (hidden) so SelectItem.OnParametersSet fires
   on first load and registers value→text in the parent's lookup map.
   The visible popover is only shown when the select is open. *@
<div hidden style="display:none">
    @ChildContent
</div>

@code {
    [CascadingParameter] private Select? Parent { get; set; }

    [Parameter] public string Side { get; set; } = "bottom";
    [Parameter] public string MaxHeight { get; set; } = "15rem";

    protected override void OnParametersSet()
    {
        Parent?.SetContent(BuildContent(), GetPlacement());
    }

    private RenderFragment BuildContent() => __builder =>
    {
        <CascadingValue Value="Parent" IsFixed="true">
            <div data-slot="select-backdrop"
                 class="fixed inset-0 z-0"
                 @onclick="() => Parent?.Close()"
                 @onclick:preventDefault="true"></div>
            <div data-slot="select-content"
                 data-state="open"
                 data-side="@Side"
                 class="@GetClass()"
                 style="max-height: @MaxHeight;"
                 @onclick:stopPropagation="true"
                 @onclick:preventDefault="true"
                 @attributes="AdditionalAttributes">
                <div class="cn-select-list">
                    @ChildContent
                </div>
            </div>
        </CascadingValue>
    };

    private PopoverPlacement GetPlacement()
        => string.Equals(Side, "top", StringComparison.OrdinalIgnoreCase)
            ? PopoverPlacement.TopStart
            : PopoverPlacement.BottomStart;

    private string GetClass()
    {
        var baseClass = "cn-select-content relative z-10 min-w-full overflow-x-hidden overflow-y-auto rounded-md border border-input bg-popover text-popover-foreground shadow-md p-1";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
