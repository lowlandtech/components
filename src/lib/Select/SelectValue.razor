@namespace LowlandTech.Components.Select
@inherits LtComponentBase

<span data-slot="select-value" class="@GetClass()" @attributes="AdditionalAttributes">
    @GetDisplayText()
</span>

@code {
    [CascadingParameter] private Select? Parent { get; set; }

    /// <summary>
    /// The placeholder text when no value is selected.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }

    private string? GetDisplayText()
    {
        // Three sources, in order:
        //  1. SelectedText set by SelectItem.OnClick — the freshest source
        //     after a user-pick.
        //  2. Parent.GetTextForValue(Value) — looks up the text registered
        //     by SelectItems for the controlled Value. Covers preloaded
        //     state ("show 'Visible' on first render when state.Value is
        //     'visible'") before the user has picked anything.
        //  3. Placeholder — final fallback.
        return Parent?.SelectedText
            ?? Parent?.GetTextForValue(Parent.Value)
            ?? Placeholder;
    }

    private string GetClass()
    {
        var baseClass = "cn-select-value";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
