@namespace LowlandTech.Components.Select
@inherits TinyComponentBase

<button data-slot="select-trigger"
        data-size="@Size"
        data-value="@(Parent?.Value)"
        data-invalid="@(Invalid ? "true" : null)"
        type="button"
        class="@GetClass()"
        disabled="@Disabled"
        aria-invalid="@Invalid"
        @onclick="OnClick"
        @onclick:stopPropagation="true"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-select-trigger-icon pointer-events-none ml-2 opacity-0 transition-opacity group-hover:opacity-100">
        <path d="m6 9 6 6 6-6" />
    </svg>
</button>

@code {
    [CascadingParameter] private Select? Parent { get; set; }

    /// <summary>
    /// The size of the select trigger.
    /// </summary>
    [Parameter] public string Size { get; set; } = "default";

    /// <summary>
    /// Whether the select trigger is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Whether the select trigger has an invalid state.
    /// </summary>
    [Parameter] public bool Invalid { get; set; }

    private void OnClick()
    {
        if (Disabled) return;
        Parent?.Toggle();
    }

    private string GetClass()
    {
        // w-full so the trigger fills its host column (form rows, grid
        // cells, flex children). Was w-fit which made the trigger
        // content-sized — fine for "shrink to label" but broken in the
        // canvas designer's row layouts where it needs to span the
        // value column.
        var baseClass = "cn-select-trigger group flex w-full items-center justify-between whitespace-nowrap outline-none *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center [&_svg]:pointer-events-none [&_svg]:shrink-0";

        // Disabled styles
        var disabledClass = " disabled:cursor-not-allowed disabled:opacity-50 disabled:pointer-events-none";

        // Border and focus styles based on invalid state
        var borderClass = Invalid
            ? " border-red-500 focus-visible:ring-red-500"
            : " border-input focus-visible:ring-ring";

        // Size-aware geometry. "compact" matches the dense canvas style
        // editor rows that previously hosted NativeSelect (28px tall, tight
        // horizontal padding, xs text). The other sizes carry their own
        // padding now too, so each variant owns its full geometry instead
        // of relying on a shared px-3 py-2 baseline that was wrong for
        // dense panels.
        var sizeClass = Size switch
        {
            "compact" => " h-7 px-2 text-xs",
            "sm"      => " h-8 px-2.5 text-xs",
            "lg"      => " h-10 px-3 py-2 text-base",
            _         => " h-9 px-3 py-2 text-sm",
        };

        // Base appearance classes (height + padding moved into sizeClass).
        var appearanceClass = " rounded-md border bg-transparent shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1";

        var result = $"{baseClass}{appearanceClass}{sizeClass}{borderClass}{disabledClass}";
        return string.IsNullOrEmpty(Class) ? result : $"{result} {Class}";
    }
}
