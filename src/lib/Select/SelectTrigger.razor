@namespace LowlandTech.Components.Select
@inherits LtComponentBase

<button data-slot="select-trigger"
        data-size="@Size"
        type="button"
        class="@GetClass()"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-select-trigger-icon pointer-events-none">
        <path d="m6 9 6 6 6-6" />
    </svg>
</button>

@code {
    [CascadingParameter] private Select? Parent { get; set; }

    /// <summary>
    /// The size of the select trigger.
    /// </summary>
    [Parameter] public string Size { get; set; } = "default";

    private void OnClick()
    {
        Parent?.Toggle();
    }

    private string GetClass()
    {
        var baseClass = "cn-select-trigger flex w-fit items-center justify-between whitespace-nowrap outline-none disabled:cursor-not-allowed disabled:opacity-50 *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center [&_svg]:pointer-events-none [&_svg]:shrink-0";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
