@namespace LowlandTech.Components
@inherits TinyComponentBase
@implements IDisposable
@inject IPopoverService PopoverService
@attribute [Properties(Group = "Forms", Icon = "select",
    Description = "Dropdown — wrap a SelectTrigger + SelectContent")]

<CascadingValue Value="this">
    <div data-slot="select"
         data-design-mode="@DesignModeAttribute"
         data-design-selectable="@DesignSelectableAttribute"
         data-design-selected="@DesignSelectedAttribute"
         data-design-instance-id="@DesignInstanceIdAttribute"
         class="@GetClass()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly Guid _popoverId = Guid.NewGuid();
    private RenderFragment? _contentFragment;
    private PopoverPlacement _placement = PopoverPlacement.BottomStart;

    /// <summary>
    /// The currently selected value.
    /// </summary>
    [Parameter, PropertyGrid(Label = "Default Value", Editor = PropertyEditor.Text)]
    public string? Value { get; set; }

    /// <summary>
    /// Event callback when value changes.
    /// </summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Whether the select is open.
    /// </summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>
    /// The current selected item text.
    /// </summary>
    internal string? SelectedText { get; set; }

    internal string PopoverAnchorId => $"popover-anchor-{_popoverId}";

    protected override void OnInitialized()
    {
        PopoverService.Register(_popoverId);
    }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            UpdatePopover(true);
        }
    }

    /// <summary>
    /// Toggles the select dropdown.
    /// </summary>
    internal void Toggle()
    {
        if (IsOpen)
        {
            Close();
            return;
        }

        IsOpen = true;
        UpdatePopover(true);
        StateHasChanged();
    }

    /// <summary>
    /// Closes the select dropdown.
    /// </summary>
    internal void Close()
    {
        IsOpen = false;
        UpdatePopover(false);
        StateHasChanged();
    }

    internal void SetContent(RenderFragment fragment, PopoverPlacement placement)
    {
        _contentFragment = fragment;
        _placement = placement;
        if (IsOpen)
        {
            UpdatePopover(true);
        }
    }

    /// <summary>
    /// Selects an item.
    /// </summary>
    internal async Task SelectItem(string value, string text)
    {
        Value = value;
        SelectedText = text;
        Close();
        await ValueChanged.InvokeAsync(Value);
    }

    /// <summary>
    /// Map of value → text registered by child SelectItems on
    /// OnParametersSet. Lets SelectValue resolve the display text for a
    /// preloaded Value (e.g. seeded from state on first render) before
    /// the user has clicked anything. SelectedText is only set on
    /// user-pick; this dictionary covers the controlled-Value case.
    /// </summary>
    private readonly Dictionary<string, string> _itemText = new(StringComparer.Ordinal);

    internal event Action? ItemsRegistered;

    internal void RegisterItemText(string value, string text)
    {
        if (_itemText.TryGetValue(value, out var existing) && existing == text)
            return;
        _itemText[value] = text;
        ItemsRegistered?.Invoke();
    }

    internal string? GetTextForValue(string? value)
        => value is not null && _itemText.TryGetValue(value, out var text) ? text : null;

    private void UpdatePopover(bool open)
    {
        PopoverService.Update(_popoverId, new PopoverState
        {
            Open = open,
            Placement = _placement,
            CssClass = "cn-select-popover",
            Fragment = open ? _contentFragment : null
        });
    }

    public void Dispose()
    {
        PopoverService.Unregister(_popoverId);
    }

    private string GetClass()
    {
        var baseClass = "cn-select relative";
        var result = string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
        return $"{result} {DesignModeClass}".Trim();
    }
}
