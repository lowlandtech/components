@namespace LowlandTech.Components.Select
@inherits TinyComponentBase
@attribute [Properties(Group = "Forms", Icon = "select",
    Description = "Dropdown — wrap a SelectTrigger + SelectContent")]

<CascadingValue Value="this">
    <div data-slot="select" class="@GetClass()" @attributes="AdditionalAttributes">
        @if (IsOpen)
        {
            @* Click-outside catcher — fixed inset-0 sits below the open
               content (z-40 vs content's z-50) so any click outside the
               trigger / list dismisses the popover. *@
            <div data-slot="select-backdrop"
                 class="fixed inset-0 z-40"
                  @onclick="Close"
                  @onclick:preventDefault="true"></div>
        }
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// The currently selected value.
    /// </summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>
    /// Event callback when value changes.
    /// </summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Whether the select is open.
    /// </summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>
    /// The current selected item text.
    /// </summary>
    internal string? SelectedText { get; set; }

    /// <summary>
    /// Toggles the select dropdown.
    /// </summary>
    internal void Toggle()
    {
        IsOpen = !IsOpen;
        StateHasChanged();
    }

    /// <summary>
    /// Closes the select dropdown.
    /// </summary>
    internal void Close()
    {
        IsOpen = false;
        StateHasChanged();
    }

    /// <summary>
    /// Selects an item.
    /// </summary>
    internal async Task SelectItem(string value, string text)
    {
        Value = value;
        SelectedText = text;
        Close();
        await ValueChanged.InvokeAsync(Value);
    }

    /// <summary>
    /// Map of value → text registered by child SelectItems on
    /// OnParametersSet. Lets SelectValue resolve the display text for a
    /// preloaded Value (e.g. seeded from state on first render) before
    /// the user has clicked anything. SelectedText is only set on
    /// user-pick; this dictionary covers the controlled-Value case.
    /// </summary>
    private readonly Dictionary<string, string> _itemText = new(StringComparer.Ordinal);

    internal event Action? ItemsRegistered;

    internal void RegisterItemText(string value, string text)
    {
        if (_itemText.TryGetValue(value, out var existing) && existing == text)
            return;
        _itemText[value] = text;
        ItemsRegistered?.Invoke();
    }

    internal string? GetTextForValue(string? value)
        => value is not null && _itemText.TryGetValue(value, out var text) ? text : null;

    private string GetClass()
    {
        var baseClass = "cn-select relative";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
