@namespace LowlandTech.Components
@inherits TinyComponentBase

<p data-slot="field-description"
   class="@GetClass()"
   @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    private string GetClass()
    {
        var baseClass = "cn-field-description leading-normal font-normal group-has-data-horizontal/field:text-balance last:mt-0 nth-last-2:-mt-1 [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
