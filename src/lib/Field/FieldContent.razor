@namespace LowlandTech.Components.Field
@inherits LtComponentBase

<div data-slot="field-content"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-field-content group/field-content flex flex-1 flex-col leading-snug";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
