@namespace LowlandTech.Components.Field
@inherits LtComponentBase

<div data-slot="field-group"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-field-group group/field-group @container/field-group flex w-full flex-col";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
