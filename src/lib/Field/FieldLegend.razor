@namespace LowlandTech.Components
@inherits TinyComponentBase

<legend data-slot="field-legend"
        data-variant="@Variant"
        class="@GetClass()"
        @attributes="AdditionalAttributes">
    @ChildContent
</legend>

@code {
    /// <summary>
    /// The variant of the legend.
    /// </summary>
    [Parameter] public string Variant { get; set; } = "legend";

    private string GetClass()
    {
        var baseClass = "cn-field-legend";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
