
@namespace LowlandTech.Components
@inherits TinyComponentBase

<CascadingValue Value="@GroupContext" Name="ToggleGroupContext">
    <div data-slot="toggle-group"
         data-variant="@VariantValue"
         data-size="@SizeValue"
         data-spacing="@spacing"
         data-orientation="@OrientationValue"
         style="@GroupStyle"
         class="@CssClass"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>