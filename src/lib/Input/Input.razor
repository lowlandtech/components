@namespace LowlandTech.Components.Input
@inherits TinyComponentBase

@if (Variant == "floating")
{
    <div class="lt-fl-wrap"
         data-design-mode="@DesignModeAttribute"
         data-design-selectable="@DesignSelectableAttribute"
         data-design-selected="@DesignSelectedAttribute"
         data-design-instance-id="@DesignInstanceIdAttribute">
        <input data-slot="input"
               data-variant="@Variant"
               data-size="@Size"
               data-invalid="@(Invalid ? "true" : null)"
               type="@Type"
               class="@GetClass()"
               placeholder=" "
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-invalid="@Invalid"
               value="@Value"
            @ref="_inputRef"
               @oninput="HandleInput"
               @onkeyup="HandleKeyUp"
               @attributes="AdditionalAttributes" />
        <label class="lt-fl-label">@Label</label>
    </div>
}
else
{
    <input data-slot="input"
           data-variant="@Variant"
           data-size="@Size"
           data-invalid="@(Invalid ? "true" : null)"
           data-design-mode="@DesignModeAttribute"
           data-design-selectable="@DesignSelectableAttribute"
           data-design-selected="@DesignSelectedAttribute"
           data-design-instance-id="@DesignInstanceIdAttribute"
           type="@Type"
           class="@GetClass()"
           placeholder="@Placeholder"
           disabled="@Disabled"
           readonly="@ReadOnly"
           aria-invalid="@Invalid"
           value="@Value"
        @ref="_inputRef"
           @oninput="HandleInput"
           @onkeyup="HandleKeyUp"
           @attributes="AdditionalAttributes" />
}

@code {
    /// <summary>
    /// The type of the input element.
    /// </summary>
    [Parameter, PropertyGrid(Group = "Behavior", Editor = PropertyEditor.Select,
        Options = new[] { "text", "email", "password", "number", "search", "tel", "url" },
        Description = "HTML input type")]
    public string Type { get; set; } = "text";

    private string GetClass()
    {
        var baseClass = "cn-input flex w-full min-w-0 rounded-md border bg-transparent px-3 py-1 text-base shadow-sm transition-colors file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm";

        var borderClass = Invalid
            ? " border-red-500 focus-visible:ring-red-500"
            : " border-input focus-visible:ring-ring";

        var sizeClass = Size switch
        {
            "sm" => " h-8",
            "lg" => " h-10",
            _ => " h-9"
        };

        var variantClass = Variant switch
        {
            "destructive" => " border-destructive focus-visible:ring-destructive",
            _ => ""
        };

        var result = $"{baseClass}{borderClass}{sizeClass}{variantClass}";
        result = string.IsNullOrEmpty(Class) ? result : $"{result} {Class}";
        return $"{result} {DesignModeClass}".Trim();
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }
}
