@namespace LowlandTech.Components.ThemeProvider
@implements IDisposable
@inject ComponentThemeService ThemeService

@if (!string.IsNullOrEmpty(_tokenCss))
{
    <style>[data-theme-provider="@Id"]{@((MarkupString)_tokenCss)}</style>
}
<div data-theme-provider="@Id"
     data-theme-name="@_activeThemeName"
     data-theme-style="@_activeThemeStyle"
     class="@Class"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="_context" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>
    /// Unique identifier for this provider. Used by <see cref="ComponentThemeService"/>
    /// to track which theme is active at this boundary.
    /// </summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>Name of the initial <see cref="IComponentTheme"/> to apply.</summary>
    [Parameter] public string? Theme { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ThemeProviderContext _context = null!;
    private string _tokenCss = "";
    private string? _activeThemeName;
    private string? _activeThemeStyle;

    protected override void OnInitialized()
    {
        _context = new(Id, ThemeService);
        ThemeService.Register(Id, Theme);
        ThemeService.ThemeChanged += OnThemeChanged;
        UpdateStyle();
    }

    private void OnThemeChanged(string providerId)
    {
        if (providerId == Id)
            InvokeAsync(() => { UpdateStyle(); StateHasChanged(); });
    }

    private void UpdateStyle()
    {
        var theme = ThemeService.GetForProvider(Id);
        _tokenCss = theme is null
            ? ""
            : string.Join(";", theme.Tokens.Select(kv => $"{kv.Key}:{kv.Value}"));
        _activeThemeName = theme?.Name;
        _activeThemeStyle = ResolveThemeStyle(theme);
        // Refresh the context so child components see the updated active theme.
        _context = new(Id, ThemeService);
    }

    /// <summary>
    /// Maps a theme to a broad style family name for the
    /// <c>data-theme-style</c> attribute.  Themes can implement a marker
    /// interface to declare their style family; otherwise, <c>"default"</c>
    /// is used.
    /// </summary>
    private static string? ResolveThemeStyle(IComponentTheme? theme) =>
        theme is IThemeStyleFamily family ? family.StyleFamily : null;

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
        ThemeService.Unregister(Id);
    }
}
