@namespace LowlandTech.Components
@inherits TinyComponentBase

<CascadingValue Value="this">
    <div data-slot="drawer"
         data-state="@(IsOpen ? "open" : "closed")"
         class="@GetClass()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>
    /// Whether the drawer is open.
    /// </summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>
    /// Event callback when open state changes.
    /// </summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// The direction of the drawer ("left" | "right" | "top" | "bottom").
    /// </summary>
    [Parameter] public string Direction { get; set; } = "right";

    /// <summary>
    /// Opens the drawer.
    /// </summary>
    public async Task Open()
    {
        IsOpen = true;
        await IsOpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    /// <summary>
    /// Closes the drawer.
    /// </summary>
    public async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    private string GetClass()
    {
        var baseClass = "cn-drawer";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
