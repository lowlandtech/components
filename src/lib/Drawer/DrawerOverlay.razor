@namespace LowlandTech.Components.Drawer
@inherits LtComponentBase

<div data-slot="drawer-overlay"
     data-state="@GetState()"
     class="@GetClass()"
     @onclick="OnClick"
     @attributes="AdditionalAttributes">
</div>

@code {
    [CascadingParameter] private Drawer? Parent { get; set; }

    private string GetState() => Parent?.IsOpen == true ? "open" : "closed";

    private async Task OnClick()
    {
        if (Parent != null)
        {
            await Parent.Close();
        }
    }

    private string GetClass()
    {
        var baseClass = "cn-drawer-overlay fixed inset-0 z-50 " +
                        "data-[state=open]:animate-in data-[state=closed]:animate-out " +
                        "data-[state=open]:fade-in-0 data-[state=closed]:fade-out-0";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
