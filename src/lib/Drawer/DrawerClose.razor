@namespace LowlandTech.Components.Drawer
@inherits LtComponentBase

<button data-slot="drawer-close"
        class="@GetClass()"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [CascadingParameter] private Drawer? Parent { get; set; }

    private async Task OnClick()
    {
        if (Parent != null)
        {
            await Parent.Close();
        }
    }

    private string GetClass()
    {
        var baseClass = "cn-drawer-close";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
