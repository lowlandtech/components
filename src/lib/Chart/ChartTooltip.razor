@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="chart-tooltip" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        return $"pointer-events-none absolute z-50 hidden rounded-md border bg-popover p-3 text-sm text-popover-foreground shadow-md {Class}".Trim();
    }
}
