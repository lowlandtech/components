@namespace LowlandTech.Components.DropdownMenu
@inherits LtComponentBase

<div data-slot="dropdown-menu-radio-item"
     class="@GetClass()"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span class="absolute left-2 flex h-3.5 w-3.5 items-center justify-center">
        @if (IsSelected)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="h-2 w-2 fill-current">
                <circle cx="12" cy="12" r="10"/>
            </svg>
        }
    </span>
    <span class="pl-6">@ChildContent</span>
    @if (DropdownMenuShortcut != null)
    {
        <span class="ml-auto pl-2 text-xs tracking-widest opacity-60">
            @DropdownMenuShortcut
        </span>
    }
</div>

@code {
    [CascadingParameter] public DropdownMenuRadioGroup? RadioGroup { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? DropdownMenuShortcut { get; set; }

    private bool IsSelected => RadioGroup?.Value == Value;

    private string GetClass()
    {
        var baseClass = "relative flex cursor-default select-none items-center rounded-sm py-1.5 pr-2 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 hover:bg-accent hover:text-accent-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private async Task HandleClick()
    {
        if (!Disabled && RadioGroup != null)
        {
            await RadioGroup.SelectValueAsync(Value);
            await OnSelect.InvokeAsync();
        }
    }
}
