@namespace LowlandTech.Components.DropdownMenu
@inherits LtComponentBase

<div data-slot="dropdown-menu-separator"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
</div>

@code {
    private string GetClass()
    {
        var baseClass = "-mx-1 my-1 h-px bg-muted";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
