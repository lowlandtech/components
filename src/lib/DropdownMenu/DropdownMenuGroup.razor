@namespace LowlandTech.Components.DropdownMenu
@inherits TinyComponentBase

<div data-slot="dropdown-menu-group"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "";
        return string.IsNullOrEmpty(Class) ? baseClass : Class;
    }
}
