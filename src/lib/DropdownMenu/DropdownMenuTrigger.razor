@namespace LowlandTech.Components
@inherits TinyComponentBase

<button type="button"
        data-slot="dropdown-menu-trigger"
        class="@GetClass()"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetClass()
    {
        var baseClass = "inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
