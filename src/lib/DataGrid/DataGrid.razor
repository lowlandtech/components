@namespace LowlandTech.Components.DataGrid
@typeparam TItem
@inherits TinyComponentBase

<div data-slot="data-grid"
     data-loading="@IsLoading.ToString().ToLowerInvariant()"
     data-selection-mode="@SelectionMode.ToString().ToLowerInvariant()"
     data-density="@Density.ToString().ToLowerInvariant()"
     data-grid-lines="@GridLines.ToString().ToLowerInvariant()"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        <div hidden>
            @if (Columns is not null)
            {
                @Columns
            }
            else
            {
                @ChildContent
            }
        </div>

        <div data-slot="data-grid-table-container" class="cn-data-grid-table-container">
            <table data-slot="data-grid-table" class="cn-data-grid-table">
                <thead data-slot="data-grid-header" class="cn-data-grid-header">
                    <tr data-slot="data-grid-header-row" class="cn-data-grid-row">
                        @if (DetailTemplate is not null)
                        {
                            <th data-slot="data-grid-header-cell" class="cn-data-grid-head cn-data-grid-expand-cell">
                                <span class="sr-only">Expand</span>
                            </th>
                        }
                        @if (SelectionMode == DataGridSelectionMode.Multiple)
                        {
                            <th data-slot="data-grid-header-cell" class="cn-data-grid-head cn-data-grid-selection-cell">
                                <input data-slot="data-grid-select-all"
                                       type="checkbox"
                                       checked="@IsAllVisibleSelected()"
                                       aria-label="Select all visible rows"
                                       @onchange="ToggleSelectAll" />
                            </th>
                        }
                        @foreach (var column in VisibleColumns)
                        {
                            <th data-slot="data-grid-header-cell" class="@GetHeaderCellClass(column)">
                                @if (column.HeaderTemplate is not null)
                                {
                                    @column.HeaderTemplate
                                }
                                else if (CanSort(column))
                                {
                                    <button type="button"
                                            data-slot="data-grid-sort-button"
                                            data-sort-direction="@GetSortDirection(column).ToString().ToLowerInvariant()"
                                            class="cn-data-grid-sort-button"
                                            @onclick="eventArgs => ToggleSort(column, eventArgs)">
                                        <span>@column.HeaderText</span>
                                        <span aria-hidden="true" class="cn-data-grid-sort-indicator">@GetSortIndicator(column)</span>
                                    </button>
                                }
                                else
                                {
                                    @column.HeaderText
                                }
                            </th>
                        }
                    </tr>
                    @if (AllowFiltering && VisibleColumns.Any(CanFilter))
                    {
                        <tr data-slot="data-grid-filter-row" class="cn-data-grid-filter-row">
                            @if (DetailTemplate is not null)
                            {
                                <th data-slot="data-grid-filter-cell" class="cn-data-grid-filter-cell cn-data-grid-expand-cell"></th>
                            }
                            @if (SelectionMode == DataGridSelectionMode.Multiple)
                            {
                                <th data-slot="data-grid-filter-cell" class="cn-data-grid-filter-cell cn-data-grid-selection-cell"></th>
                            }
                            @foreach (var column in VisibleColumns)
                            {
                                <th data-slot="data-grid-filter-cell" class="cn-data-grid-filter-cell">
                                    @if (CanFilter(column))
                                    {
                                        <input data-slot="data-grid-filter-input"
                                               class="cn-data-grid-filter-input"
                                               value="@GetFilterValue(column)"
                                               aria-label="Filter @column.HeaderText"
                                               @oninput="eventArgs => UpdateFilter(column, eventArgs.Value?.ToString())" />
                                    }
                                </th>
                            }
                        </tr>
                    }
                </thead>
                <tbody data-slot="data-grid-body" class="cn-data-grid-body">
                    @if (IsLoading)
                    {
                        <tr data-slot="data-grid-loading-row" class="cn-data-grid-row">
                            <td data-slot="data-grid-loading" class="cn-data-grid-state-cell" colspan="@ColumnSpan">
                                @if (LoadingTemplate is not null)
                                {
                                    @LoadingTemplate
                                }
                                else
                                {
                                    <span>Loading...</span>
                                }
                            </td>
                        </tr>
                    }
                    else if (!CurrentPageItems.Any())
                    {
                        <tr data-slot="data-grid-empty-row" class="cn-data-grid-row">
                            <td data-slot="data-grid-empty" class="cn-data-grid-state-cell" colspan="@ColumnSpan">
                                @if (EmptyTemplate is not null)
                                {
                                    @EmptyTemplate
                                }
                                else
                                {
                                    <span>@(!string.IsNullOrWhiteSpace(EmptyText) ? EmptyText : "No results found.")</span>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in CurrentPageItems)
                        {
                            <tr data-slot="data-grid-row"
                                data-selected="@(IsSelected(item) ? "true" : null)"
                                data-expanded="@(IsDetailExpanded(item) ? "true" : null)"
                                aria-selected="@(SelectionMode == DataGridSelectionMode.None ? null : IsSelected(item).ToString().ToLowerInvariant())"
                                class="cn-data-grid-row"
                                @onclick="() => ToggleSelection(item)">
                                @if (DetailTemplate is not null)
                                {
                                    <td data-slot="data-grid-cell" class="cn-data-grid-cell cn-data-grid-expand-cell">
                                        <button type="button"
                                                data-slot="data-grid-expand-button"
                                                class="cn-data-grid-expand-button"
                                                aria-expanded="@IsDetailExpanded(item).ToString().ToLowerInvariant()"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => ToggleDetailRow(item)">
                                            @(IsDetailExpanded(item) ? "-" : "+")
                                        </button>
                                    </td>
                                }
                                @if (SelectionMode == DataGridSelectionMode.Multiple)
                                {
                                    <td data-slot="data-grid-cell" class="cn-data-grid-cell cn-data-grid-selection-cell">
                                        <input data-slot="data-grid-selection-input"
                                               type="checkbox"
                                               checked="@IsSelected(item)"
                                               aria-label="Select row"
                                               @onclick:stopPropagation="true"
                                               @onchange="() => ToggleSelection(item)" />
                                    </td>
                                }
                                @if (RowTemplate is not null)
                                {
                                    @RowTemplate(item)
                                }
                                else
                                {
                                    @foreach (var column in VisibleColumns)
                                    {
                                        <td data-slot="data-grid-cell" class="@GetCellClass(column)" tabindex="0" @onkeydown="eventArgs => HandleCellKeyDown(eventArgs, item, column)">
                                            @if (column.Template is not null)
                                            {
                                                @column.Template(item)
                                            }
                                            else
                                            {
                                                @column.FormatValue(item)
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                            @if (DetailTemplate is not null && IsDetailExpanded(item))
                            {
                                <tr data-slot="data-grid-detail-row" class="cn-data-grid-detail-row">
                                    <td data-slot="data-grid-detail-cell" class="cn-data-grid-detail-cell" colspan="@ColumnSpan">
                                        @DetailTemplate(item)
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
                @if (FooterTemplate is not null)
                {
                    <tfoot data-slot="data-grid-footer" class="cn-data-grid-footer">
                        <tr data-slot="data-grid-footer-row" class="cn-data-grid-row">
                            <td data-slot="data-grid-footer-cell" class="cn-data-grid-footer-cell" colspan="@ColumnSpan">
                                @FooterTemplate
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        @if (AllowPaging && TotalItems > PageSize)
        {
            <div data-slot="data-grid-pager" class="cn-data-grid-pager">
                <span data-slot="data-grid-page-summary" class="cn-data-grid-page-summary">
                    Page @(PageIndex + 1) of @TotalPages
                </span>
                <div class="cn-data-grid-pager-actions">
                    <button type="button"
                            data-slot="data-grid-page-previous"
                            class="cn-data-grid-page-button"
                            disabled="@(PageIndex == 0)"
                            @onclick="GoToPreviousPage">
                        Previous
                    </button>
                    <button type="button"
                            data-slot="data-grid-page-next"
                            class="cn-data-grid-page-button"
                            disabled="@(PageIndex >= TotalPages - 1)"
                            @onclick="GoToNextPage">
                        Next
                    </button>
                </div>
            </div>
        }
    </CascadingValue>
</div>

@code {
    private readonly List<DataGridColumn<TItem>> _columns = [];
    private readonly List<DataGridFilterDescriptor> _filterDescriptors = [];
    private readonly List<DataGridSortDescriptor> _sortDescriptors = [];
    private readonly HashSet<string> _selectedRowKeys = [];
    private readonly HashSet<string> _expandedRowKeys = [];

    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public RenderFragment? Columns { get; set; }
    [Parameter] public RenderFragment? EmptyTemplate { get; set; }
    [Parameter] public RenderFragment? LoadingTemplate { get; set; }
    [Parameter] public RenderFragment<TItem>? DetailTemplate { get; set; }
    [Parameter] public RenderFragment? FooterTemplate { get; set; }
    /// <summary>Per-row content override. When supplied, the DataGrid emits the
    /// author's template inside the <c>&lt;tr&gt;</c> wrapper (so click-to-select,
    /// data-selected, paging, and sorting all compose around the override).
    /// When null, the default column-driven rendering runs. Ported from Radzen
    /// DataGrid's Template pattern — see docs/pluginize/issues/block-crud-page-template.md.</summary>
    [Parameter] public RenderFragment<TItem>? RowTemplate { get; set; }
    [Parameter] public bool AllowSorting { get; set; } = true;
    [Parameter] public bool AllowMultiSort { get; set; }
    [Parameter] public bool AllowFiltering { get; set; }
    [Parameter] public bool AllowPaging { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public EventCallback<int> PageIndexChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<DataGridSortDescriptor>> SortChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<DataGridFilterDescriptor>> FilterChanged { get; set; }
    [Parameter] public EventCallback<DataGridStateRepresentation> StateChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public DataGridSelectionMode SelectionMode { get; set; } = DataGridSelectionMode.None;
    [Parameter] public ISet<TItem>? SelectedItems { get; set; }
    [Parameter] public EventCallback<ISet<TItem>> SelectedItemsChanged { get; set; }
    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }
    [Parameter] public DataGridDensity Density { get; set; } = DataGridDensity.Default;
    [Parameter] public DataGridGridLines GridLines { get; set; } = DataGridGridLines.Horizontal;
    [Parameter] public Func<TItem, string>? ItemKey { get; set; }
    [Parameter] public string? EmptyText { get; set; }

    private int EffectivePageSize => Math.Max(1, PageSize);
    private IEnumerable<DataGridColumn<TItem>> VisibleColumns => _columns.Where(column => column.Visible);
    private int ColumnSpan => Math.Max(1, VisibleColumns.Count() + (SelectionMode == DataGridSelectionMode.Multiple ? 1 : 0) + (DetailTemplate is not null ? 1 : 0));
    private IReadOnlyList<TItem> CurrentPageItems => GetCurrentPageItems();
    private int TotalItems => GetFilteredAndSortedItems().Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)EffectivePageSize));

    protected override void OnParametersSet()
    {
        if (SelectedItems is not null)
        {
            _selectedRowKeys.Clear();
            foreach (var item in SelectedItems)
            {
                _selectedRowKeys.Add(GetRowKey(item));
            }
        }
        else if (SelectionMode == DataGridSelectionMode.Single && SelectedItem is not null)
        {
            _selectedRowKeys.Clear();
            _selectedRowKeys.Add(GetRowKey(SelectedItem));
        }

        var totalPages = TotalPages;
        if (PageIndex > 0 && PageIndex >= totalPages)
        {
            var clamped = Math.Max(0, totalPages - 1);
            if (PageIndex != clamped)
            {
                PageIndex = clamped;
                _ = PageIndexChanged.InvokeAsync(PageIndex);
            }
        }
    }

    internal void RegisterColumn(DataGridColumn<TItem> column)
    {
        if (!_columns.Contains(column))
        {
            _columns.Add(column);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    internal void UnregisterColumn(DataGridColumn<TItem> column)
    {
        if (_columns.Remove(column))
        {
            _ = InvokeAsync(StateHasChanged);
        }

        _sortDescriptors.RemoveAll(s => s.ColumnKey == column.Key);
    }

    private string GetClass()
    {
        const string baseClass = "cn-data-grid";
        return string.IsNullOrWhiteSpace(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetHeaderCellClass(DataGridColumn<TItem> column)
    {
        var className = $"cn-data-grid-head {column.GetHeaderClass()}";
        return CanSort(column) ? $"{className} cn-data-grid-sortable-head" : className;
    }

    private string GetCellClass(DataGridColumn<TItem> column)
    {
        return $"cn-data-grid-cell {column.GetCellClass()}";
    }

    private bool CanSort(DataGridColumn<TItem> column)
    {
        return AllowSorting && (column.Sortable ?? !string.IsNullOrWhiteSpace(column.Property));
    }

    private bool CanFilter(DataGridColumn<TItem> column)
    {
        return AllowFiltering && (column.Filterable ?? !string.IsNullOrWhiteSpace(column.Property));
    }

    private DataGridSortDirection GetSortDirection(DataGridColumn<TItem> column)
    {
        var descriptor = _sortDescriptors.FirstOrDefault(s => s.ColumnKey == column.Key);
        return descriptor?.Direction ?? DataGridSortDirection.None;
    }

    private int? GetSortOrder(DataGridColumn<TItem> column)
    {
        var descriptor = _sortDescriptors.FirstOrDefault(s => s.ColumnKey == column.Key);
        return descriptor?.Order;
    }

    private string GetSortIndicator(DataGridColumn<TItem> column)
    {
        return GetSortDirection(column) switch
        {
            DataGridSortDirection.Ascending => "Asc",
            DataGridSortDirection.Descending => "Desc",
            _ => "Sort"
        };
    }

    private async Task ToggleSort(DataGridColumn<TItem> column, MouseEventArgs eventArgs)
    {
        var additive = AllowMultiSort && eventArgs.CtrlKey;
        var existing = _sortDescriptors.FirstOrDefault(s => s.ColumnKey == column.Key);
        var nextDirection = existing?.Direction switch
        {
            DataGridSortDirection.Ascending => DataGridSortDirection.Descending,
            DataGridSortDirection.Descending => DataGridSortDirection.None,
            _ => DataGridSortDirection.Ascending
        };

        if (!additive)
        {
            _sortDescriptors.Clear();
        }

        if (existing is not null)
        {
            _sortDescriptors.Remove(existing);
        }

        if (nextDirection != DataGridSortDirection.None)
        {
            _sortDescriptors.Add(new DataGridSortDescriptor(column.Key, column.Property ?? column.Key, nextDirection, _sortDescriptors.Count));
        }

        PageIndex = 0;
        await PageIndexChanged.InvokeAsync(PageIndex);
        await SortChanged.InvokeAsync(_sortDescriptors.ToList());
        await NotifyStateChanged();
    }

    private string GetFilterValue(DataGridColumn<TItem> column)
    {
        var descriptor = _filterDescriptors.FirstOrDefault(f => f.ColumnKey == column.Key);
        return descriptor?.Value ?? string.Empty;
    }

    private async Task UpdateFilter(DataGridColumn<TItem> column, string? value)
    {
        _filterDescriptors.RemoveAll(f => f.ColumnKey == column.Key);

        if (!string.IsNullOrWhiteSpace(value))
        {
            _filterDescriptors.Add(new DataGridFilterDescriptor(
                column.Key,
                column.Property ?? column.Key,
                "Contains",
                value));
        }

        PageIndex = 0;
        await PageIndexChanged.InvokeAsync(PageIndex);
        await FilterChanged.InvokeAsync(_filterDescriptors.ToList());
        await NotifyStateChanged();
    }

    private IReadOnlyList<TItem> GetCurrentPageItems()
    {
        var items = GetFilteredAndSortedItems().ToList();

        if (!AllowPaging)
        {
            return items;
        }

        var pageIndex = Math.Clamp(PageIndex, 0, TotalPages - 1);
        return items.Skip(pageIndex * EffectivePageSize).Take(EffectivePageSize).ToList();
    }

    private IEnumerable<TItem> GetFilteredAndSortedItems()
    {
        var query = Items ?? Enumerable.Empty<TItem>();

        foreach (var filter in _filterDescriptors)
        {
            var column = VisibleColumns.FirstOrDefault(candidate => candidate.Key == filter.ColumnKey);

            if (column is null)
            {
                continue;
            }

            query = query.Where(item => column
                .FormatValue(item)
                .Contains(filter.Value, StringComparison.CurrentCultureIgnoreCase));
        }

        var activeSorts = _sortDescriptors.Where(s => s.Direction != DataGridSortDirection.None).ToList();
        if (activeSorts.Count > 0)
        {
            IOrderedEnumerable<TItem>? ordered = null;

            foreach (var descriptor in activeSorts)
            {
                var column = VisibleColumns.FirstOrDefault(c => c.Key == descriptor.ColumnKey);
                if (column is null) continue;

                if (ordered is null)
                {
                    ordered = descriptor.Direction == DataGridSortDirection.Ascending
                        ? query.OrderBy(item => GetComparableSortValue(column.GetValue(item)))
                        : query.OrderByDescending(item => GetComparableSortValue(column.GetValue(item)));
                }
                else
                {
                    ordered = descriptor.Direction == DataGridSortDirection.Ascending
                        ? ordered.ThenBy(item => GetComparableSortValue(column.GetValue(item)))
                        : ordered.ThenByDescending(item => GetComparableSortValue(column.GetValue(item)));
                }
            }

            query = ordered ?? query;
        }

        return query;
    }

    private static object? GetComparableSortValue(object? value)
    {
        return value is IComparable ? value : value?.ToString();
    }

    private bool IsSelected(TItem item)
    {
        return _selectedRowKeys.Contains(GetRowKey(item));
    }

    private HashSet<TItem> GetSelectedItems()
    {
        var items = Items ?? Enumerable.Empty<TItem>();
        return items.Where(item => _selectedRowKeys.Contains(GetRowKey(item))).ToHashSet();
    }

    private TItem? GetSelectedItem()
    {
        var items = Items ?? Enumerable.Empty<TItem>();
        return items.FirstOrDefault(item => _selectedRowKeys.Contains(GetRowKey(item)));
    }

    private async Task ToggleSelection(TItem item)
    {
        if (SelectionMode == DataGridSelectionMode.None)
        {
            return;
        }

        var key = GetRowKey(item);

        if (SelectionMode == DataGridSelectionMode.Single)
        {
            if (_selectedRowKeys.Contains(key))
            {
                _selectedRowKeys.Clear();
                SelectedItem = default;
            }
            else
            {
                _selectedRowKeys.Clear();
                _selectedRowKeys.Add(key);
                SelectedItem = item;
            }

            await SelectedItemChanged.InvokeAsync(GetSelectedItem());
            await SelectedItemsChanged.InvokeAsync(GetSelectedItems());
            await NotifyStateChanged();
            return;
        }

        if (!_selectedRowKeys.Add(key))
        {
            _selectedRowKeys.Remove(key);
        }

        await SelectedItemsChanged.InvokeAsync(GetSelectedItems());
        await NotifyStateChanged();
    }

    private bool IsAllVisibleSelected()
    {
        var visible = CurrentPageItems;
        return visible.Count > 0 && visible.All(item => _selectedRowKeys.Contains(GetRowKey(item)));
    }

    private async Task ToggleSelectAll(ChangeEventArgs args)
    {
        if (SelectionMode != DataGridSelectionMode.Multiple)
        {
            return;
        }

        if (args.Value is true)
        {
            foreach (var item in CurrentPageItems)
            {
                _selectedRowKeys.Add(GetRowKey(item));
            }
        }
        else
        {
            foreach (var item in CurrentPageItems)
            {
                _selectedRowKeys.Remove(GetRowKey(item));
            }
        }

        await SelectedItemsChanged.InvokeAsync(GetSelectedItems());
        await NotifyStateChanged();
    }

    private string GetRowKey(TItem item)
    {
        if (item is null)
        {
            return Guid.NewGuid().ToString();
        }

        return ItemKey?.Invoke(item) ?? item.GetHashCode().ToString();
    }

    private bool IsDetailExpanded(TItem item)
    {
        return _expandedRowKeys.Contains(GetRowKey(item));
    }

    private async Task ToggleDetailRow(TItem item)
    {
        var key = GetRowKey(item);
        if (!_expandedRowKeys.Add(key))
        {
            _expandedRowKeys.Remove(key);
        }

        await NotifyStateChanged();
    }

    private DataGridStateRepresentation GetStateRepresentation()
    {
        return new DataGridStateRepresentation(
            PageIndex,
            PageSize,
            _sortDescriptors.ToList(),
            _filterDescriptors.ToList(),
            _selectedRowKeys.ToList(),
            _expandedRowKeys.ToList());
    }

    private async Task NotifyStateChanged()
    {
        if (StateChanged.HasDelegate)
        {
            await StateChanged.InvokeAsync(GetStateRepresentation());
        }
    }

    private async Task HandleCellKeyDown(KeyboardEventArgs eventArgs, TItem item, DataGridColumn<TItem> column)
    {
        if (eventArgs.Key == "Enter" || eventArgs.Key == " ")
        {
            if (DetailTemplate is not null)
            {
                await ToggleDetailRow(item);
            }
            else if (SelectionMode != DataGridSelectionMode.None)
            {
                await ToggleSelection(item);
            }
        }
    }

    private async Task GoToPreviousPage()
    {
        PageIndex = Math.Max(0, PageIndex - 1);
        await PageIndexChanged.InvokeAsync(PageIndex);
        await NotifyStateChanged();
    }

    private async Task GoToNextPage()
    {
        PageIndex = Math.Min(TotalPages - 1, PageIndex + 1);
        await PageIndexChanged.InvokeAsync(PageIndex);
        await NotifyStateChanged();
    }
}
