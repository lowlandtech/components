@namespace LowlandTech.Components.Breadcrumb
@inherits TinyComponentBase

<span data-slot="breadcrumb-page"
      role="link"
      aria-disabled="true"
      aria-current="page"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private string GetClass()
    {
        var baseClass = "cn-breadcrumb-page";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
