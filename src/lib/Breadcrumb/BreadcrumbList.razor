@namespace LowlandTech.Components.Breadcrumb
@inherits TinyComponentBase

<ol data-slot="breadcrumb-list"
    class="@GetClass()"
    @attributes="AdditionalAttributes">
    @ChildContent
</ol>

@code {
    private string GetClass()
    {
        var baseClass = "cn-breadcrumb-list flex flex-wrap items-center wrap-break-word";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
