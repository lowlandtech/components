@namespace LowlandTech.Components.Slider
@inherits TinyComponentBase
@inject IJSRuntime JSRuntime

<CascadingValue Value="this">
    <div data-slot="slider"
         data-orientation="@Orientation"
         data-disabled="@Disabled"
         class="@GetClass()"
         role="slider"
         aria-valuemin="@Min"
         aria-valuemax="@Max"
         aria-valuenow="@GetCurrentValue()"
         aria-disabled="@Disabled.ToString().ToLower()"
         aria-orientation="@Orientation"
         tabindex="@GetTabIndex()"
         @ref="_element"
         @onpointerdown="OnPointerDown"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Orientation { get; set; } = "horizontal";
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double[]? ValueRange { get; set; }
    [Parameter] public EventCallback<double[]> ValueRangeChanged { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _jsModule;
    private bool _isDragging;
    private double _trackLeft;
    private double _trackTop;
    private double _trackWidth;
    private double _trackHeight;

    private string GetClass()
    {
        var baseClass = "cn-slider relative flex touch-none select-none items-center data-[orientation=vertical]:h-full data-[orientation=vertical]:w-1.5 data-[orientation=vertical]:flex-col data-[disabled]:pointer-events-none data-[disabled]:opacity-50";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetCurrentValue()
    {
        return ValueRange != null && ValueRange.Length > 0
            ? string.Join(",", ValueRange)
            : Value.ToString();
    }

    private string GetTabIndex() => Disabled ? "-1" : "0";

    internal async Task UpdateValueAsync(double newValue)
    {
        if (Disabled) return;

        var clampedValue = Math.Clamp(newValue, Min, Max);
        var steppedValue = Math.Round((clampedValue - Min) / Step) * Step + Min;

        if (Math.Abs(Value - steppedValue) > 0.0001)
        {
            Value = steppedValue;
            await ValueChanged.InvokeAsync(Value);
            StateHasChanged();
        }
    }

    internal double GetPercentage(double value)
    {
        return ((value - Min) / (Max - Min)) * 100;
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (Disabled) return;

        _isDragging = true;
        try
        {
            _jsModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/LowlandTech.Components/js/slider.js");
            await _jsModule.InvokeVoidAsync("setPointerCapture", _element, e.PointerId);

            var rect = await _jsModule.InvokeAsync<TrackRect>("getBoundingClientRect", _element);
            if (rect != null)
            {
                _trackLeft = rect.Left;
                _trackTop = rect.Top;
                _trackWidth = rect.Width;
                _trackHeight = rect.Height;
            }
        }
        catch (JSDisconnectedException)
        {
            // Ignore
        }
        catch
        {
            // JS interop may not be available in test environments
        }

        await UpdateValueFromPointer(e.ClientX, e.ClientY);
    }

    private async Task OnPointerMove(PointerEventArgs e)
    {
        if (!_isDragging) return;
        await UpdateValueFromPointer(e.ClientX, e.ClientY);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (!_isDragging) return;
        _isDragging = false;
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("releasePointerCapture", _element, e.PointerId);
        }
    }

    private async Task UpdateValueFromPointer(double clientX, double clientY)
    {
        double percentage;
        if (Orientation == "vertical")
        {
            percentage = _trackHeight > 0 ? (_trackTop + _trackHeight - clientY) / _trackHeight * 100 : 0;
        }
        else
        {
            percentage = _trackWidth > 0 ? (clientX - _trackLeft) / _trackWidth * 100 : 0;
        }

        var newValue = Min + (percentage / 100) * (Max - Min);
        await UpdateValueAsync(newValue);
    }

    private class TrackRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
