@namespace LowlandTech.Components.Work
@inherits TinyComponentBase

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div data-slot="work-error-banner" class="@GetClass()" @attributes="AdditionalAttributes">
        <Alert Variant="destructive" class="border-rose-200 bg-rose-50 text-rose-900 dark:border-rose-800/60 dark:bg-rose-950/20 dark:text-rose-200">
            <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2">
                    <Icon Name="circle-alert" Size="18" />
                    <span class="text-sm font-medium">@Error</span>
                </div>
                <Button data-testid="work-error-dismiss"
                        Variant="ghost" Size="icon-sm"
                        OnClick="DismissAsync"
                        class="shrink-0 text-rose-700 hover:bg-rose-100 dark:text-rose-300 dark:hover:bg-rose-950/40">
                    <Icon Name="x" Size="16" />
                </Button>
            </div>
        </Alert>
    </div>
}

@code {
    private string GetClass()
    {
        var baseClass = "w-full";
        return string.IsNullOrWhiteSpace(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
