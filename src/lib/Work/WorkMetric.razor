@namespace LowlandTech.Components.Work
@inherits TinyComponentBase

@if (!string.IsNullOrWhiteSpace(Metric.Url))
{
    <a href="@Metric.Url" data-slot="work-metric" class="@GetClass()" @attributes="AdditionalAttributes">
        <div class="flex flex-col items-center gap-1 p-4">
            <span class="text-2xl font-bold tracking-tight">@(Metric.Value ?? "—")</span>
            <span class="text-xs font-medium text-muted-foreground">@Metric.Title</span>
        </div>
    </a>
}
else if (OnClick.HasDelegate)
{
    <button type="button"
            data-testid="work-metric-button"
            data-slot="work-metric"
            class="@GetClass()"
            @onclick="@(() => OnClick.InvokeAsync())"
            @attributes="AdditionalAttributes">
        <div class="flex flex-col items-center gap-1 p-4">
            <span class="text-2xl font-bold tracking-tight">@(Metric.Value ?? "—")</span>
            <span class="text-xs font-medium text-muted-foreground">@Metric.Title</span>
        </div>
    </button>
}
else
{
    <div data-slot="work-metric" class="@GetClass()" @attributes="AdditionalAttributes">
        <div class="flex flex-col items-center gap-1 p-4">
            <span class="text-2xl font-bold tracking-tight">@(Metric.Value ?? "—")</span>
            <span class="text-xs font-medium text-muted-foreground">@Metric.Title</span>
        </div>
    </div>
}

@code {
    [Parameter] public WorkMetricItem Metric { get; set; } = new("", null);
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetClass()
    {
        var baseClass = "rounded-lg border transition-colors";
        var styleClass = Metric.Style switch
        {
            WorkMetricStyle.Success => "border-emerald-200 bg-emerald-50 text-emerald-900 hover:bg-emerald-100 dark:border-emerald-800/60 dark:bg-emerald-950/10 dark:text-emerald-200 dark:hover:bg-emerald-950/25",
            WorkMetricStyle.Warning => "border-amber-200 bg-amber-50 text-amber-900 hover:bg-amber-100 dark:border-amber-800/60 dark:bg-amber-950/10 dark:text-amber-200 dark:hover:bg-amber-950/25",
            WorkMetricStyle.Danger => "border-rose-200 bg-rose-50 text-rose-900 hover:bg-rose-100 dark:border-rose-800/60 dark:bg-rose-950/10 dark:text-rose-200 dark:hover:bg-rose-950/25",
            WorkMetricStyle.Info => "border-blue-200 bg-blue-50 text-blue-900 hover:bg-blue-100 dark:border-blue-800/60 dark:bg-blue-950/10 dark:text-blue-200 dark:hover:bg-blue-950/25",
            WorkMetricStyle.Null => "border-dashed border-border bg-muted/30 text-muted-foreground",
            _ => "border-border bg-card text-card-foreground hover:bg-muted/50"
        };
        return $"{baseClass} {styleClass} {Class}".Trim();
    }
}
