@namespace LowlandTech.Components.Work
@inherits TinyComponentBase
@inject IServiceProvider Services

<Badge data-slot="work-state-badge"
       class="@GetClass()"
       @attributes="AdditionalAttributes">
    @GetLabel()
</Badge>

@code {
    [Parameter] public WorkItemState State { get; set; }
    [Parameter] public string? CustomLabel { get; set; }

    private IStringLocalizer<WorkStateBadgeStrings>? _localizer;

    protected override void OnInitialized()
    {
        _localizer = Services.GetService<IStringLocalizer<WorkStateBadgeStrings>>();
    }

    private string GetClass() => State switch
    {
        WorkItemState.Succeeded => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300",
        WorkItemState.Failed => "bg-rose-100 text-rose-800 dark:bg-rose-950/50 dark:text-rose-300",
        WorkItemState.Processing => "bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300",
        WorkItemState.Scheduled => "bg-blue-100 text-blue-800 dark:bg-blue-950/50 dark:text-blue-300",
        WorkItemState.Enqueued => "bg-muted text-muted-foreground",
        WorkItemState.Deleted => "bg-slate-100 text-slate-600 dark:bg-slate-900 dark:text-slate-400 line-through",
        WorkItemState.Awaiting => "bg-violet-100 text-violet-800 dark:bg-violet-950/50 dark:text-violet-300",
        WorkItemState.Retry => "bg-orange-100 text-orange-800 dark:bg-orange-950/50 dark:text-orange-300",
        _ => "bg-muted text-muted-foreground"
    };

    private string GetLabel() => !string.IsNullOrWhiteSpace(CustomLabel)
        ? CustomLabel
        : _localizer?[State.ToString()] ?? State.ToString();
}
