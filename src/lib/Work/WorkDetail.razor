@namespace LowlandTech.Components.Work
@inherits TinyComponentBase

<div data-slot="work-detail" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (Job is null)
    {
        <div data-testid="work-detail-empty" class="flex flex-col items-center justify-center gap-2 px-3 py-12 text-sm text-muted-foreground">
            <Icon Name="file-search" Size="24" class="opacity-40" />
            <p>Select a job to view details.</p>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-4 p-4">
            <header class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <WorkStateBadge State="Job.State" />
                        <span class="font-mono text-xs text-muted-foreground">@Job.Id</span>
                    </div>
                    <h3 class="text-lg font-semibold">@Job.JobDisplayName</h3>
                </div>
                @if (!IsReadOnly)
                {
                    <div class="flex items-center gap-2">
                        <Button data-testid="work-detail-requeue"
                                Variant="outline" Size="sm"
                                OnClick="@(() => OnCommand.InvokeAsync(new WorkCommandSubmitted("requeue", new List<string> { Job.Id })))">
                            <Icon Name="refresh-cw" Size="14" />
                            Requeue
                        </Button>
                        <Button data-testid="work-detail-delete"
                                Variant="destructive" Size="sm"
                                OnClick="@(() => OnCommand.InvokeAsync(new WorkCommandSubmitted("delete", new List<string> { Job.Id })))">
                            <Icon Name="trash-2" Size="14" />
                            Delete
                        </Button>
                    </div>
                }
            </header>

            @if (Job.IsExpired)
            {
                <Alert Variant="warning">This job has expired.</Alert>
            }

            @if (!string.IsNullOrWhiteSpace(Job.ExceptionType))
            {
                <Alert Variant="destructive">
                    <div class="space-y-1">
                        <p class="font-medium">@Job.ExceptionType</p>
                        <p class="text-sm">@Job.ExceptionMessage</p>
                    </div>
                </Alert>
            }

            <section class="rounded-lg border border-border">
                <header class="border-b border-border px-3 py-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Parameters</header>
                @if (Job.Parameters?.Count > 0)
                {
                    <div class="divide-y divide-border">
                        @foreach (var param in Job.Parameters)
                        {
                            <div class="flex gap-2 px-3 py-2">
                                <span class="text-xs font-medium text-muted-foreground w-32 shrink-0">@param.Key</span>
                                <pre class="text-xs font-mono truncate">@param.Value</pre>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="px-3 py-4 text-sm text-muted-foreground">No parameters.</div>
                }
            </section>

            <section>
                <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">State History</h4>
                <WorkTimeline History="History" />
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public WorkItem? Job { get; set; }
    [Parameter] public IReadOnlyList<WorkStateHistory> History { get; set; } = [];
    [Parameter] public IReadOnlyList<WorkItem> Continuations { get; set; } = [];
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback<WorkCommandSubmitted> OnCommand { get; set; }

    private string GetClass() => string.IsNullOrEmpty(Class)
        ? "rounded-lg border border-border bg-card"
        : $"rounded-lg border border-border bg-card {Class}";
}
