@namespace LowlandTech.Components.Work
@inherits TinyComponentBase

<div data-slot="work-server" class="@GetClass()" @attributes="AdditionalAttributes">
    <DataGrid TItem="WorkServerItem"
              Items="Servers"
              SelectionMode="DataGridSelectionMode.None"
              AllowSorting="false"
              AllowFiltering="false"
              AllowPaging="false"
              EmptyText="No servers available.">
        <Columns>
            <DataGridColumn TItem="WorkServerItem" Property="Name" Title="Name" />
            <DataGridColumn TItem="WorkServerItem" Property="Workers" Title="Workers" />
            <DataGridColumn TItem="WorkServerItem" Title="Queues">
                <Template Context="server">
                    <div class="flex flex-wrap gap-1">
                        @foreach (var queue in server.Queues)
                        {
                            <Badge Variant="outline" Size="sm">@queue</Badge>
                        }
                    </div>
                </Template>
            </DataGridColumn>
            <DataGridColumn TItem="WorkServerItem" Title="Started">
                <Template Context="server">
                    <span class="text-muted-foreground">@GetRelativeTime(server.StartedAt)</span>
                </Template>
            </DataGridColumn>
            <DataGridColumn TItem="WorkServerItem" Title="Heartbeat">
                <Template Context="server">
                    <div class="flex items-center gap-1.5">
                        @if (server.HeartbeatAt.HasValue)
                        {
                            var status = GetHeartbeatStatus(server.HeartbeatAt.Value);
                            <Icon Name="@status.Icon" Size="14" class="@status.Class" />
                            <span class="text-xs text-muted-foreground">@GetRelativeTime(server.HeartbeatAt.Value)</span>
                        }
                        else
                        {
                            <span class="text-xs text-muted-foreground">—</span>
                        }
                    </div>
                </Template>
            </DataGridColumn>
        </Columns>
    </DataGrid>
</div>

@code {
    [Parameter] public IReadOnlyList<WorkServerItem> Servers { get; set; } = [];
    [Parameter] public EventCallback<WorkItemSelected> OnSelected { get; set; }

    private record HeartbeatStatus(string Icon, string Class);

    private HeartbeatStatus GetHeartbeatStatus(DateTimeOffset heartbeat)
    {
        var diff = DateTimeOffset.UtcNow - heartbeat;
        return diff.TotalMinutes > 1
            ? new HeartbeatStatus("alert-triangle", "text-rose-500")
            : new HeartbeatStatus("check-circle", "text-emerald-500");
    }

    private static string GetRelativeTime(DateTimeOffset value)
    {
        var diff = DateTimeOffset.UtcNow - value;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private string GetClass() => string.IsNullOrEmpty(Class)
        ? "rounded-lg border border-border bg-card"
        : $"rounded-lg border border-border bg-card {Class}";
}
