@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="work-filter-bar" class="@GetClass()" @attributes="AdditionalAttributes">
    <div class="relative w-full">
        <Icon Name="search" Size="14" class="absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground" />
        <Input type="text"
               data-testid="work-filter-input"
               placeholder="Filter jobs..."
               class="pl-8"
               value="@FilterText"
               @oninput="e => OnFilterChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
    </div>
</div>

@code {
    [Parameter] public string FilterText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnFilterChanged { get; set; }

    private string GetClass() => string.IsNullOrEmpty(Class)
        ? "flex min-w-0 items-center"
        : $"flex min-w-0 items-center {Class}";
}
