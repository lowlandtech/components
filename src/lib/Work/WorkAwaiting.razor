@namespace LowlandTech.Components.Work
@inherits TinyComponentBase

<div data-slot="work-awaiting" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (Jobs.Count == 0)
    {
        <div data-testid="work-awaiting-empty" class="px-3 py-4 text-sm text-muted-foreground">No awaiting jobs.</div>
    }
    else
    {
        <Table>
            <TableHeader>
                <TableRow>
                    @if (!IsReadOnly)
                    {
                        <TableHead class="w-10"><span class="sr-only">Select</span></TableHead>
                    }
                    <TableHead>ID</TableHead>
                    <TableHead>Job</TableHead>
                    <TableHead>Options</TableHead>
                    <TableHead>Parent</TableHead>
                    <TableHead>Since</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var job in Jobs)
                {
                    <TableRow data-testid="work-awaiting-row"
                              data-job-id="@job.Id"
                              @onclick="() => SelectAsync(job)"
                              class="cursor-pointer hover:bg-muted/40">
                        @if (!IsReadOnly)
                        {
                            <TableCell @onclick:stopPropagation>
                                <Checkbox data-testid="work-awaiting-checkbox"
                                          CheckedChanged="_ => ToggleAsync(job.Id)"
                                          Disabled="IsReadOnly" />
                            </TableCell>
                        }
                        <TableCell class="font-mono text-xs">@job.Id</TableCell>
                        <TableCell class="font-medium">@job.JobDisplayName</TableCell>
                        <TableCell>
                            @if (!string.IsNullOrWhiteSpace(job.ContinuationOptions))
                            {
                                <Badge Variant="outline">@job.ContinuationOptions</Badge>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-sm">—</span>
                            }
                        </TableCell>
                        <TableCell>
                            @if (!string.IsNullOrWhiteSpace(job.ParentId))
                            {
                                <button data-testid="work-awaiting-parent"
                                        type="button"
                                        class="inline-flex"
                                        @onclick:stopPropagation
                                        @onclick="() => SelectParentAsync(job.ParentId!)">
                                    <WorkStateBadge State="WorkItemState.Succeeded" CustomLabel="@job.ParentId" />
                                </button>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-sm">—</span>
                            }
                        </TableCell>
                        <TableCell class="text-muted-foreground text-sm">@GetRelativeTime(job.CreatedAt)</TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
</div>
