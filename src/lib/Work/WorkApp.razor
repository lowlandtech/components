@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="work-app"
     data-testid="work-app"
     data-active-view="@Context.State.Ui.ActiveView.ToString().ToLowerInvariant()"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="Context" IsFixed="false">
        @if (ChildContent is null)
        {
            <WorkAppSidebar />
            <WorkAppMain>
                <WorkAppHeader />
                <WorkAppContent />
                <WorkAppFooter />
                <WorkAppCommandBar />
            </WorkAppMain>
            <WorkAppDetailPanel />
        }
        else
        {
            @ChildContent
        }
    </CascadingValue>
</div>
