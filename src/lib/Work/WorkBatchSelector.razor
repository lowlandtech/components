@namespace LowlandTech.Components.Work
@inherits TinyComponentBase

<div data-slot="work-batch-selector" class="@GetClass()" @attributes="AdditionalAttributes">
    <div class="flex items-center gap-3">
        <Checkbox data-testid="work-batch-select-all"
                  Checked="IsAllSelected"
                  CheckedChanged="OnSelectAllChangedAsync"
                  Disabled="TotalCount == 0" />
        <span class="text-sm font-medium">Select All</span>
    </div>
    @if (SelectedCount > 0)
    {
        <div data-slot="work-batch-status" class="ml-3 flex items-center">
            <Badge data-testid="work-batch-count" Variant="secondary">@SelectedCount of @TotalCount selected</Badge>
        </div>
    }
</div>

@code {
    private string GetClass()
    {
        var baseClass = "mb-3 flex h-10 items-center justify-between rounded-md border border-border bg-muted/30 px-3";
        return string.IsNullOrWhiteSpace(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
