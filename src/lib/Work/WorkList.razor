@namespace LowlandTech.Components.Work
@inherits TinyComponentBase

<div data-slot="work-list" class="@GetClass()" @attributes="AdditionalAttributes">
    @if (Jobs.Count == 0)
    {
        <div data-testid="work-list-empty" class="flex flex-col items-center justify-center gap-2 px-3 py-12 text-sm text-muted-foreground">
            <Icon Name="inbox" Size="24" class="opacity-40" />
            <p>No jobs found.</p>
        </div>
    }
    else
    {
        <Table>
            <TableHeader>
                <TableRow>
                    @if (!IsReadOnly)
                    {
                        <TableHead class="w-10">
                            <input type="checkbox"
                                   class="h-4 w-4 rounded border-border"
                                   checked="@IsAllSelected()"
                                   @onchange="ToggleSelectAll" />
                        </TableHead>
                    }
                    <TableHead>ID</TableHead>
                    <TableHead>State</TableHead>
                    <TableHead>Job</TableHead>
                    <TableHead>Timestamp</TableHead>
                    @if (ShowServerColumn)
                    {
                        <TableHead>Server</TableHead>
                    }
                    @if (ShowQueueColumn)
                    {
                        <TableHead>Queue</TableHead>
                    }
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var job in Jobs)
                {
                    <TableRow data-testid="work-list-row"
                              data-job-id="@job.Id"
                              @onclick="() => OnSelected.InvokeAsync(new WorkItemSelected(job.Id))"
                              class="@GetRowClass(job)">
                        @if (!IsReadOnly)
                        {
                            <TableCell @onclick:stopPropagation>
                                <input type="checkbox"
                                       class="h-4 w-4 rounded border-border"
                                       checked="@State.SelectedJobIds.Contains(job.Id)"
                                       @onchange="() => OnToggleSelection.InvokeAsync(new ToggleWorkSelection(job.Id))" />
                            </TableCell>
                        }
                        <TableCell class="font-mono text-xs">@SafeId(job.Id)</TableCell>
                        <TableCell><WorkStateBadge State="job.State" /></TableCell>
                        <TableCell class="font-medium">@job.JobDisplayName</TableCell>
                        <TableCell class="text-muted-foreground text-sm">@GetTimestamp(job)</TableCell>
                        @if (ShowServerColumn)
                        {
                            <TableCell class="text-sm">@(job.ServerName ?? "—")</TableCell>
                        }
                        @if (ShowQueueColumn)
                        {
                            <TableCell class="text-sm">@(job.QueueName ?? "—")</TableCell>
                        }
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
</div>

@code {
    [Parameter] public WorkUiState State { get; set; } = WorkUiDefaults.Empty;
    [Parameter] public IReadOnlyList<WorkItem> Jobs { get; set; } = [];
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool ShowServerColumn { get; set; }
    [Parameter] public bool ShowQueueColumn { get; set; }
    [Parameter] public EventCallback<WorkItemSelected> OnSelected { get; set; }
    [Parameter] public EventCallback<ToggleWorkSelection> OnToggleSelection { get; set; }
    [Parameter] public EventCallback<bool> OnSelectAll { get; set; }

    private bool IsAllSelected() => Jobs.Count > 0 && Jobs.All(j => State.SelectedJobIds.Contains(j.Id));

    private async Task ToggleSelectAll(ChangeEventArgs e)
    {
        var select = e.Value is true;
        await OnSelectAll.InvokeAsync(select);
    }

    private string GetRowClass(WorkItem job) => job.IsExpired
        ? "opacity-50 line-through cursor-pointer hover:bg-muted/40"
        : "cursor-pointer hover:bg-muted/40";

    private static string GetTimestamp(WorkItem job) => job.State switch
    {
        WorkItemState.Enqueued => GetRelativeTime(job.EnqueuedAt ?? job.CreatedAt),
        WorkItemState.Scheduled => GetRelativeTime(job.ScheduledAt ?? job.CreatedAt),
        WorkItemState.Processing => GetRelativeTime(job.StartedAt ?? job.CreatedAt),
        WorkItemState.Succeeded => GetRelativeTime(job.SucceededAt ?? job.CreatedAt),
        WorkItemState.Failed => GetRelativeTime(job.FailedAt ?? job.CreatedAt),
        WorkItemState.Deleted => GetRelativeTime(job.DeletedAt ?? job.CreatedAt),
        _ => GetRelativeTime(job.CreatedAt)
    };

    private static string GetRelativeTime(DateTimeOffset value)
    {
        var diff = DateTimeOffset.UtcNow - value;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private string GetClass() => string.IsNullOrEmpty(Class)
        ? "rounded-lg border border-border bg-card"
        : $"rounded-lg border border-border bg-card {Class}";
}
