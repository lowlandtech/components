
@namespace LowlandTech.Components.Toggle
@inherits TinyComponentBase

<button data-slot="toggle"
        data-variant="@VariantValue"
        data-size="@SizeValue"
        type="button"
        aria-pressed="@Pressed.ToString().ToLowerInvariant()"
        class="@CssClass"
        @onclick="ToggleAsync"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>