@namespace LowlandTech.Components.Card
@inherits LtComponentBase

<div data-slot="card"
     data-size="@Size"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-card group/card flex flex-col";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
