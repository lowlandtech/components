@namespace LowlandTech.Components.Card
@inherits TinyComponentBase

<div data-slot="card"
     data-size="@Size"
     data-variant="@Variant"
     data-elevation="@Elevation"
     data-square="@(Square ? "true" : null)"
     data-mode="@NormalizedMode"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    public const string ModeNormal = "normal";
    public const string ModeMinimized = "minimized";
    public const string ModeMaximized = "maximized";
    public const string ModeOverlayPage = "overlay-page";
    public const string ModeOverlayApp = "overlay-app";

    private string NormalizedMode => Mode?.ToLowerInvariant() switch
    {
        ModeMinimized => ModeMinimized,
        ModeMaximized => ModeMaximized,
        ModeOverlayPage => ModeOverlayPage,
        ModeOverlayApp => ModeOverlayApp,
        _ => ModeNormal
    };

    private string GetClass()
    {
        var baseClass = "cn-card card group/card";

        if (Variant != "outlined")
        {
            baseClass += " " + GetShadowClass(Elevation);
        }

        baseClass += NormalizedMode switch
        {
            ModeMinimized => " overflow-hidden",
            ModeMaximized => " flex min-h-full w-full flex-col overflow-hidden",
            ModeOverlayPage => " flex min-h-full w-full flex-col overflow-hidden",
            ModeOverlayApp => " fixed inset-0 z-50 flex h-dvh w-dvw flex-col overflow-hidden rounded-none",
            _ => ""
        };

        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private static string GetShadowClass(int elevation)
    {
        if (elevation <= 0) return "shadow-none";
        if (elevation <= 1) return "shadow-sm";
        if (elevation <= 2) return "shadow";
        if (elevation <= 3) return "shadow-md";
        if (elevation <= 5) return "shadow-lg";
        if (elevation <= 8) return "shadow-xl";
        return "shadow-2xl";
    }
}
