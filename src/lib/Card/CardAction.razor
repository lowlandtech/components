@namespace LowlandTech.Components.Card
@inherits LtComponentBase

<div data-slot="card-action"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-card-action card-action col-start-2 row-span-2 row-start-1 self-start justify-self-end";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
