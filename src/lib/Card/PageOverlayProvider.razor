@namespace LowlandTech.Components
@inject IPageOverlayService Service
@implements IDisposable

@if (Service.Content is not null)
{
    <div class="@GetContainerClass()">
        @Service.Content
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Service.OnChanged += OnServiceChanged;
    }

    private void OnServiceChanged() => InvokeAsync(StateHasChanged);

    private string GetContainerClass() =>
        string.IsNullOrWhiteSpace(Service.ContainerClass)
            ? "page-overlay-container absolute inset-0 z-40 flex h-full w-full flex-col bg-background"
            : Service.ContainerClass;

    public void Dispose()
    {
        Service.OnChanged -= OnServiceChanged;
    }
}
