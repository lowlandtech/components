@namespace LowlandTech.Components.ButtonGroup
@inherits TinyComponentBase

<div data-slot="button-group"
     data-orientation="@Orientation"
     role="group"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// The orientation of the button group.
    /// </summary>
    [Parameter] public string Orientation { get; set; } = "horizontal";

    private string GetClass()
    {
        var baseClass = "cn-button-group flex w-fit items-stretch *:focus-visible:relative *:focus-visible:z-10 [&>[data-slot=select-trigger]:not([class*='w-'])]:w-fit [&>input]:flex-1";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
