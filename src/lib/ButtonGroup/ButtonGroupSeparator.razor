@namespace LowlandTech.Components.ButtonGroup
@inherits TinyComponentBase

<div data-slot="button-group-separator"
     data-orientation="@Orientation"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
</div>

@code {
    /// <summary>
    /// The orientation of the separator.
    /// </summary>
    [Parameter] public string Orientation { get; set; } = "vertical";

    private string GetClass()
    {
        var baseClass = "cn-button-group-separator relative self-stretch data-horizontal:mx-px data-horizontal:w-auto data-vertical:my-px data-vertical:h-auto";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
