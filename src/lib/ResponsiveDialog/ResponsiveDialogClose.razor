@namespace LowlandTech.Components.ResponsiveDialog
@inherits TinyComponentBase

<div data-slot="responsive-dialog-close" class="@Class" @onclick="OnClick" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] private ResponsiveDialog? Parent { get; set; }

    private async Task OnClick()
    {
        if (Parent != null)
        {
            await Parent.Close();
        }
    }
}
