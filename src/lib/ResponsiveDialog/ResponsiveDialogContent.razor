@namespace LowlandTech.Components.ResponsiveDialog
@inherits LtComponentBase

@if (Parent?.IsOpen == true)
{
    @if (Parent.IsMobile)
    {
        <!-- Mobile: Use Drawer -->
        <div data-slot="responsive-dialog-overlay"
             class="cn-responsive-dialog-overlay fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
             @onclick="OnOverlayClick">
        </div>
        <div data-slot="responsive-dialog-drawer-content"
             data-state="open"
             data-direction="@GetDrawerDirection()"
             class="@GetDrawerClass()"
             role="dialog"
             aria-modal="true"
             @attributes="AdditionalAttributes">
            <div class="cn-drawer-handle mx-auto hidden shrink-0"></div>
            @ChildContent
        </div>
    }
    else
    {
        <!-- Desktop: Use Dialog -->
        <div data-slot="responsive-dialog-overlay"
             class="cn-responsive-dialog-overlay fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
             @onclick="OnOverlayClick">
        </div>
        <div data-slot="responsive-dialog-content"
             class="@GetDialogClass()"
             role="dialog"
             aria-modal="true"
             @attributes="AdditionalAttributes">
            @ChildContent
            <button data-slot="responsive-dialog-close"
                    class="cn-responsive-dialog-close absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none"
                    @onclick="OnClose">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span class="sr-only">Close</span>
            </button>
        </div>
    }
}

@code {
    [CascadingParameter] private ResponsiveDialog? Parent { get; set; }
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    private string GetDrawerDirection() => Parent?.DrawerDirection ?? "bottom";

    private void OnOverlayClick()
    {
        if (CloseOnOverlayClick)
            Parent?.Close();
    }

    private void OnClose()
    {
        Parent?.Close();
    }

    private string GetDrawerAnimationClasses()
    {
        var direction = GetDrawerDirection();
        return direction switch
        {
            "left"   => "data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=open]:slide-in-from-left data-[state=closed]:slide-out-to-left",
            "right"  => "data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=open]:slide-in-from-right data-[state=closed]:slide-out-to-right",
            "top"    => "data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=open]:slide-in-from-top data-[state=closed]:slide-out-to-top",
            "bottom" => "data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=open]:slide-in-from-bottom data-[state=closed]:slide-out-to-bottom",
            _        => "data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=open]:slide-in-from-bottom data-[state=closed]:slide-out-to-bottom"
        };
    }

    private string GetDrawerDirectionClasses()
    {
        var direction = GetDrawerDirection();
        return direction switch
        {
            "left"   => "fixed left-0 top-0 h-full w-3/4 sm:w-1/2 md:w-1/3",
            "right"  => "fixed right-0 top-0 h-full w-3/4 sm:w-1/2 md:w-1/3",
            "top"    => "fixed top-0 left-0 w-full h-1/2 sm:h-1/3",
            "bottom" => "fixed bottom-0 left-0 w-full h-1/2 sm:h-1/3",
            _        => "fixed bottom-0 left-0 w-full h-1/2 sm:h-1/3"
        };
    }

    private string GetDrawerClass()
    {
        var baseClass = $"cn-responsive-dialog-drawer group/responsive-dialog-drawer z-50 bg-white flex flex-col {GetDrawerDirectionClasses()} {GetDrawerAnimationClasses()}";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetDialogClass()
    {
        var baseClass = "cn-responsive-dialog-content fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg duration-200 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%] sm:rounded-lg";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
