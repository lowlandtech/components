@namespace LowlandTech.Components.ResponsiveDialog
@inherits TinyComponentBase

<button data-slot="responsive-dialog-trigger"
        class="@GetClass()"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [CascadingParameter] private ResponsiveDialog? Parent { get; set; }

    private async Task OnClick()
    {
        if (Parent != null)
        {
            await Parent.Open();
        }
    }

    private string GetClass()
    {
        var baseClass = "cn-responsive-dialog-trigger";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
