@namespace LowlandTech.Components.ResponsiveDialog
@inherits LtComponentBase

<p data-slot="responsive-dialog-description" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    private string GetClass()
    {
        var baseClass = "cn-responsive-dialog-description text-sm text-muted-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
