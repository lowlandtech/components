@namespace LowlandTech.Components.ResponsiveDialog
@inherits TinyComponentBase

<h2 data-slot="responsive-dialog-title" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</h2>

@code {
    private string GetClass()
    {
        var baseClass = "cn-responsive-dialog-title text-lg font-semibold leading-none tracking-tight";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
