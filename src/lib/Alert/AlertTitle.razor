@namespace LowlandTech.Components.Alert
@inherits TinyComponentBase

<h5 data-slot="alert-title"
    class="@GetClass()"
    @attributes="AdditionalAttributes">
    @ChildContent
</h5>

@code {
    private string GetClass()
    {
        var baseClass = "cn-alert-title [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
