@namespace LowlandTech.Components.Alert
@inherits LtComponentBase

<div data-slot="alert-description"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-alert-description [&_p]:leading-relaxed [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
