@namespace LowlandTech.Components
@inherits TinyComponentBase
@implements IDisposable

<div data-slot="navigation-menu-content"
     data-state="@GetState()"
     style="@(IsOpenState ? null : "display: none;")"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] private NavigationMenu? Menu { get; set; }
    [CascadingParameter] private NavigationMenuItem? Item { get; set; }
    [Parameter] public bool IsOpen { get; set; } = true;
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool IsManaged => !string.IsNullOrEmpty(Item?.Value);
    private bool IsOpenState => IsManaged ? (Menu?.IsItemActive(Item?.Value) ?? false) : IsOpen;

    protected override void OnInitialized()
    {
        if (Menu != null)
            Menu.OnActiveValueChanged += OnMenuChanged;
    }

    private void OnMenuChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (Menu != null)
            Menu.OnActiveValueChanged -= OnMenuChanged;
    }

    private string GetState() => IsOpenState ? "open" : "closed";

    private string GetClass()
    {
        var baseClass = "absolute left-0 top-full z-50 min-w-max origin-top-center data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=open]:fade-in-0 data-[state=closed]:fade-out-0 data-[state=open]:zoom-in-95 data-[state=closed]:zoom-out-95 duration-200";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
