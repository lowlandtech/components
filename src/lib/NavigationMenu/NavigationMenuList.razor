@namespace LowlandTech.Components
@inherits TinyComponentBase

<ul data-slot="navigation-menu-list" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</ul>

@code {
    private string GetClass()
    {
        var baseClass = "group flex flex-1 list-none items-center justify-center space-x-1";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
