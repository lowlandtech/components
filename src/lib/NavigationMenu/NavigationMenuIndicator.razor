@namespace LowlandTech.Components.NavigationMenu
@inherits LtComponentBase

<div data-slot="navigation-menu-indicator"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    <div class="top-full relative h-1.5 w-1.5 rotate-45 rounded-tl-sm bg-border shadow-md"></div>
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-navigation-menu-indicator top-full z-1 flex h-1.5 items-end justify-center overflow-hidden";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
