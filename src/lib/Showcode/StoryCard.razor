@namespace LowlandTech.Components
@inject IJSRuntime JS

@if (States.Count > 0)
{
    <section data-slot="story-card" class="@GetClass()">
        @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description))
        {
            <div class="space-y-1 p-4 pb-2">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h2 class="text-base font-semibold text-foreground">@Title</h2>
                }
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="max-w-2xl text-sm text-muted-foreground">@Description</p>
                }
            </div>
        }

        <Tabs Value="@_activeState" ValueChanged="@((v) => _activeState = v)" class="w-full">
            @if (States.Count > 1)
            {
                <div class="flex items-center px-4 pb-3">
                    <TabsList class="story-card-pill-tabs">
                        @foreach (var state in States)
                        {
                            <TabsTrigger Value="@state.Value" class="story-card-pill-tab">
                                @state.Name
                            </TabsTrigger>
                        }
                    </TabsList>
                </div>
            }

            @foreach (var state in States)
            {
                <TabsContent Value="@state.Value" class="mt-0">
                    <div class="relative mx-4 flex min-h-32 items-center justify-center rounded-lg border border-border/70 bg-background p-10">
                        @state.Preview
                    </div>

                    @if (state.CodeTabs.Count > 0)
                    {
                        <Tabs DefaultValue="@state.CodeTabs[0].Value" class="mx-4 mb-4 mt-4 overflow-hidden rounded-lg border border-[#444c56] bg-[#24292E] text-[#c9d1d9] shadow-sm">
                            <div class="flex min-h-12 items-center justify-between gap-3 border-b border-[#444c56] bg-[#2d333b] px-3">
                                <TabsList class="story-card-code-tabs">
                                    @foreach (var codeTab in state.CodeTabs)
                                    {
                                        <TabsTrigger Value="@codeTab.Value" class="story-card-code-tab">
                                            <span class="story-card-file-dot" data-language="@codeTab.Language"></span>
                                            @codeTab.Name
                                        </TabsTrigger>
                                    }
                                </TabsList>
                            </div>

                            @foreach (var codeTab in state.CodeTabs)
                            {
                                <TabsContent Value="@codeTab.Value" class="mt-0">
                                    <div class="relative">
                                        <Button Variant="ghost"
                                                Size="icon-sm"
                                                class="story-card-copy-button text-[#8b949e] hover:bg-[#444c56] hover:text-[#c9d1d9]"
                                                title="@($"Copy {codeTab.Name} code")"
                                                @onclick="() => CopyCode(codeTab)">
                                            <Icon Name="@(CopiedValue == codeTab.Value ? "check" : "copy")" Size="14" />
                                            <span class="sr-only">Copy @codeTab.Name code</span>
                                        </Button>
                                    <div class="story-card-code-editor" data-language="@codeTab.Language">
                                        @foreach (var line in GetHighlightedLines(codeTab))
                                        {
                                            <div class="story-card-code-line">
                                                <span class="story-card-line-number">@line.Number</span>
                                                <code class="story-card-line-code">@((MarkupString)line.Html)</code>
                                            </div>
                                        }
                                    </div>
                                    </div>
                                </TabsContent>
                            }
                        </Tabs>
                    }
                </TabsContent>
            }
        </Tabs>
    </section>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? DefaultState { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<State> States { get; set; } = [];

    private string? CopiedValue { get; set; }

    private string DefaultStateValue => DefaultState ?? States[0].Value;

    private string _activeState = "";

    protected override void OnInitialized() => _activeState = DefaultStateValue;

    private string GetClass()
    {
        var baseClass = "overflow-hidden bg-background text-foreground";
        return string.IsNullOrWhiteSpace(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private async Task CopyCode(CodeTab codeTab)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", codeTab.Code);
        CopiedValue = codeTab.Value;
    }

    public sealed record State(
        string Value,
        string Name,
        RenderFragment Preview,
        IReadOnlyList<CodeTab> CodeTabs);

    public sealed record CodeTab(
        string Value,
        string Name,
        string Code,
        string Language = "razor");

    private static readonly ConcurrentDictionary<HighlightCacheKey, IReadOnlyList<CodeLine>> HighlightedLineCache = new();

    private static IReadOnlyList<CodeLine> GetHighlightedLines(CodeTab codeTab)
    {
        var normalized = codeTab.Code.Replace("\r\n", "\n").TrimEnd('\n');
        var cacheKey = new HighlightCacheKey(normalized, codeTab.Language);

        return HighlightedLineCache.GetOrAdd(cacheKey, key =>
            key.Code.Split('\n')
                .Select((line, index) => new CodeLine(index + 1, HighlightLine(line, key.Language)))
                .ToList());
    }

    private static string HighlightLine(string line, string language)
    {
        try
        {
            return language.Equals("csharp", StringComparison.OrdinalIgnoreCase)
                ? HighlightCSharpLine(line)
                : HighlightMarkupLine(line);
        }
        catch
        {
            // Fallback: return encoded plain text if highlighting fails
            return Encode(line);
        }
    }

    private static string HighlightMarkupLine(string line)
    {
        var encoded = Encode(line);
        encoded = HighlightMarkupAttributes(encoded);
        encoded = HighlightStrings(encoded);
        encoded = HighlightRazorExpressions(encoded);

        foreach (var tag in MarkupTags)
        {
            encoded = encoded.Replace($"&lt;{tag}", $"&lt;<span class=\"story-card-token-tag\">{tag}</span>", StringComparison.Ordinal);
            encoded = encoded.Replace($"&lt;/{tag}", $"&lt;/<span class=\"story-card-token-tag\">{tag}</span>", StringComparison.Ordinal);
        }

        encoded = HighlightMarkupToken(encoded, "&lt;/", "story-card-token-punctuation");
        encoded = HighlightMarkupToken(encoded, "&lt;", "story-card-token-punctuation");
        encoded = HighlightMarkupToken(encoded, "/&gt;", "story-card-token-punctuation");
        encoded = HighlightMarkupToken(encoded, "&gt;", "story-card-token-punctuation");

        return encoded;
    }

    private static string HighlightCSharpLine(string line)
    {
        var encoded = Encode(line);

        // 1. Highlight strings first (they take precedence over everything else)
        encoded = HighlightCSharpStrings(encoded);

        // 2. Highlight comments (take precedence over keywords/types)
        encoded = Regex.Replace(encoded, @"(//.*$)", "<span class=\"story-card-token-comment\">$1</span>", RegexOptions.Multiline);

        // 3. Highlight numbers
        encoded = Regex.Replace(encoded, @"(?<![A-Za-z0-9_&lt;])(0[xX][0-9a-fA-F_]+|0[bB][01_]+|\d[\d_]*\.?\d*([eE][+-]?\d+)?[dfmFlL]?)(?![A-Za-z0-9_&gt;])", "<span class=\"story-card-token-number\">$0</span>");

        // 4. Highlight keywords and types
        foreach (var keyword in CSharpKeywords)
        {
            encoded = HighlightWord(encoded, keyword, "story-card-token-keyword");
        }

        foreach (var type in CSharpTypes)
        {
            encoded = HighlightWord(encoded, type, "story-card-token-type");
        }

        return encoded;
    }

    private static string HighlightCSharpStrings(string encoded)
    {
        var parts = encoded.Split("&quot;");
        if (parts.Length < 3)
        {
            return encoded;
        }

        var result = new List<string>();
        for (var i = 0; i < parts.Length; i++)
        {
            if (i % 2 == 1)
            {
                result.Add($"<span class=\"story-card-token-string\">&quot;{parts[i]}&quot;</span>");
            }
            else
            {
                result.Add(parts[i]);
            }
        }

        return string.Join(string.Empty, result);
    }

