@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="container-grid"
     data-id="@Id"
     data-rows="@Rows"
     data-cols="@Columns"
     data-options="@GridOptionsJson"
     class="lt-container-grid @Class"
     style="@GridStyle"
     @attributes="AdditionalAttributes"
     @onclick="OnClickHandler"
     @onclick:stopPropagation="OnClickStopPropagation"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="OnContextMenuPreventDefault"
     @oncontextmenu:stopPropagation="OnContextMenuStopPropagation"
     @ref="GridElement">
    <CascadingValue Value="@this" IsFixed="true">@ChildContent</CascadingValue>
    <div class="lt-container-grid-overlay" aria-hidden="true"></div>
    <div class="lt-container-grid-placeholder" aria-hidden="true"></div>
</div>
