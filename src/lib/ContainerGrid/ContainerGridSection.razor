@namespace LowlandTech.Components.ContainerGrid
@inherits LtComponentBase

<div data-slot="container-grid-section"
     data-id="@Id"
     data-row="@Row"
     data-col="@Column"
     data-row-span="@RowSpan"
     data-col-span="@ColSpan"
     @ref="ElementReference"
     class="lt-container-grid-section @Class"
     style="@SectionStyle"
     @attributes="AdditionalAttributes"
     @onclick="OnClickHandler"
     @ondblclick="OnDblClickHandler"
     @onclick:stopPropagation="OnClickStopPropagation"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="OnContextMenuPreventDefault"
     @oncontextmenu:stopPropagation="OnContextMenuStopPropagation">
    @ChildContent

    @* ── Selection bezel host ────────────────────────────────────────────
       The whole chrome (resize handles, label, badges, toolbar) lives
       inside this host div. The host is `position: fixed` (escapes any
       parent overflow:auto / stacking context) and its top/left/width/
       height are JS-synced to the section's bbox via ltBezel.attach.
       Keeping the host as a DOM descendant of the section means existing
       descendant selectors (`.lt-container-grid-section--selected
       .lt-bezel-toolbar` etc.) still resolve, and drift-guard tests that
       look up [data-id='…'] [data-slot='…'] still find the chrome. *@
    <div class="lt-bezel-host" @ref="BezelHost" data-slot="container-grid-bezel-host">
        @if (Resizable)
        {
            <div class="lt-container-grid-handle lt-handle-se" @ref="HandleSE"></div>
            <div class="lt-container-grid-handle lt-handle-e"  @ref="HandleE"></div>
            <div class="lt-container-grid-handle lt-handle-s"  @ref="HandleS"></div>
        }
        @if (!string.IsNullOrEmpty(SelectorLabel))
        {
            <div data-slot="container-grid-bezel-label"
                 class="lt-bezel-label"
                 title="@SelectorLabel">@SelectorLabel</div>
        }
        @if (ShowBezelBadges)
        {
            <div data-slot="container-grid-bezel-badge"
                 data-edge="col-start"
                 class="lt-bezel-badge lt-bezel-badge--col-start">@Column</div>
            <div data-slot="container-grid-bezel-badge"
                 data-edge="col-end"
                 class="lt-bezel-badge lt-bezel-badge--col-end">@(Column + ColSpan)</div>
            <div data-slot="container-grid-bezel-badge"
                 data-edge="row-start"
                 class="lt-bezel-badge lt-bezel-badge--row-start">@Row</div>
            <div data-slot="container-grid-bezel-badge"
                 data-edge="row-end"
                 class="lt-bezel-badge lt-bezel-badge--row-end">@(Row + RowSpan)</div>
        }
        @if (Movable || ActionToolbar is not null)
        {
            <div data-slot="container-grid-bezel-toolbar"
                 class="lt-bezel-toolbar"
                 @onclick:stopPropagation>
                @if (Movable)
                {
                    @* The lt-container-grid-grip class is the contract the JS
                       drag binding queries for (containerGrid.js wireDrag).
                       Keep it on this element — renaming silently breaks drag. *@
                    <button type="button"
                            class="lt-bezel-button lt-bezel-grip lt-container-grid-grip"
                            @ref="HandleGrip"
                            title="Drag to move"
                            aria-label="Drag to move">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
                            <circle cx="2" cy="2" r="1" />
                            <circle cx="2" cy="5" r="1" />
                            <circle cx="2" cy="8" r="1" />
                            <circle cx="5" cy="2" r="1" />
                            <circle cx="5" cy="5" r="1" />
                            <circle cx="5" cy="8" r="1" />
                            <circle cx="8" cy="2" r="1" />
                            <circle cx="8" cy="5" r="1" />
                            <circle cx="8" cy="8" r="1" />
                        </svg>
                    </button>
                }
                @ActionToolbar
            </div>
        }
    </div>
</div>
