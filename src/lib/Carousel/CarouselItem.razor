@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="carousel-item" data-active="@(IsActive ? "true" : null)" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public bool IsActive { get; set; }

    private string GetClass()
    {
        var baseClass = "min-w-0 shrink-0 grow-0 basis-full";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
