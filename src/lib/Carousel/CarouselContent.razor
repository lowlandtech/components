@namespace LowlandTech.Components.Carousel
@inherits LtComponentBase

<div data-slot="carousel-content" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "flex overflow-hidden";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
