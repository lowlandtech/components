@namespace LowlandTech.Components
@inherits TinyComponentBase

<CascadingValue Value="this">
    <span data-slot="avatar"
          data-size="@Size"
          class="@GetClass()"
          @attributes="AdditionalAttributes">
        @ChildContent
    </span>
</CascadingValue>

@code {
    private string GetClass()
    {
        var baseClass = "cn-avatar group/avatar relative flex shrink-0 select-none rounded-full after:absolute after:inset-0 after:rounded-full after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten";
        
        // Add size classes based on Size parameter
        var sizeClass = Size?.ToLower() switch
        {
            "sm" => " size-8",
            "lg" => " size-12",
            "xl" => " size-16",
            _ => " size-10" // default
        };
        
        baseClass += sizeClass;
        
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
