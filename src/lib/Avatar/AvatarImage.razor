@namespace LowlandTech.Components
@inherits TinyComponentBase

<img data-slot="avatar-image"
     class="@GetClass()"
     @onload="OnLoad"
     @onerror="OnError"
     @attributes="AdditionalAttributes" />

@code {
    [CascadingParameter] private Avatar? Parent { get; set; }

    private string GetClass()
    {
        var baseClass = "cn-avatar-image aspect-square size-full rounded-full object-cover";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private void OnLoad()
    {
        Parent?.MarkImageLoaded();
    }

    private void OnError()
    {
        Parent?.MarkImageError();
    }
}
