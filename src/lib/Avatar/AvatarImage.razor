@namespace LowlandTech.Components.Avatar
@inherits LtComponentBase

<img data-slot="avatar-image"
     class="@GetClass()"
     @attributes="AdditionalAttributes" />

@code {
    private string GetClass()
    {
        var baseClass = "cn-avatar-image aspect-square size-full rounded-full object-cover";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
