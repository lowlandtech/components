@namespace LowlandTech.Components.Avatar
@inherits LtComponentBase

<span data-slot="avatar-fallback"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private string GetClass()
    {
        var baseClass = "cn-avatar-fallback flex size-full items-center justify-center text-sm group-data-[size=sm]/avatar:text-xs";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
