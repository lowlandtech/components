@namespace LowlandTech.Components
@inherits TinyComponentBase

@if (Parent is null || !Parent.ImageLoaded || Parent.ImageError)
{
    <span data-slot="avatar-fallback"
          class="@GetClass()"
          @attributes="AdditionalAttributes">
        @ChildContent
    </span>
}

@code {
    [CascadingParameter] private Avatar? Parent { get; set; }

    private string GetClass()
    {
        var baseClass = "cn-avatar-fallback absolute inset-0 flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium group-data-[size=sm]/avatar:text-xs group-data-[size=lg]/avatar:text-base group-data-[size=xl]/avatar:text-lg";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
