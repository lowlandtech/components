@namespace LowlandTech.Components.Avatar
@inherits LtComponentBase

<span data-slot="avatar-fallback"
      class="@GetClass()"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private string GetClass()
    {
        var baseClass = "cn-avatar-fallback flex size-full items-center justify-center rounded-full bg-muted text-muted-foreground text-sm font-medium group-data-[size=sm]/avatar:text-xs group-data-[size=lg]/avatar:text-base group-data-[size=xl]/avatar:text-lg";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
