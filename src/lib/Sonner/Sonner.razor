@namespace LowlandTech.Components.Sonner
@inherits TinyComponentBase
@implements IDisposable
@inject ISonnerService SonnerService

<div data-slot="sonner-toaster"
     data-theme="@ThemeValue"
     data-position="@PositionValue"
     class="@GetContainerClass()"
     style="@GetContainerStyle()"
     @attributes="AdditionalAttributes">
    @foreach (var toast in SonnerService.Toasts)
    {
        <div data-slot="sonner-toast"
             data-type="@toast.Type.ToString().ToLowerInvariant()"
             data-visible="true"
             data-exiting="@toast.IsExiting.ToString().ToLowerInvariant()"
             role="status"
             aria-live="polite"
             class="@GetToastClass(toast)">
            
            <!-- Progress bar -->
            @if (toast.Duration > 0 && !toast.IsExiting)
            {
                <div class="sonner-progress-bar" style="animation-duration: @(toast.Duration)ms;"></div>
            }
            
            <div class="sonner-content">
                <!-- Icon -->
                <div class="sonner-icon">
                    @GetToastIcon(toast.Type)
                </div>
                
                <!-- Message and Description -->
                <div class="sonner-message-wrapper">
                    <div class="sonner-title">@toast.Message</div>
                    @if (!string.IsNullOrEmpty(toast.Description))
                    {
                        <div class="sonner-description">@toast.Description</div>
                    }
                </div>
                
                <!-- Close button -->
                @if (toast.IsDismissible)
                {
                    <button type="button" 
                            class="sonner-close-button" 
                            @onclick="() => DismissToast(toast.Id)"
                            aria-label="Close toast">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                        </svg>
                    </button>
                }
            </div>
        </div>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string? Theme { get; set; }
    [Parameter] public string? Position { get; set; }

    private string ThemeValue => string.IsNullOrWhiteSpace(Theme) ? "system" : Theme!;
    private string PositionValue => string.IsNullOrWhiteSpace(Position) ? "bottom-right" : Position!;

    private string GetContainerClass()
    {
        const string baseClass = "sonner-toaster group fixed z-[100] flex flex-col gap-2 p-4";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetContainerStyle()
    {
        return $@"
            --normal-bg: var(--popover);
            --normal-text: var(--popover-foreground);
            --normal-border: var(--border);
            --border-radius: var(--radius);
            --success-bg: #dcfce7;
            --success-text: #166534;
            --success-border: #86efac;
            --info-bg: #dbeafe;
            --info-text: #1e40af;
            --info-border: #93c5fd;
            --warning-bg: #fef3c7;
            --warning-text: #92400e;
            --warning-border: #fcd34d;
            --error-bg: #fee2e2;
            --error-text: #991b1b;
            --error-border: #fca5a5;
            {GetPositionStyles()}";
    }

    private string GetPositionStyles()
    {
        return PositionValue switch
        {
            "top-left" => "top: 0; left: 0;",
            "top-center" => "top: 0; left: 50%; transform: translateX(-50%);",
            "top-right" => "top: 0; right: 0;",
            "bottom-left" => "bottom: 0; left: 0;",
            "bottom-center" => "bottom: 0; left: 50%; transform: translateX(-50%);",
            "bottom-right" => "bottom: 0; right: 0;",
            _ => "bottom: 0; right: 0;"
        };
    }

    private string GetToastClass(SonnerToast toast)
    {
        var classes = new List<string> { "sonner-toast" };
        
        // Type-specific class
        classes.Add($"sonner-toast--{toast.Type.ToString().ToLowerInvariant()}");
        
        // Animation states
        if (toast.IsExiting)
        {
            classes.Add("sonner-toast--exiting");
        }
        else
        {
            classes.Add("sonner-toast--entering");
        }
        
        return string.Join(" ", classes);
    }

    private RenderFragment GetToastIcon(ToastType type) => type switch
    {
        ToastType.Success => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="m9 12 2 2 4-4"/>
        </svg>,
        ToastType.Info => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4"/>
            <path d="M12 8h.01"/>
        </svg>,
        ToastType.Warning => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
            <path d="M12 9v4"/>
            <path d="M12 17h.01"/>
        </svg>,
        ToastType.Error => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="m15 9-6 6"/>
            <path d="m9 9 6 6"/>
        </svg>,
        ToastType.Promise or ToastType.Loading => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>,
        _ => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
        </svg>
    };

    private void DismissToast(Guid id) => SonnerService.Dismiss(id);

    protected override void OnInitialized()
    {
        SonnerService.OnChanged += OnToastChanged;
    }

    private void OnToastChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => SonnerService.OnChanged -= OnToastChanged;
}
