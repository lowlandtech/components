@namespace LowlandTech.Components.InputGroup
@inherits LtComponentBase

<div data-slot="input-group-addon"
     role="group"
     data-align="@Align"
     class="@GetClass()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public string Align { get; set; } = "inline-start";

    private string GetClass()
    {
        const string baseClass = "cn-input-group-addon flex cursor-text items-center justify-center select-none";
        var alignClass = Align switch
        {
            "inline-end"   => "cn-input-group-addon-align-inline-end order-last",
            "block-start"  => "cn-input-group-addon-align-block-start order-first w-full justify-start",
            "block-end"    => "cn-input-group-addon-align-block-end order-last w-full justify-start",
            _              => "cn-input-group-addon-align-inline-start order-first",
        };
        var combined = $"{baseClass} {alignClass}";
        return string.IsNullOrEmpty(Class) ? combined : $"{combined} {Class}";
    }
}
