<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>LowlandTech.Components</PackageId>
    <Description>Blazor component library for the Foundry platform.</Description>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>




  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.9" />
    <PackageReference Include="NCalcSync" Version="6.3.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\**\*.resx">
      <LogicalName>$(AssemblyName).$([System.String]::Copy('%(RelativeDir)%(Filename)').Replace('\', '.').Replace('/', '.')).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\LowlandTech.Components.Core.csproj" />
    <PackageReference Include="LowlandTech.Core" Version="[$(LowlandTechCoreVersion)]" Condition="'$(LowlandTechCoreVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <Content Remove="wwwroot\node_modules\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <None Remove="wwwroot\node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="LowlandTech.Components.csproj.lscache" />
    <None Remove="LowlandTech.Components.ncrunchproject" />
    <None Remove="LowlandTech.Components.v3.ncrunchproject" />
  </ItemGroup>

  <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwindBuild)' != 'true'">
    <PropertyGroup>
      <WwwRootPath>$(MSBuildProjectDirectory)/wwwroot</WwwRootPath>
      <NodeModulesPath>$(WwwRootPath)/node_modules</NodeModulesPath>
    </PropertyGroup>
    <!-- Windows: prepend VS NodeJs to PATH so npm.cmd is found -->
    <Exec Command="set PATH=$(VisualStudioNodeJsPath);%PATH% &amp;&amp; $(NpmCommand) install" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' == 'Windows_NT' And !Exists('$(NodeModulesPath)')" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <Exec Command="set PATH=$(VisualStudioNodeJsPath);%PATH% &amp;&amp; $(NpmCommand) run build:css" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' == 'Windows_NT'" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <!-- Linux/macOS: use npm directly from PATH -->
    <Exec Command="npm install" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' != 'Windows_NT' And !Exists('$(NodeModulesPath)')" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <Exec Command="npm run build:css" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' != 'Windows_NT'" ConsoleToMSBuild="true" IgnoreExitCode="false" />
  </Target>

  <Target Name="RequireCompatibleCorePackage" BeforeTargets="CollectPackageReferences;PrepareForBuild;GenerateNuspec">
    <Error Condition="'$(LowlandTechCoreVersion)' == '' Or '$(LowlandTechCoreVersion)' == '2026.5.29'"
           Text="Set LowlandTechCoreVersion to a verified Core package that references Components.Core instead of defining its moved types. Core 2026.5.29 duplicates Icons and block intent contracts and is incompatible. See docs/local-build.md." />
  </Target>

</Project>
