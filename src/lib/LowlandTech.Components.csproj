<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>LowlandTech.Components</PackageId>
    <Version>1.0.0</Version>
    <Authors>LowlandTech</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Blazor component library for the Foundry platform.</Description>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>

  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\core\LowlandTech.Core.csproj')">
      <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\core\LowlandTech.Core.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="LowlandTech.Core" Version="*" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <Content Remove="wwwroot\node_modules\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <None Remove="wwwroot\node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="LowlandTech.Components.csproj.lscache" />
    <None Remove="LowlandTech.Components.ncrunchproject" />
  </ItemGroup>

  <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwindBuild)' != 'true'">
    <PropertyGroup>
      <WwwRootPath>$(MSBuildProjectDirectory)\wwwroot</WwwRootPath>
      <NodeModulesPath>$(WwwRootPath)\node_modules</NodeModulesPath>
    </PropertyGroup>
    <Exec Command="set PATH=$(VisualStudioNodeJsPath);%PATH% &amp;&amp; $(NpmCommand) install" WorkingDirectory="$(WwwRootPath)" Condition="!Exists('$(NodeModulesPath)')" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <Exec Command="set PATH=$(VisualStudioNodeJsPath);%PATH% &amp;&amp; $(NpmCommand) run build:css" WorkingDirectory="$(WwwRootPath)" ConsoleToMSBuild="true" IgnoreExitCode="false" />
  </Target>

</Project>
