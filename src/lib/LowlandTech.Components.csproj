<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>LowlandTech.Components</PackageId>
    <Description>Blazor component library for the Foundry platform.</Description>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <!-- The resources of this package are embedded under two manifest names
         below, so the default glob is replaced by an explicit list. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>




  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.9" />
    <PackageReference Include="NCalcSync" Version="6.3.2" />
  </ItemGroup>

  <!--
    i18n: the manifest name of an embedded resource decides whether
    IStringLocalizer<T> resolves its strings.

    ResourceManagerStringLocalizerFactory asks for the full name of the type, so
    the resource of LowlandTech.Components.DataFormStrings has to carry the
    manifest name "LowlandTech.Components.DataFormStrings.resources".

    Two rules follow from that name. The name carries the namespace of the type
    and not the path of the file, so the LogicalName below names the type of the
    file and not the folder it sits in. The name of a culture resource carries
    its culture, because the ResourceManager looks a resource up in the
    satellite that carries the culture under the name of the resource with its
    culture, and the neutral resource of the type carries no culture at all.

    The English resource of every type is the neutral resource: it is named
    without a culture and the SDK embeds it in the assembly of the package
    itself. A client that asks for a culture without a satellite of its own
    reads the English resource, and the ResourceManager never depends on a
    satellite being loaded to answer in English.

    A host that configures a resources path asks for another name: the path is
    inserted between the assembly and the type. The hosts of this workspace
    configure "Resources", so the package carries that name as well and no host
    style loses its labels.
  -->
  <ItemGroup>
    <ComponentsResource Include="Resources\**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Resources\**\*.resx" />
    <EmbeddedResource Include="@(ComponentsResource)">
      <LogicalName>$(AssemblyName).%(Filename).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The second copy of every resource carries the name a host asks for when it
    configures a resources path. It is a copy of the same file under its own
    path, because two embedded resources of one file cannot carry two manifest
    names: the SDK resolves one manifest name per file path.
  -->
  <Target Name="AddResourcesPathResources" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="@(ComponentsResource)"
          DestinationFiles="@(ComponentsResource->'$(IntermediateOutputPath)resources-path/%(Filename).resx')">
      <Output TaskParameter="CopiedFiles" ItemName="ComponentsResourceCopy" />
    </Copy>
    <ItemGroup>
      <EmbeddedResource Include="@(ComponentsResourceCopy)">
        <LogicalName>$(AssemblyName).Resources.%(Filename).resources</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\core\LowlandTech.Components.Core.csproj" />
    <PackageReference Include="LowlandTech.Core" Version="[$(LowlandTechCoreVersion)]" Condition="'$(LowlandTechCoreVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <Content Remove="wwwroot\node_modules\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <None Remove="wwwroot\node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="LowlandTech.Components.csproj.lscache" />
    <None Remove="LowlandTech.Components.ncrunchproject" />
    <None Remove="LowlandTech.Components.v3.ncrunchproject" />
  </ItemGroup>

  <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwindBuild)' != 'true'">
    <PropertyGroup>
      <WwwRootPath>$(MSBuildProjectDirectory)/wwwroot</WwwRootPath>
      <NodeModulesPath>$(WwwRootPath)/node_modules</NodeModulesPath>
    </PropertyGroup>
    <!-- Windows: prepend VS NodeJs to PATH so npm.cmd is found -->
    <Exec Command="set PATH=$(VisualStudioNodeJsPath);%PATH% &amp;&amp; $(NpmCommand) install" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' == 'Windows_NT' And !Exists('$(NodeModulesPath)')" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <Exec Command="set PATH=$(VisualStudioNodeJsPath);%PATH% &amp;&amp; $(NpmCommand) run build:css" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' == 'Windows_NT'" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <!-- Linux/macOS: use npm directly from PATH -->
    <Exec Command="npm install" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' != 'Windows_NT' And !Exists('$(NodeModulesPath)')" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <Exec Command="npm run build:css" WorkingDirectory="$(WwwRootPath)" Condition="'$(OS)' != 'Windows_NT'" ConsoleToMSBuild="true" IgnoreExitCode="false" />
  </Target>

  <Target Name="RequireCompatibleCorePackage" BeforeTargets="CollectPackageReferences;PrepareForBuild;GenerateNuspec">
    <Error Condition="'$(LowlandTechCoreVersion)' == '' Or '$(LowlandTechCoreVersion)' == '2026.5.29'"
           Text="Set LowlandTechCoreVersion to a verified Core package that references Components.Core instead of defining its moved types. Core 2026.5.29 duplicates Icons and block intent contracts and is incompatible. See docs/local-build.md." />
  </Target>

</Project>
