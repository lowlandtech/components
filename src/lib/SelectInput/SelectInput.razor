@namespace LowlandTech.Components
@typeparam TValue
@inherits TinyComponentBase

<div data-slot="select-input" class="@GetRootClass()" @attributes="AdditionalAttributes">
    <button type="button" 
            data-slot="select-trigger"
            class="select-trigger" 
            @onclick="Toggle" 
            @onclick:stopPropagation>
        <span class="select-value @(string.IsNullOrEmpty(DisplayValue) ? "select-placeholder" : "")">
            @(string.IsNullOrEmpty(DisplayValue) ? Placeholder : DisplayValue)
        </span>
        @if (!string.IsNullOrEmpty(ChevronDownIcon))
        {
            <Icon Paths="@ChevronDownIcon" Size="14" Class="select-chevron" />
        }
    </button>

    @if (_open)
    {
        <div data-slot="select-backdrop" class="select-backdrop" @onclick="Close" @onclick:stopPropagation></div>
        <div data-slot="select-content" class="select-content">
            @foreach (var opt in Options)
            {
                var isSelected = EqualityComparer<TValue>.Default.Equals(opt.Value, Value);
                <div data-slot="select-item"
                     class="select-item @(isSelected ? "selected" : "")"
                     @onclick="() => SelectOption(opt.Value)" 
                     @onclick:stopPropagation>
                    <span>@opt.Label</span>
                    @if (isSelected && !string.IsNullOrEmpty(CheckIcon))
                    {
                        <Icon Paths="@CheckIcon" Size="14" Class="select-check" />
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string GetRootClass()
    {
        var baseClass = "select-root relative";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
