{
  "name": "lowlandtech-components",
  "version": "1.0.0",
  "private": true,
  "description": "shadcn/ui components for Blazor",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "npx tailwindcss -i ./css/app.css -o ./css/app.min.css --minify",
    "watch:css": "npx tailwindcss -i ./css/app.css -o ./css/app.min.css --watch",
    "shadcn": "npx shadcn@latest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.18",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "shadcn": "^2.1.5"
  },
  "dependencies": {
    "lucide": "^0.563.0"
  }
}
