@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="collapsible-content"
     class="@GetClass() grid transition-all duration-300 ease-in-out @(Parent?.IsOpen == true ? "grid-rows-[1fr]" : "grid-rows-[0fr]")"
     @attributes="AdditionalAttributes">
    <div class="min-h-0 overflow-hidden">
        @ChildContent
    </div>
</div>

@code {
    [CascadingParameter] private Collapsible? Parent { get; set; }

    private string GetClass()
    {
        var baseClass = "cn-collapsible-content";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
