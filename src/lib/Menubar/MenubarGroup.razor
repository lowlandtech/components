@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="menubar-group" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "";
        return string.IsNullOrEmpty(Class) ? baseClass : Class;
    }
}
