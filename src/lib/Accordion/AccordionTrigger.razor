@namespace LowlandTech.Components.Accordion
@inherits LtComponentBase

<button data-slot="accordion-trigger"
        id="@(ItemContext?.TriggerId)"
        data-state="@(ItemContext?.IsOpen == true ? "open" : "closed")"
        aria-expanded="@(ItemContext?.IsOpen == true ? "true" : "false")"
        aria-controls="@(ItemContext?.IsOpen == true ? ItemContext?.ContentId : null)"
        class="@GetClass()"
        @onclick="OnClick"
        @onkeydown="OnKeyDown"
        disabled="@(ItemContext?.Disabled == true)"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-slot="accordion-trigger-icon" class="cn-accordion-trigger-icon pointer-events-none shrink-0">
        <path d="m6 9 6 6 6-6" />
    </svg>
</button>

@code {
    private string GetClass()
    {
        var baseClass = "cn-accordion-trigger accordion-trigger group/accordion-trigger relative flex flex-1 items-start justify-between border border-transparent transition-all outline-none aria-disabled:pointer-events-none aria-disabled:opacity-50";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
