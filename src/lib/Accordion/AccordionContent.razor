@namespace LowlandTech.Components.Accordion
@inherits LtComponentBase

@if (ItemContext?.IsOpen == true)
{
    <div data-slot="accordion-content"
         data-state="open"
         class="@GetClass()"
         @attributes="AdditionalAttributes">
        <div class="cn-accordion-content-inner h-(--accordion-panel-height) data-ending-style:h-0 data-starting-style:h-0 [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground [&_p:not(:last-child)]:mb-4">
            @ChildContent
        </div>
    </div>
}

@code {
    private string GetClass()
    {
        var baseClass = "cn-accordion-content accordion-content overflow-hidden";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
