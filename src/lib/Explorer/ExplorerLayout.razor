@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject ILogger<ExplorerLayout> Logger

<div @ref="_containerRef" class="@LayoutClass" style="--panel-width: @(_panelWidth)px;" data-storage-key="@SplitterStorageKey" data-view-mode="@ViewMode.ToString().ToLowerInvariant()" @attributes="AdditionalAttributes">
    @* ── Floating expand button (when collapsed) ── *@
    @if (ShowLeftPane && _collapsed)
    {
        <PaneToggleButton Side="left"
                          Action="open"
                          BorderSide="right"
                          TestId="explorer-sidebar-open"
                          Title="Expand sidebar"
                          AriaLabel="Expand sidebar"
                          Class="explorer-sidebar-toggle absolute top-0 left-0 z-50"
                          OnClick="ToggleCollapse" />
    }

    @* ── Stacked modes: LeftOnTop renders left above right; LeftOnBottom renders right above left ── *@
    @if (ViewMode is ExplorerViewMode.LeftOnTop or ExplorerViewMode.LeftOnBottom)
    {
        var leftFirst = ViewMode == ExplorerViewMode.LeftOnTop;
        var firstPane  = leftFirst ? ListFragment  : DetailFragment;
        var secondPane = leftFirst ? DetailFragment : ListFragment;
        @firstPane
        @secondPane
    }
    else
    {
        @* ── Left Pane ── *@
        @if (ShowLeftPane)
        {
            <div class="explorer-sidebar @(ViewMode == ExplorerViewMode.LeftOnly ? "flex-1" : "shrink-0 border-r border-border") flex flex-col bg-background @(_splitter?.IsDragging == true ? "" : "transition-[width] duration-150 ease-in-out")"
                 style="@(ViewMode == ExplorerViewMode.LeftOnly ? "" : $"width: var(--panel-width); max-width: calc(100% - 336px);")">
                @* ── Header with collapse button ── *@
                <div class="explorer-sidebar-header flex h-9 items-center border-b border-border pr-1.5">
                    <div class="explorer-sidebar-header-slot flex-1 min-w-0">
                        @if (ListHeader is not null)
                        {
                            @ListHeader
                        }
                        else
                        {
                            <div class="explorer-sidebar-default-header flex items-center justify-between px-3 h-9">
                                <span class="explorer-sidebar-default-title text-sm font-semibold">@Title</span>
                            </div>
                        }
                    </div>
                    @if (ViewMode != ExplorerViewMode.LeftOnly)
                    {
                        <PaneToggleButton Side="left"
                                          Action="close"
                                          BorderSide="left"
                                          TestId="explorer-sidebar-collapse"
                                          Title="Collapse sidebar"
                                          AriaLabel="Collapse sidebar"
                                          Class="explorer-sidebar-collapse-btn shrink-0"
                                          OnClick="ToggleCollapse" />
                    }
                </div>

                @* ── Scrollable List ── *@
                <div class="explorer-sidebar-list flex-1 overflow-y-auto">
                    @ListContent
                </div>
            </div>
        }

        @* ── Splitter (only in side-by-side mode) ── *@
        @if (ShowLeftPane && ShowRightPane)
        {
            <PanelSplitter @ref="_splitter"
                           ElementId="@_splitterId"
                           StorageKey="@SplitterStorageKey"
                           DefaultWidth="DefaultWidth"
                           MinWidth="MinWidth"
                           MaxWidth="MaxWidth"
                           OnWidthChanged="OnSplitterWidthChanged"
                           KeyboardSave="OnKeyboardSave" />
        }

        @* ── Right Pane ── *@
        @if (ShowRightPane)
        {
            <div class="explorer-detail flex-1 flex flex-col min-w-0 overflow-hidden">
                @DetailContent

                @if (FooterContent is not null)
                {
                    @FooterContent
                }
            </div>
        }
    }

    @ChildContent
</div>

@code {
    private PanelSplitter? _splitter;
    private ElementReference _containerRef;
    private int _panelWidth = 288;
    private bool _collapsed;
    private string _splitterId = $"splitter-{Guid.NewGuid():N}";
    private DotNetObjectReference<ExplorerLayout>? _dotNetRef;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public RenderFragment? ListHeader { get; set; }
    [Parameter, EditorRequired] public RenderFragment ListContent { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment DetailContent { get; set; } = default!;
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string SplitterStorageKey { get; set; } = default!;
    [Parameter] public int DefaultWidth { get; set; } = 288;
    [Parameter] public int MinWidth { get; set; } = 180;
    [Parameter] public int MaxWidth { get; set; } = 600;
    [Parameter] public EventCallback OnKeyboardSave { get; set; }
    [Parameter] public string? HeightClass { get; set; }
    [Parameter] public ExplorerViewMode ViewMode { get; set; } = ExplorerViewMode.SideBySide;

    private bool ShowLeftPane  => ViewMode is ExplorerViewMode.SideBySide or ExplorerViewMode.LeftOnly or ExplorerViewMode.LeftOnTop or ExplorerViewMode.LeftOnBottom;
    private bool ShowRightPane => ViewMode is ExplorerViewMode.SideBySide or ExplorerViewMode.RightOnly or ExplorerViewMode.LeftOnTop or ExplorerViewMode.LeftOnBottom;

    private string ViewModeClass => ViewMode switch
    {
        ExplorerViewMode.RightOnly    => "explorer-right-only",
        ExplorerViewMode.LeftOnTop    => "explorer-stacked flex-col",
        ExplorerViewMode.LeftOnBottom => "explorer-stacked flex-col",
        _                             => string.Empty,
    };

    private string LayoutClass =>
        $"explorer-layout {ViewModeClass} {(_collapsed ? "explorer-collapsed" : string.Empty)} flex {(string.IsNullOrWhiteSpace(HeightClass) ? "h-[calc(100vh-3.5rem)]" : HeightClass)} overflow-hidden relative";

    private RenderFragment ListFragment => __builder =>
    {
        <div class="explorer-sidebar flex flex-col bg-background border-b border-border">
            <div class="flex items-center border-b border-border">
                <div class="flex-1 min-w-0">
                    @if (ListHeader is not null) { @ListHeader }
                    else
                    {
                        <div class="flex items-center justify-between px-3 h-9">
                            <span class="text-sm font-semibold">@Title</span>
                        </div>
                    }
                </div>
            </div>
            <div class="flex-1 overflow-y-auto">@ListContent</div>
        </div>
    };

    private RenderFragment DetailFragment => __builder =>
    {
        <div class="explorer-detail flex-1 flex flex-col min-w-0 overflow-hidden">
            @DetailContent
            @if (FooterContent is not null) { @FooterContent }
        </div>
    };

    public bool IsCollapsed => _collapsed;

    protected override void OnInitialized()
    {
        _panelWidth = DefaultWidth;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await InitializeCollapseStateAsync();
        }
    }

    private async Task InitializeCollapseStateAsync()
    {
        try
        {
            var isCollapsed = await JsRuntime.InvokeAsync<bool>("eval", 
                $"localStorage.getItem('explorer-collapsed-{SplitterStorageKey}') === 'true'");
            
            if (_collapsed != isCollapsed)
            {
                _collapsed = isCollapsed;
                await UpdateCollapseClassAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to initialize collapse state");
        }
    }

    public async Task ToggleCollapse()
    {
        _collapsed = !_collapsed;
        
        try
        {
            await JsRuntime.InvokeVoidAsync("eval", 
                $"localStorage.setItem('explorer-collapsed-{SplitterStorageKey}', '{_collapsed.ToString().ToLowerInvariant()}')");
            await UpdateCollapseClassAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save collapse state");
        }
        
        StateHasChanged();
    }

    private async Task UpdateCollapseClassAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("eval", $"""
                var el = document.querySelector('[data-storage-key="{SplitterStorageKey}"]');
                if (el) el.classList.toggle('explorer-collapsed', {_collapsed.ToString().ToLowerInvariant()});
            """);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to update collapse class");
        }
    }

    private void OnSplitterWidthChanged(int width)
    {
        _panelWidth = width;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_splitter is not null)
            await _splitter.DisposeAsync();
        _dotNetRef?.Dispose();
    }
}
