
@namespace LowlandTech.Components
@inherits TinyComponentBase
@inject IJSRuntime JSRuntime
@implements IDisposable

@* tailwind-safelist: overflow-x-auto overflow-y-hidden overflow-auto w-[var(--sa-thumb-width)] h-[var(--sa-thumb-width)] *@

<div data-slot="scroll-area"
     class="@CssClass"
     @attributes="AdditionalAttributes">
    <div data-slot="scroll-area-viewport"
         @ref="_viewportRef"
         class="cn-scroll-area-viewport size-full @ViewportOverflowClass rounded-[inherit] transition-[color,box-shadow] outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1"
         tabindex="-1">
        @ChildContent
    </div>
    @if (ShowScrollbar)
    {
        <div data-slot="scroll-area-scrollbar"
             data-orientation="@EffectiveOrientation"
             @ref="_scrollbarRef"
             class="cn-scroll-area-scrollbar absolute @GetScrollbarPositionClass() transition-opacity duration-200 @GetScrollbarVisibilityClass()"
             style="@GetScrollbarStyle()">
            <div data-slot="scroll-area-track"
                 @ref="_trackRef"
                 class="cn-scroll-area-track relative size-full rounded-full"
                 style="@GetTrackStyle()">
                <div data-slot="scroll-area-thumb"
                     @ref="_thumbRef"
                     class="cn-scroll-area-thumb absolute rounded-full"
                     style="@GetThumbStyle()"></div>
            </div>
        </div>
    }
    <div data-slot="scroll-area-corner" class="hidden"></div>
</div>
