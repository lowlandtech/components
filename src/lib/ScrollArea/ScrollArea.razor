
@namespace LowlandTech.Components.ScrollArea
@inherits LtComponentBase

@* tailwind-safelist: overflow-x-auto overflow-y-hidden overflow-auto *@

<div data-slot="scroll-area"
     class="@CssClass"
     @attributes="AdditionalAttributes">
    <div data-slot="scroll-area-viewport"
         class="cn-scroll-area-viewport size-full @ViewportOverflowClass rounded-[inherit] transition-[color,box-shadow] outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1"
         tabindex="-1">
        @ChildContent
    </div>
    <div data-slot="scroll-area-scrollbar"
         data-orientation="vertical"
         class="cn-scroll-area-scrollbar hidden">
        <div data-slot="scroll-area-thumb"
             class="cn-scroll-area-thumb relative flex-1 bg-border"></div>
    </div>
    <div data-slot="scroll-area-corner" class="hidden"></div>
</div>
