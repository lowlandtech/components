@namespace LowlandTech.Components.ScrollArea
@inherits LtComponentBase

<div data-slot="scroll-area-scrollbar"
     data-orientation="@OrientationValue"
     class="@CssClass"
     @attributes="AdditionalAttributes">
    <div data-slot="scroll-area-thumb"
         class="cn-scroll-area-thumb relative flex-1 bg-border"></div>
</div>

@code {
    [Parameter] public string? Orientation { get; set; }

    private string OrientationValue => string.IsNullOrWhiteSpace(Orientation) ? "vertical" : Orientation!;

    private string CssClass
    {
        get
        {
            const string baseClass = "cn-scroll-area-scrollbar flex touch-none p-px transition-colors select-none";
            return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
        }
    }
}
