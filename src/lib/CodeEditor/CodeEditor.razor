@namespace LowlandTech.Components.CodeEditor
@inherits LtComponentBase

<div data-slot="code-editor"
     class="@GetClass()"
     
     @attributes="AdditionalAttributes">
    <pre class="code-editor-highlights" aria-hidden="true">@((MarkupString)HighlightedHtml)&#10;</pre>
    <textarea data-slot="code-editor-input"
              class="code-editor-input"
              rows="@Rows"
              placeholder="@Placeholder"
              disabled="@Disabled"
              readonly="@ReadOnly"
              spellcheck="false"
              @bind="Value"
              @bind:event="oninput"
              @bind:after="OnInput"></textarea>
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    
    private string HighlightedHtml => Highlight(Value ?? "");
    
    private async Task OnInput()
    {
        await ValueChanged.InvokeAsync(Value);
    }
    
    private static string Highlight(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        var escaped = text
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;");

        return System.Text.RegularExpressions.Regex.Replace(
            escaped,
            @"\$\{([^}]*)\}",
            """<span style="color:var(--primary);font-weight:700">${$1}</span>""");
    }
    
    private string GetClass()
    {
        var baseClass = "cn-code-editor relative font-mono text-sm";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
