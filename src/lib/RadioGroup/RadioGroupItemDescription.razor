@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="radio-group-item-description" class="@GetClass()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private string GetClass()
    {
        var baseClass = "cn-radio-group-item-description text-sm text-muted-foreground";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }
}
