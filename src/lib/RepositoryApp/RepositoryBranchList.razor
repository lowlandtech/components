@namespace LowlandTech.Components.RepositoryApp
@inherits TinyComponentBase

@if (Context?.State.Current is not null)
{
    <div data-slot="repository-branch-list" class="@GetClass()" @attributes="AdditionalAttributes">
        <div class="border-b border-border bg-card px-4 py-3">
            <div class="flex flex-wrap items-center gap-2">
                <Button data-testid="repo-branches-search-toggle"
                        Variant="outline"
                        Size="sm">
                    <Icon Name="search" Size="14" />
                    <span>Filter branches</span>
                </Button>
                <Button data-testid="repo-branch-new"
                        Variant="outline"
                        Size="sm">
                    <Icon Name="plus" Size="14" />
                    <span>New branch</span>
                </Button>
                <span class="ml-auto text-xs text-muted-foreground">@Branches.Count.ToString("N0") branches</span>
            </div>
        </div>
        <div class="flex-1 overflow-auto">
            @foreach (var branch in Branches)
            {
                var isSelected = string.Equals(Context.State.Ui.SelectedBranch, branch.Name, StringComparison.OrdinalIgnoreCase);
                <div data-slot="repo-branch-row"
                     data-branch="@branch.Name"
                     data-selected="@(isSelected ? "true" : "false")"
                     class="grid grid-cols-[1.5rem_minmax(0,1fr)_minmax(0,2fr)_minmax(0,1.5fr)_6rem] items-center gap-2 border-b border-border px-4 py-2 text-sm transition-colors hover:bg-muted/40 @(isSelected ? "bg-primary/5" : string.Empty)">
                    <span class="inline-flex w-5 items-center justify-center text-muted-foreground">
                        <Icon Name="git-branch" Size="14" />
                    </span>
                    <Button data-testid="repo-branch-select"
                            Variant="unstyled"
                            Class="min-w-0 truncate text-left text-sm font-medium text-primary hover:underline"
                            OnClick="@(() => Context.HandleBranchChanged(new RepositoryBranchChanged(branch.Name)))">
                        @branch.Name
                    </Button>
                    <div class="flex min-w-0 flex-wrap items-center gap-2 text-xs text-muted-foreground">
                        <span class="font-mono">@branch.Sha</span>
                        <span>·</span>
                        <span>updated @FormatRelative(branch.UpdatedAt)</span>
                    </div>
                    <div class="flex min-w-0 items-center gap-2 text-xs">
                        @if (branch.AheadBy is > 0)
                        {
                            <span class="inline-flex items-center gap-1 text-success"><Icon Name="arrow-up" Size="12" />@branch.AheadBy</span>
                        }
                        @if (branch.BehindBy is > 0)
                        {
                            <span class="inline-flex items-center gap-1 text-muted-foreground"><Icon Name="arrow-down" Size="12" />@branch.BehindBy</span>
                        }
                    </div>
                    <div class="flex items-center justify-end gap-1">
                        @if (branch.IsDefault)
                        {
                            <Badge Variant="default" Size="sm">Default</Badge>
                        }
                        @if (branch.IsProtected)
                        {
                            <Badge Variant="secondary" Size="sm">
                                <Icon Name="lock" Size="10" /> Protected
                            </Badge>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
