@namespace LowlandTech.Components
@inherits TinyComponentBase

@if (Context?.State.Current is not null)
{
    var current = Context.State.Current;
    <div data-slot="repository-app-header" class="@GetClass()" @attributes="AdditionalAttributes">
        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div class="flex min-w-0 flex-wrap items-center gap-2 text-lg">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-muted text-muted-foreground">
                    <Icon Name="@GetRepoIcon()" Size="16" />
                </span>
                <a class="font-normal text-muted-foreground hover:text-foreground transition-colors"
                   href="/@current.Owner.Name">
                    @current.Owner.Name
                </a>
                <span class="text-muted-foreground/60">/</span>
                <a class="font-semibold text-foreground hover:text-primary transition-colors"
                   href="/@current.FullName">
                    @current.Name
                </a>

                <div class="ml-2 flex flex-wrap items-center gap-1">
                    @if (Context.IsRepoArchived())
                    {
                        <Badge data-testid="repo-header-archived" Variant="secondary" Size="sm">Archived</Badge>
                    }
                    @if (Context.IsRepoPrivate())
                    {
                        <Badge data-testid="repo-header-private" Variant="secondary" Size="sm">
                            <Icon Name="lock" Size="10" class="mr-1" /> Private
                        </Badge>
                    }
                    else if (Context.IsRepoInternal())
                    {
                        <Badge data-testid="repo-header-internal" Variant="secondary" Size="sm">
                            <Icon Name="shield" Size="10" class="mr-1" /> Internal
                        </Badge>
                    }
                    @if (Context.IsRepoTemplate())
                    {
                        <Badge data-testid="repo-header-template" Variant="secondary" Size="sm">Template</Badge>
                    }
                    @if (!string.IsNullOrWhiteSpace(current.Website))
                    {
                        <Badge data-testid="repo-header-public-access" Variant="default" Size="sm">Public Access</Badge>
                    }
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <Button data-testid="repo-header-rss"
                        Variant="outline"
                        Size="sm"
                        Title="RSS feed">
                    <Icon Name="rss" Size="14" />
                </Button>
                <Button data-testid="repo-header-watch"
                        Variant="outline"
                        Size="sm"
                        OnClick="@(() => Context.HandleWatchToggled())">
                    <Icon Name="eye" Size="14" />
                    <span>Watch</span>
                    <Badge Variant="secondary" Size="sm">@current.Watchers</Badge>
                </Button>
                <Button data-testid="repo-header-star"
                        Variant="outline"
                        Size="sm"
                        OnClick="@(() => Context.HandleStarToggled())">
                    <Icon Name="star" Size="14" />
                    <span>Star</span>
                    <Badge Variant="secondary" Size="sm">@current.Stars</Badge>
                </Button>
                <Button data-testid="repo-header-fork"
                        Variant="outline"
                        Size="sm"
                        OnClick="@(() => Context.HandleForkRequested())">
                    <Icon Name="git-fork" Size="14" />
                    <span>Fork</span>
                    <Badge Variant="secondary" Size="sm">@current.Forks</Badge>
                </Button>
            </div>
        </div>

        @if (Context.IsRepoMirror() || Context.IsRepoFork())
        {
            <div class="px-4 pt-1 text-xs text-muted-foreground">
                @if (Context.IsRepoMirror())
                {
                    <span>Mirrored from <a class="text-primary hover:underline" href="#">upstream</a> · synced 12 minutes ago</span>
                }
                @if (Context.IsRepoFork())
                {
                    <span>Forked from <a class="text-primary hover:underline" href="#">upstream</a></span>
                }
            </div>
        }
    </div>
}
