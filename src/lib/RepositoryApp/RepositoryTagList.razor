@namespace LowlandTech.Components.RepositoryApp
@inherits TinyComponentBase

@if (Context?.State.Current is not null)
{
    <div data-slot="repository-tag-list" class="@GetClass()" @attributes="AdditionalAttributes">
        <div class="border-b border-border bg-card px-4 py-3">
            <div class="flex flex-wrap items-center gap-2">
                <Button data-testid="repo-tags-search-toggle"
                        Variant="outline"
                        Size="sm">
                    <Icon Name="search" Size="14" />
                    <span>Filter tags</span>
                </Button>
                <Button data-testid="repo-tag-new"
                        Variant="outline"
                        Size="sm">
                    <Icon Name="plus" Size="14" />
                    <span>New tag</span>
                </Button>
                <span class="ml-auto text-xs text-muted-foreground">@Tags.Count.ToString("N0") tags</span>
            </div>
        </div>
        <div class="flex-1 overflow-auto">
            @foreach (var tag in Tags)
            {
                <div data-slot="repo-tag-row"
                     data-tag="@tag.Name"
                     class="grid grid-cols-[1.5rem_minmax(0,1fr)_minmax(0,2fr)_minmax(0,1.5fr)] items-center gap-2 border-b border-border px-4 py-2 text-sm transition-colors hover:bg-muted/40">
                    <span class="inline-flex w-5 items-center justify-center text-muted-foreground">
                        <Icon Name="tag" Size="14" />
                    </span>
                    <a class="min-w-0 truncate text-left text-sm font-medium text-primary hover:underline"
                       href="@($"/{Context.State.Current.FullName}/releases/tag/{tag.Name}")">
                        @tag.Name
                    </a>
                    <span class="font-mono text-xs text-muted-foreground">@tag.ShortSha</span>
                    <span class="text-xs text-muted-foreground">created @FormatRelative(tag.CreatedAt)</span>
                </div>
            }
        </div>
    </div>
}
