@namespace LowlandTech.Components
@inherits TinyComponentBase
@implements IDisposable
@inject IStringLocalizer<DataFormStrings> L

<CascadingValue Value="_editContext">
    <form data-slot="data-form"
          data-layout="@Layout"
          class="@GetClass()"
          @attributes="AdditionalAttributes"
          @onsubmit="HandleSubmit"
          @onsubmit:preventDefault>


        @if (ShowValidationSummary && _validationSummary.Count > 0)
        {
            <div data-slot="validation-summary" role="alert" class="rounded-md border border-destructive/50 bg-destructive/10 p-3 text-sm text-destructive">
                @foreach (var msg in _validationSummary)
                {
                    <div>@msg</div>
                }
            </div>
        }

        <div class="@GetFieldContainerClass()">
            @foreach (var field in _fields)
            {
                var fieldId = $"dataform-field-{field.PropertyName}";
                var validationId = $"{fieldId}-validation";
                var fieldMessages = GetFieldMessages(field.PropertyName);
                var hasErrors = fieldMessages.Count > 0;
                var currentValue = GetDisplayValue(field.PropertyName);

                <div data-field="@field.PropertyName" class="@GetFieldWrapperClass()">
                    @if (LabelTemplate != null)
                    {
                        @LabelTemplate(field)
                    }
                    else
                    {
                        <label data-field-label="@field.PropertyName" for="@fieldId" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
                            @field.DisplayName
                        </label>
                    }

                    @if (FieldTemplate != null)
                    {
                        @FieldTemplate(field)
                    }
                    else if (ReadOnly || field.ReadOnly)
                    {
                        <div data-field-readonly="@field.PropertyName" class="rounded-md border border-input bg-muted px-3 py-2 text-sm text-muted-foreground">
                            @currentValue
                        </div>
                    }
                    else
                    {
                        var fieldType = MapToFormFieldType(field);
                        var validator = GetValidatorForField(field.PropertyName);
                        var fieldValue = UseStore && Store?.State.Values.TryGetValue(field.PropertyName, out var v) == true ? v : GetValue(field.PropertyName);

                        <FormField FieldName="@field.PropertyName"
                                   FieldType="@fieldType"
                                   Label="@field.DisplayName"
                                   Value="@fieldValue"
                                   ValueChanged="async v => { await SetValueAsync(field.PropertyName, v); await OnFieldChanged(new FormFieldChangeArgs { FieldName = field.PropertyName, NewValue = v }); }"
                                   Validator="@validator"
                                   Mask="@validator?.Mask"
                                   Required="@field.Required"
                                   Disabled="@ReadOnly"
                                   EnumType="@(field.PropertyType.IsEnum ? field.PropertyType : null)"
                                   OnChanging="OnFieldChanging"
                                   OnChange="OnFieldChange"
                                   OnBlur="async e => { if (Store != null) Store.Dispatch(new DataFormActions.FieldBlurred(field.PropertyName)); }"
                                   OnFocus="async e => { if (Store != null) Store.Dispatch(new DataFormActions.FieldFocused(field.PropertyName)); }" />

                        @if (UseStore)
                        {
                            var storeErrors = Store?.State.Errors.TryGetValue(field.PropertyName, out var se) == true ? se : null;
                            var hasStoreErrors = storeErrors?.Count > 0;

                            @if (hasStoreErrors)
                            {
                                <div data-field-validation="@field.PropertyName" class="text-sm font-medium text-destructive" role="alert">
                                    @foreach (var error in storeErrors!)
                                    {
                                        <div>@error</div>
                                    }
                                </div>
                            }
                        }
                    }

                    @if (ValidationTemplate != null)
                    {
                        @ValidationTemplate(field)
                    }
                    else if (hasErrors)
                    {
                        <div data-field-validation="@field.PropertyName" id="@validationId" class="text-sm font-medium text-destructive" role="alert">
                            @foreach (var msg in fieldMessages)
                            {
                                <div>@msg</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (ActionsTemplate != null)
        {
            @ActionsTemplate(this)
        }
        else if (ShowDefaultActions)
        {
            <div data-slot="data-form-actions" class="flex gap-2">
                <Button Type="submit">@L["SubmitButton"]</Button>
                <Button Type="button" Variant="outline" @onclick="ResetModel">@L["ResetButton"]</Button>
            </div>
        }
    </form>
</CascadingValue>
