
@namespace LowlandTech.Components
@inherits TinyComponentBase

<div data-slot="native-select-wrapper"
     data-size="@SizeValue"
     class="@WrapperClass">
    <select data-slot="native-select"
            data-size="@SizeValue"
            class="cn-native-select w-full appearance-none rounded-md border border-input bg-transparent text-foreground pl-3 pr-8 transition-colors outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:cursor-not-allowed @SelectSizeClass"
            @attributes="AdditionalAttributes">
        @ChildContent
    </select>
    <svg data-slot="native-select-icon"
         aria-hidden="true"
         class="cn-native-select-icon pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-muted-foreground select-none"
         width="14"
         height="14"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
        <path d="m6 9 6 6 6-6" />
    </svg>
</div>

@code {
    private string SelectSizeClass => SizeValue switch
    {
        "sm" => "h-8 text-sm",
        "lg" => "h-10 text-base",
        _    => "h-9 text-sm",
    };
}