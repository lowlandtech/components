@namespace LowlandTech.Components.Switch
@inherits LtComponentBase

<button data-slot="switch"
        data-size="@Size"
        data-state="@GetState()"
    data-disabled="@(Disabled ? "true" : null)"
        aria-checked="@IsChecked.ToString().ToLower()"
        role="switch"
        name="@Name"
        value="@Value"
    disabled="@Disabled"
        class="@GetClass()"
        @onclick="OnClick"
        @onkeydown="OnKeyDown"
        @attributes="AdditionalAttributes">
    <span data-slot="switch-thumb" class="cn-switch-thumb pointer-events-none block ring-0 transition-transform"></span>
    @ChildContent
</button>

@code {
    private string GetClass()
    {
        var baseClass = "cn-switch peer group/switch relative inline-flex items-center transition-all outline-none after:absolute after:-inset-x-3 after:-inset-y-2 data-disabled:cursor-not-allowed data-disabled:opacity-50";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetState() => IsChecked ? "checked" : "unchecked";

    private async Task OnClick()
    {
        if (Disabled)
            return;
        await ToggleAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
            return;

        if (e.Key == " " || e.Key == "Enter")
        {
            await ToggleAsync();
        }
    }

    private async Task ToggleAsync()
    {
        IsChecked = !IsChecked;
        await IsCheckedChanged.InvokeAsync(IsChecked);
        StateHasChanged();
    }
}
