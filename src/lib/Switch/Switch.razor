@namespace LowlandTech.Components.Switch
@inherits LtComponentBase

@if (ChoiceCard)
{
    <label class="@GetChoiceCardClass() cursor-pointer">
        <div class="flex items-start gap-4">
            <button data-slot="switch"
                    data-size="@Size"
                    data-state="@GetState()"
                    data-disabled="@(Disabled ? "true" : null)"
                    data-invalid="@(Invalid ? "true" : null)"
                    aria-checked="@IsChecked.ToString().ToLower()"
                    aria-invalid="@Invalid"
                    role="switch"
                    name="@Name"
                    value="@Value"
                    disabled="@Disabled"
                    class="@GetClass() shrink-0"
                    @onclick="OnClick"
                    @onkeydown="OnKeyDown"
                    @attributes="AdditionalAttributes">
                <span data-slot="switch-thumb"
                      data-state="@GetState()"
                      class="@GetThumbClass()"></span>
            </button>
            <div class="flex-1">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <p class="cn-switch-title font-medium text-sm">@Title</p>
                }
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="cn-switch-description text-sm text-muted-foreground">@Description</p>
                }
                @if (ChildContent != null)
                {
                    <div class="cn-switch-content">@ChildContent</div>
                }
            </div>
        </div>
    </label>
}
else
{
    <button data-slot="switch"
            data-size="@Size"
            data-state="@GetState()"
            data-disabled="@(Disabled ? "true" : null)"
            data-invalid="@(Invalid ? "true" : null)"
            aria-checked="@IsChecked.ToString().ToLower()"
            aria-invalid="@Invalid"
            role="switch"
            name="@Name"
            value="@Value"
            disabled="@Disabled"
            class="@GetClass()"
            @onclick="OnClick"
            @onkeydown="OnKeyDown"
            @attributes="AdditionalAttributes">
        <span data-slot="switch-thumb"
              data-state="@GetState()"
              class="@GetThumbClass()"></span>
        @ChildContent
    </button>
}

@code {
    private bool IsSmall => string.Equals(Size, "sm", StringComparison.OrdinalIgnoreCase);

    private string GetClass()
    {
        var sizeClasses = IsSmall ? "h-4 w-7" : "h-5 w-9";
        var baseClass = $"cn-switch peer group/switch relative inline-flex shrink-0 items-center rounded-full border transition-all outline-none after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:ring-2 focus-visible:ring-offset-2 data-disabled:cursor-not-allowed data-disabled:opacity-50 data-[state=checked]:bg-primary {sizeClasses}";

        // Invalid state styling
        if (Invalid)
        {
            baseClass += " border-red-500 bg-red-100 focus-visible:ring-red-500";
        }
        else
        {
            baseClass += " border-transparent bg-input focus-visible:ring-ring";
        }

        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetThumbClass()
    {
        var sizeClasses = IsSmall ? "h-3 w-3" : "h-4 w-4";
        var translateClass = IsChecked
            ? (IsSmall ? "translate-x-3" : "translate-x-4")
            : "translate-x-0";

        // Thumb color for invalid state
        var colorClass = Invalid && !IsChecked ? " bg-red-500" : " bg-background";

        return $"cn-switch-thumb pointer-events-none block rounded-full shadow-sm ring-0 transition-transform {sizeClasses}{colorClass} {translateClass}";
    }

    private string GetChoiceCardClass()
    {
        var baseClass = "cn-switch-choice-card flex w-full items-center rounded-lg border p-4 transition-colors";

        if (Invalid)
        {
            baseClass += " border-red-500 bg-red-50/50 hover:bg-red-50";
        }
        else if (IsChecked)
        {
            baseClass += " border-primary bg-primary/5";
        }
        else
        {
            baseClass += " border-input bg-background hover:bg-muted/50";
        }

        if (Disabled)
        {
            baseClass += " opacity-50 cursor-not-allowed";
        }

        return baseClass;
    }

    private string GetState() => IsChecked ? "checked" : "unchecked";

    private async Task OnClick()
    {
        if (Disabled)
            return;
        await ToggleAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
            return;

        if (e.Key == " " || e.Key == "Enter")
        {
            await ToggleAsync();
        }
    }

    private async Task ToggleAsync()
    {
        IsChecked = !IsChecked;
        await IsCheckedChanged.InvokeAsync(IsChecked);
        StateHasChanged();
    }
}
