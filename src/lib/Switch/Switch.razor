@namespace LowlandTech.Components.Switch
@inherits LtComponentBase

<button data-slot="switch"
        data-size="@Size"
        data-state="@GetState()"
        data-disabled="@(Disabled ? "true" : null)"
        aria-checked="@IsChecked.ToString().ToLower()"
        role="switch"
        name="@Name"
        value="@Value"
        disabled="@Disabled"
        class="@GetClass()"
        @onclick="OnClick"
        @onkeydown="OnKeyDown"
        @attributes="AdditionalAttributes">
    <span data-slot="switch-thumb"
          data-state="@GetState()"
          class="@GetThumbClass()"></span>
    @ChildContent
</button>

@code {
    private bool IsSmall => string.Equals(Size, "sm", StringComparison.OrdinalIgnoreCase);

    private string GetClass()
    {
        var sizeClasses = IsSmall ? "h-4 w-7" : "h-5 w-9";
        var baseClass = $"cn-switch peer group/switch relative inline-flex shrink-0 items-center rounded-full border border-transparent bg-input transition-all outline-none after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-disabled:cursor-not-allowed data-disabled:opacity-50 data-[state=checked]:bg-primary {sizeClasses}";
        return string.IsNullOrEmpty(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private string GetThumbClass()
    {
        var sizeClasses = IsSmall ? "h-3 w-3" : "h-4 w-4";
        var translateClass = IsChecked
            ? (IsSmall ? "translate-x-3" : "translate-x-4")
            : "translate-x-0";

        return $"cn-switch-thumb pointer-events-none block rounded-full bg-background shadow-sm ring-0 transition-transform {sizeClasses} {translateClass}";
    }

    private string GetState() => IsChecked ? "checked" : "unchecked";

    private async Task OnClick()
    {
        if (Disabled)
            return;
        await ToggleAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
            return;

        if (e.Key == " " || e.Key == "Enter")
        {
            await ToggleAsync();
        }
    }

    private async Task ToggleAsync()
    {
        IsChecked = !IsChecked;
        await IsCheckedChanged.InvokeAsync(IsChecked);
        StateHasChanged();
    }
}
