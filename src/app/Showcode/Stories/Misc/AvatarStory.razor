@attribute [DisplayName("Misc/Avatar")]
@inherits StoryComponent

<StoryCard Title="Avatar"
           Description="Avatar displays a user image with fallback initials, sizes, groups, and status badges."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "image",
            "With image",
            @<AvatarImageExample />,
            [
                StorySourceRegistry.CodeTab(
                    "image-razor",
                    "AvatarImageExample.razor",
                    "Showcode/Examples/Misc/Avatar/AvatarImageExample.razor")
            ]),
        new(
            "fallback",
            "Fallback only",
            @<AvatarFallbackExample />,
            [
                StorySourceRegistry.CodeTab(
                    "fallback-razor",
                    "AvatarFallbackExample.razor",
                    "Showcode/Examples/Misc/Avatar/AvatarFallbackExample.razor")
            ]),
        new(
            "sizes",
            "Sizes",
            @<AvatarSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "AvatarSizesExample.razor",
                    "Showcode/Examples/Misc/Avatar/AvatarSizesExample.razor")
            ]),
        new(
            "group",
            "Group",
            @<AvatarGroupExample />,
            [
                StorySourceRegistry.CodeTab(
                    "group-razor",
                    "AvatarGroupExample.razor",
                    "Showcode/Examples/Misc/Avatar/AvatarGroupExample.razor")
            ]),
        new(
            "badge",
            "Badge",
            @<AvatarBadgeExample />,
            [
                StorySourceRegistry.CodeTab(
                    "badge-razor",
                    "AvatarBadgeExample.razor",
                    "Showcode/Examples/Misc/Avatar/AvatarBadgeExample.razor")
            ])
    ];
}
