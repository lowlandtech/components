@attribute [DisplayName("Misc/Kbd")]
@inherits StoryComponent

<div class="space-y-8">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Modifier keys</h2>
        <div class="flex flex-wrap gap-2">
            <Kbd>Ctrl</Kbd>
            <Kbd>Alt</Kbd>
            <Kbd>Shift</Kbd>
            <Kbd>Cmd</Kbd>
            <Kbd>Tab</Kbd>
            <Kbd>Enter</Kbd>
            <Kbd>Esc</Kbd>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Shortcut combos</h2>
        <div class="space-y-2 text-sm">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground w-32">Save</span>
                <div class="flex gap-1"><Kbd>Ctrl</Kbd><span>+</span><Kbd>S</Kbd></div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground w-32">Copy</span>
                <div class="flex gap-1"><Kbd>Ctrl</Kbd><span>+</span><Kbd>C</Kbd></div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground w-32">Command palette</span>
                <div class="flex gap-1"><Kbd>Ctrl</Kbd><span>+</span><Kbd>K</Kbd></div>
            </div>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Sizes</h2>
        <div class="flex flex-wrap items-center gap-3">
            <Kbd Size="sm">sm</Kbd>
            <Kbd Size="md">md</Kbd>
            <Kbd Size="lg">lg</Kbd>
        </div>
    </section>
</div>
