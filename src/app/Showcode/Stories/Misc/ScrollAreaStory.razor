@attribute [DisplayName("Misc/Scroll Area")]
@inherits StoryComponent

<StoryCard Title="Scroll Area"
           Description="ScrollArea states demonstrate vertical, horizontal, and customizable scrollbar layouts."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "vertical",
            "Vertical",
            @<ScrollAreaVerticalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "vertical-razor",
                    "ScrollAreaVerticalExample.razor",
                    "Showcode/Examples/Misc/ScrollArea/ScrollAreaVerticalExample.razor")
            ]),
        new(
            "horizontal",
            "Horizontal",
            @<ScrollAreaHorizontalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "horizontal-razor",
                    "ScrollAreaHorizontalExample.razor",
                    "Showcode/Examples/Misc/ScrollArea/ScrollAreaHorizontalExample.razor")
            ]),
        new(
            "styled-scrollbar",
            "Styled scrollbar",
            @<ScrollAreaStyledScrollbarExample />,
            [
                StorySourceRegistry.CodeTab(
                    "styled-razor",
                    "ScrollAreaStyledScrollbarExample.razor",
                    "Showcode/Examples/Misc/ScrollArea/ScrollAreaStyledScrollbarExample.razor")
            ]),
        new(
            "hover-only",
            "Hover only",
            @<ScrollAreaHoverOnlyExample />,
            [
                StorySourceRegistry.CodeTab(
                    "hover-razor",
                    "ScrollAreaHoverOnlyExample.razor",
                    "Showcode/Examples/Misc/ScrollArea/ScrollAreaHoverOnlyExample.razor")
            ])
    ];
}
