@attribute [DisplayName("Misc/Scroll Area")]
@inherits StoryComponent

<StoryCard Title="Scroll Area"
           Description="ScrollArea states demonstrate vertical and horizontal overflow scrolling."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "vertical",
            "Vertical",
            @<ScrollArea class="h-48 w-72 border rounded-md" Orientation="vertical">
                <div class="p-4 space-y-2">
                    @for (var i = 1; i <= 20; i++)
                    {
                        <p class="text-sm">Item @i: Lorem ipsum dolor sit amet.</p>
                    }
                </div>
            </ScrollArea>,
            [
                new StoryCard.CodeTab("vertical-razor", "ScrollAreaStory.razor", VerticalRazor)
            ]),
        new(
            "horizontal",
            "Horizontal",
            @<ScrollArea class="h-24 w-72 border rounded-md" Orientation="horizontal">
                <div class="flex gap-3 p-4" style="width: max-content;">
                    @for (var i = 1; i <= 12; i++)
                    {
                        <div class="w-28 h-14 bg-muted rounded flex items-center justify-center shrink-0">
                            <span class="text-xs font-medium">Card @i</span>
                        </div>
                    }
                </div>
            </ScrollArea>,
            [
                new StoryCard.CodeTab("horizontal-razor", "ScrollAreaStory.razor", HorizontalRazor)
            ])
    ];

    private const string VerticalRazor =
        """
        <ScrollArea class="h-48 w-72 border rounded-md" Orientation="vertical">
            <div class="p-4 space-y-2">
                @for (var i = 1; i <= 20; i++)
                {
                    <p class="text-sm">Item @i: Lorem ipsum dolor sit amet.</p>
                }
            </div>
        </ScrollArea>
        """;

    private const string HorizontalRazor =
        """
        <ScrollArea class="h-24 w-72 border rounded-md" Orientation="horizontal">
            <div class="flex gap-3 p-4" style="width: max-content;">
                @for (var i = 1; i <= 12; i++)
                {
                    <div class="w-28 h-14 bg-muted rounded flex items-center justify-center shrink-0">
                        <span class="text-xs font-medium">Card @i</span>
                    </div>
                }
            </div>
        </ScrollArea>
        """;
}
