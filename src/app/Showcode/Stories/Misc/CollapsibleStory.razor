@attribute [DisplayName("Misc/Collapsible")]
@inherits StoryComponent

<div class="space-y-8 max-w-sm">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Default</h2>
        <Collapsible @bind-IsOpen="_open">
            <CollapsibleTrigger class="flex items-center gap-2 text-sm font-medium hover:underline">
                <span>Toggle repositories</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform" style="transform: rotate(@(_open ? "180deg" : "0deg"))"><path d="m6 9 6 6 6-6"/></svg>
            </CollapsibleTrigger>
            <CollapsibleContent class="mt-2 space-y-1">
                <div class="rounded-md border px-4 py-2 text-sm">@@permer/cloc</div>
                <div class="rounded-md border px-4 py-2 text-sm">@@stitches/core</div>
                <div class="rounded-md border px-4 py-2 text-sm">@@radix-ui/react-collapsible</div>
            </CollapsibleContent>
        </Collapsible>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">In a card</h2>
        <Collapsible @bind-IsOpen="_open2">
            <Card>
                <CardHeader>
                    <div class="flex items-center justify-between">
                        <CardTitle>Advanced Settings</CardTitle>
                        <CollapsibleTrigger class="p-1.5 hover:bg-muted rounded">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(@(_open2 ? "180deg" : "0deg"))"><path d="m6 9 6 6 6-6"/></svg>
                        </CollapsibleTrigger>
                    </div>
                </CardHeader>
                <CollapsibleContent>
                    <CardContent class="pt-0">
                        <p class="text-sm text-muted-foreground">Advanced settings are hidden by default to keep the UI clean.</p>
                    </CardContent>
                </CollapsibleContent>
            </Card>
        </Collapsible>
    </section>
</div>

@code {
    bool _open;
    bool _open2;
}
