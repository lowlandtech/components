@attribute [DisplayName("Misc/Theme Provider")]
@inherits StoryComponent

<StoryCard Title="Theme Provider"
           Description="ThemeProvider establishes a scoped theme boundary. Multiple providers can be active simultaneously, each tracking an independent active theme via ComponentThemeService. ThemeToggle inside a provider cycles through all registered IComponentTheme implementations without affecting sibling boundaries."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "boundary",
            "Boundary",
            @<ThemeProviderBoundaryExample />,
            [
                StorySourceRegistry.CodeTab(
                    "boundary-razor",
                    "ThemeProviderBoundaryExample.razor",
                    "Showcode/Examples/Misc/ThemeProvider/ThemeProviderBoundaryExample.razor")
            ]),
        new(
            "nested",
            "Nested",
            @<ThemeProviderNestedExample />,
            [
                StorySourceRegistry.CodeTab(
                    "nested-razor",
                    "ThemeProviderNestedExample.razor",
                    "Showcode/Examples/Misc/ThemeProvider/ThemeProviderNestedExample.razor")
            ])
    ];
}
