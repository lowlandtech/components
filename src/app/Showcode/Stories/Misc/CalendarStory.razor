@attribute [DisplayName("Misc/Calendar")]
@inherits StoryComponent

<StoryCard Title="Calendar"
           Description="Calendar states demonstrate single, range, and multiple selection modes, presets, dropdown navigation, and disabled dates."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "single",
            "Single",
            @<CalendarSingleExample />,
            [
                StorySourceRegistry.CodeTab(
                    "single-razor",
                    "CalendarSingleExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarSingleExample.razor")
            ]),
        new(
            "range",
            "Range",
            @<CalendarRangeExample />,
            [
                StorySourceRegistry.CodeTab(
                    "range-razor",
                    "CalendarRangeExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarRangeExample.razor")
            ]),
        new(
            "multiple",
            "Multiple",
            @<CalendarMultipleExample />,
            [
                StorySourceRegistry.CodeTab(
                    "multiple-razor",
                    "CalendarMultipleExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarMultipleExample.razor")
            ]),
        new(
            "presets",
            "With Presets",
            @<CalendarPresetsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "presets-razor",
                    "CalendarPresetsExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarPresetsExample.razor")
            ]),
        new(
            "dropdowns",
            "Dropdown Navigation",
            @<CalendarDropdownsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "dropdowns-razor",
                    "CalendarDropdownsExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarDropdownsExample.razor")
            ]),
        new(
            "disabled",
            "Disabled Weekends",
            @<CalendarDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "CalendarDisabledExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarDisabledExample.razor")
            ]),
        new(
            "no-outside",
            "Hide Outside Days",
            @<CalendarNoOutsideExample />,
            [
                StorySourceRegistry.CodeTab(
                    "no-outside-razor",
                    "CalendarNoOutsideExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarNoOutsideExample.razor")
            ]),
        new(
            "zoom",
            "View Zoom",
            @<CalendarZoomExample />,
            [
                StorySourceRegistry.CodeTab(
                    "zoom-razor",
                    "CalendarZoomExample.razor",
                    "Showcode/Examples/Misc/Calendar/CalendarZoomExample.razor")
            ])
    ];
}
