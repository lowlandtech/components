@attribute [DisplayName("Navigation/Pagination")]
@inherits StoryComponent

<StoryCard Title="Pagination"
           Description="Page navigation with previous/next controls, page links, and ellipsis for large ranges."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States =>
    [
        new(
            "first-page",
            "First page (1 of 10)",
            @<PaginationFirstPageExample />,
            [
                StorySourceRegistry.CodeTab(
                    "first-razor",
                    "PaginationFirstPageExample.razor",
                    "Showcode/Examples/Navigation/Pagination/PaginationFirstPageExample.razor")
            ]),
        new(
            "middle-page",
            "Middle page (5 of 20)",
            @<PaginationMiddlePageExample />,
            [
                StorySourceRegistry.CodeTab(
                    "middle-razor",
                    "PaginationMiddlePageExample.razor",
                    "Showcode/Examples/Navigation/Pagination/PaginationMiddlePageExample.razor")
            ]),
        new(
            "last-page",
            "Last page (10 of 10)",
            @<PaginationLastPageExample />,
            [
                StorySourceRegistry.CodeTab(
                    "last-razor",
                    "PaginationLastPageExample.razor",
                    "Showcode/Examples/Navigation/Pagination/PaginationLastPageExample.razor")
            ])
    ];
}
