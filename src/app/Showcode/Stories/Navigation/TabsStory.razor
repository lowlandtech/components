@attribute [DisplayName("Navigation/Tabs")]
@inherits StoryComponent

<StoryCard Title="Tabs"
           Description="Tabs states demonstrate default, disabled, line, overflow, and IDE-style dynamic tabs."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States =>
    [
        new(
            "default",
            "Default",
            @<TabsDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "TabsDefaultExample.razor",
                    "Showcode/Examples/Navigation/Tabs/TabsDefaultExample.razor")
            ]),
        new(
            "disabled",
            "Disabled",
            @<TabsDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "TabsDisabledExample.razor",
                    "Showcode/Examples/Navigation/Tabs/TabsDisabledExample.razor")
            ]),
        new(
            "line",
            "Line",
            @<TabsLineExample />,
            [
                StorySourceRegistry.CodeTab(
                    "line-razor",
                    "TabsLineExample.razor",
                    "Showcode/Examples/Navigation/Tabs/TabsLineExample.razor")
            ]),
        new(
            "overflow",
            "Overflow",
            @<TabsOverflowExample />,
            [
                StorySourceRegistry.CodeTab(
                    "overflow-razor",
                    "TabsOverflowExample.razor",
                    "Showcode/Examples/Navigation/Tabs/TabsOverflowExample.razor")
            ]),
        new(
            "ide",
            "IDE",
            @<TabsIdeExample />,
            [
                StorySourceRegistry.CodeTab(
                    "ide-razor",
                    "TabsIdeExample.razor",
                    "Showcode/Examples/Navigation/Tabs/TabsIdeExample.razor")
            ])
    ];
}
