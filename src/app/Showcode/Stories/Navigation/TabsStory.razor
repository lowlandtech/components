@attribute [DisplayName("Navigation/Tabs")]
@inherits StoryComponent

<StoryCard Title="Tabs"
           Description="Tabs states demonstrate default, disabled, and line variants with the markup for each composition."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<Tabs DefaultValue="account" class="w-full max-w-lg">
                <TabsList>
                    <TabsTrigger Value="account">Account</TabsTrigger>
                    <TabsTrigger Value="password">Password</TabsTrigger>
                    <TabsTrigger Value="settings">Settings</TabsTrigger>
                </TabsList>
                <TabsContent Value="account">
                    <div class="rounded-lg border bg-card p-4 text-card-foreground">
                        <h3 class="mb-1 font-medium">Account Settings</h3>
                        <p class="text-sm text-muted-foreground">Manage your account preferences and personal information.</p>
                    </div>
                </TabsContent>
                <TabsContent Value="password">
                    <div class="rounded-lg border bg-card p-4 text-card-foreground">
                        <h3 class="mb-1 font-medium">Password Settings</h3>
                        <p class="text-sm text-muted-foreground">Update your password and security preferences.</p>
                    </div>
                </TabsContent>
                <TabsContent Value="settings">
                    <div class="rounded-lg border bg-card p-4 text-card-foreground">
                        <h3 class="mb-1 font-medium">General Settings</h3>
                        <p class="text-sm text-muted-foreground">Configure application-wide settings and notifications.</p>
                    </div>
                </TabsContent>
            </Tabs>,
            [
                new StoryCard.CodeTab("default-razor", "TabsStory.razor", DefaultRazor)
            ]),
        new(
            "disabled",
            "Disabled",
            @<Tabs DefaultValue="tab1" class="w-full max-w-lg">
                <TabsList>
                    <TabsTrigger Value="tab1">Active</TabsTrigger>
                    <TabsTrigger Value="tab2">Also Active</TabsTrigger>
                    <TabsTrigger Value="tab3" Disabled="true">Disabled</TabsTrigger>
                </TabsList>
                <TabsContent Value="tab1"><p class="p-2 text-sm text-muted-foreground">Tab 1 content.</p></TabsContent>
                <TabsContent Value="tab2"><p class="p-2 text-sm text-muted-foreground">Tab 2 content.</p></TabsContent>
                <TabsContent Value="tab3"><p class="p-2 text-sm text-muted-foreground">Unreachable content.</p></TabsContent>
            </Tabs>,
            [
                new StoryCard.CodeTab("disabled-razor", "TabsStory.razor", DisabledRazor)
            ]),
        new(
            "line",
            "Line",
            @<Tabs DefaultValue="preview" class="w-full max-w-lg">
                <TabsList Variant="line">
                    <TabsTrigger Value="preview">Preview</TabsTrigger>
                    <TabsTrigger Value="code">Code</TabsTrigger>
                    <TabsTrigger Value="settings">Settings</TabsTrigger>
                </TabsList>
                <TabsContent Value="preview">
                    <p class="p-3 text-sm text-muted-foreground">Line tabs keep focus on dense editor-like surfaces.</p>
                </TabsContent>
                <TabsContent Value="code">
                    <p class="p-3 text-sm text-muted-foreground">Code content.</p>
                </TabsContent>
                <TabsContent Value="settings">
                    <p class="p-3 text-sm text-muted-foreground">Settings content.</p>
                </TabsContent>
            </Tabs>,
            [
                new StoryCard.CodeTab("line-razor", "TabsStory.razor", LineRazor)
            ])
    ];

    private const string DefaultRazor =
        """
        <Tabs DefaultValue="account">
            <TabsList>
                <TabsTrigger Value="account">Account</TabsTrigger>
                <TabsTrigger Value="password">Password</TabsTrigger>
                <TabsTrigger Value="settings">Settings</TabsTrigger>
            </TabsList>
            <TabsContent Value="account">
                <div class="rounded-lg border bg-card p-4 text-card-foreground">
                    <h3 class="mb-1 font-medium">Account Settings</h3>
                    <p class="text-sm text-muted-foreground">Manage your account preferences and personal information.</p>
                </div>
            </TabsContent>
        </Tabs>
        """;

    private const string DisabledRazor =
        """
        <Tabs DefaultValue="tab1">
            <TabsList>
                <TabsTrigger Value="tab1">Active</TabsTrigger>
                <TabsTrigger Value="tab2">Also Active</TabsTrigger>
                <TabsTrigger Value="tab3" Disabled="true">Disabled</TabsTrigger>
            </TabsList>
            <TabsContent Value="tab1">
                <p class="p-2 text-sm text-muted-foreground">Tab 1 content.</p>
            </TabsContent>
        </Tabs>
        """;

    private const string LineRazor =
        """
        <Tabs DefaultValue="preview">
            <TabsList Variant="line">
                <TabsTrigger Value="preview">Preview</TabsTrigger>
                <TabsTrigger Value="code">Code</TabsTrigger>
                <TabsTrigger Value="settings">Settings</TabsTrigger>
            </TabsList>
            <TabsContent Value="preview">
                <p class="p-3 text-sm text-muted-foreground">Line tabs keep focus on dense editor-like surfaces.</p>
            </TabsContent>
        </Tabs>
        """;
}
