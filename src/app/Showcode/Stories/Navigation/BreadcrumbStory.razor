@attribute [DisplayName("Navigation/Breadcrumb")]
@inherits StoryComponent

<StoryCard Title="Breadcrumb"
           Description="Hierarchical navigation trail with separator variants and ellipsis truncation."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States =>
    [
        new(
            "basic",
            "Basic",
            @<BreadcrumbBasicExample />,
            [
                StorySourceRegistry.CodeTab(
                    "basic-razor",
                    "BreadcrumbBasicExample.razor",
                    "Showcode/Examples/Navigation/Breadcrumb/BreadcrumbBasicExample.razor")
            ]),
        new(
            "custom-separator",
            "Custom separator",
            @<BreadcrumbCustomSeparatorExample />,
            [
                StorySourceRegistry.CodeTab(
                    "separator-razor",
                    "BreadcrumbCustomSeparatorExample.razor",
                    "Showcode/Examples/Navigation/Breadcrumb/BreadcrumbCustomSeparatorExample.razor")
            ]),
        new(
            "with-ellipsis",
            "With ellipsis",
            @<BreadcrumbWithEllipsisExample />,
            [
                StorySourceRegistry.CodeTab(
                    "ellipsis-razor",
                    "BreadcrumbWithEllipsisExample.razor",
                    "Showcode/Examples/Navigation/Breadcrumb/BreadcrumbWithEllipsisExample.razor")
            ])
    ];
}
