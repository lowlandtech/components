@attribute [DisplayName("Navigation/Command")]
@inherits StoryComponent

<StoryCard Title="Command"
           Description="Fast, composable command palette with keyboard navigation, groups, and shortcut support."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States =>
    [
        new(
            "basic",
            "Basic",
            @<CommandBasicExample />,
            [
                StorySourceRegistry.CodeTab(
                    "basic-razor",
                    "CommandBasicExample.razor",
                    "Showcode/Examples/Navigation/Command/CommandBasicExample.razor")
            ]),
        new(
            "with-shortcuts",
            "With shortcuts",
            @<CommandWithShortcutsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "shortcuts-razor",
                    "CommandWithShortcutsExample.razor",
                    "Showcode/Examples/Navigation/Command/CommandWithShortcutsExample.razor")
            ])
    ];
}
