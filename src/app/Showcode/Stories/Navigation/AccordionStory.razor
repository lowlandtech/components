@attribute [DisplayName("Navigation/Accordion")]
@inherits StoryComponent

<StoryCard Title="Accordion"
           Description="Accordion displays collapsible content panels for organizing information."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States =>
    [
        new(
            "single",
            "Single",
            @<AccordionSingleExample />,
            [
                StorySourceRegistry.CodeTab(
                    "single-razor",
                    "AccordionSingleExample.razor",
                    "Showcode/Examples/Navigation/Accordion/AccordionSingleExample.razor")
            ]),
        new(
            "multiple",
            "Multiple",
            @<AccordionMultipleExample />,
            [
                StorySourceRegistry.CodeTab(
                    "multiple-razor",
                    "AccordionMultipleExample.razor",
                    "Showcode/Examples/Navigation/Accordion/AccordionMultipleExample.razor")
            ]),
        new(
            "default-open",
            "Default open",
            @<AccordionDefaultOpenExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-open-razor",
                    "AccordionDefaultOpenExample.razor",
                    "Showcode/Examples/Navigation/Accordion/AccordionDefaultOpenExample.razor")
            ]),
        new(
            "disabled",
            "Disabled item",
            @<AccordionDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "AccordionDisabledExample.razor",
                    "Showcode/Examples/Navigation/Accordion/AccordionDisabledExample.razor")
            ])
    ];
}
