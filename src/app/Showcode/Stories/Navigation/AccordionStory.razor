@attribute [DisplayName("Navigation/Accordion")]
@inherits StoryComponent

<StoryCard Title="Accordion"
           Description="Accordion displays collapsible content panels for organizing information."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "single",
            "Single",
            @<Accordion Type="single" Collapsible="true" class="w-full max-w-md">
                <AccordionItem Value="item-1">
                    <AccordionHeader><AccordionTrigger>Is it accessible?</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Yes. It adheres to the WAI-ARIA design pattern.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="item-2">
                    <AccordionHeader><AccordionTrigger>Is it styled?</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Yes. It comes with default styles that match the other components aesthetic.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="item-3">
                    <AccordionHeader><AccordionTrigger>Is it animated?</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Yes. It is animated by default, but you can disable it if you prefer.</AccordionContent>
                </AccordionItem>
            </Accordion>,
            [
                new StoryCard.CodeTab("single-razor", "AccordionStory.razor", SingleRazor)
            ]),
        new(
            "multiple",
            "Multiple",
            @<Accordion Type="multiple" class="w-full max-w-md">
                <AccordionItem Value="q1">
                    <AccordionHeader><AccordionTrigger>What is Foundry?</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Foundry is a modular, extensible web platform built on .NET 10.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="q2">
                    <AccordionHeader><AccordionTrigger>Which framework is used for the UI?</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Blazor Server with Interactive Server Components and Tailwind CSS 4.0.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="q3">
                    <AccordionHeader><AccordionTrigger>Is there a plugin system?</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Yes. Plugins follow a core/backend/frontend architecture with hot-reload support.</AccordionContent>
                </AccordionItem>
            </Accordion>,
            [
                new StoryCard.CodeTab("multiple-razor", "AccordionStory.razor", MultipleRazor)
            ]),
        new(
            "default-open",
            "Default open",
            @<Accordion Type="single" Collapsible="true" DefaultValue="faq-2" class="w-full max-w-md">
                <AccordionItem Value="faq-1">
                    <AccordionHeader><AccordionTrigger>Installation</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Run dotnet restore and dotnet build to get started.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="faq-2">
                    <AccordionHeader><AccordionTrigger>Configuration</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Edit appsettings.json to configure database, SMTP, and external services.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="faq-3">
                    <AccordionHeader><AccordionTrigger>Deployment</AccordionTrigger></AccordionHeader>
                    <AccordionContent>Use Docker Compose with the provided infra configuration files.</AccordionContent>
                </AccordionItem>
            </Accordion>,
            [
                new StoryCard.CodeTab("default-open-razor", "AccordionStory.razor", DefaultOpenRazor)
            ]),
        new(
            "disabled",
            "Disabled item",
            @<Accordion Type="single" class="w-full max-w-md">
                <AccordionItem Value="a1">
                    <AccordionHeader><AccordionTrigger>Available item</AccordionTrigger></AccordionHeader>
                    <AccordionContent>This item can be expanded and collapsed.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="a2" Disabled="true">
                    <AccordionHeader><AccordionTrigger>Disabled item</AccordionTrigger></AccordionHeader>
                    <AccordionContent>This content is inaccessible because the item is disabled.</AccordionContent>
                </AccordionItem>
                <AccordionItem Value="a3">
                    <AccordionHeader><AccordionTrigger>Another available item</AccordionTrigger></AccordionHeader>
                    <AccordionContent>This item is also fully interactive.</AccordionContent>
                </AccordionItem>
            </Accordion>,
            [
                new StoryCard.CodeTab("disabled-razor", "AccordionStory.razor", DisabledRazor)
            ])
    ];

    private const string SingleRazor =
        """
        <Accordion Type="single" Collapsible="true">
            <AccordionItem Value="item-1">
                <AccordionHeader><AccordionTrigger>Is it accessible?</AccordionTrigger></AccordionHeader>
                <AccordionContent>Yes. It adheres to the WAI-ARIA design pattern.</AccordionContent>
            </AccordionItem>
            <AccordionItem Value="item-2">
                <AccordionHeader><AccordionTrigger>Is it styled?</AccordionTrigger></AccordionHeader>
                <AccordionContent>Yes. It comes with default styles.</AccordionContent>
            </AccordionItem>
        </Accordion>
        """;

    private const string MultipleRazor =
        """
        <Accordion Type="multiple">
            <AccordionItem Value="q1">
                <AccordionHeader><AccordionTrigger>What is Foundry?</AccordionTrigger></AccordionHeader>
                <AccordionContent>Foundry is a modular web platform built on .NET 10.</AccordionContent>
            </AccordionItem>
            <AccordionItem Value="q2">
                <AccordionHeader><AccordionTrigger>Which framework?</AccordionTrigger></AccordionHeader>
                <AccordionContent>Blazor Server with Tailwind CSS 4.0.</AccordionContent>
            </AccordionItem>
        </Accordion>
        """;

    private const string DefaultOpenRazor =
        """
        <Accordion Type="single" Collapsible="true" DefaultValue="faq-2">
            <AccordionItem Value="faq-1">
                <AccordionHeader><AccordionTrigger>Installation</AccordionTrigger></AccordionHeader>
                <AccordionContent>Run dotnet restore and dotnet build.</AccordionContent>
            </AccordionItem>
            <AccordionItem Value="faq-2">
                <AccordionHeader><AccordionTrigger>Configuration</AccordionTrigger></AccordionHeader>
                <AccordionContent>Edit appsettings.json to configure services.</AccordionContent>
            </AccordionItem>
        </Accordion>
        """;

    private const string DisabledRazor =
        """
        <Accordion Type="single">
            <AccordionItem Value="a1">
                <AccordionHeader><AccordionTrigger>Available item</AccordionTrigger></AccordionHeader>
                <AccordionContent>This item can be expanded.</AccordionContent>
            </AccordionItem>
            <AccordionItem Value="a2" Disabled="true">
                <AccordionHeader><AccordionTrigger>Disabled item</AccordionTrigger></AccordionHeader>
                <AccordionContent>This content is inaccessible.</AccordionContent>
            </AccordionItem>
        </Accordion>
        """;
}
