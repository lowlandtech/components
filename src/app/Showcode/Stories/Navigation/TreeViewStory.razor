@attribute [DisplayName("Navigation/TreeView")]
@inherits StoryComponent

<StoryCard Title="TreeView"
           Description="TreeView displays hierarchical data with expandable nodes."
           States="@States" />

@code {
    private sealed record FileItem(string Name, IReadOnlyList<FileItem> Children);

    private static string GetIcon(FileItem item) => item.Children.Count > 0 ? "folder" : "file";

    private static readonly IReadOnlyList<FileItem> RootItems =
    [
        new("src",
        [
            new("components",
            [
                new("Button.razor", []),
                new("Card.razor", []),
                new("Dialog.razor", [])
            ]),
            new("app",
            [
                new("Program.cs", [])
            ])
        ]),
        new("docs",
        [
            new("readme.md", [])
        ]),
        new("package.json", [])
    ];

    private const string CollapsedRazor =
        """
        <TreeView TItem="FileItem"
                  Items="RootItems"
                  GetChildren="f => f.Children"
                  HasChildren="f => f.Children.Count > 0">
            <ItemTemplate Context="ctx">
                <div style="padding-left: @(ctx.Depth * 16 + 8)px">
                    <span>@ctx.Item.Name</span>
                </div>
            </ItemTemplate>
        </TreeView>
        """;

    private const string ExpandedRazor =
        """
        <TreeView TItem="FileItem"
                  Items="RootItems"
                  GetChildren="f => f.Children"
                  HasChildren="f => f.Children.Count > 0"
                  IsExpanded='f => f.Name == "src" || f.Name == "components"'>
            <ItemTemplate Context="ctx">
                <div style="padding-left: @(ctx.Depth * 16 + 8)px">
                    <span>@ctx.Item.Name</span>
                </div>
            </ItemTemplate>
        </TreeView>
        """;

    private IReadOnlyList<StoryCard.State> States => [
        new(
            "collapsed",
            "Collapsed",
            @<div class="w-full max-w-sm rounded-lg border border-border p-4">
                <TreeView TItem="FileItem"
                          Items="RootItems"
                          GetChildren="f => f.Children"
                          HasChildren="f => f.Children.Count > 0"
                          class="space-y-1">
                    <ItemTemplate Context="ctx">
                        <div class="flex items-center gap-2 rounded px-2 py-1 hover:bg-muted"
                             style="padding-left: @(ctx.Depth * 16 + 8)px">
                            @if (ctx.HasChildren)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     class="transition-transform @(ctx.IsExpanded ? "rotate-90" : "")">
                                    <path d="m9 18 6-6-6-6"/>
                                </svg>
                            }
                            else
                            {
                                <span class="w-3.5"></span>
                            }
                            <Icon Name="@GetIcon(ctx.Item)" Size="14" />
                            <span class="text-sm">@ctx.Item.Name</span>
                        </div>
                    </ItemTemplate>
                </TreeView>
            </div>,
            [
                new StoryCard.CodeTab("collapsed-razor", "TreeViewStory.razor", CollapsedRazor)
            ]),
        new(
            "expanded",
            "Expanded",
            @<div class="w-full max-w-sm rounded-lg border border-border p-4">
                <TreeView TItem="FileItem"
                          Items="RootItems"
                          GetChildren="f => f.Children"
                          HasChildren="f => f.Children.Count > 0"
                          IsExpanded='f => f.Name == "src" || f.Name == "components"'
                          class="space-y-1">
                    <ItemTemplate Context="ctx">
                        <div class="flex items-center gap-2 rounded px-2 py-1 hover:bg-muted"
                             style="padding-left: @(ctx.Depth * 16 + 8)px">
                            @if (ctx.HasChildren)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     class="transition-transform @(ctx.IsExpanded ? "rotate-90" : "")">
                                    <path d="m9 18 6-6-6-6"/>
                                </svg>
                            }
                            else
                            {
                                <span class="w-3.5"></span>
                            }
                            <Icon Name="@GetIcon(ctx.Item)" Size="14" />
                            <span class="text-sm">@ctx.Item.Name</span>
                        </div>
                    </ItemTemplate>
                </TreeView>
            </div>,
            [
                new StoryCard.CodeTab("expanded-razor", "TreeViewStory.razor", ExpandedRazor)
            ])
    ];
}
