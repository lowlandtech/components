@attribute [DisplayName("Navigation/NavigationMenu")]
@inherits StoryComponent

<StoryCard Title="NavigationMenu"
           Description="NavigationMenu displays a horizontal menu with dropdown panels for site navigation."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States =>
    [
        new(
            "with-dropdowns",
            "With dropdowns",
            @<NavigationMenuWithDropdownsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "dropdowns-razor",
                    "NavigationMenuWithDropdownsExample.razor",
                    "Showcode/Examples/Navigation/NavigationMenu/NavigationMenuWithDropdownsExample.razor")
            ]),
        new(
            "links-only",
            "Links only",
            @<NavigationMenuLinksOnlyExample />,
            [
                StorySourceRegistry.CodeTab(
                    "links-razor",
                    "NavigationMenuLinksOnlyExample.razor",
                    "Showcode/Examples/Navigation/NavigationMenu/NavigationMenuLinksOnlyExample.razor")
            ])
    ];
}
