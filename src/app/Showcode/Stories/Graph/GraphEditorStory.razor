@attribute [DisplayName("Graph/Editor")]
@inherits StoryComponent

<StoryCard Title="GraphEditor"
           Description="Interactive diagram editor — drag any node and its edges and ports follow automatically. Built on a mutable GraphDiagram model with C# event-driven reactivity. No JavaScript required for WASM; Server-mode hosting benefits from a JS-interop pointer-move debounce for high-latency connections."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "pipeline",
            "Pipeline",
            @<GraphEditorPipelineExample />,
            [
                StorySourceRegistry.CodeTab(
                    "pipeline-razor",
                    "GraphEditorPipelineExample.razor",
                    "Showcode/Examples/Graph/GraphEditor/GraphEditorPipelineExample.razor")
            ]),
        new(
            "branching",
            "Branching",
            @<GraphEditorBranchingExample />,
            [
                StorySourceRegistry.CodeTab(
                    "branching-razor",
                    "GraphEditorBranchingExample.razor",
                    "Showcode/Examples/Graph/GraphEditor/GraphEditorBranchingExample.razor")
            ])
    ];
}
