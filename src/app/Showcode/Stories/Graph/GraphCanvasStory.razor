@attribute [DisplayName("Graph/Canvas")]
@inherits StoryComponent

<StoryCard Title="GraphCanvas"
           Description="SVG canvas container for graph visualizations. Provides a dot-grid background, arrowhead marker definitions, and a cascading ID so nested edges can reference the correct markers."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "pipeline",
            "Pipeline",
            @<GraphCanvasPipelineExample />,
            [
                StorySourceRegistry.CodeTab(
                    "pipeline-razor",
                    "GraphCanvasPipelineExample.razor",
                    "Showcode/Examples/Graph/GraphCanvas/GraphCanvasPipelineExample.razor")
            ]),
        new(
            "branching",
            "Branching",
            @<GraphCanvasBranchingExample />,
            [
                StorySourceRegistry.CodeTab(
                    "branching-razor",
                    "GraphCanvasBranchingExample.razor",
                    "Showcode/Examples/Graph/GraphCanvas/GraphCanvasBranchingExample.razor")
            ]),
        new(
            "no-grid",
            "No grid",
            @<GraphCanvasNoGridExample />,
            [
                StorySourceRegistry.CodeTab(
                    "no-grid-razor",
                    "GraphCanvasNoGridExample.razor",
                    "Showcode/Examples/Graph/GraphCanvas/GraphCanvasNoGridExample.razor")
            ])
    ];
}
