@attribute [DisplayName("Feedback/Alert")]
@inherits StoryComponent

<StoryCard Title="Alert"
           Description="Alert states demonstrate default, destructive, and icon-supported feedback patterns."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<AlertDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "AlertDefaultExample.razor",
                    "Showcode/Examples/Feedback/Alert/AlertDefaultExample.razor")
            ]),
        new(
            "destructive",
            "Destructive",
            @<AlertDestructiveExample />,
            [
                StorySourceRegistry.CodeTab(
                    "destructive-razor",
                    "AlertDestructiveExample.razor",
                    "Showcode/Examples/Feedback/Alert/AlertDestructiveExample.razor")
            ]),
        new(
            "with-icon",
            "With icon",
            @<AlertWithIconExample />,
            [
                StorySourceRegistry.CodeTab(
                    "icon-razor",
                    "AlertWithIconExample.razor",
                    "Showcode/Examples/Feedback/Alert/AlertWithIconExample.razor")
            ])
    ];
}
