@attribute [DisplayName("Feedback/Alert")]
@inherits StoryComponent

<StoryCard Title="Alert"
           Description="Alert states demonstrate default, destructive, and icon-supported feedback patterns."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<Alert class="max-w-lg">
                <AlertTitle>Default</AlertTitle>
                <AlertDescription>This is a default alert with general information.</AlertDescription>
            </Alert>,
            [
                new StoryCard.CodeTab("default-razor", "AlertStory.razor", DefaultRazor)
            ]),
        new(
            "destructive",
            "Destructive",
            @<Alert Variant="destructive" class="max-w-lg">
                <AlertTitle>Destructive</AlertTitle>
                <AlertDescription>Your session has expired. Please log in again to continue.</AlertDescription>
            </Alert>,
            [
                new StoryCard.CodeTab("destructive-razor", "AlertStory.razor", DestructiveRazor)
            ]),
        new(
            "with-icon",
            "With icon",
            @<Alert class="max-w-lg">
                <Icon Name="circle-alert" Size="16" data-slot="alert-icon" />
                <AlertTitle>Heads up!</AlertTitle>
                <AlertDescription>You can add components and dependencies to your app using the CLI.</AlertDescription>
            </Alert>,
            [
                new StoryCard.CodeTab("icon-razor", "AlertStory.razor", IconRazor)
            ])
    ];

    private const string DefaultRazor =
        """
        <Alert>
            <AlertTitle>Default</AlertTitle>
            <AlertDescription>This is a default alert with general information.</AlertDescription>
        </Alert>
        """;

    private const string DestructiveRazor =
        """
        <Alert Variant="destructive">
            <AlertTitle>Destructive</AlertTitle>
            <AlertDescription>Your session has expired. Please log in again to continue.</AlertDescription>
        </Alert>
        """;

    private const string IconRazor =
        """
        <Alert>
            <Icon Name="circle-alert" Size="16" data-slot="alert-icon" />
            <AlertTitle>Heads up!</AlertTitle>
            <AlertDescription>You can add components and dependencies to your app using the CLI.</AlertDescription>
        </Alert>
        """;
}
