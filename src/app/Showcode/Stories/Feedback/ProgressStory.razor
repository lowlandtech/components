@attribute [DisplayName("Feedback/Progress")]
@inherits StoryComponent

<StoryCard Title="Progress"
           Description="Progress states demonstrate value ranges, completion, compact sizing, and indeterminate loading."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "values",
            "Values",
            @<ProgressValuesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "values-razor",
                    "ProgressValuesExample.razor",
                    "Showcode/Examples/Feedback/Progress/ProgressValuesExample.razor")
            ]),
        new(
            "indeterminate",
            "Indeterminate",
            @<ProgressIndeterminateExample />,
            [
                StorySourceRegistry.CodeTab(
                    "indeterminate-razor",
                    "ProgressIndeterminateExample.razor",
                    "Showcode/Examples/Feedback/Progress/ProgressIndeterminateExample.razor")
            ]),
        new(
            "custom-max",
            "Custom max",
            @<ProgressCustomMaxExample />,
            [
                StorySourceRegistry.CodeTab(
                    "custom-max-razor",
                    "ProgressCustomMaxExample.razor",
                    "Showcode/Examples/Feedback/Progress/ProgressCustomMaxExample.razor")
            ])
    ];
}
