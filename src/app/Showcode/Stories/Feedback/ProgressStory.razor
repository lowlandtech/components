@attribute [DisplayName("Feedback/Progress")]
@inherits StoryComponent

<div class="space-y-8 max-w-sm">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Values</h2>
        <div class="space-y-4">
            <div class="space-y-1">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">0%</span>
                </div>
                <Progress Value="0" Max="100" />
            </div>
            <div class="space-y-1">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">33%</span>
                </div>
                <Progress Value="33" Max="100" />
            </div>
            <div class="space-y-1">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">66%</span>
                </div>
                <Progress Value="66" Max="100" />
            </div>
            <div class="space-y-1">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">100%</span>
                </div>
                <Progress Value="100" Max="100" />
            </div>
        </div>
    </section>
</div>
