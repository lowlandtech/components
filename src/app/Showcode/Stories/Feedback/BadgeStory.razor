@attribute [DisplayName("Feedback/Badge")]
@inherits StoryComponent

<StoryCard Title="Badge"
           Description="Badge states demonstrate semantic variants, status labels, and compact icon composition."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "variants",
            "Variants",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Badge Variant="default">Default</Badge>
                <Badge Variant="secondary">Secondary</Badge>
                <Badge Variant="destructive">Destructive</Badge>
                <Badge Variant="outline">Outline</Badge>
            </div>,
            [
                new StoryCard.CodeTab("variants-razor", "BadgeStory.razor", VariantsRazor)
            ]),
        new(
            "status",
            "In context",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <span class="text-sm font-medium">Status:</span>
                <Badge Variant="default">Active</Badge>
                <Badge Variant="secondary">Pending</Badge>
                <Badge Variant="destructive">Rejected</Badge>
                <Badge Variant="outline">Draft</Badge>
            </div>,
            [
                new StoryCard.CodeTab("status-razor", "BadgeStory.razor", StatusRazor)
            ]),
        new(
            "with-icon",
            "With icon",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Badge>
                    <Icon Name="check" Size="12" />
                    Verified
                </Badge>
                <Badge Variant="secondary">
                    <Icon Name="circle-alert" Size="12" />
                    New
                </Badge>
            </div>,
            [
                new StoryCard.CodeTab("icon-razor", "BadgeStory.razor", IconRazor)
            ])
    ];

    private const string VariantsRazor =
        """
        <div class="flex flex-wrap gap-3">
            <Badge Variant="default">Default</Badge>
            <Badge Variant="secondary">Secondary</Badge>
            <Badge Variant="destructive">Destructive</Badge>
            <Badge Variant="outline">Outline</Badge>
        </div>
        """;

    private const string StatusRazor =
        """
        <div class="flex flex-wrap items-center gap-3">
            <span class="text-sm font-medium">Status:</span>
            <Badge Variant="default">Active</Badge>
            <Badge Variant="secondary">Pending</Badge>
            <Badge Variant="destructive">Rejected</Badge>
            <Badge Variant="outline">Draft</Badge>
        </div>
        """;

    private const string IconRazor =
        """
        <div class="flex flex-wrap gap-3">
            <Badge>
                <Icon Name="check" Size="12" />
                Verified
            </Badge>
            <Badge Variant="secondary">
                <Icon Name="circle-alert" Size="12" />
                New
            </Badge>
        </div>
        """;
}
