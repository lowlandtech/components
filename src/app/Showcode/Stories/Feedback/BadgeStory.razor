@attribute [DisplayName("Feedback/Badge")]
@inherits StoryComponent

<StoryCard Title="Badge"
           Description="Badge states demonstrate semantic variants, status labels, and compact icon composition."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "variants",
            "Variants",
            @<BadgeVariantsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "variants-razor",
                    "BadgeVariantsExample.razor",
                    "Showcode/Examples/Feedback/Badge/BadgeVariantsExample.razor")
            ]),
        new(
            "status",
            "In context",
            @<BadgeStatusExample />,
            [
                StorySourceRegistry.CodeTab(
                    "status-razor",
                    "BadgeStatusExample.razor",
                    "Showcode/Examples/Feedback/Badge/BadgeStatusExample.razor")
            ]),
        new(
            "with-icon",
            "With icon",
            @<BadgeWithIconExample />,
            [
                StorySourceRegistry.CodeTab(
                    "icon-razor",
                    "BadgeWithIconExample.razor",
                    "Showcode/Examples/Feedback/Badge/BadgeWithIconExample.razor")
            ])
    ];
}
