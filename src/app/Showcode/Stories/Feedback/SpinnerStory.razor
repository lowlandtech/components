@attribute [DisplayName("Feedback/Spinner")]
@inherits StoryComponent

<StoryCard Title="Spinner"
           Description="Spinner states demonstrate sizing, colors, inline labels, and disabled button loading affordances."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "sizes",
            "Sizes",
            @<div class="flex flex-wrap items-end justify-center gap-6">
                <div class="flex flex-col items-center gap-2">
                    <Spinner class="size-4" />
                    <span class="text-xs text-muted-foreground">size-4</span>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <Spinner class="size-6" />
                    <span class="text-xs text-muted-foreground">size-6</span>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <Spinner class="size-8" />
                    <span class="text-xs text-muted-foreground">size-8</span>
                </div>
            </div>,
            [
                new StoryCard.CodeTab("sizes-razor", "SpinnerStory.razor", SizesRazor)
            ]),
        new(
            "colors",
            "Colors",
            @<div class="flex flex-wrap items-center justify-center gap-6">
                <div class="flex flex-col items-center gap-2">
                    <Spinner class="size-6" Color="text-primary" />
                    <span class="text-xs text-muted-foreground">primary</span>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <Spinner class="size-6" Color="text-destructive" />
                    <span class="text-xs text-muted-foreground">destructive</span>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <Spinner class="size-6" Color="text-green-500" />
                    <span class="text-xs text-muted-foreground">green-500</span>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <Spinner class="size-6" Color="text-amber-500" />
                    <span class="text-xs text-muted-foreground">amber-500</span>
                </div>
            </div>,
            [
                new StoryCard.CodeTab("colors-razor", "SpinnerStory.razor", ColorsRazor)
            ]),
        new(
            "with-label",
            "With label",
            @<div class="flex items-center gap-2 text-sm text-muted-foreground">
                <Spinner class="size-4" />
                Loading...
            </div>,
            [
                new StoryCard.CodeTab("label-razor", "SpinnerStory.razor", LabelRazor)
            ]),
        new(
            "inside-button",
            "Inside button",
            @<Button Variant="outline" disabled>
                <Spinner class="size-4" />
                Processing
            </Button>,
            [
                new StoryCard.CodeTab("button-razor", "SpinnerStory.razor", ButtonRazor)
            ])
    ];

    private const string SizesRazor =
        """
        <div class="flex flex-wrap items-end gap-6">
            <Spinner class="size-4" />
            <Spinner class="size-6" />
            <Spinner class="size-8" />
        </div>
        """;

    private const string ColorsRazor =
        """
        <div class="flex flex-wrap items-center gap-6">
            <Spinner class="size-6" Color="text-primary" />
            <Spinner class="size-6" Color="text-destructive" />
            <Spinner class="size-6" Color="text-green-500" />
            <Spinner class="size-6" Color="text-amber-500" />
        </div>
        """;

    private const string LabelRazor =
        """
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <Spinner class="size-4" />
            Loading...
        </div>
        """;

    private const string ButtonRazor =
        """
        <Button Variant="outline" disabled>
            <Spinner class="size-4" />
            Processing
        </Button>
        """;
}
