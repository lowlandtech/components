@attribute [DisplayName("Feedback/Spinner")]
@inherits StoryComponent

<StoryCard Title="Spinner"
           Description="Spinner states demonstrate sizing, colors, inline labels, and disabled button loading affordances."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "sizes",
            "Sizes",
            @<SpinnerSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "SpinnerSizesExample.razor",
                    "Showcode/Examples/Feedback/Spinner/SpinnerSizesExample.razor")
            ]),
        new(
            "colors",
            "Colors",
            @<SpinnerColorsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "colors-razor",
                    "SpinnerColorsExample.razor",
                    "Showcode/Examples/Feedback/Spinner/SpinnerColorsExample.razor")
            ]),
        new(
            "with-label",
            "With label",
            @<SpinnerWithLabelExample />,
            [
                StorySourceRegistry.CodeTab(
                    "label-razor",
                    "SpinnerWithLabelExample.razor",
                    "Showcode/Examples/Feedback/Spinner/SpinnerWithLabelExample.razor")
            ]),
        new(
            "inside-button",
            "Inside button",
            @<SpinnerInsideButtonExample />,
            [
                StorySourceRegistry.CodeTab(
                    "button-razor",
                    "SpinnerInsideButtonExample.razor",
                    "Showcode/Examples/Feedback/Spinner/SpinnerInsideButtonExample.razor")
            ])
    ];
}
