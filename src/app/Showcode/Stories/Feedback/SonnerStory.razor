@attribute [DisplayName("Feedback/Sonner")]
@inherits StoryComponent
@inject ISonnerService SonnerService

<StoryCard Title="Sonner"
           Description="Sonner displays toast notifications with types, descriptions, positioning, and auto-dismiss."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "types",
            "Types",
            @<div class="flex flex-col items-center gap-3">
                <div class="flex flex-wrap justify-center gap-2">
                    <Button @onclick='() => SonnerService.Show("Default toast")' Variant="outline">Default</Button>
                    <Button @onclick='() => SonnerService.Show("Success toast", ToastType.Success)' class="bg-green-600 text-white hover:bg-green-700">Success</Button>
                    <Button @onclick='() => SonnerService.Show("Info toast", ToastType.Info)' class="bg-blue-600 text-white hover:bg-blue-700">Info</Button>
                    <Button @onclick='() => SonnerService.Show("Warning toast", ToastType.Warning)' class="bg-amber-500 text-white hover:bg-amber-600">Warning</Button>
                    <Button @onclick='() => SonnerService.Show("Error toast", ToastType.Error)' Variant="destructive">Error</Button>
                </div>
                <p class="text-xs text-muted-foreground">Click buttons to trigger toasts</p>
                <Sonner Position="bottom-center" />
            </div>,
            [
                new StoryCard.CodeTab("types-razor", "SonnerStory.razor", TypesRazor)
            ]),
        new(
            "descriptions",
            "With description",
            @<div class="flex flex-col items-center gap-3">
                <div class="flex flex-wrap justify-center gap-2">
                    <Button @onclick='() => SonnerService.Show("Event created", ToastType.Success, 4000, "Your event has been scheduled for March 15th.")' class="bg-green-600 text-white hover:bg-green-700">Success + desc</Button>
                    <Button @onclick='() => SonnerService.Show("Connection failed", ToastType.Error, 4000, "Unable to reach the server. Please try again later.")' Variant="destructive">Error + desc</Button>
                    <Button @onclick='() => SonnerService.Show("Update available", ToastType.Info, 4000, "A new version of Foundry is ready to install.")' class="bg-blue-600 text-white hover:bg-blue-700">Info + desc</Button>
                </div>
                <p class="text-xs text-muted-foreground">Click buttons to trigger toasts with descriptions</p>
                <Sonner Position="bottom-center" />
            </div>,
            [
                new StoryCard.CodeTab("descriptions-razor", "SonnerStory.razor", DescriptionsRazor)
            ]),
        new(
            "non-dismissible",
            "Non-dismissible",
            @<div class="flex flex-col items-center gap-3">
                <div class="flex flex-wrap justify-center gap-2">
                    <Button @onclick="ShowNonDismissible" Variant="outline">Show persistent toast</Button>
                    <Button @onclick="SonnerService.DismissAll" Variant="ghost">Dismiss all</Button>
                </div>
                <p class="text-xs text-muted-foreground">Persistent toast stays until manually dismissed</p>
                <Sonner Position="bottom-center" />
            </div>,
            [
                new StoryCard.CodeTab("non-dismissible-razor", "SonnerStory.razor", NonDismissibleRazor)
            ]),
        new(
            "top-position",
            "Top position",
            @<div class="flex flex-col items-center gap-3">
                <div class="flex flex-wrap justify-center gap-2">
                    <Button @onclick='() => SonnerService.Show("Top toast", ToastType.Info)' class="bg-blue-600 text-white hover:bg-blue-700">Trigger top toast</Button>
                </div>
                <p class="text-xs text-muted-foreground">Toasts appear at top-center</p>
                <Sonner Position="top-center" />
            </div>,
            [
                new StoryCard.CodeTab("top-position-razor", "SonnerStory.razor", TopPositionRazor)
            ])
    ];

    private void ShowNonDismissible()
    {
        SonnerService.Show("Loading data...", ToastType.Loading, 0, "This toast stays until you dismiss all.");
    }

    private const string TypesRazor =
        """
        <Sonner Position="bottom-center" />

        @code {
            [Inject] private ISonnerService SonnerService { get; set; } = default!;

            private void ShowSuccess() => SonnerService.Show("Success!", ToastType.Success);
        }
        """;

    private const string DescriptionsRazor =
        """
        SonnerService.Show("Event created", ToastType.Success, 4000, "Scheduled for March 15th.");
        """;

    private const string NonDismissibleRazor =
        """
        SonnerService.Show("Loading...", ToastType.Loading, 0);
        """;

    private const string TopPositionRazor =
        """
        <Sonner Position="top-center" />
        """;
}
