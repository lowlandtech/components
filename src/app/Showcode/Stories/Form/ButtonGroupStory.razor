@attribute [DisplayName("Form/Button Group")]
@inherits StoryComponent

<div class="space-y-8">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Default</h2>
        <ButtonGroup>
            <Button Variant="outline">Left</Button>
            <Button Variant="outline">Middle</Button>
            <Button Variant="outline">Right</Button>
        </ButtonGroup>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Primary</h2>
        <ButtonGroup>
            <Button Variant="default">Bold</Button>
            <Button Variant="default">Italic</Button>
            <Button Variant="default">Underline</Button>
        </ButtonGroup>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">With Icons</h2>
        <ButtonGroup>
            <Button Variant="outline" Size="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            </Button>
            <Button Variant="outline" Size="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </Button>
        </ButtonGroup>
    </section>
</div>
