@attribute [DisplayName("Form/Button Group")]
@inherits StoryComponent

<StoryCard Title="Button Group"
           Description="ButtonGroup states demonstrate segmented actions, primary action sets, icon-only controls, and mixed input chrome."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "segmented",
            "Segmented",
            @<ButtonGroupSegmentedExample />,
            [
                StorySourceRegistry.CodeTab(
                    "segmented-razor",
                    "ButtonGroupSegmentedExample.razor",
                    "Showcode/Examples/Form/ButtonGroup/ButtonGroupSegmentedExample.razor")
            ]),
        new(
            "primary",
            "Primary",
            @<ButtonGroupPrimaryExample />,
            [
                StorySourceRegistry.CodeTab(
                    "primary-razor",
                    "ButtonGroupPrimaryExample.razor",
                    "Showcode/Examples/Form/ButtonGroup/ButtonGroupPrimaryExample.razor")
            ]),
        new(
            "icons",
            "Icons",
            @<ButtonGroupIconsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "icons-razor",
                    "ButtonGroupIconsExample.razor",
                    "Showcode/Examples/Form/ButtonGroup/ButtonGroupIconsExample.razor")
            ]),
        new(
            "with-input",
            "With input",
            @<ButtonGroupWithInputExample />,
            [
                StorySourceRegistry.CodeTab(
                    "input-razor",
                    "ButtonGroupWithInputExample.razor",
                    "Showcode/Examples/Form/ButtonGroup/ButtonGroupWithInputExample.razor")
            ]),
        new(
            "input-left",
            "Input left",
            @<ButtonGroupInputLeftExample />,
            [
                StorySourceRegistry.CodeTab(
                    "input-left-razor",
                    "ButtonGroupInputLeftExample.razor",
                    "Showcode/Examples/Form/ButtonGroup/ButtonGroupInputLeftExample.razor")
            ]),
        new(
            "input-right",
            "Input right",
            @<ButtonGroupInputRightExample />,
            [
                StorySourceRegistry.CodeTab(
                    "input-right-razor",
                    "ButtonGroupInputRightExample.razor",
                    "Showcode/Examples/Form/ButtonGroup/ButtonGroupInputRightExample.razor")
            ])
    ];
}
