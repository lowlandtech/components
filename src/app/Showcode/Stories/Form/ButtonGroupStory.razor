@attribute [DisplayName("Form/Button Group")]
@inherits StoryComponent

<StoryCard Title="Button Group"
           Description="ButtonGroup states demonstrate segmented actions, primary action sets, icon-only controls, and mixed input chrome."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "segmented",
            "Segmented",
            @<ButtonGroup>
                <Button Variant="outline">Left</Button>
                <Button Variant="outline">Middle</Button>
                <Button Variant="outline">Right</Button>
            </ButtonGroup>,
            [
                new StoryCard.CodeTab("segmented-razor", "ButtonGroupStory.razor", SegmentedRazor)
            ]),
        new(
            "primary",
            "Primary",
            @<ButtonGroup>
                <Button Variant="default">Bold</Button>
                <Button Variant="default">Italic</Button>
                <Button Variant="default">Underline</Button>
            </ButtonGroup>,
            [
                new StoryCard.CodeTab("primary-razor", "ButtonGroupStory.razor", PrimaryRazor)
            ]),
        new(
            "icons",
            "Icons",
            @<ButtonGroup>
                <Button Variant="outline" Size="icon">
                    <Icon Name="arrow-left" Size="14" />
                </Button>
                <Button Variant="outline" Size="icon">
                    <Icon Name="arrow-right" Size="14" />
                </Button>
            </ButtonGroup>,
            [
                new StoryCard.CodeTab("icons-razor", "ButtonGroupStory.razor", IconsRazor)
            ]),
        new(
            "with-input",
            "With input",
            @<InputGroup class="w-full max-w-sm">
                <InputGroupAddon>
                    <Icon Name="search" Size="14" />
                </InputGroupAddon>
                <Input Placeholder="Search components..." />
                <InputGroupAddon Align="inline-end">
                    <Button Variant="outline">Search</Button>
                </InputGroupAddon>
            </InputGroup>,
            [
                new StoryCard.CodeTab("input-razor", "ButtonGroupStory.razor", InputRazor)
            ]),
        new(
            "input-left",
            "Input left",
            @<InputGroup class="w-full max-w-sm">
                <Input Placeholder="Search components..." />
                <InputGroupAddon Align="inline-end">
                    <Button Variant="outline">Search</Button>
                </InputGroupAddon>
            </InputGroup>,
            [
                new StoryCard.CodeTab("input-left-razor", "ButtonGroupStory.razor", InputLeftRazor)
            ]),
        new(
            "input-right",
            "Input right",
            @<InputGroup class="w-full max-w-sm">
                <InputGroupAddon>
                    <Icon Name="search" Size="14" />
                </InputGroupAddon>
                <Input Placeholder="Search components..." />
            </InputGroup>,
            [
                new StoryCard.CodeTab("input-right-razor", "ButtonGroupStory.razor", InputRightRazor)
            ])
    ];

    private const string SegmentedRazor =
        """
        <ButtonGroup>
            <Button Variant="outline">Left</Button>
            <Button Variant="outline">Middle</Button>
            <Button Variant="outline">Right</Button>
        </ButtonGroup>
        """;

    private const string PrimaryRazor =
        """
        <ButtonGroup>
            <Button Variant="default">Bold</Button>
            <Button Variant="default">Italic</Button>
            <Button Variant="default">Underline</Button>
        </ButtonGroup>
        """;

    private const string IconsRazor =
        """
        <ButtonGroup>
            <Button Variant="outline" Size="icon">
                <Icon Name="arrow-left" Size="14" />
            </Button>
            <Button Variant="outline" Size="icon">
                <Icon Name="arrow-right" Size="14" />
            </Button>
        </ButtonGroup>
        """;

    private const string InputRazor =
        """
        <InputGroup class="w-full max-w-sm">
            <InputGroupAddon>
                <Icon Name="search" Size="14" />
            </InputGroupAddon>
            <Input Placeholder="Search components..." />
            <InputGroupAddon Align="inline-end">
                <Button Variant="outline">Search</Button>
            </InputGroupAddon>
        </InputGroup>
        """;

    private const string InputLeftRazor =
        """
        <InputGroup class="w-full max-w-sm">
            <Input Placeholder="Search components..." />
            <InputGroupAddon Align="inline-end">
                <Button Variant="outline">Search</Button>
            </InputGroupAddon>
        </InputGroup>
        """;

    private const string InputRightRazor =
        """
        <InputGroup class="w-full max-w-sm">
            <InputGroupAddon>
                <Icon Name="search" Size="14" />
            </InputGroupAddon>
            <Input Placeholder="Search components..." />
        </InputGroup>
        """;
}
