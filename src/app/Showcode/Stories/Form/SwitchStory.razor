@attribute [DisplayName("Form/Switch")]
@inherits StoryComponent

<StoryCard Title="Switch"
           Description="Switch states demonstrate checked, unchecked, disabled, invalid, and choice-card patterns."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "states",
            "States",
            @<div class="space-y-3">
                <div class="flex items-center gap-3">
                    <Switch id="sw1" IsChecked="false" />
                    <Label For="sw1">Off</Label>
                </div>
                <div class="flex items-center gap-3">
                    <Switch id="sw2" IsChecked="true" />
                    <Label For="sw2">On</Label>
                </div>
                <div class="flex items-center gap-3">
                    <Switch id="sw3" Disabled="true" />
                    <Label For="sw3" Disabled="true">Disabled</Label>
                </div>
            </div>,
            [
                new StoryCard.CodeTab("states-razor", "SwitchStory.razor", StatesRazor)
            ]),
        new(
            "choice-card",
            "Choice card",
            @<div class="w-full max-w-md">
                <Switch ChoiceCard="true"
                        Title="Email notifications"
                        Description="Receive emails about your account activity."
                        IsChecked="true" />
            </div>,
            [
                new StoryCard.CodeTab("choice-card-razor", "SwitchStory.razor", ChoiceCardRazor)
            ]),
        new(
            "invalid",
            "Invalid",
            @<div class="flex items-center gap-3">
                <Switch id="sw-invalid" Invalid="true" />
                <Label For="sw-invalid">Requires review</Label>
            </div>,
            [
                new StoryCard.CodeTab("invalid-razor", "SwitchStory.razor", InvalidRazor)
            ])
    ];

    private const string StatesRazor =
        """
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <Switch id="sw1" IsChecked="false" />
                <Label For="sw1">Off</Label>
            </div>
            <div class="flex items-center gap-3">
                <Switch id="sw2" IsChecked="true" />
                <Label For="sw2">On</Label>
            </div>
            <div class="flex items-center gap-3">
                <Switch id="sw3" Disabled="true" />
                <Label For="sw3" Disabled="true">Disabled</Label>
            </div>
        </div>
        """;

    private const string ChoiceCardRazor =
        """
        <Switch ChoiceCard="true"
                Title="Email notifications"
                Description="Receive emails about your account activity."
                IsChecked="true" />
        """;

    private const string InvalidRazor =
        """
        <div class="flex items-center gap-3">
            <Switch id="sw-invalid" Invalid="true" />
            <Label For="sw-invalid">Requires review</Label>
        </div>
        """;
}
