@attribute [DisplayName("Form/Switch")]
@inherits StoryComponent

<StoryCard Title="Switch"
           Description="Switch states demonstrate checked, unchecked, disabled, invalid, and choice-card patterns."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "states",
            "States",
            @<SwitchStatesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "states-razor",
                    "SwitchStatesExample.razor",
                    "Showcode/Examples/Form/Switch/SwitchStatesExample.razor")
            ]),
        new(
            "choice-card",
            "Choice card",
            @<SwitchChoiceCardExample />,
            [
                StorySourceRegistry.CodeTab(
                    "choice-card-razor",
                    "SwitchChoiceCardExample.razor",
                    "Showcode/Examples/Form/Switch/SwitchChoiceCardExample.razor")
            ]),
        new(
            "invalid",
            "Invalid",
            @<SwitchInvalidExample />,
            [
                StorySourceRegistry.CodeTab(
                    "invalid-razor",
                    "SwitchInvalidExample.razor",
                    "Showcode/Examples/Form/Switch/SwitchInvalidExample.razor")
            ])
    ];
}
