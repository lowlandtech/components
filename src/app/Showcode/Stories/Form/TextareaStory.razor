@attribute [DisplayName("Form/Textarea")]
@inherits StoryComponent

<StoryCard Title="Textarea"
           Description="Textarea states demonstrate default, labeled, disabled, read-only, and invalid multiline fields."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<div class="w-full max-w-sm">
                <Textarea Placeholder="Type your message here." />
            </div>,
            [
                new StoryCard.CodeTab("default-razor", "TextareaStory.razor", DefaultRazor)
            ]),
        new(
            "with-label",
            "With label",
            @<div class="w-full max-w-sm space-y-1">
                <Label For="msg">Your message</Label>
                <Textarea id="msg" Placeholder="Leave a comment..." />
            </div>,
            [
                new StoryCard.CodeTab("label-razor", "TextareaStory.razor", LabelRazor)
            ]),
        new(
            "states",
            "States",
            @<div class="w-full max-w-sm space-y-2">
                <Textarea Placeholder="Disabled textarea" Disabled="true" />
                <Textarea ReadOnly="true" Value="Read-only note" />
                <Textarea Invalid="true" Value="This needs a little more detail." />
            </div>,
            [
                new StoryCard.CodeTab("states-razor", "TextareaStory.razor", StatesRazor)
            ])
    ];

    private const string DefaultRazor =
        """
        <Textarea Placeholder="Type your message here." />
        """;

    private const string LabelRazor =
        """
        <div class="space-y-1">
            <Label For="msg">Your message</Label>
            <Textarea id="msg" Placeholder="Leave a comment..." />
        </div>
        """;

    private const string StatesRazor =
        """
        <div class="space-y-2">
            <Textarea Placeholder="Disabled textarea" Disabled="true" />
            <Textarea ReadOnly="true" Value="Read-only note" />
            <Textarea Invalid="true" Value="This needs a little more detail." />
        </div>
        """;
}
