@attribute [DisplayName("Form/Button")]
@inherits StoryComponent

<StoryCard Title="Button"
           Description="Button states demonstrate visual variants, sizes, icon composition, and disabled behavior with paired source."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "variants",
            "Variants",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Button Variant="default">Default</Button>
                <Button Variant="destructive">Destructive</Button>
                <Button Variant="outline">Outline</Button>
                <Button Variant="secondary">Secondary</Button>
                <Button Variant="ghost">Ghost</Button>
                <Button Variant="link">Link</Button>
            </div>,
            [
                new StoryCard.CodeTab("variants-razor", "ButtonStory.razor", VariantsRazor)
            ]),
        new(
            "sizes",
            "Sizes",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Button Size="sm">Small</Button>
                <Button Size="default">Default</Button>
                <Button Size="lg">Large</Button>
                <Button Size="icon" Variant="outline">
                    <Icon Name="arrow-right" Size="16" />
                </Button>
            </div>,
            [
                new StoryCard.CodeTab("sizes-razor", "ButtonStory.razor", SizesRazor)
            ]),
        new(
            "with-icon",
            "With icon",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Button Variant="default">
                    <Icon Name="upload" Size="16" />
                    Upload
                </Button>
                <Button Variant="outline">
                    Settings
                    <Icon Name="settings" Size="16" />
                </Button>
            </div>,
            [
                new StoryCard.CodeTab("icon-razor", "ButtonStory.razor", IconRazor)
            ]),
        new(
            "disabled",
            "Disabled",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Button Variant="default" disabled>Default</Button>
                <Button Variant="outline" disabled>Outline</Button>
            </div>,
            [
                new StoryCard.CodeTab("disabled-razor", "ButtonStory.razor", DisabledRazor)
            ])
    ];

    private const string VariantsRazor =
        """
        <div class="flex flex-wrap gap-3">
            <Button Variant="default">Default</Button>
            <Button Variant="destructive">Destructive</Button>
            <Button Variant="outline">Outline</Button>
            <Button Variant="secondary">Secondary</Button>
            <Button Variant="ghost">Ghost</Button>
            <Button Variant="link">Link</Button>
        </div>
        """;

    private const string SizesRazor =
        """
        <div class="flex flex-wrap items-center gap-3">
            <Button Size="sm">Small</Button>
            <Button Size="default">Default</Button>
            <Button Size="lg">Large</Button>
            <Button Size="icon" Variant="outline">
                <Icon Name="arrow-right" Size="16" />
            </Button>
        </div>
        """;

    private const string IconRazor =
        """
        <div class="flex flex-wrap gap-3">
            <Button Variant="default">
                <Icon Name="upload" Size="16" />
                Upload
            </Button>
            <Button Variant="outline">
                Settings
                <Icon Name="settings" Size="16" />
            </Button>
        </div>
        """;

    private const string DisabledRazor =
        """
        <div class="flex flex-wrap gap-3">
            <Button Variant="default" disabled>Default</Button>
            <Button Variant="outline" disabled>Outline</Button>
        </div>
        """;
}
