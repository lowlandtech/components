@attribute [DisplayName("Form/Button")]
@inherits StoryComponent

<StoryCard Title="Button"
           Description="Button states demonstrate visual variants, sizes, icon composition, and disabled behavior with paired source."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "variants",
            "Variants",
            @<ButtonVariantsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "variants-razor",
                    "ButtonVariantsExample.razor",
                    "Showcode/Examples/Form/Button/ButtonVariantsExample.razor")
            ]),
        new(
            "sizes",
            "Sizes",
            @<ButtonSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "ButtonSizesExample.razor",
                    "Showcode/Examples/Form/Button/ButtonSizesExample.razor")
            ]),
        new(
            "with-icon",
            "With icon",
            @<ButtonWithIconExample />,
            [
                StorySourceRegistry.CodeTab(
                    "icon-razor",
                    "ButtonWithIconExample.razor",
                    "Showcode/Examples/Form/Button/ButtonWithIconExample.razor")
            ]),
        new(
            "disabled",
            "Disabled",
            @<ButtonDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "ButtonDisabledExample.razor",
                    "Showcode/Examples/Form/Button/ButtonDisabledExample.razor")
            ])
    ];
}
