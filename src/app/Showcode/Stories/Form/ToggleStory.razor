@attribute [DisplayName("Form/Toggle")]
@inherits StoryComponent

<div class="space-y-8">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Default</h2>
        <Toggle>Toggle</Toggle>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Variants</h2>
        <div class="flex flex-wrap gap-3">
            <Toggle variant="default">Default</Toggle>
            <Toggle variant="outline">Outline</Toggle>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Sizes</h2>
        <div class="flex flex-wrap items-center gap-3">
            <Toggle size="sm">Small</Toggle>
            <Toggle size="default">Default</Toggle>
            <Toggle size="lg">Large</Toggle>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">With icon</h2>
        <div class="flex gap-2">
            <Toggle>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                Bold
            </Toggle>
            <Toggle>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
                Italic
            </Toggle>
        </div>
    </section>
</div>
