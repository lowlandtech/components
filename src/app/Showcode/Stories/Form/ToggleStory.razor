@attribute [DisplayName("Form/Toggle")]
@inherits StoryComponent

<StoryCard Title="Toggle"
           Description="Toggle states demonstrate variants, sizes, icon composition, and pressed state."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "variants",
            "Variants",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Toggle variant="default">Default</Toggle>
                <Toggle variant="outline">Outline</Toggle>
                <Toggle variant="outline" Pressed="true">Pressed</Toggle>
            </div>,
            [
                new StoryCard.CodeTab("variants-razor", "ToggleStory.razor", VariantsRazor)
            ]),
        new(
            "sizes",
            "Sizes",
            @<div class="flex flex-wrap items-center justify-center gap-3">
                <Toggle size="sm">Small</Toggle>
                <Toggle size="default">Default</Toggle>
                <Toggle size="lg">Large</Toggle>
            </div>,
            [
                new StoryCard.CodeTab("sizes-razor", "ToggleStory.razor", SizesRazor)
            ]),
        new(
            "with-icon",
            "With icon",
            @<div class="flex items-center justify-center gap-2">
                <Toggle>
                    <Icon Name="bold" Size="14" />
                    Bold
                </Toggle>
                <Toggle>
                    <Icon Name="italic" Size="14" />
                    Italic
                </Toggle>
            </div>,
            [
                new StoryCard.CodeTab("icon-razor", "ToggleStory.razor", IconRazor)
            ])
    ];

    private const string VariantsRazor =
        """
        <div class="flex flex-wrap gap-3">
            <Toggle variant="default">Default</Toggle>
            <Toggle variant="outline">Outline</Toggle>
            <Toggle variant="outline" Pressed="true">Pressed</Toggle>
        </div>
        """;

    private const string SizesRazor =
        """
        <div class="flex flex-wrap items-center gap-3">
            <Toggle size="sm">Small</Toggle>
            <Toggle size="default">Default</Toggle>
            <Toggle size="lg">Large</Toggle>
        </div>
        """;

    private const string IconRazor =
        """
        <div class="flex gap-2">
            <Toggle>
                <Icon Name="bold" Size="14" />
                Bold
            </Toggle>
            <Toggle>
                <Icon Name="italic" Size="14" />
                Italic
            </Toggle>
        </div>
        """;
}
