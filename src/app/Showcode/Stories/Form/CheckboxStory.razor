@attribute [DisplayName("Form/Checkbox")]
@inherits StoryComponent

<div class="space-y-8">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">States</h2>
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <Checkbox id="cb1" aria-checked="false" />
                <Label For="cb1">Unchecked</Label>
            </div>
            <div class="flex items-center gap-2">
                <Checkbox id="cb2" aria-checked="true" />
                <Label For="cb2">Checked</Label>
            </div>
            <div class="flex items-center gap-2">
                <Checkbox id="cb3" disabled aria-checked="false" />
                <Label For="cb3" class="opacity-50">Disabled</Label>
            </div>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Terms & Conditions</h2>
        <div class="flex items-start gap-2">
            <Checkbox id="terms" aria-checked="false" />
            <div class="flex flex-col gap-1">
                <Label For="terms">Accept terms and conditions</Label>
                <p class="text-sm text-muted-foreground">You agree to our Terms of Service and Privacy Policy.</p>
            </div>
        </div>
    </section>
</div>
