@attribute [DisplayName("Form/Checkbox")]
@inherits StoryComponent

<StoryCard Title="Checkbox"
           Description="Checkbox states demonstrate checked, unchecked, disabled, and label-description compositions."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "states",
            "States",
            @<CheckboxStatesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "states-razor",
                    "CheckboxStatesExample.razor",
                    "Showcode/Examples/Form/Checkbox/CheckboxStatesExample.razor")
            ]),
        new(
            "terms",
            "Terms",
            @<CheckboxTermsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "terms-razor",
                    "CheckboxTermsExample.razor",
                    "Showcode/Examples/Form/Checkbox/CheckboxTermsExample.razor")
            ]),
        new(
            "checked",
            "Checked",
            @<CheckboxCheckedExample />,
            [
                StorySourceRegistry.CodeTab(
                    "checked-razor",
                    "CheckboxCheckedExample.razor",
                    "Showcode/Examples/Form/Checkbox/CheckboxCheckedExample.razor")
            ])
    ];
}
