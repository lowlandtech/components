@attribute [DisplayName("Form/ColorPicker")]
@inherits StoryComponent

<StoryCard Title="ColorPicker"
           Description="Native colour swatch combined with a free-text input for any CSS colour expression."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<ColorPickerDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "ColorPickerDefaultExample.razor",
                    "Showcode/Examples/Form/ColorPicker/ColorPickerDefaultExample.razor")
            ]),
        new(
            "sizes",
            "Sizes",
            @<ColorPickerSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "ColorPickerSizesExample.razor",
                    "Showcode/Examples/Form/ColorPicker/ColorPickerSizesExample.razor")
            ]),
        new(
            "disabled",
            "Disabled",
            @<ColorPickerDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "ColorPickerDisabledExample.razor",
                    "Showcode/Examples/Form/ColorPicker/ColorPickerDisabledExample.razor")
            ])
    ];
}
