@attribute [DisplayName("Form/Slider")]
@inherits StoryComponent

<div class="space-y-8 max-w-sm">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Default</h2>
        <Slider Value="40" Min="0" Max="100" />
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">With Steps</h2>
        <Slider Value="50" Min="0" Max="100" Step="10" />
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Disabled</h2>
        <Slider Value="30" Disabled="true" />
    </section>
</div>
