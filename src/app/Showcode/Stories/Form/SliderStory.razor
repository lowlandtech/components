@attribute [DisplayName("Form/Slider")]
@inherits StoryComponent

<StoryCard Title="Slider"
           Description="Slider states demonstrate default, stepped, disabled, and vertical range control compositions."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<SliderDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "SliderDefaultExample.razor",
                    "Showcode/Examples/Form/Slider/SliderDefaultExample.razor")
            ]),
        new(
            "steps",
            "Steps",
            @<SliderStepsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "steps-razor",
                    "SliderStepsExample.razor",
                    "Showcode/Examples/Form/Slider/SliderStepsExample.razor")
            ]),
        new(
            "disabled",
            "Disabled",
            @<SliderDisabledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "disabled-razor",
                    "SliderDisabledExample.razor",
                    "Showcode/Examples/Form/Slider/SliderDisabledExample.razor")
            ]),
        new(
            "vertical",
            "Vertical",
            @<SliderVerticalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "vertical-razor",
                    "SliderVerticalExample.razor",
                    "Showcode/Examples/Form/Slider/SliderVerticalExample.razor")
            ])
    ];
}
