@attribute [DisplayName("Form/Input")]
@inherits StoryComponent

<StoryCard Title="Input"
           Description="Input states demonstrate common HTML types, sizes, and disabled/read-only/invalid affordances."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<InputDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "InputDefaultExample.razor",
                    "Showcode/Examples/Form/Input/InputDefaultExample.razor")
            ]),
        new(
            "types",
            "Types",
            @<InputTypesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "types-razor",
                    "InputTypesExample.razor",
                    "Showcode/Examples/Form/Input/InputTypesExample.razor")
            ]),
        new(
            "sizes",
            "Sizes",
            @<InputSizesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "sizes-razor",
                    "InputSizesExample.razor",
                    "Showcode/Examples/Form/Input/InputSizesExample.razor")
            ]),
        new(
            "states",
            "States",
            @<InputStatesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "states-razor",
                    "InputStatesExample.razor",
                    "Showcode/Examples/Form/Input/InputStatesExample.razor")
            ]),
        new(
            "floating-label",
            "Floating Label",
            @<InputFloatingLabelExample />,
            [
                StorySourceRegistry.CodeTab(
                    "floating-razor",
                    "InputFloatingLabelExample.razor",
                    "Showcode/Examples/Form/Input/InputFloatingLabelExample.razor")
            ])
    ];
}
