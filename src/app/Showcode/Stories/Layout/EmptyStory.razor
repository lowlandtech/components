@attribute [DisplayName("Layout/Empty")]
@inherits StoryComponent

<div class="space-y-8">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Default</h2>
        <div class="h-48 border border-dashed rounded-lg">
            <Empty>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-10 text-muted-foreground mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
                <p class="text-sm font-medium">No results found</p>
                <p class="text-xs text-muted-foreground mt-1">Try adjusting your search or filters.</p>
            </Empty>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">With action</h2>
        <div class="h-56 border border-dashed rounded-lg">
            <Empty>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-10 text-muted-foreground mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                <p class="text-sm font-medium">No documents yet</p>
                <p class="text-xs text-muted-foreground mt-1 mb-3">Create your first document to get started.</p>
                <Button Size="sm">Create document</Button>
            </Empty>
        </div>
    </section>
</div>
