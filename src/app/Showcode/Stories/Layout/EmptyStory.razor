@attribute [DisplayName("Layout/Empty")]
@inherits StoryComponent

<StoryCard Title="Empty"
           Description="Empty states demonstrate quiet no-result messaging and actionable first-run guidance."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<EmptyDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "EmptyDefaultExample.razor",
                    "Showcode/Examples/Layout/Empty/EmptyDefaultExample.razor")
            ]),
        new(
            "with-action",
            "With action",
            @<EmptyWithActionExample />,
            [
                StorySourceRegistry.CodeTab(
                    "action-razor",
                    "EmptyWithActionExample.razor",
                    "Showcode/Examples/Layout/Empty/EmptyWithActionExample.razor")
            ])
    ];
}
