@attribute [DisplayName("Layout/Aspect Ratio")]
@inherits StoryComponent

<StoryCard Title="Aspect Ratio"
           Description="AspectRatio states demonstrate 16:9, 4:3, and 1:1 responsive ratio containers."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "16-9",
            "16:9",
            @<AspectRatio169Example />,
            [
                StorySourceRegistry.CodeTab(
                    "16-9-razor",
                    "AspectRatio169Example.razor",
                    "Showcode/Examples/Layout/AspectRatio/AspectRatio169Example.razor")
            ]),
        new(
            "4-3",
            "4:3",
            @<AspectRatio43Example />,
            [
                StorySourceRegistry.CodeTab(
                    "4-3-razor",
                    "AspectRatio43Example.razor",
                    "Showcode/Examples/Layout/AspectRatio/AspectRatio43Example.razor")
            ]),
        new(
            "1-1",
            "1:1",
            @<AspectRatio11Example />,
            [
                StorySourceRegistry.CodeTab(
                    "1-1-razor",
                    "AspectRatio11Example.razor",
                    "Showcode/Examples/Layout/AspectRatio/AspectRatio11Example.razor")
            ])
    ];
}
