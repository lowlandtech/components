@attribute [DisplayName("Layout/Separator")]
@inherits StoryComponent

<StoryCard Title="Separator"
           Description="Separator states demonstrate horizontal, vertical, and labeled separators."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "horizontal",
            "Horizontal",
            @<div class="w-full max-w-sm">
                <p class="text-sm text-muted-foreground">Above the separator</p>
                <Separator class="my-3" />
                <p class="text-sm text-muted-foreground">Below the separator</p>
            </div>,
            [
                new StoryCard.CodeTab("horizontal-razor", "SeparatorStory.razor", HorizontalRazor)
            ]),
        new(
            "vertical",
            "Vertical",
            @<div class="flex h-5 items-center gap-3 text-sm">
                <span>Blog</span>
                <Separator Orientation="vertical" />
                <span>Docs</span>
                <Separator Orientation="vertical" />
                <span>Source</span>
            </div>,
            [
                new StoryCard.CodeTab("vertical-razor", "SeparatorStory.razor", VerticalRazor)
            ]),
        new(
            "with-label",
            "With label",
            @<div class="w-full max-w-sm">
                <Separator>OR</Separator>
            </div>,
            [
                new StoryCard.CodeTab("label-razor", "SeparatorStory.razor", LabelRazor)
            ])
    ];

    private const string HorizontalRazor =
        """
        <div>
            <p class="text-sm text-muted-foreground">Above the separator</p>
            <Separator class="my-3" />
            <p class="text-sm text-muted-foreground">Below the separator</p>
        </div>
        """;

    private const string VerticalRazor =
        """
        <div class="flex h-5 items-center gap-3 text-sm">
            <span>Blog</span>
            <Separator Orientation="vertical" />
            <span>Docs</span>
            <Separator Orientation="vertical" />
            <span>Source</span>
        </div>
        """;

    private const string LabelRazor =
        """
        <Separator>OR</Separator>
        """;
}
