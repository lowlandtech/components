@attribute [DisplayName("Layout/Separator")]
@inherits StoryComponent

<div class="space-y-8 max-w-sm">
    <section class="space-y-3">
        <h2 class="text-base font-semibold">Horizontal (default)</h2>
        <div>
            <p class="text-sm text-muted-foreground">Above the separator</p>
            <Separator class="my-3" />
            <p class="text-sm text-muted-foreground">Below the separator</p>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">Vertical</h2>
        <div class="flex h-5 items-center gap-3 text-sm">
            <span>Blog</span>
            <Separator Orientation="vertical" />
            <span>Docs</span>
            <Separator Orientation="vertical" />
            <span>Source</span>
        </div>
    </section>

    <section class="space-y-3">
        <h2 class="text-base font-semibold">With label</h2>
        <Separator>OR</Separator>
    </section>
</div>
