@attribute [DisplayName("Layout/Separator")]
@inherits StoryComponent

<StoryCard Title="Separator"
           Description="Separator states demonstrate horizontal, vertical, and labeled separators."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "horizontal",
            "Horizontal",
            @<SeparatorHorizontalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "horizontal-razor",
                    "SeparatorHorizontalExample.razor",
                    "Showcode/Examples/Layout/Separator/SeparatorHorizontalExample.razor")
            ]),
        new(
            "vertical",
            "Vertical",
            @<SeparatorVerticalExample />,
            [
                StorySourceRegistry.CodeTab(
                    "vertical-razor",
                    "SeparatorVerticalExample.razor",
                    "Showcode/Examples/Layout/Separator/SeparatorVerticalExample.razor")
            ]),
        new(
            "with-label",
            "With label",
            @<SeparatorWithLabelExample />,
            [
                StorySourceRegistry.CodeTab(
                    "label-razor",
                    "SeparatorWithLabelExample.razor",
                    "Showcode/Examples/Layout/Separator/SeparatorWithLabelExample.razor")
            ])
    ];
}
