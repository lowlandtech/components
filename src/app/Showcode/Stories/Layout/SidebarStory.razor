                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarHeader>
                        <SidebarContent>
                            <SidebarGroup>
                                <SidebarGroupLabel>Platform</SidebarGroupLabel>
                                <SidebarGroupContent>
                                    <SidebarMenu>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton IsActive="true">
                                                <Icon Name="home" Size="16" />
                                                <span class="sidebar-menu-text">Playground</span>
                                                <Icon Name="chevron-down" Size="14" class="sidebar-docs-chevron" />
                                            </SidebarMenuButton>
                                            <SidebarMenuSub IsOpen="true">
                                                <SidebarMenuSubContent IsVisible="true">
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>History</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Starred</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Settings</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                </SidebarMenuSubContent>
                                            </SidebarMenuSub>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton>
                                                <Icon Name="settings" Size="16" />
                                                <span class="sidebar-menu-text">Models</span>
                                                <Icon Name="chevron-right" Size="14" class="sidebar-docs-chevron" />
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton>
                                                <Icon Name="search" Size="16" />
                                                <span class="sidebar-menu-text">Documentation</span>
                                                <Icon Name="chevron-right" Size="14" class="sidebar-docs-chevron" />
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton>
                                                <Icon Name="settings" Size="16" />
                                                <span class="sidebar-menu-text">Settings</span>
