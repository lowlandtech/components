                                            <span class="sidebar-docs-subtitle">m@example.com</span>
                                        </span>
                                        <Icon Name="chevron-down" Size="14" class="sidebar-docs-chevron" />
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarFooter>
                    </Sidebar>
                    <SidebarInset>
