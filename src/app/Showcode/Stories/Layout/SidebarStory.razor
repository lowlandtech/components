                                <SidebarMenuItem>
                                    <SidebarMenuButton class="sidebar-docs-team">
                                        <span class="sidebar-docs-logo">
                                            <Icon Name="calendar" Size="16" />
                                        </span>
                                        <span class="sidebar-docs-team-copy">
                                            <span class="sidebar-docs-title">Acme Inc</span>
                                            <span class="sidebar-docs-subtitle">Enterprise</span>
                                        </span>
