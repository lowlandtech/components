@attribute [DisplayName("Layout/Sidebar")]
@inherits StoryComponent

<StoryCard Title="Sidebar"
           Description="A collapsible navigation sidebar with groups, sub-menus, badges, and controlled open state."
           DefaultState="docs-preview"
           States="@States" />



@code {
    bool _openDocs = true;
    bool _open4 = true;
    bool _subExpanded;

    private IReadOnlyList<StoryCard.State> States => [
        new(
            "docs-preview",
            "Docs preview",
            @<div class="h-96 w-full border border-border rounded-lg overflow-hidden flex">
                <SidebarProvider @bind-Open="_openDocs" Width="16rem">
                    <Sidebar Collapsible="icon">
                        <SidebarHeader>
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton class="h-12">
                                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-blue-600 text-white">
                                            <Icon Name="calendar" Size="14" />
                                        </span>
                                        <span class="sidebar-docs-team-copy grid min-w-0 flex-1 text-left leading-tight">
                                            <span class="truncate text-sm font-semibold">Acme Inc</span>
                                            <span class="truncate text-xs text-muted-foreground">Enterprise</span>
                                        </span>
                                        <Icon Name="chevron-down" Size="14" class="sidebar-docs-chevron ml-auto" />
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarHeader>
                        <SidebarContent>
                            <SidebarGroup>
                                <SidebarGroupLabel>Platform</SidebarGroupLabel>
                                <SidebarGroupContent>
                                    <SidebarMenu>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton IsActive="true">
                                                <Icon Name="home" Size="16" />
                                                <span class="sidebar-menu-text">Playground</span>
                                                <Icon Name="chevron-down" Size="14" class="sidebar-docs-chevron ml-auto" />
                                            </SidebarMenuButton>
                                            <SidebarMenuSub IsOpen="true">
                                                <SidebarMenuSubContent IsVisible="true">
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>History</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Starred</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Settings</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                </SidebarMenuSubContent>
                                            </SidebarMenuSub>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton>
                                                <Icon Name="settings" Size="16" />
                                                <span class="sidebar-menu-text">Models</span>
                                                <Icon Name="chevron-right" Size="14" class="sidebar-docs-chevron ml-auto" />
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
