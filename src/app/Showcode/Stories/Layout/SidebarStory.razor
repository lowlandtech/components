                            <SidebarTrigger class="h-7 w-7"><Icon Name="@(_open4 ? "panel-left-close" : "panel-left-open")" Size="16" /></SidebarTrigger>
                            <span class="text-sm font-medium">Dashboard</span>
                        </header>
                        <div class="p-4 space-y-3">
                            <p class="text-sm text-muted-foreground">
                                State: <span class="font-semibold text-foreground">@(_open4 ? "Open" : "Closed")</span>
                            </p>
                            <div class="flex gap-2">
                                <Button Variant="outline" Size="sm" @onclick="@(() => _open4 = true)">Open</Button>
                                <Button Variant="outline" Size="sm" @onclick="@(() => _open4 = false)">Close</Button>
                            </div>
                        </div>
                    </SidebarInset>
                </SidebarProvider>
            </div>,
            [
                new StoryCard.CodeTab("controlled-razor", "SidebarStory.razor", ControlledRazor)
            ])
    ];

