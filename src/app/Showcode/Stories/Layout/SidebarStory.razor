@attribute [DisplayName("Layout/Sidebar")]
@inherits StoryComponent

<StoryCard Title="Sidebar"
           Description="A collapsible navigation sidebar with groups, sub-menus, badges, and controlled open state."
           DefaultState="docs-preview"
           States="@States" />

<style>
    .sidebar-docs-card {
        width: min(40rem, 100%);
        height: 25rem;
        overflow: hidden;
        border: 1px solid #27272a;
        border-radius: 0.75rem;
        background: #09090b;
        color: #fafafa;
    }

    .sidebar-docs-frame {
        position: relative;
        min-height: 100%;
        background: #09090b;
        --background: #09090b;
        --foreground: #fafafa;
        --sidebar: #18181b;
        --sidebar-foreground: #e4e4e7;
        --sidebar-primary: #155dfc;
        --sidebar-primary-foreground: #fafafa;
        --sidebar-accent: #27272a;
        --sidebar-accent-foreground: #fafafa;
        --sidebar-border: #27272a;
        --sidebar-ring: #52525b;
    }

    .sidebar-docs-frame .sidebar-inset {
        min-height: 100%;
        background: #09090b;
    }

    .sidebar-docs-inset-header {
        display: flex;
        height: 4rem;
        align-items: center;
        gap: 0.5rem;
        padding-inline: 1rem;
    }

    .sidebar-docs-logo,
    .sidebar-docs-avatar {
        display: inline-flex;
        width: 2rem;
        height: 2rem;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 0.625rem;
        background: #155dfc;
        color: #fafafa;
    }

    .sidebar-docs-avatar {
        background: linear-gradient(135deg, #fb7185, #7c3aed 55%, #22d3ee);
        font-size: 0.625rem;
        font-weight: 700;
    }

    .sidebar-docs-team,
    .sidebar-docs-user {
        min-height: 3rem;
    }

    .sidebar-docs-team-copy {
        display: grid;
        min-width: 0;
        flex: 1;
        line-height: 1.15;
        text-align: left;
    }

    .sidebar-docs-title,
    .sidebar-docs-subtitle {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sidebar-docs-title {
        font-size: 0.875rem;
        font-weight: 600;
    }

    .sidebar-docs-subtitle {
        color: #d4d4d8;
        font-size: 0.75rem;
    }

    .sidebar-docs-chevron {
        margin-left: auto;
    }
</style>

@code {
    bool _openDocs = true;
    bool _open4 = true;
    bool _subExpanded;

    private IReadOnlyList<StoryCard.State> States => [
        new(
