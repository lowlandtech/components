@attribute [DisplayName("Layout/Skeleton")]
@inherits StoryComponent

<StoryCard Title="Skeleton"
           Description="Skeleton states demonstrate text, profile, and card-placeholder loading layouts."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "text-lines",
            "Text lines",
            @<div class="w-full max-w-sm space-y-2">
                <Skeleton class="h-4 w-full rounded" />
                <Skeleton class="h-4 w-4/5 rounded" />
                <Skeleton class="h-4 w-3/5 rounded" />
            </div>,
            [
                new StoryCard.CodeTab("text-razor", "SkeletonStory.razor", TextRazor)
            ]),
        new(
            "profile",
            "Profile",
            @<div class="flex w-full max-w-sm items-center gap-4">
                <Skeleton class="h-12 w-12 rounded-full" />
                <div class="flex-1 space-y-2">
                    <Skeleton class="h-4 w-3/4 rounded" />
                    <Skeleton class="h-4 w-1/2 rounded" />
                </div>
            </div>,
            [
                new StoryCard.CodeTab("profile-razor", "SkeletonStory.razor", ProfileRazor)
            ]),
        new(
            "card",
            "Card",
            @<div class="w-full max-w-sm rounded-lg border border-border p-4 space-y-4">
                <div class="flex items-center justify-between">
                    <Skeleton class="h-4 w-24 rounded" />
                    <Skeleton class="h-4 w-16 rounded" />
                </div>
                <div class="flex gap-4">
                    <Skeleton class="h-20 w-20 shrink-0 rounded-lg" />
                    <div class="flex-1 space-y-2">
                        <Skeleton class="h-4 w-full rounded" />
                        <Skeleton class="h-4 w-5/6 rounded" />
                        <Skeleton class="h-4 w-4/6 rounded" />
                    </div>
                </div>
                <div class="flex items-center justify-between pt-2">
                    <Skeleton class="h-8 w-20 rounded" />
                    <Skeleton class="h-8 w-20 rounded" />
                </div>
            </div>,
            [
                new StoryCard.CodeTab("card-razor", "SkeletonStory.razor", CardRazor)
            ])
    ];

    private const string TextRazor =
        """
        <div class="space-y-2">
            <Skeleton class="h-4 w-full rounded" />
            <Skeleton class="h-4 w-4/5 rounded" />
            <Skeleton class="h-4 w-3/5 rounded" />
        </div>
        """;

    private const string ProfileRazor =
        """
        <div class="flex items-center gap-4">
            <Skeleton class="h-12 w-12 rounded-full" />
            <div class="flex-1 space-y-2">
                <Skeleton class="h-4 w-3/4 rounded" />
                <Skeleton class="h-4 w-1/2 rounded" />
            </div>
        </div>
        """;

    private const string CardRazor =
        """
        <div class="rounded-lg border border-border p-4 space-y-4">
            <div class="flex items-center justify-between">
                <Skeleton class="h-4 w-24 rounded" />
                <Skeleton class="h-4 w-16 rounded" />
            </div>
            <div class="flex gap-4">
                <Skeleton class="h-20 w-20 shrink-0 rounded-lg" />
                <div class="flex-1 space-y-2">
                    <Skeleton class="h-4 w-full rounded" />
                    <Skeleton class="h-4 w-5/6 rounded" />
                    <Skeleton class="h-4 w-4/6 rounded" />
                </div>
            </div>
            <div class="flex items-center justify-between pt-2">
                <Skeleton class="h-8 w-20 rounded" />
                <Skeleton class="h-8 w-20 rounded" />
            </div>
        </div>
        """;
}
