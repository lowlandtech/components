@attribute [DisplayName("Layout/Skeleton")]
@inherits StoryComponent

<StoryCard Title="Skeleton"
           Description="Skeleton states demonstrate text, profile, and card-placeholder loading layouts."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "text-lines",
            "Text lines",
            @<SkeletonTextLinesExample />,
            [
                StorySourceRegistry.CodeTab(
                    "text-razor",
                    "SkeletonTextLinesExample.razor",
                    "Showcode/Examples/Layout/Skeleton/SkeletonTextLinesExample.razor")
            ]),
        new(
            "profile",
            "Profile",
            @<SkeletonProfileExample />,
            [
                StorySourceRegistry.CodeTab(
                    "profile-razor",
                    "SkeletonProfileExample.razor",
                    "Showcode/Examples/Layout/Skeleton/SkeletonProfileExample.razor")
            ]),
        new(
            "card",
            "Card",
            @<SkeletonCardExample />,
            [
                StorySourceRegistry.CodeTab(
                    "card-razor",
                    "SkeletonCardExample.razor",
                    "Showcode/Examples/Layout/Skeleton/SkeletonCardExample.razor")
            ])
    ];
}
