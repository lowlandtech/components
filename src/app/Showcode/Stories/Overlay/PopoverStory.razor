@attribute [DisplayName("Overlay/Popover")]
@inherits StoryComponent

<StoryCard Title="Popover"
           Description="States can switch the rendered example, while each state keeps its own Razor and service-oriented code."
           States="@States" />

@code {
    private const string ServiceSource = "Showcode/Examples/Overlay/Popover/PopoverServiceExample.cs";
    private const string ProviderSource = "Showcode/Examples/Overlay/Popover/PopoverProviderExample.razor";

    private IReadOnlyList<StoryCard.State> States => [
        new(
            "basic",
            "Basic",
            @<PopoverBasicExample />,
            [
                StorySourceRegistry.CodeTab(
                    "basic-razor",
                    "PopoverBasicExample.razor",
                    "Showcode/Examples/Overlay/Popover/PopoverBasicExample.razor"),
                StorySourceRegistry.CodeTab("basic-service", "PopoverService.cs", ServiceSource, "csharp")
            ]),
        new(
            "outlined",
            "Outlined",
            @<PopoverOutlinedExample />,
            [
                StorySourceRegistry.CodeTab(
                    "outlined-razor",
                    "PopoverOutlinedExample.razor",
                    "Showcode/Examples/Overlay/Popover/PopoverOutlinedExample.razor"),
                StorySourceRegistry.CodeTab("outlined-service", "PopoverService.cs", ServiceSource, "csharp")
            ]),
        new(
            "form",
            "With form",
            @<PopoverFormExample />,
            [
                StorySourceRegistry.CodeTab(
                    "form-razor",
                    "PopoverFormExample.razor",
                    "Showcode/Examples/Overlay/Popover/PopoverFormExample.razor"),
                StorySourceRegistry.CodeTab("form-provider", "PopoverProvider.razor", ProviderSource)
            ])
    ];
}
