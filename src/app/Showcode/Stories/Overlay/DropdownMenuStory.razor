@attribute [DisplayName("Overlay/Dropdown Menu")]
@inherits StoryComponent

<StoryCard Title="Dropdown Menu"
           Description="Dropdown menu displays a toggleable list of actions, links, and form controls with full property and event binding."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "basic",
            "Basic",
            @<DropdownMenuBasicExample />,
            [
                StorySourceRegistry.CodeTab(
                    "basic-razor",
                    "DropdownMenuBasicExample.razor",
                    "Showcode/Examples/Overlay/DropdownMenu/DropdownMenuBasicExample.razor")
            ]),
        new(
            "controlled",
            "Controlled open",
            @<DropdownMenuControlledExample />,
            [
                StorySourceRegistry.CodeTab(
                    "controlled-razor",
                    "DropdownMenuControlledExample.razor",
                    "Showcode/Examples/Overlay/DropdownMenu/DropdownMenuControlledExample.razor")
            ]),
        new(
            "checkbox",
            "Checkbox items",
            @<DropdownMenuCheckboxExample />,
            [
                StorySourceRegistry.CodeTab(
                    "checkbox-razor",
                    "DropdownMenuCheckboxExample.razor",
                    "Showcode/Examples/Overlay/DropdownMenu/DropdownMenuCheckboxExample.razor")
            ]),
        new(
            "radio",
            "Radio group",
            @<DropdownMenuRadioExample />,
            [
                StorySourceRegistry.CodeTab(
                    "radio-razor",
                    "DropdownMenuRadioExample.razor",
                    "Showcode/Examples/Overlay/DropdownMenu/DropdownMenuRadioExample.razor")
            ]),
        new(
            "events",
            "Event binding",
            @<DropdownMenuEventsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "events-razor",
                    "DropdownMenuEventsExample.razor",
                    "Showcode/Examples/Overlay/DropdownMenu/DropdownMenuEventsExample.razor")
            ])
    ];
}
