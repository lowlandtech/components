@attribute [DisplayName("Overlay/Dialog")]
@inherits StoryComponent

<StoryCard Title="Dialog"
           Description="Dialog overlays the page with a modal window for forms, confirmations, or custom content."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "edit-profile",
            "Edit profile",
            @<DialogEditProfileExample />,
            [
                StorySourceRegistry.CodeTab(
                    "edit-profile-razor",
                    "DialogEditProfileExample.razor",
                    "Showcode/Examples/Overlay/Dialog/DialogEditProfileExample.razor")
            ]),
        new(
            "confirm",
            "Confirm",
            @<DialogConfirmExample />,
            [
                StorySourceRegistry.CodeTab(
                    "confirm-razor",
                    "DialogConfirmExample.razor",
                    "Showcode/Examples/Overlay/Dialog/DialogConfirmExample.razor")
            ]),
        new(
            "no-overlay-close",
            "No overlay close",
            @<DialogNoOverlayCloseExample />,
            [
                StorySourceRegistry.CodeTab(
                    "no-overlay-close-razor",
                    "DialogNoOverlayCloseExample.razor",
                    "Showcode/Examples/Overlay/Dialog/DialogNoOverlayCloseExample.razor")
            ])
    ];
}
