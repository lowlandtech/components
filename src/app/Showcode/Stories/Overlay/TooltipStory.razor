@attribute [DisplayName("Overlay/Tooltip")]
@inherits StoryComponent

<StoryCard Title="Tooltip"
           Description="Tooltip displays contextual information on hover with configurable position, alignment, and delays."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "default",
            "Default",
            @<TooltipDefaultExample />,
            [
                StorySourceRegistry.CodeTab(
                    "default-razor",
                    "TooltipDefaultExample.razor",
                    "Showcode/Examples/Overlay/Tooltip/TooltipDefaultExample.razor")
            ]),
        new(
            "positions",
            "Positions",
            @<TooltipPositionsExample />,
            [
                StorySourceRegistry.CodeTab(
                    "positions-razor",
                    "TooltipPositionsExample.razor",
                    "Showcode/Examples/Overlay/Tooltip/TooltipPositionsExample.razor")
            ]),
        new(
            "delay",
            "With delay",
            @<TooltipDelayExample />,
            [
                StorySourceRegistry.CodeTab(
                    "delay-razor",
                    "TooltipDelayExample.razor",
                    "Showcode/Examples/Overlay/Tooltip/TooltipDelayExample.razor")
            ])
    ];
}
