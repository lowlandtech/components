@attribute [DisplayName("Overlay/Context Menu")]
@inherits StoryComponent

<StoryCard Title="Context Menu"
           Description="A right-click menu with items, shortcuts, separators, checkboxes, radio groups, and sub-menus."
           States="@States" />

@code {
    private IReadOnlyList<StoryCard.State> States => [
        new(
            "basic",
            "Basic",
            @<ContextMenuBasicExample />,
            [
                StorySourceRegistry.CodeTab(
                    "basic-razor",
                    "ContextMenuBasicExample.razor",
                    "Showcode/Examples/Overlay/ContextMenu/ContextMenuBasicExample.razor")
            ]),
        new(
            "event-binding",
            "Event binding",
            @<ContextMenuEventBindingExample />,
            [
                StorySourceRegistry.CodeTab(
                    "event-razor",
                    "ContextMenuEventBindingExample.razor",
                    "Showcode/Examples/Overlay/ContextMenu/ContextMenuEventBindingExample.razor")
            ]),
        new(
            "checkbox-radio",
            "Checkboxes & radio",
            @<ContextMenuCheckboxRadioExample />,
            [
                StorySourceRegistry.CodeTab(
                    "checkbox-razor",
                    "ContextMenuCheckboxRadioExample.razor",
                    "Showcode/Examples/Overlay/ContextMenu/ContextMenuCheckboxRadioExample.razor")
            ]),
        new(
            "submenu",
            "Sub-menu",
            @<ContextMenuSubmenuExample />,
            [
                StorySourceRegistry.CodeTab(
                    "submenu-razor",
                    "ContextMenuSubmenuExample.razor",
                    "Showcode/Examples/Overlay/ContextMenu/ContextMenuSubmenuExample.razor")
            ])
    ];
}
