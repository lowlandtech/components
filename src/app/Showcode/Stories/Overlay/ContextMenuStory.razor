@attribute [DisplayName("Overlay/Context Menu")]
@inherits StoryComponent

<StoryCard Title="Context Menu"
           Description="A right-click menu with items, shortcuts, separators, checkboxes, radio groups, and sub-menus."
           States="@States" />

@code {
    bool _evtOpen;
    List<string> _log = [];
    bool _showToolbar = true;
    bool _showStatusBar;
    string _theme = "light";
    bool _subOpen;

    private IReadOnlyList<StoryCard.State> States => [
        new(
            "basic",
            "Basic",
            @<div class="flex h-40 w-full items-center justify-center rounded-lg border border-dashed border-border">
                <ContextMenu>
                    <ContextMenuTrigger>
                        <div class="flex h-20 w-48 items-center justify-center rounded-md border bg-muted text-sm text-muted-foreground select-none">
                            Right click here
                        </div>
                    </ContextMenuTrigger>
                    <ContextMenuContent>
                        <ContextMenuItem>New Tab</ContextMenuItem>
                        <ContextMenuItem>New Window</ContextMenuItem>
                        <ContextMenuSeparator />
                        <ContextMenuItem>
                            Undo
                            <ContextMenuShortcut>⌘Z</ContextMenuShortcut>
                        </ContextMenuItem>
                        <ContextMenuItem>
                            Redo
                            <ContextMenuShortcut>⌘Y</ContextMenuShortcut>
                        </ContextMenuItem>
                        <ContextMenuSeparator />
                        <ContextMenuLabel>Danger Zone</ContextMenuLabel>
                        <ContextMenuItem Variant="destructive">Delete</ContextMenuItem>
                    </ContextMenuContent>
                </ContextMenu>
            </div>,
            [
                new StoryCard.CodeTab("basic-razor", "ContextMenuStory.razor", BasicRazor)
            ]),
        new(
            "event-binding",
            "Event binding",
            @<div class="flex w-full gap-4">
                <div class="flex flex-1 items-center justify-center rounded-lg border border-dashed border-border h-40">
                    <ContextMenu @bind-IsOpen="_evtOpen">
                        <ContextMenuTrigger>
                            <div class="flex h-20 w-48 items-center justify-center rounded-md border bg-muted text-sm text-muted-foreground select-none">
                                Right click here
                            </div>
                        </ContextMenuTrigger>
                        <ContextMenuContent>
                            <ContextMenuItem OnClick="@(() => _log.Insert(0, "Cut"))">
                                Cut <ContextMenuShortcut>⌘X</ContextMenuShortcut>
                            </ContextMenuItem>
                            <ContextMenuItem OnClick="@(() => _log.Insert(0, "Copy"))">
                                Copy <ContextMenuShortcut>⌘C</ContextMenuShortcut>
                            </ContextMenuItem>
                            <ContextMenuItem OnClick="@(() => _log.Insert(0, "Paste"))">
                                Paste <ContextMenuShortcut>⌘V</ContextMenuShortcut>
                            </ContextMenuItem>
                        </ContextMenuContent>
                    </ContextMenu>
                </div>
                <div class="w-48 rounded-lg border bg-muted/40 p-3 text-xs space-y-1">
                    <p class="font-medium text-foreground">Event log</p>
                    <p class="text-muted-foreground">Open: @_evtOpen</p>
                    @foreach (var entry in _log.Take(5))
                    {
                        <p class="text-muted-foreground">→ @entry</p>
                    }
                </div>
            </div>,
            [
                new StoryCard.CodeTab("event-razor", "ContextMenuStory.razor", EventRazor)
            ]),
        new(
            "checkbox-radio",
            "Checkboxes & radio",
            @<div class="flex h-40 w-full items-center justify-center rounded-lg border border-dashed border-border">
                <ContextMenu>
                    <ContextMenuTrigger>
                        <div class="flex h-20 w-48 items-center justify-center rounded-md border bg-muted text-sm text-muted-foreground select-none">
                            Right click here
                        </div>
                    </ContextMenuTrigger>
                    <ContextMenuContent>
                        <ContextMenuLabel>View</ContextMenuLabel>
                        <ContextMenuCheckboxItem @bind-Checked="_showToolbar">Toolbar</ContextMenuCheckboxItem>
                        <ContextMenuCheckboxItem @bind-Checked="_showStatusBar">Status Bar</ContextMenuCheckboxItem>
                        <ContextMenuSeparator />
                        <ContextMenuLabel>Theme</ContextMenuLabel>
                        <ContextMenuRadioGroup @bind-Value="_theme">
                            <ContextMenuRadioItem Value="light">Light</ContextMenuRadioItem>
                            <ContextMenuRadioItem Value="dark">Dark</ContextMenuRadioItem>
                            <ContextMenuRadioItem Value="system">System</ContextMenuRadioItem>
                        </ContextMenuRadioGroup>
                    </ContextMenuContent>
                </ContextMenu>
            </div>,
            [
                new StoryCard.CodeTab("checkbox-razor", "ContextMenuStory.razor", CheckboxRazor)
            ]),
        new(
            "submenu",
            "Sub-menu",
            @<div class="flex h-40 w-full items-center justify-center rounded-lg border border-dashed border-border">
                <ContextMenu Modal="false">
                    <ContextMenuTrigger>
                        <div class="flex h-20 w-48 items-center justify-center rounded-md border bg-muted text-sm text-muted-foreground select-none">
                            Right click here
                        </div>
                    </ContextMenuTrigger>
                    <ContextMenuContent>
                        <ContextMenuItem>Back</ContextMenuItem>
                        <ContextMenuItem>Forward</ContextMenuItem>
                        <ContextMenuSeparator />
                        <ContextMenuSub @bind-IsOpen="_subOpen">
                            <ContextMenuSubTrigger>Share</ContextMenuSubTrigger>
                            <ContextMenuSubContent>
                                <ContextMenuItem>Email link</ContextMenuItem>
                                <ContextMenuItem>Copy link</ContextMenuItem>
                                <ContextMenuItem>Twitter / X</ContextMenuItem>
                            </ContextMenuSubContent>
                        </ContextMenuSub>
                        <ContextMenuSeparator />
                        <ContextMenuItem Variant="destructive">Delete</ContextMenuItem>
                    </ContextMenuContent>
                </ContextMenu>
            </div>,
            [
                new StoryCard.CodeTab("submenu-razor", "ContextMenuStory.razor", SubmenuRazor)
            ])
    ];

    private const string BasicRazor =
        """
        <ContextMenu>
            <ContextMenuTrigger>
                <div class="...trigger area...">Right click here</div>
            </ContextMenuTrigger>
            <ContextMenuContent>
                <ContextMenuItem>New Tab</ContextMenuItem>
                <ContextMenuItem>New Window</ContextMenuItem>
                <ContextMenuSeparator />
                <ContextMenuItem>
                    Undo <ContextMenuShortcut>⌘Z</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuSeparator />
                <ContextMenuLabel>Danger Zone</ContextMenuLabel>
                <ContextMenuItem Variant="destructive">Delete</ContextMenuItem>
            </ContextMenuContent>
        </ContextMenu>
        """;

    private const string EventRazor =
        """
        <ContextMenu @bind-IsOpen="_open">
            <ContextMenuTrigger>
                <div class="...">Right click here</div>
            </ContextMenuTrigger>
            <ContextMenuContent>
                <ContextMenuItem OnClick="@(() => _log.Insert(0, "Cut"))">
                    Cut <ContextMenuShortcut>⌘X</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem OnClick="@(() => _log.Insert(0, "Copy"))">
                    Copy <ContextMenuShortcut>⌘C</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem OnClick="@(() => _log.Insert(0, "Paste"))">
                    Paste <ContextMenuShortcut>⌘V</ContextMenuShortcut>
                </ContextMenuItem>
            </ContextMenuContent>
        </ContextMenu>

        @code {
            bool _open;
            List<string> _log = [];
        }
        """;

    private const string CheckboxRazor =
        """
        <ContextMenu>
            <ContextMenuTrigger>
                <div class="...">Right click here</div>
            </ContextMenuTrigger>
            <ContextMenuContent>
                <ContextMenuLabel>View</ContextMenuLabel>
                <ContextMenuCheckboxItem @bind-Checked="_showToolbar">Toolbar</ContextMenuCheckboxItem>
                <ContextMenuCheckboxItem @bind-Checked="_showStatusBar">Status Bar</ContextMenuCheckboxItem>
                <ContextMenuSeparator />
                <ContextMenuLabel>Theme</ContextMenuLabel>
                <ContextMenuRadioGroup @bind-Value="_theme">
                    <ContextMenuRadioItem Value="light">Light</ContextMenuRadioItem>
                    <ContextMenuRadioItem Value="dark">Dark</ContextMenuRadioItem>
                    <ContextMenuRadioItem Value="system">System</ContextMenuRadioItem>
                </ContextMenuRadioGroup>
            </ContextMenuContent>
        </ContextMenu>

        @code {
            bool _showToolbar = true;
            bool _showStatusBar;
            string _theme = "light";
        }
        """;

    private const string SubmenuRazor =
        """
        <ContextMenu Modal="false">
            <ContextMenuTrigger>
                <div class="...">Right click here</div>
            </ContextMenuTrigger>
            <ContextMenuContent>
                <ContextMenuItem>Back</ContextMenuItem>
                <ContextMenuItem>Forward</ContextMenuItem>
                <ContextMenuSeparator />
                <ContextMenuSub @bind-IsOpen="_subOpen">
                    <ContextMenuSubTrigger>Share</ContextMenuSubTrigger>
                    <ContextMenuSubContent>
                        <ContextMenuItem>Email link</ContextMenuItem>
                        <ContextMenuItem>Copy link</ContextMenuItem>
                    </ContextMenuSubContent>
                </ContextMenuSub>
                <ContextMenuSeparator />
                <ContextMenuItem Variant="destructive">Delete</ContextMenuItem>
            </ContextMenuContent>
        </ContextMenu>

        @code {
            bool _subOpen;
        }
        """;
}
