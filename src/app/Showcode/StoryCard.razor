@namespace LowlandTech.Components.App.Showcode
@inject IJSRuntime JS

@if (States.Count > 0)
{
    <section data-slot="story-card" class="@GetClass()">
        @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description))
        {
            <div class="space-y-1 p-4 pb-2">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h2 class="text-base font-semibold text-foreground">@Title</h2>
                }
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="max-w-2xl text-sm text-muted-foreground">@Description</p>
                }
            </div>
        }

        <Tabs Value="@_activeState" ValueChanged="@((v) => _activeState = v)" class="w-full">
            @if (States.Count > 1)
            {
                <div class="flex items-center px-4 pb-3">
                    <TabsList class="story-card-pill-tabs">
                        @foreach (var state in States)
                        {
                            <TabsTrigger Value="@state.Value" class="story-card-pill-tab">
                                @state.Name
                            </TabsTrigger>
                        }
                    </TabsList>
                </div>
            }

            @foreach (var state in States)
            {
                <TabsContent Value="@state.Value" class="mt-0">
                    <div class="relative mx-4 flex min-h-32 items-center justify-center rounded-lg border border-border/70 bg-background p-10">
                        @state.Preview
                    </div>

                    @if (state.CodeTabs.Count > 0)
                    {
                        <Tabs DefaultValue="@state.CodeTabs[0].Value" class="mx-4 mb-4 mt-4 overflow-hidden rounded-lg border border-[#444c56] bg-[#24292E] text-[#c9d1d9] shadow-sm">
                            <div class="flex min-h-12 items-center justify-between gap-3 border-b border-[#444c56] bg-[#2d333b] px-3">
                                <TabsList class="story-card-code-tabs">
                                    @foreach (var codeTab in state.CodeTabs)
                                    {
                                        <TabsTrigger Value="@codeTab.Value" class="story-card-code-tab">
                                            <span class="story-card-file-dot" data-language="@codeTab.Language"></span>
                                            @codeTab.Name
                                        </TabsTrigger>
                                    }
                                </TabsList>
                            </div>

                            @foreach (var codeTab in state.CodeTabs)
                            {
                                <TabsContent Value="@codeTab.Value" class="mt-0">
                                    <div class="story-card-code-header">
                                        <div class="flex items-center gap-2">
                                            <span>@codeTab.Name</span>
                                            <span class="rounded bg-[#444c56] px-1.5 py-0.5 uppercase tracking-wider text-[#c9d1d9]">@codeTab.Language</span>
                                        </div>
                                        <Button Variant="ghost"
                                                Size="icon-sm"
                                                class="story-card-copy-button text-[#8b949e] hover:bg-[#444c56] hover:text-[#c9d1d9]"
                                                title="@($"Copy {codeTab.Name} code")"
                                                @onclick="() => CopyCode(codeTab)">
                                            <Icon Name="@(CopiedValue == codeTab.Value ? "check" : "copy")" Size="14" />
                                            <span class="sr-only">Copy @codeTab.Name code</span>
                                        </Button>
                                    </div>
                                    <div class="story-card-code-editor" data-language="@codeTab.Language">
                                        @foreach (var line in GetHighlightedLines(codeTab))
                                        {
                                            <div class="story-card-code-line">
                                                <span class="story-card-line-number">@line.Number</span>
                                                <code class="story-card-line-code">@((MarkupString)line.Html)</code>
                                            </div>
                                        }
                                    </div>
                                </TabsContent>
                            }
                        </Tabs>
                    }
                </TabsContent>
            }
        </Tabs>
    </section>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? DefaultState { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<State> States { get; set; } = [];

    private string? CopiedValue { get; set; }

    private string DefaultStateValue => DefaultState ?? States[0].Value;

    private string _activeState = "";

    protected override void OnInitialized() => _activeState = DefaultStateValue;

    private string GetClass()
    {
        var baseClass = "overflow-hidden rounded-xl border bg-card text-card-foreground";
        return string.IsNullOrWhiteSpace(Class) ? baseClass : $"{baseClass} {Class}";
    }

    private async Task CopyCode(CodeTab codeTab)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", codeTab.Code);
        CopiedValue = codeTab.Value;
    }

    public sealed record State(
        string Value,
        string Name,
        RenderFragment Preview,
        IReadOnlyList<CodeTab> CodeTabs);

    public sealed record CodeTab(
        string Value,
        string Name,
        string Code,
        string Language = "razor");

    private static IReadOnlyList<CodeLine> GetHighlightedLines(CodeTab codeTab)
    {
        var normalized = codeTab.Code.Replace("\r\n", "\n").TrimEnd('\n');
        return normalized.Split('\n')
            .Select((line, index) => new CodeLine(index + 1, HighlightLine(line, codeTab.Language)))
            .ToList();
    }

    private static string HighlightLine(string line, string language)
    {
        try
        {
            return language.Equals("csharp", StringComparison.OrdinalIgnoreCase)
                ? HighlightCSharpLine(line)
                : HighlightMarkupLine(line);
        }
        catch
        {
            // Fallback: return encoded plain text if highlighting fails
            return Encode(line);
        }
    }

    private static string HighlightMarkupLine(string line)
    {
        var encoded = Encode(line);
        encoded = HighlightMarkupAttributes(encoded);
        encoded = HighlightStrings(encoded);
        encoded = HighlightRazorExpressions(encoded);

        foreach (var tag in new[]
        {
            // Accordion
            "AccordionContent", "AccordionHeader", "AccordionItem", "AccordionTrigger", "Accordion",
            // AlertDialog (longer prefix first), then Alert
            "AlertDialogAction", "AlertDialogCancel", "AlertDialogContent", "AlertDialogDescription",
            "AlertDialogFooter", "AlertDialogHeader", "AlertDialogTitle", "AlertDialogTrigger", "AlertDialog",
            "AlertDescription", "AlertTitle", "Alert",
            // AspectRatio
            "AspectRatio",
            // Avatar — GroupCount before Group before Avatar
            "AvatarBadge", "AvatarFallback", "AvatarGroupCount", "AvatarGroup", "AvatarImage", "Avatar",
            // Badge
            "Badge",
            // Breadcrumb
            "BreadcrumbEllipsis", "BreadcrumbItem", "BreadcrumbLink", "BreadcrumbList",
            "BreadcrumbPage", "BreadcrumbSeparator", "Breadcrumb",
            // ButtonGroup before Button
            "ButtonGroupSeparator", "ButtonGroupText", "ButtonGroup", "Button",
            // Card
            "CardAction", "CardContent", "CardDescription", "CardFooter", "CardHeader", "CardTitle", "Card",
            // Checkbox / Collapsible
            "Checkbox", "CollapsibleContent", "CollapsibleTrigger", "Collapsible",
            // ColorPicker
            "ColorPicker",
            // Command
            "CommandContainer", "CommandDialog", "CommandEmpty", "CommandGroup",
            "CommandInput", "CommandItem", "CommandList", "CommandSearch",
            "CommandSeparator", "CommandShortcut",
            // ContextMenu — Sub* before Sub before Menu
            "ContextMenuCheckboxItem", "ContextMenuContent", "ContextMenuItem", "ContextMenuLabel",
            "ContextMenuRadioGroup", "ContextMenuRadioItem", "ContextMenuSeparator", "ContextMenuShortcut",
            "ContextMenuSubContent", "ContextMenuSubTrigger", "ContextMenuSub", "ContextMenuTrigger", "ContextMenu",
            // Calendar
            "CalendarPresets", "CalendarMonthGrid", "CalendarYearGrid",
            "CalendarGrid", "CalendarNavigation", "CalendarDay", "Calendar",
            // DataForm / DataGrid
            "DataForm", "DataGridColumn", "DataGrid",
            // Dialog
            "DialogContent", "DialogDescription", "DialogFooter", "DialogHeader", "DialogTitle", "DialogTrigger", "Dialog",
            // Drawer
            "DrawerClose", "DrawerContent", "DrawerDescription", "DrawerFooter", "DrawerHeader",
            "DrawerOverlay", "DrawerTitle", "DrawerTrigger", "Drawer",
            // DropdownMenu
            "DropdownMenuCheckboxItem", "DropdownMenuContent", "DropdownMenuGroup", "DropdownMenuItem",
            "DropdownMenuLabel", "DropdownMenuRadioGroup", "DropdownMenuRadioItem", "DropdownMenuSeparator",
            "DropdownMenuShortcut", "DropdownMenuTrigger", "DropdownMenu",
            // Empty — EmptyTemplate must precede Empty
            "EmptyContent", "EmptyDescription", "EmptyMedia", "EmptyTemplate", "EmptyTitle", "Empty",
            // Grid
            "AppLayout", "GridItem", "Grid",
            // Kbd
            "Kbd",
            // LoadingTemplate (before Template below)
            "LoadingTemplate",
            // NavigationMenu — deepest first
            "NavigationMenuContent", "NavigationMenuIndicator", "NavigationMenuItem",
            "NavigationMenuLink", "NavigationMenuList", "NavigationMenuTrigger",
            "NavigationMenuViewport", "NavigationMenu",
            // Pagination
            "PaginationContent", "PaginationEllipsis", "PaginationItem", "PaginationLink",
            "PaginationNext", "PaginationPrevious", "Pagination",
            // Popover
            "PopoverContent", "PopoverProvider", "PopoverReference", "PopoverTrigger", "Popover",
            // Progress
            "Progress",
            // RadioGroup — ItemDescription/Title before Item before Group
            "RadioGroupItemDescription", "RadioGroupItemTitle", "RadioGroupItem", "RadioGroup",
            // Resizable
            "ResizableHandle", "ResizablePanel", "Resizable",
            // ScrollArea
            "ScrollArea",
            // Select
            "SelectContent", "SelectGroup", "SelectItem", "SelectLabel",
            "SelectSeparator", "SelectTrigger", "SelectValue", "Select",
            // Separator / Skeleton / Slider
            "Separator", "Skeleton", "SliderRange", "SliderThumb", "SliderTrack", "Slider",
            // Sidebar — deepest sub-tree first
            "SidebarGroupContent", "SidebarGroupLabel", "SidebarGroup",
            "SidebarMenuBadge", "SidebarMenuButton", "SidebarMenuItem",
            "SidebarMenuSubButton", "SidebarMenuSubContent", "SidebarMenuSubItem", "SidebarMenuSubTrigger",
            "SidebarMenuSub", "SidebarMenu",
            "SidebarContent", "SidebarFooter", "SidebarHeader", "SidebarInput", "SidebarInset",
            "SidebarProvider", "SidebarTrigger", "Sidebar",
            // Sonner / Spinner / Switch
            "Sonner", "Spinner", "Switch",
            // Tabs
            "TabsContent", "TabsList", "TabsTrigger", "Tabs",
            // TreeView
            "TreeNode", "TreeView",
            // Template (after EmptyTemplate / LoadingTemplate)
            "Template", "Textarea", "Toggle",
            // ThemeProvider / ThemeToggle
            "ThemeProvider", "ThemeToggle",
            // Tooltip
            "TooltipContent", "TooltipProvider", "TooltipTrigger", "Tooltip",
            // Standalone
            "Columns", "Icon", "Input", "Label",
            // HTML elements
            "span", "div", "header", "h1", "h2", "h3", "p", "ul", "li", "ol",
        })
        {
            encoded = encoded.Replace($"&lt;{tag}", $"&lt;<span class=\"story-card-token-tag\">{tag}</span>", StringComparison.Ordinal);
            encoded = encoded.Replace($"&lt;/{tag}", $"&lt;/<span class=\"story-card-token-tag\">{tag}</span>", StringComparison.Ordinal);
        }

        encoded = HighlightMarkupToken(encoded, "&lt;/", "story-card-token-punctuation");
        encoded = HighlightMarkupToken(encoded, "&lt;", "story-card-token-punctuation");
        encoded = HighlightMarkupToken(encoded, "/&gt;", "story-card-token-punctuation");
        encoded = HighlightMarkupToken(encoded, "&gt;", "story-card-token-punctuation");

        return encoded;
    }

    private static string HighlightCSharpLine(string line)
    {
        var encoded = Encode(line);

        // 1. Highlight strings first (they take precedence over everything else)
        encoded = HighlightCSharpStrings(encoded);

        // 2. Highlight comments (take precedence over keywords/types)
        encoded = Regex.Replace(encoded, @"(//.*$)", "<span class=\"story-card-token-comment\">$1</span>", RegexOptions.Multiline);

        // 3. Highlight numbers
        encoded = Regex.Replace(encoded, @"(?<![A-Za-z0-9_&lt;])(0[xX][0-9a-fA-F_]+|0[bB][01_]+|\d[\d_]*\.?\d*([eE][+-]?\d+)?[dfmFlL]?)(?![A-Za-z0-9_&gt;])", "<span class=\"story-card-token-number\">$0</span>");

        // 4. Highlight keywords and types
        foreach (var keyword in CSharpKeywords)
        {
            encoded = HighlightWord(encoded, keyword, "story-card-token-keyword");
        }

        foreach (var type in CSharpTypes)
        {
            encoded = HighlightWord(encoded, type, "story-card-token-type");
        }

        return encoded;
    }

    private static string HighlightCSharpStrings(string encoded)
    {
        var parts = encoded.Split("&quot;");
        if (parts.Length < 3)
        {
            return encoded;
        }

        var result = new List<string>();
        for (var i = 0; i < parts.Length; i++)
        {
            if (i % 2 == 1)
            {
                result.Add($"<span class=\"story-card-token-string\">&quot;{parts[i]}&quot;</span>");
            }
            else
            {
                result.Add(parts[i]);
            }
        }

        return string.Join(string.Empty, result);
    }

    private static readonly string[] CSharpKeywords = new[]
    {
        "abstract", "as", "base", "bool", "break", "byte", "case", "catch", "char", "checked",
        "class", "const", "continue", "decimal", "default", "delegate", "do", "double", "else",
        "enum", "event", "explicit", "extern", "false", "finally", "fixed", "float", "for",
        "foreach", "goto", "if", "implicit", "in", "int", "interface", "internal", "is",
        "lock", "long", "namespace", "new", "null", "object", "operator", "out", "override",
        "params", "private", "protected", "public", "readonly", "ref", "return", "sbyte",
        "sealed", "short", "sizeof", "stackalloc", "static", "string", "struct", "switch",
        "this", "throw", "true", "try", "typeof", "uint", "ulong", "unchecked", "unsafe",
        "ushort", "using", "virtual", "void", "volatile", "while", "add", "alias", "ascending",
        "async", "await", "by", "descending", "dynamic", "equals", "from", "get", "global",
        "group", "into", "join", "let", "nameof", "not", "notnull", "on", "or", "orderby",
        "partial", "record", "remove", "required", "scoped", "select", "set", "unmanaged",
        "value", "var", "when", "where", "with", "yield", "init"
    };

    private static readonly string[] CSharpTypes = new[]
    {
        // Common framework types
        "Task", "Task&lt;", "ValueTask", "ValueTask&lt;", "CancellationToken", "IDisposable",
        "IEnumerable", "IEnumerable&lt;", "IEnumerator", "IEnumerator&lt;", "IQueryable",
        "IQueryable&lt;", "ICollection", "ICollection&lt;", "IList", "IList&lt;", "IReadOnlyList",
        "IReadOnlyList&lt;", "IReadOnlyCollection", "IReadOnlyCollection&lt;", "IDictionary",
        "IDictionary&lt;", "IReadOnlyDictionary", "IReadOnlyDictionary&lt;", "HashSet", "HashSet&lt;",
        "List", "List&lt;", "Dictionary", "Dictionary&lt;", "Queue", "Queue&lt;", "Stack", "Stack&lt;",
        "Array", "Span", "Span&lt;", "ReadOnlySpan", "ReadOnlySpan&lt;", "Memory", "Memory&lt;",
        "Nullable", "Nullable&lt;", "Exception", "ArgumentException", "InvalidOperationException",
        "NotImplementedException", "NotSupportedException", "NullReferenceException",
        "DateTime", "DateTimeOffset", "TimeSpan", "DateOnly", "TimeOnly", "Guid", "Uri",
        "Stream", "MemoryStream", "FileStream", "StringBuilder", "Encoding", "Regex",
        "JsonDocument", "JsonElement", "JsonSerializer", "HttpClient", "HttpResponseMessage",
        "HttpRequestMessage", "HttpStatusCode", "StringContent", "FormUrlEncodedContent",
        "IFormFile", "IConfiguration", "ILogger", "ILogger&lt;", "IServiceProvider",
        "IServiceCollection", "IHost", "IHostBuilder", "WebApplication", "WebApplicationBuilder",
        "IEndpointRouteBuilder", "RouteHandlerBuilder", "Results", "TypedResults",
        // Blazor / Component types
        "RenderFragment", "RenderFragment&lt;", "RenderTreeBuilder", "ComponentBase",
        "LayoutComponentBase", "EditorRequired", "Parameter", "Inject", "CascadingParameter",
        "EventCallback", "EventCallback&lt;", "MarkupString", "IJSRuntime", "NavigationManager",
        "AuthenticationStateProvider", "AuthorizeView", "FocusOnNavigate",
        // LowlandTech component types
        "Accordion", "AlertDialog", "Alert", "AspectRatio", "Avatar", "Badge", "Breadcrumb",
        "ButtonGroup", "Button", "Card", "Checkbox", "Collapsible", "ContextMenu", "Calendar",
        "DataForm", "DataGrid", "Dialog", "Drawer", "DropdownMenu", "Empty", "Grid", "GridItem",
        "AppLayout", "Kbd", "NavigationMenu", "Pagination", "Popover", "Progress", "RadioGroup",
        "Resizable", "ScrollArea", "Select", "Separator", "Skeleton", "Slider", "Sidebar",
        "Sonner", "Spinner", "Switch", "Tabs", "TreeView", "TreeNode", "Textarea", "Toggle",
        "Tooltip", "ThemeProvider", "ThemeToggle", "CodeEditor", "Icon", "Input", "Label",
        "Columns", "Template", "LoadingTemplate",
        // Common test / scenario types
        "Scenario", "AppLayoutScenario", "ComponentScenario", "ApiScenario", "WorkspaceApiScenario",
        "AppFactory", "ApiFactory", "FoundryContext", "GraphSession", "IGraphSession",
        "Shouldly", "Fact", "Theory", "InlineData", "Trait", "ClassData", "MemberData",
        // Event args
        "TreeViewSelectEventArgs", "TreeViewExpandEventArgs", "TreeNodeContext",
        "ChangeEventArgs", "MouseEventArgs", "KeyboardEventArgs", "FocusEventArgs",
        // Other common types
        "Action", "Action&lt;", "Func", "Func&lt;", "Predicate", "Predicate&lt;", "Comparison",
        "Comparison&lt;", "Converter", "Converter&lt;", "EventHandler", "EventHandler&lt;",
        "Lazy", "Lazy&lt;", "Tuple", "Tuple&lt;", "ValueTuple", "ValueTuple&lt;",
        "KeyValuePair", "KeyValuePair&lt;", "Attribute", "Enum", "Delegate", "MulticastDelegate",
        "Type", "MethodInfo", "PropertyInfo", "FieldInfo", "ConstructorInfo",
        "Expression", "Expression&lt;", "ParameterExpression", "LambdaExpression",
        "CancellationTokenSource", "ConcurrentDictionary", "ConcurrentDictionary&lt;",
        "ConcurrentBag", "ConcurrentBag&lt;", "ConcurrentQueue", "ConcurrentQueue&lt;",
        "BlockingCollection", "BlockingCollection&lt;", "ObservableCollection",
        "ObservableCollection&lt;", "ReadOnlyObservableCollection",
    };

    private static string HighlightWord(string encoded, string word, string cssClass)
    {
        // Match whole words only — preceded/followed by non-word char or boundary
        var pattern = $@"(?<![A-Za-z0-9_&lt;]){System.Text.RegularExpressions.Regex.Escape(word)}(?![A-Za-z0-9_&gt;])";
        return System.Text.RegularExpressions.Regex.Replace(encoded, pattern, $"<span class=\"{cssClass}\">$0</span>");
    }

    private static string HighlightMarkupAttributes(string encoded)
    {
        return System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"(?<=\s)(@?[A-Za-z_][A-Za-z0-9_:-]*)(?=\=)",
            "<span class=\"story-card-token-attribute\">$1</span>");
    }

    private static string HighlightRazorExpressions(string encoded)
    {
        return System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"@([A-Za-z_][A-Za-z0-9_\.]*)",
            "<span class=\"story-card-token-razor\">@$1</span>");
    }

    private static string HighlightStrings(string encoded)
    {
        var parts = encoded.Split("&quot;");
        if (parts.Length < 3)
        {
            return encoded;
        }

        var result = new List<string>();
        for (var i = 0; i < parts.Length; i++)
        {
            if (i % 2 == 1)
            {
                result.Add($"<span class=\"story-card-token-string\">&quot;{parts[i]}&quot;</span>");
            }
            else
            {
                result.Add(parts[i]);
            }
        }

        return string.Join(string.Empty, result);
    }

    private static string HighlightMarkupToken(string encoded, string token, string cssClass)
    {
        return encoded.Replace(token, $"<span class=\"{cssClass}\">{token}</span>", StringComparison.Ordinal);
    }

    private static string Encode(string value)
    {
        return value
            .Replace("&", "&amp;", StringComparison.Ordinal)
            .Replace("<", "&lt;", StringComparison.Ordinal)
            .Replace(">", "&gt;", StringComparison.Ordinal)
            .Replace("\"", "&quot;", StringComparison.Ordinal);
    }

    private sealed record CodeLine(int Number, string Html);
}
