@namespace LowlandTech.Components.App.Showcode.Examples.Layout

<div class="w-full">
    <div class="min-h-[22rem] w-full overflow-hidden rounded-md border border-border">
        <AppLayout Scenario="AppLayoutScenario.Chat"
                   TopBar="@TopBar"
                   Sidebar="@Sidebar"
                   Main="@Main" />
    </div>
</div>

@code {
    private RenderFragment TopBar => @<div class="font-semibold">Messages</div>;

    private RenderFragment Sidebar => @<div class="space-y-1 p-2">
        <div class="px-2 py-1.5 text-xs font-semibold text-muted-foreground">Conversations</div>
        <div class="rounded-md bg-sidebar-accent px-3 py-2 text-sm font-medium text-sidebar-accent-foreground">Design review</div>
        <div class="rounded-md px-3 py-2 text-sm text-sidebar-foreground/80">Sprint planning</div>
        <div class="rounded-md px-3 py-2 text-sm text-sidebar-foreground/80">Bug triage</div>
        <div class="rounded-md px-3 py-2 text-sm text-sidebar-foreground/80">Onboarding flow</div>
    </div>;

    private RenderFragment Main => @<div class="flex min-h-[22rem] flex-col">
        <div class="flex-1 space-y-4 overflow-auto p-4">
            <div class="flex justify-end">
                <div class="max-w-xs rounded-2xl rounded-br-sm bg-primary px-4 py-2 text-sm text-primary-foreground">Can you review the new layout?</div>
            </div>
            <div class="flex justify-start">
                <div class="max-w-xs rounded-2xl rounded-bl-sm bg-muted px-4 py-2 text-sm">Sure! The sidebar width looks good. The main area could use more breathing room though.</div>
            </div>
            <div class="flex justify-end">
                <div class="max-w-xs rounded-2xl rounded-br-sm bg-primary px-4 py-2 text-sm text-primary-foreground">Agreed. I'll bump the padding.</div>
            </div>
        </div>
        <div class="border-t border-border p-3">
            <div class="flex items-center gap-2 rounded-lg border border-border bg-muted/40 px-3 py-2 text-sm text-muted-foreground">
                <span class="flex-1">Type a message…</span>
                <span class="text-xs">↵</span>
            </div>
        </div>
    </div>;
}
