@namespace LowlandTech.Components.App.Showcode.Examples.Overlay

<div class="flex flex-col items-center gap-4">
    <div class="h-8 rounded-md border bg-muted/40 px-3 py-1.5 text-xs font-mono">
        @(string.IsNullOrEmpty(_lastAction) ? "Click an item..." : $"Last action: {_lastAction}")
    </div>
    <DropdownMenu>
        <DropdownMenuTrigger><Button Variant="outline">Actions</Button></DropdownMenuTrigger>
        <DropdownMenuContent>
            <DropdownMenuGroup>
                <DropdownMenuLabel>File</DropdownMenuLabel>
                <DropdownMenuItem OnSelect='() => _lastAction = "new-file"'>New file</DropdownMenuItem>
                <DropdownMenuItem OnSelect='() => _lastAction = "copy"'>Copy</DropdownMenuItem>
                <DropdownMenuItem OnSelect='() => _lastAction = "paste"'>Paste</DropdownMenuItem>
            </DropdownMenuGroup>
            <DropdownMenuSeparator />
            <DropdownMenuGroup>
                <DropdownMenuLabel>Edit</DropdownMenuLabel>
                <DropdownMenuItem OnSelect='() => _lastAction = "undo"'>Undo</DropdownMenuItem>
                <DropdownMenuItem OnSelect='() => _lastAction = "redo"'>Redo</DropdownMenuItem>
                <DropdownMenuItem OnSelect='() => _lastAction = "cut"' Disabled="true">Cut</DropdownMenuItem>
            </DropdownMenuGroup>
            <DropdownMenuSeparator />
            <DropdownMenuItem OnSelect='() => _lastAction = "delete"' class="text-destructive focus:text-destructive">
                Delete
            </DropdownMenuItem>
        </DropdownMenuContent>
    </DropdownMenu>
</div>

@code {
    private string? _lastAction;
}
