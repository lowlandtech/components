@namespace LowlandTech.Components.App.Showcode.Examples.Form

<div class="space-y-3">
    <RadioGroup Name="plan" @bind-Value="_plan">
        <RadioGroupItem Value="free">Free</RadioGroupItem>
        <RadioGroupItem Value="pro">Pro</RadioGroupItem>
        <RadioGroupItem Value="enterprise">Enterprise</RadioGroupItem>
    </RadioGroup>
    <p class="text-xs text-muted-foreground">Selected: @_plan</p>
</div>

@code {
    private string _plan = "free";
}
