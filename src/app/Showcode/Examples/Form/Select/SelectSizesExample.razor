@namespace LowlandTech.Components.App.Showcode.Examples.Form

<div class="w-full max-w-sm space-y-2">
    <Select @bind-Value="_sizeDemo">
        <SelectTrigger Size="compact">
            <SelectValue Placeholder="Compact" />
        </SelectTrigger>
        <SelectContent>
            <SelectItem Value="sm" Text="Small">Small</SelectItem>
            <SelectItem Value="md" Text="Medium">Medium</SelectItem>
            <SelectItem Value="lg" Text="Large">Large</SelectItem>
        </SelectContent>
    </Select>
    <Select @bind-Value="_sizeDemo">
        <SelectTrigger Size="sm">
            <SelectValue Placeholder="Small" />
        </SelectTrigger>
        <SelectContent>
            <SelectItem Value="sm" Text="Small">Small</SelectItem>
            <SelectItem Value="md" Text="Medium">Medium</SelectItem>
            <SelectItem Value="lg" Text="Large">Large</SelectItem>
        </SelectContent>
    </Select>
    <Select @bind-Value="_sizeDemo">
        <SelectTrigger Size="default">
            <SelectValue Placeholder="Default" />
        </SelectTrigger>
        <SelectContent>
            <SelectItem Value="sm" Text="Small">Small</SelectItem>
            <SelectItem Value="md" Text="Medium">Medium</SelectItem>
            <SelectItem Value="lg" Text="Large">Large</SelectItem>
        </SelectContent>
    </Select>
    <Select @bind-Value="_sizeDemo">
        <SelectTrigger Size="lg">
            <SelectValue Placeholder="Large" />
        </SelectTrigger>
        <SelectContent>
            <SelectItem Value="sm" Text="Small">Small</SelectItem>
            <SelectItem Value="md" Text="Medium">Medium</SelectItem>
            <SelectItem Value="lg" Text="Large">Large</SelectItem>
        </SelectContent>
    </Select>
</div>

@code {
    private string _sizeDemo = "md";
}
