@namespace LowlandTech.Components.App.Showcode.Examples.Navigation

<Tabs DefaultValue="tab-01" class="w-full max-w-sm">
    <TabsList ShowScrollButtons="true">
        @for (var i = 1; i <= 10; i++)
        {
            var value = $"tab-{i:00}";
            <TabsTrigger Value="@value">Document @i</TabsTrigger>
        }
    </TabsList>
    <TabsContent Value="tab-01">
        <p class="p-3 text-sm text-muted-foreground">The header stays inside its parent and exposes scroll controls.</p>
    </TabsContent>
</Tabs>
