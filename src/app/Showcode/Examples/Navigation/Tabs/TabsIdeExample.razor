        new() { Value = "graph", Title = "GraphCanvas.razor", Closeable = true, Pinnable = true, Renameable = true, Draggable = true },
        new() { Value = "theme", Title = "ThemeProvider.razor", Closeable = true, Pinnable = true, Renameable = true, Draggable = true },
        new() { Value = "dataform", Title = "DataForm.razor", Closeable = true, Pinnable = true, Renameable = true, Draggable = true },
        new() { Value = "tabs", Title = "Tabs.razor", Closeable = true, Pinnable = true, Renameable = true, Draggable = true }
    ];
}
