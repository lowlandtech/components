<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="visual-artifacts\**" />
    <Content Remove="visual-artifacts\**" />
    <EmbeddedResource Remove="visual-artifacts\**" />
    <None Remove="visual-artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="LowlandTech.Components.App.csproj.Backup.tmp" />
    <None Remove="LowlandTech.Components.App.csproj.DotSettings" />
    <None Remove="LowlandTech.Components.App.csproj.lscache" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\stories\LowlandTech.Components.Stories.csproj" />
  </ItemGroup>

</Project>
