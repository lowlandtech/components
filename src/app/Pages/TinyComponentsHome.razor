@page "/"
@layout HomeLayout
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="flex flex-col">

    @* ── Hero ─────────────────────────────────────────────────────── *@
    <section class="relative flex flex-col items-center overflow-hidden px-6 text-center"
             style="min-height: calc(100vh - 56px); padding-top: 3rem; padding-bottom: 2rem;">

        @* Radial glow behind the heading *@
        <div class="pointer-events-none absolute"
             style="width: 700px; height: 500px; left: 50%; top: 50%; transform: translate(-50%, -55%); border-radius: 50%; background: radial-gradient(ellipse at center, color-mix(in srgb, var(--primary) 18%, transparent) 0%, transparent 70%); filter: blur(48px);"></div>

        <div class="relative flex flex-1 flex-col items-center justify-center gap-8" style="max-width: 48rem;">

            @* Badge pill *@
            <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary"
                 style="box-shadow: 0 0 20px color-mix(in srgb, var(--primary) 12%, transparent);">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
                </svg>
                A beautiful component library for Blazor
            </div>

            @* Main heading *@
            <h1 class="font-bold tracking-tight leading-none text-foreground"
                style="font-size: clamp(3.25rem, 8vw, 5.5rem); letter-spacing: -0.03em;">
                <span class="text-primary">Tiny</span>Components
            </h1>

            @* Subtitle *@
            <p class="text-xl text-muted-foreground leading-relaxed" style="max-width: 36rem;">
                50+ beautifully crafted Blazor components, inspired by shadcn/ui.
                Styled with Tailwind CSS 4, dark mode included. Copy. Paste. Ship.
            </p>

            @* CTAs *@
            <div class="flex flex-wrap items-center justify-center gap-4">
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-lg bg-primary font-semibold text-primary-foreground transition-all hover:bg-primary/90"
                        style="padding: 0.75rem 1.75rem; font-size: 0.9375rem; box-shadow: 0 0 28px color-mix(in srgb, var(--primary) 30%, transparent);"
                        @onclick='() => Nav.NavigateTo("/components")'>
                    Browse Components
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                    </svg>
                </button>
                <a href="https://github.com/lowlandtech/foundry"
                   target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 rounded-lg border border-border bg-card font-semibold text-foreground transition-all hover:border-primary/40 hover:bg-accent"
                   style="padding: 0.75rem 1.75rem; font-size: 0.9375rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                        <path d="M9 18c-4.51 2-5-2-7-2"/>
                    </svg>
                    View on GitHub
                </a>
            </div>

        </div>

        @* Scroll hint *@
        <a href="#features" class="flex flex-col items-center gap-1 text-muted-foreground/40 hover:text-muted-foreground/70 transition-colors no-underline">
            <span style="font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;">Scroll</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </a>
    </section>

    @* ── Features ──────────────────────────────────────────────────── *@
    <section id="features" class="border-t border-border px-6" style="padding-top: 5rem; padding-bottom: 5rem;">
        <div class="mx-auto" style="max-width: 72rem;">

            <div class="text-center" style="margin-bottom: 3.5rem;">
                <h2 class="font-bold text-foreground" style="font-size: 2rem; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
                    Everything you need
                </h2>
                <p class="text-muted-foreground text-lg">Built for modern Blazor applications from the ground up.</p>
            </div>

            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">

                <div class="group flex flex-col gap-4 rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/40"
                     style="box-shadow: 0 1px 4px rgba(0,0,0,.15);">
                    <div class="flex size-11 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/15">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-foreground" style="margin-bottom: 0.375rem;">shadcn/ui Inspired</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">
                            Beautifully designed components faithfully adapted from shadcn/ui for Blazor Server and WASM.
                        </p>
                    </div>
                </div>

                <div class="group flex flex-col gap-4 rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/40"
                     style="box-shadow: 0 1px 4px rgba(0,0,0,.15);">
                    <div class="flex size-11 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/15">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            <polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-foreground" style="margin-bottom: 0.375rem;">Tailwind CSS 4</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">
                            Styled with Tailwind CSS 4.0 with full dark mode and customizable design tokens via CSS variables.
                        </p>
                    </div>
                </div>

                <div class="group flex flex-col gap-4 rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/40"
                     style="box-shadow: 0 1px 4px rgba(0,0,0,.15);">
                    <div class="flex size-11 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/15">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                            <rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-foreground" style="margin-bottom: 0.375rem;">50+ Components</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">
                            From buttons to data grids and charts — a comprehensive set for production Blazor apps.
                        </p>
                    </div>
                </div>

                <div class="group flex flex-col gap-4 rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/40"
                     style="box-shadow: 0 1px 4px rgba(0,0,0,.15);">
                    <div class="flex size-11 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/15">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-foreground" style="margin-bottom: 0.375rem;">Live Code Preview</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">
                            Interactive explorer with live source code you can copy directly into your project.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    @* ── Quick Start ──────────────────────────────────────────────── *@
    <section class="border-t border-border px-6" style="padding-top: 5rem; padding-bottom: 5rem;">
        <div class="mx-auto" style="max-width: 52rem;">

            <div class="text-center" style="margin-bottom: 3rem;">
                <h2 class="font-bold text-foreground" style="font-size: 2rem; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
                    Get started in minutes
                </h2>
                <p class="text-muted-foreground text-lg">Install the package, import the namespace, start building.</p>
            </div>

            <div class="flex flex-col gap-4">

                <div class="overflow-hidden rounded-xl border border-border">
                    <div class="flex items-center justify-between border-b border-border bg-muted/40 px-5 py-3">
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                                <rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/>
                            </svg>
                            <span class="text-sm font-medium text-foreground">Installation</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-muted-foreground font-medium">.NET CLI</span>
                            <Button Variant="ghost" Size="icon-sm" class="h-7 w-7 text-muted-foreground hover:bg-accent hover:text-foreground" @onclick='() => CopyAsync("install", "dotnet add package LowlandTech.Components")'>
                                <Icon Name="@(_copiedId == "install" ? "check" : "copy")" Size="14" />
                            </Button>
                        </div>
                    </div>
                    <div class="px-5 py-4 font-mono text-sm" style="background: #24292E;">
                        <span class="select-none" style="color: #6e7681;">$ </span><span style="color: #c9d1d9;">dotnet add package </span><span class="font-medium" style="color: #ffa657;">LowlandTech.Components</span>
                    </div>
                </div>

                <div class="overflow-hidden rounded-xl border border-border">
                    <div class="flex items-center justify-between border-b border-border bg-muted/40 px-5 py-3">
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/>
                            </svg>
                            <span class="text-sm font-medium text-foreground">_Imports.razor</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-muted-foreground font-medium">Razor</span>
                            <Button Variant="ghost" Size="icon-sm" class="h-7 w-7 text-muted-foreground hover:bg-accent hover:text-foreground" @onclick='() => CopyAsync("imports", _importsSnippet)'>
                                <Icon Name="@(_copiedId == "imports" ? "check" : "copy")" Size="14" />
                            </Button>
                        </div>
                    </div>
                    <div class="px-5 py-4 font-mono text-sm" style="background: #24292E;">
                        <span style="color: #ff7b72;">@@using </span><span style="color: #ffa657;">LowlandTech.Components</span>
                    </div>
                </div>

                <div class="overflow-hidden rounded-xl border border-border">
                    <div class="flex items-center justify-between border-b border-border bg-muted/40 px-5 py-3">
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/>
                            </svg>
                            <span class="text-sm font-medium text-foreground">MyPage.razor</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-muted-foreground font-medium">Razor</span>
                            <Button Variant="ghost" Size="icon-sm" class="h-7 w-7 text-muted-foreground hover:bg-accent hover:text-foreground" @onclick='() => CopyAsync("mypage", _mypageSnippet)'>
                                <Icon Name="@(_copiedId == "mypage" ? "check" : "copy")" Size="14" />
                            </Button>
                        </div>
                    </div>
                    <div class="px-5 py-4 font-mono text-sm leading-7" style="background: #24292E;">
                        <div><span style="color: #7ee787;">&lt;Button</span> <span style="color: #79c0ff;">Variant</span><span style="color: #8b949e;">=</span><span style="color: #a5d6ff;">"primary"</span><span style="color: #7ee787;">&gt;</span><span style="color: #c9d1d9;">Click me</span><span style="color: #7ee787;">&lt;/Button&gt;</span></div>
                        <div><span style="color: #7ee787;">&lt;Badge</span> <span style="color: #79c0ff;">Variant</span><span style="color: #8b949e;">=</span><span style="color: #a5d6ff;">"secondary"</span><span style="color: #7ee787;">&gt;</span><span style="color: #c9d1d9;">New</span><span style="color: #7ee787;">&lt;/Badge&gt;</span></div>
                        <div><span style="color: #7ee787;">&lt;Alert</span> <span style="color: #79c0ff;">Title</span><span style="color: #8b949e;">=</span><span style="color: #a5d6ff;">"Heads up!"</span> <span style="color: #7ee787;">/&gt;</span></div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    @* ── Footer ──────────────────────────────────────────────────── *@
    <footer class="border-t border-border px-6 py-8 text-center">
        <p class="text-sm text-muted-foreground">
            &copy; 2026 LowlandTech &middot; Part of the
            <a href="https://github.com/lowlandtech/foundry" target="_blank" rel="noopener noreferrer"
               class="text-primary hover:underline">Foundry</a> platform
        </p>
    </footer>

</div>

@code {
    private string? _copiedId;
    private readonly string _importsSnippet = "@using LowlandTech.Components";
    private readonly string _mypageSnippet = "<Button Variant=\"primary\">Click me</Button>\n<Badge Variant=\"secondary\">New</Badge>\n<Alert Title=\"Heads up!\" />";

    private async Task CopyAsync(string id, string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        _copiedId = id;
    }
}
