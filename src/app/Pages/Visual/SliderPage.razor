@page "/visual/slider"
@using LowlandTech.Components.Slider

<PageTitle>Slider - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Slider</h1>

    <div class="space-y-12">
        <!-- Basic Slider -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Slider</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Slider @bind-Value="_basicValue" Min="0" Max="100">
                    <SliderTrack>
                        <SliderRange />
                    </SliderTrack>
                    <SliderThumb />
                </Slider>
                <p class="mt-4 text-sm text-muted-foreground">Value: @_basicValue</p>
            </div>
        </section>

        <!-- With Default Value -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Default Value</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Slider @bind-Value="_defaultValue" Min="0" Max="100">
                    <SliderTrack>
                        <SliderRange />
                    </SliderTrack>
                    <SliderThumb />
                </Slider>
                <p class="mt-4 text-sm text-muted-foreground">Value: @_defaultValue (default: 50)</p>
            </div>
        </section>

        <!-- With Steps -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Steps (Step = 10)</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Slider @bind-Value="_stepValue" Min="0" Max="100" Step="10">
                    <SliderTrack>
                        <SliderRange />
                    </SliderTrack>
                    <SliderThumb />
                </Slider>
                <div class="flex justify-between mt-2 text-xs text-muted-foreground">
                    <span>0</span>
                    <span>25</span>
                    <span>50</span>
                    <span>75</span>
                    <span>100</span>
                </div>
                <p class="mt-2 text-sm text-muted-foreground">Value: @_stepValue</p>
            </div>
        </section>

        <!-- Disabled Slider -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Disabled</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Slider @bind-Value="_disabledValue" Min="0" Max="100" Disabled="true">
                    <SliderTrack>
                        <SliderRange />
                    </SliderTrack>
                    <SliderThumb />
                </Slider>
                <p class="mt-4 text-sm text-muted-foreground">Value: @_disabledValue (disabled)</p>
            </div>
        </section>

        <!-- Custom Range -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Custom Range (0-10)</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Slider @bind-Value="_customRangeValue" Min="0" Max="10" Step="0.5">
                    <SliderTrack>
                        <SliderRange />
                    </SliderTrack>
                    <SliderThumb />
                </Slider>
                <div class="flex justify-between mt-2 text-xs text-muted-foreground">
                    @for (var i = 0; i <= 10; i++)
                    {
                        <span>@i</span>
                    }
                </div>
                <p class="mt-2 text-sm text-muted-foreground">Value: @_customRangeValue</p>
            </div>
        </section>

        <!-- Volume Control Example -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Volume Control</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex items-center gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    </svg>
                    <div class="flex-1">
                        <Slider @bind-Value="_volumeValue" Min="0" Max="100">
                            <SliderTrack>
                                <SliderRange />
                            </SliderTrack>
                            <SliderThumb />
                        </Slider>
                    </div>
                    <span class="text-sm w-12 text-right">@((int)_volumeValue)%</span>
                </div>
            </div>
        </section>

        <!-- Brightness Control Example -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Brightness Control</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex items-center gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2"></path>
                        <path d="M12 20v2"></path>
                        <path d="m4.93 4.93 1.41 1.41"></path>
                        <path d="m17.66 17.66 1.41 1.41"></path>
                        <path d="M2 12h2"></path>
                        <path d="M20 12h2"></path>
                        <path d="m6.34 17.66-1.41 1.41"></path>
                        <path d="m19.07 4.93-1.41 1.41"></path>
                    </svg>
                    <div class="flex-1">
                        <Slider @bind-Value="_brightnessValue" Min="0" Max="100">
                            <SliderTrack>
                                <SliderRange />
                            </SliderTrack>
                            <SliderThumb />
                        </Slider>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2"></path>
                        <path d="M12 20v2"></path>
                        <path d="m4.93 4.93 1.41 1.41"></path>
                        <path d="m17.66 17.66 1.41 1.41"></path>
                        <path d="M2 12h2"></path>
                        <path d="M20 12h2"></path>
                        <path d="m6.34 17.66-1.41 1.41"></path>
                        <path d="m19.07 4.93-1.41 1.41"></path>
                    </svg>
                </div>
            </div>
        </section>

        <!-- Price Range Example -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Price Filter ($0 - $1000)</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Slider @bind-Value="_priceValue" Min="0" Max="1000" Step="10">
                    <SliderTrack>
                        <SliderRange />
                    </SliderTrack>
                    <SliderThumb />
                </Slider>
                <div class="flex justify-between mt-4">
                    <div class="border rounded-md px-3 py-2">
                        <span class="text-xs text-muted-foreground">Min</span>
                        <p class="font-medium">$0</p>
                    </div>
                    <div class="border rounded-md px-3 py-2">
                        <span class="text-xs text-muted-foreground">Max</span>
                        <p class="font-medium">$@((int)_priceValue)</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Progress Example -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Progress Indicator</h2>
            <div class="p-6 border rounded-lg bg-background space-y-6">
                <div>
                    <div class="flex justify-between mb-2">
                        <span class="text-sm font-medium">Upload Progress</span>
                        <span class="text-sm text-muted-foreground">@((int)_uploadValue)%</span>
                    </div>
                    <Slider @bind-Value="_uploadValue" Min="0" Max="100">
                        <SliderTrack>
                            <SliderRange />
                        </SliderTrack>
                        <SliderThumb />
                    </Slider>
                </div>
                <div>
                    <div class="flex justify-between mb-2">
                        <span class="text-sm font-medium">Download Progress</span>
                        <span class="text-sm text-muted-foreground">@((int)_downloadValue)%</span>
                    </div>
                    <Slider @bind-Value="_downloadValue" Min="0" Max="100">
                        <SliderTrack>
                            <SliderRange />
                        </SliderTrack>
                        <SliderThumb />
                    </Slider>
                </div>
            </div>
        </section>

        <!-- Rating Example -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Rating Slider (1-5)</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Slider @bind-Value="_ratingValue" Min="1" Max="5" Step="0.5">
                    <SliderTrack>
                        <SliderRange />
                    </SliderTrack>
                    <SliderThumb />
                </Slider>
                <div class="flex justify-between mt-2 text-lg">
                    <span>⭐</span>
                    <span>⭐⭐</span>
                    <span>⭐⭐⭐</span>
                    <span>⭐⭐⭐⭐</span>
                    <span>⭐⭐⭐⭐⭐</span>
                </div>
                <p class="mt-4 text-sm text-muted-foreground text-center">Rating: @_ratingValue stars</p>
            </div>
        </section>
    </div>
</div>

@code {
    private double _basicValue = 30;
    private double _defaultValue = 50;
    private double _stepValue = 50;
    private double _disabledValue = 75;
    private double _customRangeValue = 5;
    private double _volumeValue = 70;
    private double _brightnessValue = 80;
    private double _priceValue = 500;
    private double _uploadValue = 45;
    private double _downloadValue = 78;
    private double _ratingValue = 3.5;
}
