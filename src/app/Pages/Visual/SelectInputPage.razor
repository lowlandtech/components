@page "/visual/select-input"
@using LowlandTech.Components.SelectInput

<PageTitle>Select Input - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Select Input</h1>

    <div class="space-y-12">
        <!-- Basic Select Input -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Select Input</h2>
            <div class="p-6 border rounded-lg bg-background">
                <SelectInput TValue="string"
                           @bind-Value="_basicValue"
                           Options="_basicOptions"
                           Placeholder="Choose an option..." />
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_basicValue</p>
            </div>
        </section>

        <!-- With Pre-selected Value -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Pre-selected Value</h2>
            <div class="p-6 border rounded-lg bg-background">
                <SelectInput TValue="string"
                           @bind-Value="_presetValue"
                           Options="_statusOptions"
                           Placeholder="Select status..." />
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_presetValue</p>
            </div>
        </section>

        <!-- Numeric Values -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Numeric Values</h2>
            <div class="p-6 border rounded-lg bg-background">
                <SelectInput TValue="int"
                           @bind-Value="_numericValue"
                           Options="_quantityOptions"
                           Placeholder="Select quantity..." />
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_numericValue</p>
            </div>
        </section>

        <!-- With Many Options -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Many Options</h2>
            <div class="p-6 border rounded-lg bg-background">
                <SelectInput TValue="string"
                           @bind-Value="_countryValue"
                           Options="_countryOptions"
                           Placeholder="Select a country..." />
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_countryValue</p>
            </div>
        </section>

        <!-- With Custom Styling -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Custom Styling</h2>
            <div class="p-6 border rounded-lg bg-background">
                <SelectInput TValue="string"
                           @bind-Value="_themeValue"
                           Options="_themeOptions"
                           Placeholder="Select theme..."
                           Class="w-full max-w-md" />
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_themeValue</p>
            </div>
        </section>

        <!-- Multiple Select Inputs -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Form Layout</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl">
                    <div>
                        <label class="block text-sm font-medium mb-2">Category</label>
                        <SelectInput TValue="string"
                                   @bind-Value="_categoryValue"
                                   Options="_categoryOptions"
                                   Placeholder="Select category..." />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Priority</label>
                        <SelectInput TValue="string"
                                   @bind-Value="_priorityValue"
                                   Options="_priorityOptions"
                                   Placeholder="Select priority..." />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Assignee</label>
                        <SelectInput TValue="string"
                                   @bind-Value="_assigneeValue"
                                   Options="_assigneeOptions"
                                   Placeholder="Select assignee..." />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Due Date</label>
                        <SelectInput TValue="string"
                                   @bind-Value="_dueDateValue"
                                   Options="_dueDateOptions"
                                   Placeholder="Select due date..." />
                    </div>
                </div>
                <div class="mt-6 p-4 bg-muted rounded-md">
                    <p class="text-sm font-medium">Form Values:</p>
                    <p class="text-sm text-muted-foreground mt-1">
                        Category: @_categoryValue | Priority: @_priorityValue | Assignee: @_assigneeValue | Due: @_dueDateValue
                    </p>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private string? _basicValue;
    private string? _presetValue = "active";
    private int _numericValue = 1;
    private string? _countryValue;
    private string? _themeValue;
    private string? _categoryValue;
    private string? _priorityValue;
    private string? _assigneeValue;
    private string? _dueDateValue;

    private readonly List<SelectOption<string>> _basicOptions = new()
    {
        new("option1", "Option 1"),
        new("option2", "Option 2"),
        new("option3", "Option 3"),
    };

    private readonly List<SelectOption<string>> _statusOptions = new()
    {
        new("active", "Active"),
        new("inactive", "Inactive"),
        new("pending", "Pending"),
        new("archived", "Archived"),
    };

    private readonly List<SelectOption<int>> _quantityOptions = new()
    {
        new(1, "1 item"),
        new(2, "2 items"),
        new(5, "5 items"),
        new(10, "10 items"),
        new(25, "25 items"),
        new(50, "50 items"),
        new(100, "100 items"),
    };

    private readonly List<SelectOption<string>> _countryOptions = new()
    {
        new("us", "United States"),
        new("uk", "United Kingdom"),
        new("ca", "Canada"),
        new("au", "Australia"),
        new("de", "Germany"),
        new("fr", "France"),
        new("jp", "Japan"),
        new("in", "India"),
        new("br", "Brazil"),
        new("mx", "Mexico"),
    };

    private readonly List<SelectOption<string>> _themeOptions = new()
    {
        new("light", "Light Theme"),
        new("dark", "Dark Theme"),
        new("system", "System Theme"),
        new("high-contrast", "High Contrast"),
    };

    private readonly List<SelectOption<string>> _categoryOptions = new()
    {
        new("bug", "Bug Report"),
        new("feature", "Feature Request"),
        new("improvement", "Improvement"),
        new("documentation", "Documentation"),
    };

    private readonly List<SelectOption<string>> _priorityOptions = new()
    {
        new("low", "Low"),
        new("medium", "Medium"),
        new("high", "High"),
        new("critical", "Critical"),
    };

    private readonly List<SelectOption<string>> _assigneeOptions = new()
    {
        new("john", "John Doe"),
        new("jane", "Jane Smith"),
        new("bob", "Bob Johnson"),
        new("alice", "Alice Williams"),
        new("unassigned", "Unassigned"),
    };

    private readonly List<SelectOption<string>> _dueDateOptions = new()
    {
        new("today", "Today"),
        new("tomorrow", "Tomorrow"),
        new("week", "This Week"),
        new("month", "This Month"),
        new("quarter", "This Quarter"),
    };
}
