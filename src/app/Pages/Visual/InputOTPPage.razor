@page "/visual/input-otp"
@using LowlandTech.Components.InputOTP
@using LowlandTech.Components.Label

<PageTitle>InputOTP - Visual Test</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">InputOTP</h1>
    
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Default (6 digits)</h2>
        <div class="p-6 border rounded-lg bg-card">
            <InputOTP Length="6" />
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Different Lengths</h2>
        <div class="space-y-6 p-6 border rounded-lg bg-card">
            <div>
                <Label class="mb-2 block">4 digits</Label>
                <InputOTP Length="4" />
            </div>
            <div>
                <Label class="mb-2 block">6 digits</Label>
                <InputOTP Length="6" />
            </div>
            <div>
                <Label class="mb-2 block">8 digits</Label>
                <InputOTP Length="8" />
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Disabled State</h2>
        <div class="p-6 border rounded-lg bg-card">
            <InputOTP Length="6" Disabled="true" />
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Prefilled Value</h2>
        <div class="p-6 border rounded-lg bg-card">
            <InputOTP Length="6" Value="123456" />
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">In Context</h2>
        <div class="p-6 border rounded-lg bg-card max-w-sm mx-auto text-center">
            <h3 class="text-lg font-semibold mb-2">Verification Code</h3>
            <p class="text-sm text-muted-foreground mb-4">Enter the 6-digit code sent to your phone</p>
            <InputOTP Length="6" class="justify-center" />
        </div>
    </section>
</div>
