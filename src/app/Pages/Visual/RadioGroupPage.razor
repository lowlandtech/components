@page "/visual/radio-group"
@using LowlandTech.Components.RadioGroup

<PageTitle>Radio Group - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Radio Group</h1>

    <div class="space-y-12">
        <!-- Basic Radio Group -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Radio Group</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="basic" @bind-Value="_basicValue">
                    <RadioGroupItem Value="option1">Option 1</RadioGroupItem>
                    <RadioGroupItem Value="option2">Option 2</RadioGroupItem>
                    <RadioGroupItem Value="option3">Option 3</RadioGroupItem>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_basicValue</p>
            </div>
        </section>

        <!-- Horizontal Radio Group -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Horizontal Orientation</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="horizontal" Orientation="horizontal" @bind-Value="_horizontalValue">
                    <RadioGroupItem Value="yes">Yes</RadioGroupItem>
                    <RadioGroupItem Value="no">No</RadioGroupItem>
                    <RadioGroupItem Value="maybe">Maybe</RadioGroupItem>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_horizontalValue</p>
            </div>
        </section>

        <!-- With Pre-selected Value -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Pre-selected Value</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="preset" @bind-Value="_presetValue">
                    <RadioGroupItem Value="small">Small</RadioGroupItem>
                    <RadioGroupItem Value="medium">Medium</RadioGroupItem>
                    <RadioGroupItem Value="large">Large</RadioGroupItem>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_presetValue</p>
            </div>
        </section>

        <!-- Disabled State -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Disabled Group</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="disabled" Disabled="true" @bind-Value="_disabledValue">
                    <RadioGroupItem Value="a">Option A</RadioGroupItem>
                    <RadioGroupItem Value="b">Option B</RadioGroupItem>
                    <RadioGroupItem Value="c">Option C</RadioGroupItem>
                </RadioGroup>
            </div>
        </section>

        <!-- Individual Disabled Item -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Individual Disabled Item</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="item-disabled" @bind-Value="_itemDisabledValue">
                    <RadioGroupItem Value="enabled1">Enabled Option 1</RadioGroupItem>
                    <RadioGroupItem Value="disabled" Disabled="true">Disabled Option</RadioGroupItem>
                    <RadioGroupItem Value="enabled2">Enabled Option 2</RadioGroupItem>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_itemDisabledValue</p>
            </div>
        </section>

        <!-- Required Radio Group -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Required Field</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="required" Required="true" @bind-Value="_requiredValue">
                    <RadioGroupItem Value="red">Red</RadioGroupItem>
                    <RadioGroupItem Value="green">Green</RadioGroupItem>
                    <RadioGroupItem Value="blue">Blue</RadioGroupItem>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_requiredValue</p>
            </div>
        </section>

        <!-- Choice Card - Pricing Plans -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Choice Card - Pricing Plans</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="pricing" @bind-Value="_pricingValue">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <RadioGroupItem Value="basic" Variant="choice-card">
                            <RadioGroupItemTitle>Basic Plan</RadioGroupItemTitle>
                            <RadioGroupItemDescription>$10/month - Essential features for individuals</RadioGroupItemDescription>
                        </RadioGroupItem>
                        <RadioGroupItem Value="pro" Variant="choice-card">
                            <RadioGroupItemTitle>Pro Plan</RadioGroupItemTitle>
                            <RadioGroupItemDescription>$29/month - Advanced features for professionals</RadioGroupItemDescription>
                        </RadioGroupItem>
                        <RadioGroupItem Value="enterprise" Variant="choice-card">
                            <RadioGroupItemTitle>Enterprise</RadioGroupItemTitle>
                            <RadioGroupItemDescription>$99/month - Full suite for large teams</RadioGroupItemDescription>
                        </RadioGroupItem>
                    </div>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected Plan: @_pricingValue</p>
            </div>
        </section>

        <!-- Choice Card - Single Selection Cards -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Choice Card - Deployment Options</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="deployment" @bind-Value="_deploymentValue">
                    <div class="space-y-3 max-w-md">
                        <RadioGroupItem Value="cloud" Variant="choice-card">
                            <RadioGroupItemTitle>Cloud Hosted</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Fully managed solution with automatic updates</RadioGroupItemDescription>
                        </RadioGroupItem>
                        <RadioGroupItem Value="onpremise" Variant="choice-card">
                            <RadioGroupItemTitle>On-Premise</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Self-hosted on your own infrastructure</RadioGroupItemDescription>
                        </RadioGroupItem>
                        <RadioGroupItem Value="hybrid" Variant="choice-card">
                            <RadioGroupItemTitle>Hybrid</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Mix of cloud and on-premise resources</RadioGroupItemDescription>
                        </RadioGroupItem>
                    </div>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_deploymentValue</p>
            </div>
        </section>

        <!-- Choice Card - With Pre-selected Value -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Choice Card - Pre-selected</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="preset-card" @bind-Value="_presetCardValue">
                    <div class="grid grid-cols-2 gap-4 max-w-lg">
                        <RadioGroupItem Value="monthly" Variant="choice-card">
                            <RadioGroupItemTitle>Monthly Billing</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Pay as you go, cancel anytime</RadioGroupItemDescription>
                        </RadioGroupItem>
                        <RadioGroupItem Value="yearly" Variant="choice-card">
                            <RadioGroupItemTitle>Yearly Billing</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Save 20% with annual commitment</RadioGroupItemDescription>
                        </RadioGroupItem>
                    </div>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_presetCardValue</p>
            </div>
        </section>

        <!-- Choice Card - Disabled Item -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Choice Card - Disabled Option</h2>
            <div class="p-6 border rounded-lg bg-background">
                <RadioGroup Name="disabled-card" @bind-Value="_disabledCardValue">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <RadioGroupItem Value="starter" Variant="choice-card">
                            <RadioGroupItemTitle>Starter</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Free tier available</RadioGroupItemDescription>
                        </RadioGroupItem>
                        <RadioGroupItem Value="popular" Variant="choice-card" Disabled="true">
                            <RadioGroupItemTitle>Most Popular</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Currently unavailable</RadioGroupItemDescription>
                        </RadioGroupItem>
                        <RadioGroupItem Value="premium" Variant="choice-card">
                            <RadioGroupItemTitle>Premium</RadioGroupItemTitle>
                            <RadioGroupItemDescription>Best value for teams</RadioGroupItemDescription>
                        </RadioGroupItem>
                    </div>
                </RadioGroup>
                <p class="mt-4 text-sm text-muted-foreground">Selected: @_disabledCardValue</p>
            </div>
        </section>
    </div>
</div>

@code {
    private string? _basicValue;
    private string? _horizontalValue;
    private string? _presetValue = "medium";
    private string? _disabledValue = "a";
    private string? _itemDisabledValue;
    private string? _requiredValue;
    private string? _pricingValue;
    private string? _deploymentValue;
    private string? _presetCardValue = "yearly";
    private string? _disabledCardValue;
}
