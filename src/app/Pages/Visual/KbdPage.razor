@page "/visual/kbd"
@using LowlandTech.Components.Kbd

<PageTitle>Kbd - Visual Test</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Kbd</h1>
    
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Keys</h2>
        <div class="flex flex-wrap gap-2 p-6 border rounded-lg bg-card">
            <Kbd>Ctrl</Kbd>
            <Kbd>Alt</Kbd>
            <Kbd>Shift</Kbd>
            <Kbd>Tab</Kbd>
            <Kbd>Enter</Kbd>
            <Kbd>Esc</Kbd>
            <Kbd>Space</Kbd>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Letter Keys</h2>
        <div class="flex flex-wrap gap-2 p-6 border rounded-lg bg-card">
            <Kbd>A</Kbd>
            <Kbd>B</Kbd>
            <Kbd>C</Kbd>
            <Kbd>X</Kbd>
            <Kbd>Y</Kbd>
            <Kbd>Z</Kbd>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Sizes</h2>
        <div class="flex flex-wrap gap-4 items-center p-6 border rounded-lg bg-card">
            <Kbd Size="sm">Small</Kbd>
            <Kbd Size="md">Medium</Kbd>
            <Kbd Size="lg">Large</Kbd>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">KbdGroup (Keyboard Shortcuts)</h2>
        <div class="flex flex-wrap gap-4 p-6 border rounded-lg bg-card">
            <KbdGroup>
                <Kbd>Ctrl</Kbd>
                <Kbd>C</Kbd>
            </KbdGroup>
            <KbdGroup>
                <Kbd>Ctrl</Kbd>
                <Kbd>V</Kbd>
            </KbdGroup>
            <KbdGroup>
                <Kbd>Ctrl</Kbd>
                <Kbd>Shift</Kbd>
                <Kbd>Z</Kbd>
            </KbdGroup>
            <KbdGroup>
                <Kbd>Alt</Kbd>
                <Kbd>F4</Kbd>
            </KbdGroup>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Function Keys</h2>
        <div class="flex flex-wrap gap-2 p-6 border rounded-lg bg-card">
            <Kbd>F1</Kbd>
            <Kbd>F2</Kbd>
            <Kbd>F3</Kbd>
            <Kbd>F4</Kbd>
            <Kbd>F5</Kbd>
            <Kbd>F6</Kbd>
            <Kbd>F7</Kbd>
            <Kbd>F8</Kbd>
            <Kbd>F9</Kbd>
            <Kbd>F10</Kbd>
            <Kbd>F11</Kbd>
            <Kbd>F12</Kbd>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Arrow Keys</h2>
        <div class="flex flex-wrap gap-2 p-6 border rounded-lg bg-card">
            <Kbd>↑</Kbd>
            <Kbd>↓</Kbd>
            <Kbd>←</Kbd>
            <Kbd>→</Kbd>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">In Context</h2>
        <div class="p-6 border rounded-lg bg-card">
            <p class="text-sm text-muted-foreground mb-2">Press <Kbd>Ctrl</Kbd> + <Kbd>S</Kbd> to save</p>
            <p class="text-sm text-muted-foreground">Press <Kbd>Esc</Kbd> to cancel</p>
        </div>
    </section>
</div>
