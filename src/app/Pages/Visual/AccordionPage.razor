@page "/visual/accordion"
@using LowlandTech.Components.Accordion

<PageTitle>Accordion - Visual Test</PageTitle>

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold">Accordion</h1>
        <p class="text-muted-foreground">A vertically stacked set of interactive headings that each reveal a section of content.</p>
    </div>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Single (Default)</h2>
        <p class="text-sm text-muted-foreground">Only one item can be open at a time.</p>
        <Accordion Type="single" class="w-full max-w-md">
            <AccordionItem Value="item-1">
                <AccordionHeader>
                    <AccordionTrigger>Is it accessible?</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    Yes. It adheres to the WAI-ARIA design pattern.
                </AccordionContent>
            </AccordionItem>
            <AccordionItem Value="item-2">
                <AccordionHeader>
                    <AccordionTrigger>Is it styled?</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    Yes. It comes with default styles that matches the other components.
                </AccordionContent>
            </AccordionItem>
            <AccordionItem Value="item-3">
                <AccordionHeader>
                    <AccordionTrigger>Is it animated?</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    Yes. It's animated by default, but you can disable it if you prefer.
                </AccordionContent>
            </AccordionItem>
        </Accordion>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Multiple</h2>
        <p class="text-sm text-muted-foreground">Multiple items can be open at the same time.</p>
        <Accordion Type="multiple" class="w-full max-w-md">
            <AccordionItem Value="item-1">
                <AccordionHeader>
                    <AccordionTrigger>First Item</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    This is the first item's content. You can have multiple items open.
                </AccordionContent>
            </AccordionItem>
            <AccordionItem Value="item-2">
                <AccordionHeader>
                    <AccordionTrigger>Second Item</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    This is the second item's content. Try opening another item while this is open.
                </AccordionContent>
            </AccordionItem>
            <AccordionItem Value="item-3">
                <AccordionHeader>
                    <AccordionTrigger>Third Item</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    This is the third item's content. All items can be open simultaneously.
                </AccordionContent>
            </AccordionItem>
        </Accordion>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Disabled Item</h2>
        <p class="text-sm text-muted-foreground">Items can be disabled to prevent interaction.</p>
        <Accordion Type="single" class="w-full max-w-md">
            <AccordionItem Value="item-1">
                <AccordionHeader>
                    <AccordionTrigger>Enabled Item</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    This item is enabled and can be interacted with.
                </AccordionContent>
            </AccordionItem>
            <AccordionItem Value="item-2" Disabled="true">
                <AccordionHeader>
                    <AccordionTrigger>Disabled Item</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    This item is disabled and cannot be interacted with.
                </AccordionContent>
            </AccordionItem>
            <AccordionItem Value="item-3">
                <AccordionHeader>
                    <AccordionTrigger>Another Enabled Item</AccordionTrigger>
                </AccordionHeader>
                <AccordionContent>
                    This item is also enabled and can be interacted with.
                </AccordionContent>
            </AccordionItem>
        </Accordion>
    </section>

    <!-- RTL Section -->
    <section class="space-y-4">
        <h2 class="text-lg font-semibold">RTL (Right-to-Left) Support</h2>
        <p class="text-sm text-muted-foreground">Arabic/Hebrew language support with proper text alignment and chevron positioning.</p>
        <Direction dir="rtl">
            <div class="grid md:grid-cols-2 gap-8">
                <div>
                    <h3 class="text-sm font-medium mb-2">فردي (Single)</h3>
                    <Accordion Type="single" class="w-full max-w-md">
                        <AccordionItem Value="item-1">
                            <AccordionHeader>
                                <AccordionTrigger>هل هو متاح؟</AccordionTrigger>
                            </AccordionHeader>
                            <AccordionContent>
                                نعم. إنه يتبع نمط تصميم WAI-ARIA.
                            </AccordionContent>
                        </AccordionItem>
                        <AccordionItem Value="item-2">
                            <AccordionHeader>
                                <AccordionTrigger>هل هو منسق؟</AccordionTrigger>
                            </AccordionHeader>
                            <AccordionContent>
                                نعم. يأتي مع أنماط افتراضية تتطابق مع المكونات الأخرى.
                            </AccordionContent>
                        </AccordionItem>
                        <AccordionItem Value="item-3">
                            <AccordionHeader>
                                <AccordionTrigger>هل هو متحرك؟</AccordionTrigger>
                            </AccordionHeader>
                            <AccordionContent>
                                نعم. إنه متحرك افتراضياً، لكن يمكنك تعطيله إذا أردت.
                            </AccordionContent>
                        </AccordionItem>
                    </Accordion>
                </div>

                <div>
                    <h3 class="text-sm font-medium mb-2">متعدد (Multiple)</h3>
                    <Accordion Type="multiple" class="w-full max-w-md">
                        <AccordionItem Value="item-1">
                            <AccordionHeader>
                                <AccordionTrigger>البند الأول</AccordionTrigger>
                            </AccordionHeader>
                            <AccordionContent>
                                هذا هو محتوى البند الأول. يمكنك فتح عناصر متعددة في نفس الوقت.
                            </AccordionContent>
                        </AccordionItem>
                        <AccordionItem Value="item-2">
                            <AccordionHeader>
                                <AccordionTrigger>البند الثاني</AccordionTrigger>
                            </AccordionHeader>
                            <AccordionContent>
                                هذا هو محتوى البند الثاني. جرب فتح بند آخر أثناء فتح هذا.
                            </AccordionContent>
                        </AccordionItem>
                        <AccordionItem Value="item-3">
                            <AccordionHeader>
                                <AccordionTrigger>البند الثالث</AccordionTrigger>
                            </AccordionHeader>
                            <AccordionContent>
                                هذا هو محتوى البند الثالث. يمكن فتح جميع العناصر في نفس الوقت.
                            </AccordionContent>
                        </AccordionItem>
                    </Accordion>
                </div>
            </div>
        </Direction>
    </section>
</div>
