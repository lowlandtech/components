@page "/visual/field"

<PageTitle>Field - Visual Test</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Field</h1>
    
    <div class="space-y-12">
        <!-- Default Vertical Field -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Default (Vertical)</h2>
            <div class="p-6 border rounded-lg max-w-md">
                <Field>
                    <FieldLabel>Email</FieldLabel>
                    <Input Type="email" Placeholder="Enter your email" />
                    <FieldDescription>We'll never share your email with anyone else.</FieldDescription>
                </Field>
            </div>
        </section>

        <!-- With Error -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Error</h2>
            <div class="p-6 border rounded-lg max-w-md">
                <Field>
                    <FieldLabel>Username</FieldLabel>
                    <Input Value="" Placeholder="Enter username" Class="border-destructive" />
                    <FieldError>Username is required</FieldError>
                </Field>
            </div>
        </section>

        <!-- Horizontal Layout -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Horizontal Layout</h2>
            <div class="p-6 border rounded-lg max-w-lg">
                <Field Orientation="horizontal">
                    <FieldLabel>Email Notifications</FieldLabel>
                    <Switch />
                </Field>
            </div>
        </section>

        <!-- Field Group -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Field Group</h2>
            <div class="p-6 border rounded-lg max-w-md">
                <FieldGroup>
                    <Field>
                        <FieldLabel>First Name</FieldLabel>
                        <Input Placeholder="John" />
                    </Field>
                    <Field>
                        <FieldLabel>Last Name</FieldLabel>
                        <Input Placeholder="Doe" />
                    </Field>
                </FieldGroup>
            </div>
        </section>

        <!-- Field Set -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Field Set</h2>
            <div class="p-6 border rounded-lg max-w-md">
                <FieldSet>
                    <FieldLegend>Shipping Address</FieldLegend>
                    <FieldGroup>
                        <Field>
                            <FieldLabel>Street Address</FieldLabel>
                            <Input Placeholder="123 Main St" />
                        </Field>
                        <Field>
                            <FieldLabel>City</FieldLabel>
                            <Input Placeholder="New York" />
                        </Field>
                        <Field>
                            <FieldLabel>Postal Code</FieldLabel>
                            <Input Placeholder="10001" />
                        </Field>
                    </FieldGroup>
                </FieldSet>
            </div>
        </section>

        <!-- Checkbox Field -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Checkbox Field</h2>
            <div class="p-6 border rounded-lg max-w-md space-y-4">
                <Field class="flex-row items-center gap-3">
                    <Checkbox />
                    <FieldContent>
                        <FieldLabel>Marketing Emails</FieldLabel>
                        <FieldDescription>Receive emails about new products and features.</FieldDescription>
                    </FieldContent>
                </Field>
                <Field class="flex-row items-center gap-3">
                    <Checkbox />
                    <FieldContent>
                        <FieldLabel>Security Alerts</FieldLabel>
                        <FieldDescription>Get notified about security updates.</FieldDescription>
                    </FieldContent>
                </Field>
            </div>
        </section>

        <!-- Complete Form Example -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Complete Form Example</h2>
            <div class="p-6 border rounded-lg max-w-md">
                <form class="space-y-6">
                    <FieldSet>
                        <FieldLegend Variant="legend">Personal Information</FieldLegend>
                        <FieldGroup>
                            <Field>
                                <FieldLabel>Full Name</FieldLabel>
                                <Input Placeholder="John Doe" />
                                <FieldDescription>Enter your full legal name.</FieldDescription>
                            </Field>
                            <Field>
                                <FieldLabel>Email Address</FieldLabel>
                                <Input Type="email" Placeholder="john@example.com" />
                            </Field>
                            <Field>
                                <FieldLabel>Phone Number</FieldLabel>
                                <Input Type="tel" Placeholder="+1 (555) 000-0000" />
                            </Field>
                        </FieldGroup>
                    </FieldSet>

                    <FieldSet>
                        <FieldLegend>Preferences</FieldLegend>
                        <div class="space-y-4">
                            <Field class="flex-row items-center gap-3">
                                <Checkbox />
                                <FieldLabel>Subscribe to newsletter</FieldLabel>
                            </Field>
                            <Field Orientation="horizontal">
                                <FieldLabel>Dark Mode</FieldLabel>
                                <Switch />
                            </Field>
                        </div>
                    </FieldSet>

                    <Field>
                        <FieldLabel>Bio</FieldLabel>
                        <Textarea Placeholder="Tell us about yourself..." Rows="4" />
                        <FieldDescription>Maximum 500 characters.</FieldDescription>
                    </Field>

                    <div class="flex gap-2">
                        <Button Variant="outline" class="flex-1">Cancel</Button>
                        <Button class="flex-1">Submit</Button>
                    </div>
                </form>
            </div>
        </section>

        <!-- With Field Content -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Field Content</h2>
            <div class="p-6 border rounded-lg max-w-md">
                <Field>
                    <FieldLabel>Website</FieldLabel>
                    <FieldContent>
                        <InputGroup>
                            <InputGroupAddon>https://</InputGroupAddon>
                            <Input Placeholder="example.com" />
                        </InputGroup>
                    </FieldContent>
                    <FieldDescription>Your personal or business website.</FieldDescription>
                </Field>
            </div>
        </section>

        <!-- Responsive Layout -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Responsive Layout</h2>
            <div class="p-6 border rounded-lg max-w-lg">
                <Field Orientation="responsive">
                    <FieldLabel>Enable Notifications</FieldLabel>
                    <div class="flex items-center gap-3">
                        <Switch />
                        <span class="text-sm text-muted-foreground">On</span>
                    </div>
                </Field>
            </div>
        </section>
    </div>
</div>
