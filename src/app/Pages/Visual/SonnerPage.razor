@page "/visual/sonner"
@using LowlandTech.Components.Sonner
@using LowlandTech.Components.Button
@inject ISonnerService SonnerService

<PageTitle>Sonner (Toast) - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Sonner (Toast Notifications)</h1>

    <Sonner Position="@_currentPosition" />

    <div class="space-y-12">
        <!-- Position Controls -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Position</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="grid grid-cols-3 gap-2 max-w-md">
                    <Button Variant="@GetPositionVariant("top-left")" Size="sm" @onclick="SetPositionTopLeft">
                        Top Left
                    </Button>
                    <Button Variant="@GetPositionVariant("top-center")" Size="sm" @onclick="SetPositionTopCenter">
                        Top Center
                    </Button>
                    <Button Variant="@GetPositionVariant("top-right")" Size="sm" @onclick="SetPositionTopRight">
                        Top Right
                    </Button>
                    <Button Variant="@GetPositionVariant("bottom-left")" Size="sm" @onclick="SetPositionBottomLeft">
                        Bottom Left
                    </Button>
                    <Button Variant="@GetPositionVariant("bottom-center")" Size="sm" @onclick="SetPositionBottomCenter">
                        Bottom Center
                    </Button>
                    <Button Variant="@GetPositionVariant("bottom-right")" Size="sm" @onclick="SetPositionBottomRight">
                        Bottom Right
                    </Button>
                </div>
                <p class="mt-4 text-sm text-muted-foreground">Current position: <code>@_currentPosition</code></p>
            </div>
        </section>

        <!-- Basic Toast -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Toast</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Button @onclick="ShowBasicToast">
                    Show Toast
                </Button>
            </div>
        </section>

        <!-- Toast Types with Icons -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Toast Types with Icons</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex flex-wrap gap-4">
                    <Button Variant="outline" @onclick="ShowDefaultToast">
                        Default
                    </Button>
                    <Button Variant="outline" Class="border-green-500 text-green-600 hover:bg-green-50" @onclick="ShowSuccessToast">
                        Success
                    </Button>
                    <Button Variant="outline" Class="border-blue-500 text-blue-600 hover:bg-blue-50" @onclick="ShowInfoToast">
                        Info
                    </Button>
                    <Button Variant="outline" Class="border-yellow-500 text-yellow-600 hover:bg-yellow-50" @onclick="ShowWarningToast">
                        Warning
                    </Button>
                    <Button Variant="outline" Class="border-red-500 text-red-600 hover:bg-red-50" @onclick="ShowErrorToast">
                        Error
                    </Button>
                </div>
            </div>
        </section>

        <!-- Toast with Description -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Toast with Description</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex flex-wrap gap-4">
                    <Button @onclick="ShowSuccessWithDescription">
                        Success with Description
                    </Button>
                    <Button Variant="outline" @onclick="ShowInfoWithDescription">
                        Info with Description
                    </Button>
                    <Button Variant="destructive" @onclick="ShowErrorWithDescription">
                        Error with Description
                    </Button>
                </div>
            </div>
        </section>

        <!-- Promise Toast -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Promise Toast</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex flex-wrap gap-4">
                    <Button @onclick="ShowPromiseSuccess">
                        Promise (Success)
                    </Button>
                    <Button Variant="outline" @onclick="ShowPromiseError">
                        Promise (Error)
                    </Button>
                    <Button Variant="secondary" @onclick="ShowPromiseWithDescription">
                        Promise with Description
                    </Button>
                </div>
                <p class="mt-4 text-sm text-muted-foreground">Promise toasts show a loading state, then transition to success or error based on the operation result.</p>
            </div>
        </section>

        <!-- Duration Control -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Duration Control</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex flex-wrap gap-4">
                    <Button Variant="outline" @onclick="ShowQuickToast">
                        2 Second Duration
                    </Button>
                    <Button Variant="outline" @onclick="ShowStandardToast">
                        4 Second Duration
                    </Button>
                    <Button Variant="outline" @onclick="ShowLongToast">
                        8 Second Duration
                    </Button>
                </div>
                <p class="mt-4 text-sm text-muted-foreground">Watch the progress bar at the bottom of each toast indicating remaining time.</p>
            </div>
        </section>

        <!-- Multiple Toasts -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Multiple Toasts</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Button @onclick="ShowMultipleToasts">
                    Show Multiple Toasts
                </Button>
                <p class="mt-4 text-sm text-muted-foreground">Click to show a series of toasts with different types.</p>
            </div>
        </section>

        <!-- Quick Actions -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Common Actions</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                    <Button Variant="outline" @onclick="ShowSaveFileToast">
                        Save File
                    </Button>
                    <Button Variant="outline" @onclick="ShowDiscardToast">
                        Discard Changes
                    </Button>
                    <Button Variant="outline" @onclick="ShowCopyToast">
                        Copy
                    </Button>
                    <Button Variant="outline" @onclick="ShowEmailToast">
                        Send Email
                    </Button>
                    <Button Variant="outline" @onclick="ShowDownloadToast">
                        Download
                    </Button>
                    <Button Variant="outline" @onclick="ShowUploadToast">
                        Upload
                    </Button>
                </div>
            </div>
        </section>

        <!-- Rapid Fire -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Rapid Fire Test</h2>
            <div class="p-6 border rounded-lg bg-background">
                <Button @onclick="ShowRapidToasts">
                    Rapid Fire Toasts
                </Button>
                <p class="mt-4 text-sm text-muted-foreground">Click to quickly show multiple toasts to test stacking behavior.</p>
            </div>
        </section>

        <!-- Dismiss Controls -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Dismiss Controls</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex flex-wrap gap-4">
                    <Button Variant="outline" @onclick="ShowSeveralToasts">
                        Show Several Toasts
                    </Button>
                    <Button Variant="destructive" @onclick="DismissAllToasts">
                        Dismiss All
                    </Button>
                </div>
                <p class="mt-4 text-sm text-muted-foreground">Individual toasts can be dismissed using the X button. Use "Dismiss All" to clear all at once.</p>
            </div>
        </section>
    </div>
</div>

@code {
    private string _currentPosition = "bottom-right";

    private void SetPosition(string position) => _currentPosition = position;
    private void SetPositionTopLeft() => SetPosition("top-left");
    private void SetPositionTopCenter() => SetPosition("top-center");
    private void SetPositionTopRight() => SetPosition("top-right");
    private void SetPositionBottomLeft() => SetPosition("bottom-left");
    private void SetPositionBottomCenter() => SetPosition("bottom-center");
    private void SetPositionBottomRight() => SetPosition("bottom-right");

    private string GetPositionVariant(string position) => _currentPosition == position ? "default" : "outline";

    private void ShowBasicToast() => SonnerService.Show("Hello! This is a toast message.", ToastType.Default);
    private void ShowDefaultToast() => SonnerService.Show("This is a default toast.", ToastType.Default);
    private void ShowSuccessToast() => SonnerService.Show("Operation completed successfully!", ToastType.Success);
    private void ShowInfoToast() => SonnerService.Show("Here is some information.", ToastType.Info);
    private void ShowWarningToast() => SonnerService.Show("Please review this warning.", ToastType.Warning);
    private void ShowErrorToast() => SonnerService.Show("An error occurred!", ToastType.Error);

    private void ShowSuccessWithDescription() => SonnerService.Show("File saved", ToastType.Success, description: "Your changes have been persisted to the server.");
    private void ShowInfoWithDescription() => SonnerService.Show("Update available", ToastType.Info, description: "A new version of the application is ready to install.");
    private void ShowErrorWithDescription() => SonnerService.Show("Connection failed", ToastType.Error, description: "Unable to connect to the server. Please check your network settings.");

    private void ShowQuickToast() => SonnerService.Show("Quick toast (2s)", ToastType.Info, duration: 2000);
    private void ShowStandardToast() => SonnerService.Show("Standard toast (4s)", ToastType.Info, duration: 4000);
    private void ShowLongToast() => SonnerService.Show("Long toast (8s)", ToastType.Info, duration: 8000);

    private void ShowSaveFileToast() => SonnerService.Show("File saved successfully!", ToastType.Success);
    private void ShowDiscardToast() => SonnerService.Show("Changes discarded.", ToastType.Info);
    private void ShowCopyToast() => SonnerService.Show("Item copied to clipboard.", ToastType.Success);
    private void ShowEmailToast() => SonnerService.Show("Sending email...", ToastType.Info);
    private void ShowDownloadToast() => SonnerService.Show("Downloading file...", ToastType.Default);
    private void ShowUploadToast() => SonnerService.Show("Upload complete!", ToastType.Success);

    private void ShowPromiseSuccess()
    {
        SonnerService.Promise("Saving file...", async () =>
        {
            await Task.Delay(2000);
        });
    }

    private void ShowPromiseError()
    {
        SonnerService.Promise("Uploading file...", async () =>
        {
            await Task.Delay(1500);
            throw new Exception("Upload failed");
        });
    }

    private void ShowPromiseWithDescription()
    {
        SonnerService.Promise("Processing payment...", async () =>
        {
            await Task.Delay(2500);
        }, description: "Please wait while we process your transaction securely.");
    }

    private async Task ShowMultipleToasts()
    {
        SonnerService.Show("Starting process...", ToastType.Info);
        await Task.Delay(500);
        SonnerService.Show("Step 1 completed", ToastType.Default);
        await Task.Delay(500);
        SonnerService.Show("Warning: Review required", ToastType.Warning);
        await Task.Delay(500);
        SonnerService.Show("All done!", ToastType.Success);
    }

    private async Task ShowRapidToasts()
    {
        var messages = new[] { "Notification 1", "Notification 2", "Notification 3", "Notification 4", "Notification 5" };
        foreach (var message in messages)
        {
            SonnerService.Show(message, ToastType.Default);
            await Task.Delay(200);
        }
    }

    private void ShowSeveralToasts()
    {
        SonnerService.Show("First notification", ToastType.Info);
        SonnerService.Show("Second notification", ToastType.Success);
        SonnerService.Show("Third notification", ToastType.Warning);
        SonnerService.Show("Fourth notification", ToastType.Error);
        SonnerService.Show("Fifth notification", ToastType.Default);
    }

    private void DismissAllToasts() => SonnerService.DismissAll();
}
