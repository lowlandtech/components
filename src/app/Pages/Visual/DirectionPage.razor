@page "/visual/direction"

<PageTitle>Direction - Visual Test</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Direction</h1>
    
    <div class="space-y-12">
        <!-- Default (LTR) -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Default (LTR)</h2>
            <div class="p-6 border rounded-lg">
                <Direction>
                    <Card class="max-w-md">
                        <CardHeader>
                            <CardTitle>Left-to-Right Layout</CardTitle>
                            <CardDescription>This is the default text direction for most languages.</CardDescription>
                        </CardHeader>
                        <CardContent class="space-y-4">
                            <Field>
                                <FieldLabel>Email Address</FieldLabel>
                                <Input Placeholder="Enter your email" />
                            </Field>
                            <div class="flex items-center gap-2">
                                <Checkbox />
                                <Label>Remember me</Label>
                            </div>
                        </CardContent>
                        <CardFooter class="flex justify-end gap-2">
                            <Button Variant="outline">Cancel</Button>
                            <Button>Submit</Button>
                        </CardFooter>
                    </Card>
                </Direction>
            </div>
        </section>

        <!-- RTL (Right-to-Left) -->
        <section>
            <h2 class="text-xl font-semibold mb-4">RTL (Right-to-Left)</h2>
            <div class="p-6 border rounded-lg">
                <Direction dir="rtl">
                    <Card class="max-w-md">
                        <CardHeader>
                            <CardTitle>تخطيط من اليمين إلى اليسار</CardTitle>
                            <CardDescription>هذا هو اتجاه النص الافتراضي للغات مثل العربية والعبرية.</CardDescription>
                        </CardHeader>
                        <CardContent class="space-y-4">
                            <Field>
                                <FieldLabel>البريد الإلكتروني</FieldLabel>
                                <Input Placeholder="أدخل بريدك الإلكتروني" />
                            </Field>
                            <div class="flex items-center gap-2">
                                <Checkbox />
                                <Label>تذكرني</Label>
                            </div>
                        </CardContent>
                        <CardFooter class="flex justify-end gap-2">
                            <Button Variant="outline">إلغاء</Button>
                            <Button>إرسال</Button>
                        </CardFooter>
                    </Card>
                </Direction>
            </div>
        </section>

        <!-- Mixed Content -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Mixed Content</h2>
            <div class="p-6 border rounded-lg space-y-6">
                <div>
                    <h3 class="text-sm font-medium mb-2">English (LTR)</h3>
                    <Direction>
                        <div class="flex items-center gap-4 p-4 border rounded-lg">
                            <Avatar>
                                <AvatarImage Src="https://github.com/shadcn.png" />
                                <AvatarFallback>JD</AvatarFallback>
                            </Avatar>
                            <div>
                                <p class="font-medium">John Doe</p>
                                <p class="text-sm text-muted-foreground">Software Engineer</p>
                            </div>
                            <Button class="ml-auto">Follow</Button>
                        </div>
                    </Direction>
                </div>

                <div>
                    <h3 class="text-sm font-medium mb-2">Arabic (RTL)</h3>
                    <Direction dir="rtl">
                        <div class="flex items-center gap-4 p-4 border rounded-lg">
                            <Avatar>
                                <AvatarImage Src="https://github.com/shadcn.png" />
                                <AvatarFallback>أح</AvatarFallback>
                            </Avatar>
                            <div>
                                <p class="font-medium">أحمد محمد</p>
                                <p class="text-sm text-muted-foreground">مهندس برمجيات</p>
                            </div>
                            <Button class="mr-auto">متابعة</Button>
                        </div>
                    </Direction>
                </div>
            </div>
        </section>

        <!-- Navigation with Direction -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Navigation with Direction</h2>
            <div class="p-6 border rounded-lg space-y-4">
                <div>
                    <h3 class="text-sm font-medium mb-2">LTR Navigation</h3>
                    <Direction>
                        <nav class="flex items-center gap-4 p-4 bg-muted rounded-lg">
                            <a href="#" class="text-sm font-medium hover:underline">Home</a>
                            <a href="#" class="text-sm font-medium hover:underline">Products</a>
                            <a href="#" class="text-sm font-medium hover:underline">Services</a>
                            <a href="#" class="text-sm font-medium hover:underline">About</a>
                            <Button class="ml-auto" Size="sm">Contact</Button>
                        </nav>
                    </Direction>
                </div>

                <div>
                    <h3 class="text-sm font-medium mb-2">RTL Navigation</h3>
                    <Direction dir="rtl">
                        <nav class="flex items-center gap-4 p-4 bg-muted rounded-lg">
                            <a href="#" class="text-sm font-medium hover:underline">الرئيسية</a>
                            <a href="#" class="text-sm font-medium hover:underline">المنتجات</a>
                            <a href="#" class="text-sm font-medium hover:underline">الخدمات</a>
                            <a href="#" class="text-sm font-medium hover:underline">عن الشركة</a>
                            <Button class="mr-auto" Size="sm">اتصل بنا</Button>
                        </nav>
                    </Direction>
                </div>
            </div>
        </section>

        <!-- Form Comparison -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Form Comparison</h2>
            <div class="p-6 border rounded-lg">
                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-sm font-medium mb-4">English Form (LTR)</h3>
                        <Direction>
                            <div class="space-y-4">
                                <Field>
                                    <FieldLabel>Full Name</FieldLabel>
                                    <Input Placeholder="John Doe" />
                                </Field>
                                <Field>
                                    <FieldLabel>Phone Number</FieldLabel>
                                    <Input Placeholder="+1 (555) 000-0000" />
                                </Field>
                                <Field class="flex-row items-center gap-2">
                                    <Checkbox />
                                    <FieldLabel>I agree to the terms</FieldLabel>
                                </Field>
                            </div>
                        </Direction>
                    </div>

                    <div>
                        <h3 class="text-sm font-medium mb-4">Arabic Form (RTL)</h3>
                        <Direction dir="rtl">
                            <div class="space-y-4">
                                <Field>
                                    <FieldLabel>الاسم الكامل</FieldLabel>
                                    <Input Placeholder="محمد أحمد" />
                                </Field>
                                <Field>
                                    <FieldLabel>رقم الهاتف</FieldLabel>
                                    <Input Placeholder="+966 50 000 0000" />
                                </Field>
                                <Field class="flex-row items-center gap-2">
                                    <Checkbox />
                                    <FieldLabel>أوافق على الشروط</FieldLabel>
                                </Field>
                            </div>
                        </Direction>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
