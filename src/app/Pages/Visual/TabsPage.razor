@page "/visual/tabs"
@using LowlandTech.Components.Tabs

<PageTitle>Tabs - Visual Testing</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Tabs</h1>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Default Tabs</h2>
        <Tabs DefaultValue="account">
            <TabsList>
                <TabsTrigger Value="account">Account</TabsTrigger>
                <TabsTrigger Value="password">Password</TabsTrigger>
                <TabsTrigger Value="settings">Settings</TabsTrigger>
            </TabsList>
            <TabsContent Value="account">
                <div class="p-4 rounded-lg border bg-card">
                    <h3 class="text-lg font-medium mb-2">Account Settings</h3>
                    <p class="text-muted-foreground">Manage your account preferences and personal information here.</p>
                </div>
            </TabsContent>
            <TabsContent Value="password">
                <div class="p-4 rounded-lg border bg-card">
                    <h3 class="text-lg font-medium mb-2">Password Settings</h3>
                    <p class="text-muted-foreground">Update your password and security preferences.</p>
                </div>
            </TabsContent>
            <TabsContent Value="settings">
                <div class="p-4 rounded-lg border bg-card">
                    <h3 class="text-lg font-medium mb-2">General Settings</h3>
                    <p class="text-muted-foreground">Configure application settings and notifications.</p>
                </div>
            </TabsContent>
        </Tabs>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Line Variant</h2>
        <Tabs DefaultValue="overview">
            <TabsList Variant="line">
                <TabsTrigger Value="overview">Overview</TabsTrigger>
                <TabsTrigger Value="analytics">Analytics</TabsTrigger>
                <TabsTrigger Value="reports">Reports</TabsTrigger>
                <TabsTrigger Value="notifications">Notifications</TabsTrigger>
            </TabsList>
            <TabsContent Value="overview">
                <div class="p-4">
                    <p>Overview content goes here.</p>
                </div>
            </TabsContent>
            <TabsContent Value="analytics">
                <div class="p-4">
                    <p>Analytics content goes here.</p>
                </div>
            </TabsContent>
            <TabsContent Value="reports">
                <div class="p-4">
                    <p>Reports content goes here.</p>
                </div>
            </TabsContent>
            <TabsContent Value="notifications">
                <div class="p-4">
                    <p>Notifications content goes here.</p>
                </div>
            </TabsContent>
        </Tabs>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Vertical Tabs</h2>
        <Tabs Orientation="vertical" DefaultValue="general">
            <TabsList>
                <TabsTrigger Value="general">General</TabsTrigger>
                <TabsTrigger Value="security">Security</TabsTrigger>
                <TabsTrigger Value="billing">Billing</TabsTrigger>
            </TabsList>
            <TabsContent Value="general">
                <div class="p-4 rounded-lg border bg-card ml-4">
                    <h3 class="text-lg font-medium mb-2">General Information</h3>
                    <p class="text-muted-foreground">General settings and information about your account.</p>
                </div>
            </TabsContent>
            <TabsContent Value="security">
                <div class="p-4 rounded-lg border bg-card ml-4">
                    <h3 class="text-lg font-medium mb-2">Security Settings</h3>
                    <p class="text-muted-foreground">Configure two-factor authentication and security options.</p>
                </div>
            </TabsContent>
            <TabsContent Value="billing">
                <div class="p-4 rounded-lg border bg-card ml-4">
                    <h3 class="text-lg font-medium mb-2">Billing Information</h3>
                    <p class="text-muted-foreground">Manage your subscription and payment methods.</p>
                </div>
            </TabsContent>
        </Tabs>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Tabs with Disabled State</h2>
        <Tabs DefaultValue="active">
            <TabsList>
                <TabsTrigger Value="active">Active Tab</TabsTrigger>
                <TabsTrigger Value="disabled" Disabled="true">Disabled Tab</TabsTrigger>
                <TabsTrigger Value="another">Another Tab</TabsTrigger>
            </TabsList>
            <TabsContent Value="active">
                <div class="p-4 rounded-lg border bg-card">
                    <p>This is the active tab content.</p>
                </div>
            </TabsContent>
            <TabsContent Value="disabled">
                <div class="p-4 rounded-lg border bg-card">
                    <p>This content is not accessible.</p>
                </div>
            </TabsContent>
            <TabsContent Value="another">
                <div class="p-4 rounded-lg border bg-card">
                    <p>Another tab content.</p>
                </div>
            </TabsContent>
        </Tabs>
    </section>

    <!-- RTL Section -->
    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">RTL (Right-to-Left) Support</h2>
        <p class="text-sm text-muted-foreground mb-4">Arabic/Hebrew language support with proper text alignment and tab ordering.</p>
        <Direction dir="rtl">
            <Tabs DefaultValue="account">
                <TabsList>
                    <TabsTrigger Value="account">الحساب</TabsTrigger>
                    <TabsTrigger Value="password">كلمة المرور</TabsTrigger>
                    <TabsTrigger Value="settings">الإعدادات</TabsTrigger>
                </TabsList>
                <TabsContent Value="account">
                    <div class="p-4 rounded-lg border bg-card">
                        <h3 class="text-lg font-medium mb-2">إعدادات الحساب</h3>
                        <p class="text-muted-foreground">إدارة تفضيلات حسابك والمعلومات الشخصية هنا.</p>
                    </div>
                </TabsContent>
                <TabsContent Value="password">
                    <div class="p-4 rounded-lg border bg-card">
                        <h3 class="text-lg font-medium mb-2">إعدادات كلمة المرور</h3>
                        <p class="text-muted-foreground">تحديث كلمة المرور وتفضيلات الأمان.</p>
                    </div>
                </TabsContent>
                <TabsContent Value="settings">
                    <div class="p-4 rounded-lg border bg-card">
                        <h3 class="text-lg font-medium mb-2">الإعدادات العامة</h3>
                        <p class="text-muted-foreground">تكوين إعدادات التطبيق والإشعارات.</p>
                    </div>
                </TabsContent>
            </Tabs>
        </Direction>

        <h3 class="text-lg font-semibold mt-8 mb-4 text-muted-foreground">RTL Line Variant</h3>
        <Direction dir="rtl">
            <Tabs DefaultValue="overview">
                <TabsList Variant="line">
                    <TabsTrigger Value="overview">نظرة عامة</TabsTrigger>
                    <TabsTrigger Value="analytics">التحليلات</TabsTrigger>
                    <TabsTrigger Value="reports">التقارير</TabsTrigger>
                    <TabsTrigger Value="notifications">الإشعارات</TabsTrigger>
                </TabsList>
                <TabsContent Value="overview">
                    <div class="p-4">
                        <p>محتوى النظرة العامة يظهر هنا.</p>
                    </div>
                </TabsContent>
                <TabsContent Value="analytics">
                    <div class="p-4">
                        <p>محتوى التحليلات يظهر هنا.</p>
                    </div>
                </TabsContent>
                <TabsContent Value="reports">
                    <div class="p-4">
                        <p>محتوى التقارير يظهر هنا.</p>
                    </div>
                </TabsContent>
                <TabsContent Value="notifications">
                    <div class="p-4">
                        <p>محتوى الإشعارات يظهر هنا.</p>
                    </div>
                </TabsContent>
            </Tabs>
        </Direction>
    </section>
</div>
