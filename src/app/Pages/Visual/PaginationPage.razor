@page "/visual/pagination"
@using LowlandTech.Components.Pagination

<PageTitle>Pagination - Visual Test</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Pagination</h1>
    
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Pagination</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Pagination Count="10" Page="1">
                <PaginationContent>
                    <PaginationItem>
                        <PaginationPrevious href="#" />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#" IsActive="true">1</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">2</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">3</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationEllipsis />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">10</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationNext href="#" />
                    </PaginationItem>
                </PaginationContent>
            </Pagination>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Active Page</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Pagination Count="20" Page="5">
                <PaginationContent>
                    <PaginationItem>
                        <PaginationPrevious href="#" />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">1</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationEllipsis />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">4</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#" IsActive="true">5</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">6</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationEllipsis />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">20</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationNext href="#" />
                    </PaginationItem>
                </PaginationContent>
            </Pagination>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Simple Pagination</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Pagination Count="5" Page="2">
                <PaginationContent>
                    <PaginationItem>
                        <PaginationPrevious href="#" />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">1</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#" IsActive="true">2</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">3</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">4</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">5</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationNext href="#" />
                    </PaginationItem>
                </PaginationContent>
            </Pagination>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">First Page</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Pagination Count="10" Page="1">
                <PaginationContent>
                    <PaginationItem>
                        <PaginationPrevious href="#" Disabled="true" />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#" IsActive="true">1</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">2</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">3</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationEllipsis />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">10</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationNext href="#" />
                    </PaginationItem>
                </PaginationContent>
            </Pagination>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Last Page</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Pagination Count="10" Page="10">
                <PaginationContent>
                    <PaginationItem>
                        <PaginationPrevious href="#" />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">1</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationEllipsis />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">8</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">9</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#" IsActive="true">10</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationNext href="#" Disabled="true" />
                    </PaginationItem>
                </PaginationContent>
            </Pagination>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Compact Pagination</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Pagination Count="100" Page="42">
                <PaginationContent>
                    <PaginationItem>
                        <PaginationPrevious href="#" />
                    </PaginationItem>
                    <PaginationItem>
                        <span class="text-sm text-muted-foreground px-2">
                            Page 42 of 100
                        </span>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationNext href="#" />
                    </PaginationItem>
                </PaginationContent>
            </Pagination>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Large Page Count</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Pagination Count="50" Page="25">
                <PaginationContent>
                    <PaginationItem>
                        <PaginationPrevious href="#" />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">1</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationEllipsis />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">23</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">24</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#" IsActive="true">25</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">26</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">27</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationEllipsis />
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationLink href="#">50</PaginationLink>
                    </PaginationItem>
                    <PaginationItem>
                        <PaginationNext href="#" />
                    </PaginationItem>
                </PaginationContent>
            </Pagination>
        </div>
    </section>
</div>
