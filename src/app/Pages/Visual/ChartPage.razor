@page "/visual/chart"
@using LowlandTech.Components.Chart
@using LowlandTech.Components.Chart.Models

<PageTitle>Chart - Visual Test</PageTitle>

<!-- Ensure Chart.js is loaded -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold">Chart</h1>
        <p class="text-muted-foreground">Visual representation of data using charts with Chart.js integration.</p>
    </div>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Bar Chart</h2>
        <p class="text-sm text-muted-foreground">Display data as rectangular bars with tooltips and legend.</p>
        <div class="rounded-md border p-6">
            <ChartContainer Config="_barConfig" class="h-64">
                <Chart Type="bar" ChartData="_barData" ChartOptions="_barOptions" />
            </ChartContainer>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Line Chart</h2>
        <p class="text-sm text-muted-foreground">Display data points connected by smooth lines.</p>
        <div class="rounded-md border p-6">
            <ChartContainer Config="_lineConfig" class="h-64">
                <Chart Type="line" ChartData="_lineData" ChartOptions="_lineOptions" />
            </ChartContainer>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Pie Chart</h2>
        <p class="text-sm text-muted-foreground">Display data as proportional slices.</p>
        <div class="rounded-md border p-6 flex justify-center">
            <ChartContainer Config="_pieConfig" class="h-64 w-64">
                <Chart Type="pie" ChartData="_pieData" ChartOptions="_pieOptions" />
            </ChartContainer>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Doughnut Chart</h2>
        <p class="text-sm text-muted-foreground">Similar to pie chart with a hollow center.</p>
        <div class="rounded-md border p-6 flex justify-center">
            <ChartContainer Config="_doughnutConfig" class="h-64 w-64">
                <Chart Type="doughnut" ChartData="_doughnutData" ChartOptions="_doughnutOptions" />
            </ChartContainer>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Area Chart</h2>
        <p class="text-sm text-muted-foreground">Line chart with filled area below.</p>
        <div class="rounded-md border p-6">
            <ChartContainer Config="_areaConfig" class="h-64">
                <Chart Type="area" ChartData="_areaData" ChartOptions="_areaOptions" />
            </ChartContainer>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Horizontal Bar Chart</h2>
        <p class="text-sm text-muted-foreground">Bar chart with horizontal orientation.</p>
        <div class="rounded-md border p-6">
            <ChartContainer Config="_horizontalBarConfig" class="h-64">
                <Chart Type="bar" ChartData="_horizontalBarData" ChartOptions="_horizontalBarOptions" />
            </ChartContainer>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Multi-Series Chart</h2>
        <p class="text-sm text-muted-foreground">Multiple data series with custom legend.</p>
        <div class="rounded-md border p-6">
            <ChartContainer Config="_multiConfig" class="h-64">
                <Chart Type="bar" ChartData="_multiData" ChartOptions="_multiOptions" />
            </ChartContainer>
            <ChartLegend Position="bottom" class="mt-4">
                <ChartLegendContent Items="_legendItems" />
            </ChartLegend>
        </div>
    </section>
</div>

