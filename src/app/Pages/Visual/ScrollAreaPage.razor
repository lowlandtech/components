@page "/visual/scroll-area"
@using LowlandTech.Components.ScrollArea

<PageTitle>Scroll Area - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Scroll Area</h1>

    <div class="space-y-12">
        <!-- Basic Vertical Scroll -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Vertical Scrolling</h2>
            <div class="p-6 border rounded-lg bg-background">
                <ScrollArea class="h-48 w-full border rounded-md">
                    <div class="p-4 space-y-4">
                        @for (var i = 1; i <= 20; i++)
                        {
                            <p class="text-sm">Item @i: Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                        }
                    </div>
                </ScrollArea>
            </div>
        </section>

        <!-- Horizontal Scroll -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Horizontal Content</h2>
            <div class="p-6 border rounded-lg bg-background">
                <ScrollArea class="h-32 w-full border rounded-md">
                    <div class="flex gap-4 p-4" style="width: max-content;">
                        @for (var i = 1; i <= 15; i++)
                        {
                            <div class="w-32 h-20 bg-muted rounded-md flex items-center justify-center shrink-0">
                                <span class="text-sm font-medium">Card @i</span>
                            </div>
                        }
                    </div>
                </ScrollArea>
            </div>
        </section>

        <!-- With Custom Styling -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Custom Height Scroll Area</h2>
            <div class="p-6 border rounded-lg bg-background">
                <ScrollArea class="h-64 w-full border-2 border-dashed border-muted rounded-lg">
                    <div class="p-6 space-y-6">
                        <div>
                            <h3 class="font-semibold mb-2">Section 1</h3>
                            <p class="text-sm text-muted-foreground">
                                This is a scrollable area with custom height. The content inside can be quite long
                                and will scroll within the defined container boundaries.
                            </p>
                        </div>
                        <div>
                            <h3 class="font-semibold mb-2">Section 2</h3>
                            <p class="text-sm text-muted-foreground">
                                Scroll areas are useful for creating scrollable regions within your application
                                without affecting the overall page scroll.
                            </p>
                        </div>
                        <div>
                            <h3 class="font-semibold mb-2">Section 3</h3>
                            <p class="text-sm text-muted-foreground">
                                More content here to demonstrate scrolling behavior. Keep scrolling to see more.
                            </p>
                        </div>
                        <div>
                            <h3 class="font-semibold mb-2">Section 4</h3>
                            <p class="text-sm text-muted-foreground">
                                Even more content to ensure there's enough to scroll through.
                            </p>
                        </div>
                        <div>
                            <h3 class="font-semibold mb-2">Section 5</h3>
                            <p class="text-sm text-muted-foreground">
                                Final section with some concluding text.
                            </p>
                        </div>
                    </div>
                </ScrollArea>
            </div>
        </section>

        <!-- Nested Content -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Nested Elements</h2>
            <div class="p-6 border rounded-lg bg-background">
                <ScrollArea class="h-56 w-full border rounded-md">
                    <div class="p-4 space-y-4">
                        @foreach (var category in _categories)
                        {
                            <div class="border rounded-lg p-4 bg-muted/30">
                                <h3 class="font-semibold mb-2">@category.Name</h3>
                                <div class="space-y-2">
                                    @foreach (var item in category.Items)
                                    {
                                        <div class="flex items-center gap-2 text-sm">
                                            <span class="w-2 h-2 rounded-full bg-primary"></span>
                                            <span>@item</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </ScrollArea>
            </div>
        </section>

        <!-- Compact Scroll Area -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Compact Scroll Area</h2>
            <div class="p-6 border rounded-lg bg-background">
                <ScrollArea class="h-32 w-64 border rounded-md mx-auto">
                    <div class="p-3 space-y-2 text-sm">
                        <p>Line 1: Quick brown fox</p>
                        <p>Line 2: Jumps over the</p>
                        <p>Line 3: Lazy dog multiple</p>
                        <p>Line 4: Times to demonstrate</p>
                        <p>Line 5: Scrolling in a</p>
                        <p>Line 6: Compact container</p>
                        <p>Line 7: With limited width</p>
                        <p>Line 8: And height combined</p>
                    </div>
                </ScrollArea>
            </div>
        </section>
    </div>
</div>

@code {
    private readonly List<Category> _categories = new()
    {
        new("Fruits", new[] { "Apple", "Banana", "Cherry", "Date", "Elderberry" }),
        new("Vegetables", new[] { "Asparagus", "Broccoli", "Carrot", "Dill", "Eggplant" }),
        new("Colors", new[] { "Amber", "Blue", "Cyan", "Denim", "Emerald" }),
        new("Animals", new[] { "Ant", "Bear", "Cat", "Dog", "Elephant" }),
        new("Cities", new[] { "Amsterdam", "Berlin", "Cairo", "Dublin", "Edinburgh" }),
    };

    private record Category(string Name, string[] Items);
}
