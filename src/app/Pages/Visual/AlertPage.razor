@page "/visual/alert"
@using LowlandTech.Components.Alert

<PageTitle>Alert - Visual Test</PageTitle>

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold">Alert</h1>
        <p class="text-muted-foreground">Displays a callout for user attention.</p>
    </div>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Default with Info Icon</h2>
        <Alert>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4"/>
                <path d="M12 8h.01"/>
            </svg>
            <AlertTitle>Heads up!</AlertTitle>
            <AlertDescription>
                You can add components to your app using the cli.
            </AlertDescription>
        </Alert>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Success with CheckCircle Icon</h2>
        <Alert>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <AlertTitle>Success!</AlertTitle>
            <AlertDescription>
                Your changes have been saved successfully.
            </AlertDescription>
        </Alert>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Warning with AlertTriangle Icon</h2>
        <Alert>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                <line x1="12" x2="12" y1="9" y2="13"/>
                <line x1="12" x2="12.01" y1="17" y2="17"/>
            </svg>
            <AlertTitle>Warning</AlertTitle>
            <AlertDescription>
                Please review your settings before continuing.
            </AlertDescription>
        </Alert>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Destructive with AlertCircle Icon</h2>
        <Alert Variant="destructive">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" x2="9" y1="9" y2="15"/>
                <line x1="9" x2="15" y1="9" y2="15"/>
            </svg>
            <AlertTitle>Error</AlertTitle>
            <AlertDescription>
                Your session has expired. Please log in again.
            </AlertDescription>
        </Alert>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Alert with Only Title</h2>
        <Alert>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            </svg>
            <AlertTitle>Security Alert</AlertTitle>
        </Alert>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Alert with Only Description</h2>
        <Alert>
            <AlertDescription>
                This is an alert with only a description and no title.
            </AlertDescription>
        </Alert>
    </section>

    <!-- RTL Section -->
    <section class="space-y-4">
        <h2 class="text-lg font-semibold">RTL (Right-to-Left) Support</h2>
        <p class="text-sm text-muted-foreground">Arabic/Hebrew language support with proper text alignment and icon positioning.</p>
        <Direction dir="rtl">
            <div class="space-y-4">
                <Alert>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 16v-4"/>
                        <path d="M12 8h.01"/>
                    </svg>
                    <AlertTitle>تنبيه!</AlertTitle>
                    <AlertDescription>
                        يمكنك إضافة مكونات إلى تطبيقك باستخدام واجهة سطر الأوامر.
                    </AlertDescription>
                </Alert>

                <Alert Variant="destructive">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="15" x2="9" y1="9" y2="15"/>
                        <line x1="9" x2="15" y1="9" y2="15"/>
                    </svg>
                    <AlertTitle>خطأ</AlertTitle>
                    <AlertDescription>
                        انتهت صلاحية جلستك. يرجى تسجيل الدخول مرة أخرى.
                    </AlertDescription>
                </Alert>
            </div>
        </Direction>
    </section>
</div>
