@page "/visual/separator"
@using LowlandTech.Components.Separator

<PageTitle>Separator - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Separator</h1>

    <div class="space-y-12">
        <!-- Horizontal Separator -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Horizontal Separator</h2>
            <div class="p-6 border rounded-lg bg-background space-y-4">
                <p>Content above the separator</p>
                <Separator />
                <p>Content below the separator</p>
            </div>
        </section>

        <!-- Vertical Separator -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Vertical Separator</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex items-center h-16 gap-4">
                    <span>Left content</span>
                    <Separator orientation="vertical" />
                    <span>Center content</span>
                    <Separator orientation="vertical" />
                    <span>Right content</span>
                </div>
            </div>
        </section>

        <!-- In Lists -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">In Lists</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="space-y-2">
                    <div class="py-2 px-4 hover:bg-muted rounded-md cursor-pointer">
                        <span class="font-medium">Profile Settings</span>
                        <p class="text-sm text-muted-foreground">Manage your profile information</p>
                    </div>
                    <Separator />
                    <div class="py-2 px-4 hover:bg-muted rounded-md cursor-pointer">
                        <span class="font-medium">Account Security</span>
                        <p class="text-sm text-muted-foreground">Update password and security settings</p>
                    </div>
                    <Separator />
                    <div class="py-2 px-4 hover:bg-muted rounded-md cursor-pointer">
                        <span class="font-medium">Notifications</span>
                        <p class="text-sm text-muted-foreground">Configure notification preferences</p>
                    </div>
                    <Separator />
                    <div class="py-2 px-4 hover:bg-muted rounded-md cursor-pointer">
                        <span class="font-medium">Billing</span>
                        <p class="text-sm text-muted-foreground">Manage payment methods and invoices</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- With Text -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Text (Divider Pattern)</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="relative flex items-center py-4">
                    <Separator class="flex-1" />
                    <span class="px-4 text-sm text-muted-foreground">Or continue with</span>
                    <Separator class="flex-1" />
                </div>
                <div class="flex justify-center gap-4 mt-4">
                    <div class="w-10 h-10 rounded-full bg-muted flex items-center justify-center">G</div>
                    <div class="w-10 h-10 rounded-full bg-muted flex items-center justify-center">A</div>
                    <div class="w-10 h-10 rounded-full bg-muted flex items-center justify-center">F</div>
                </div>
            </div>
        </section>

        <!-- Section Dividers -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Section Dividers</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div>
                    <h3 class="text-lg font-semibold mb-2">Personal Information</h3>
                    <p class="text-sm text-muted-foreground mb-4">Update your personal details and contact information.</p>
                </div>
                <Separator class="my-4" />
                <div>
                    <h3 class="text-lg font-semibold mb-2">Work Information</h3>
                    <p class="text-sm text-muted-foreground mb-4">Update your job title, department, and company details.</p>
                </div>
                <Separator class="my-4" />
                <div>
                    <h3 class="text-lg font-semibold mb-2">Preferences</h3>
                    <p class="text-sm text-muted-foreground">Customize your experience and default settings.</p>
                </div>
            </div>
        </section>

        <!-- Vertical in Navigation -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Navigation Divider</h2>
            <div class="p-6 border rounded-lg bg-background">
                <nav class="flex items-center gap-4">
                    <a href="#" class="text-sm font-medium hover:text-primary">Home</a>
                    <a href="#" class="text-sm font-medium hover:text-primary">Products</a>
                    <Separator orientation="vertical" class="h-4" />
                    <a href="#" class="text-sm font-medium hover:text-primary">About</a>
                    <a href="#" class="text-sm font-medium hover:text-primary">Contact</a>
                    <Separator orientation="vertical" class="h-4" />
                    <a href="#" class="text-sm font-medium hover:text-primary">Login</a>
                </nav>
            </div>
        </section>

        <!-- Custom Styling -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Custom Styling</h2>
            <div class="p-6 border rounded-lg bg-background space-y-6">
                <div>
                    <p class="text-sm mb-2">Dashed separator</p>
                    <Separator class="border-dashed" />
                </div>
                <div>
                    <p class="text-sm mb-2">Thicker separator</p>
                    <Separator class="h-1" />
                </div>
                <div class="flex items-center gap-4 h-12">
                    <span>Item A</span>
                    <Separator orientation="vertical" class="w-1" />
                    <span>Item B</span>
                    <Separator orientation="vertical" class="w-1" />
                    <span>Item C</span>
                </div>
            </div>
        </section>

        <!-- Card Layout -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Card Layout</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="grid grid-cols-3 gap-0 divide-x divide-border border rounded-lg overflow-hidden">
                    <div class="p-6 text-center">
                        <div class="text-3xl font-bold">128</div>
                        <div class="text-sm text-muted-foreground mt-1">Projects</div>
                    </div>
                    <div class="p-6 text-center">
                        <div class="text-3xl font-bold">42</div>
                        <div class="text-sm text-muted-foreground mt-1">Tasks</div>
                    </div>
                    <div class="p-6 text-center">
                        <div class="text-3xl font-bold">86</div>
                        <div class="text-sm text-muted-foreground mt-1">Completed</div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
