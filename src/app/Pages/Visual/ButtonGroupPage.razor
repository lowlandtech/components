@page "/visual/button-group"
@using LowlandTech.Components.ButtonGroup
@using LowlandTech.Components.Button

<PageTitle>Button Group - Visual Test</PageTitle>

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold">Button Group</h1>
        <p class="text-muted-foreground">A set of related buttons grouped together.</p>
    </div>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Basic Button Group</h2>
        <ButtonGroup>
            <Button Variant="outline">Left</Button>
            <Button Variant="outline">Center</Button>
            <Button Variant="outline">Right</Button>
        </ButtonGroup>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">With Separators</h2>
        <ButtonGroup>
            <Button Variant="outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                    <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                </svg>
                Share
            </Button>
            <ButtonGroupSeparator />
            <Button Variant="outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
                </svg>
                Download
            </Button>
            <ButtonGroupSeparator />
            <Button Variant="outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                </svg>
                Edit
            </Button>
        </ButtonGroup>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Vertical Orientation</h2>
        <ButtonGroup Orientation="vertical" class="w-40">
            <Button Variant="outline">Top</Button>
            <Button Variant="outline">Middle</Button>
            <Button Variant="outline">Bottom</Button>
        </ButtonGroup>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">With Text Separator</h2>
        <ButtonGroup>
            <Button Variant="default">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
                Like
            </Button>
            <ButtonGroupText class="px-3 text-sm">1.2k</ButtonGroupText>
        </ButtonGroup>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Mixed Variants</h2>
        <ButtonGroup>
            <Button Variant="default">Save</Button>
            <Button Variant="secondary">Save as Draft</Button>
            <Button Variant="outline">Cancel</Button>
        </ButtonGroup>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Icon Button Group</h2>
        <ButtonGroup>
            <Button Variant="outline" Size="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
            </Button>
            <Button Variant="outline" Size="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                </svg>
            </Button>
            <Button Variant="outline" Size="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="5" x="2" y="4" rx="2"/><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"/>
                    <path d="M10 13h4"/>
                </svg>
            </Button>
        </ButtonGroup>
    </section>
</div>
