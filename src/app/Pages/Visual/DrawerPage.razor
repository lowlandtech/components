@page "/visual/drawer"

<PageTitle>Drawer - Visual Test</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Drawer</h1>
    
    <div class="space-y-12">
        <!-- Default (Right) -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Default (Right)</h2>
            <div class="p-6 border rounded-lg">
                <Drawer @bind-IsOpen="_drawer1Open">
                    <DrawerTrigger>
                        <Button>Open Drawer</Button>
                    </DrawerTrigger>
                    <DrawerContent>
                        <DrawerHeader>
                            <DrawerTitle>Edit Profile</DrawerTitle>
                            <DrawerDescription>Make changes to your profile here.</DrawerDescription>
                        </DrawerHeader>
                        <div class="p-4 space-y-4">
                            <Field>
                                <FieldLabel>Name</FieldLabel>
                                <Input Value="John Doe" />
                            </Field>
                            <Field>
                                <FieldLabel>Email</FieldLabel>
                                <Input Value="john@example.com" />
                            </Field>
                        </div>
                        <DrawerFooter>
                            <Button @onclick="() => _drawer1Open = false">Save Changes</Button>
                            <DrawerClose>
                                <Button Variant="outline">Cancel</Button>
                            </DrawerClose>
                        </DrawerFooter>
                    </DrawerContent>
                </Drawer>
            </div>
        </section>

        <!-- Left Drawer -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Left Drawer</h2>
            <div class="p-6 border rounded-lg">
                <Drawer @bind-IsOpen="_drawer2Open" Direction="left">
                    <DrawerTrigger>
                        <Button>Open Left Drawer</Button>
                    </DrawerTrigger>
                    <DrawerContent>
                        <DrawerHeader>
                            <DrawerTitle>Navigation</DrawerTitle>
                            <DrawerDescription>Quick navigation menu</DrawerDescription>
                        </DrawerHeader>
                        <div class="p-4">
                            <nav class="space-y-2">
                                <a href="#" class="flex items-center gap-3 p-3 rounded-lg hover:bg-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    <span>Home</span>
                                </a>
                                <a href="#" class="flex items-center gap-3 p-3 rounded-lg hover:bg-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <span>Profile</span>
                                </a>
                                <a href="#" class="flex items-center gap-3 p-3 rounded-lg hover:bg-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                                    <span>Settings</span>
                                </a>
                            </nav>
                        </div>
                        <DrawerFooter>
                            <DrawerClose>
                                <Button Variant="outline" class="w-full">Close</Button>
                            </DrawerClose>
                        </DrawerFooter>
                    </DrawerContent>
                </Drawer>
            </div>
        </section>

        <!-- Top Drawer -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Top Drawer</h2>
            <div class="p-6 border rounded-lg">
                <Drawer @bind-IsOpen="_drawer3Open" Direction="top">
                    <DrawerTrigger>
                        <Button>Open Top Drawer</Button>
                    </DrawerTrigger>
                    <DrawerContent>
                        <DrawerHeader>
                            <DrawerTitle>Notifications</DrawerTitle>
                            <DrawerDescription>You have 3 unread notifications</DrawerDescription>
                        </DrawerHeader>
                        <div class="p-4 space-y-3">
                            <div class="flex items-start gap-3 p-3 bg-muted rounded-lg">
                                <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">New message received</p>
                                    <p class="text-xs text-muted-foreground">5 minutes ago</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 p-3 bg-muted rounded-lg">
                                <div class="w-8 h-8 bg-green-500/10 rounded-full flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">Task completed</p>
                                    <p class="text-xs text-muted-foreground">1 hour ago</p>
                                </div>
                            </div>
                        </div>
                        <DrawerFooter>
                            <DrawerClose>
                                <Button Variant="outline">Dismiss All</Button>
                            </DrawerClose>
                        </DrawerFooter>
                    </DrawerContent>
                </Drawer>
            </div>
        </section>

        <!-- Bottom Drawer -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Bottom Drawer</h2>
            <div class="p-6 border rounded-lg">
                <Drawer @bind-IsOpen="_drawer4Open" Direction="bottom">
                    <DrawerTrigger>
                        <Button>Open Bottom Drawer</Button>
                    </DrawerTrigger>
                    <DrawerContent>
                        <DrawerHeader>
                            <DrawerTitle>Cart</DrawerTitle>
                            <DrawerDescription>You have 2 items in your cart</DrawerDescription>
                        </DrawerHeader>
                        <div class="p-4 space-y-3">
                            <div class="flex items-center gap-4 p-3 border rounded-lg">
                                <div class="w-16 h-16 bg-muted rounded-md"></div>
                                <div class="flex-1">
                                    <p class="font-medium">Premium Headphones</p>
                                    <p class="text-sm text-muted-foreground">$299.00</p>
                                </div>
                                <Button Variant="ghost" Size="sm">Remove</Button>
                            </div>
                            <div class="flex items-center gap-4 p-3 border rounded-lg">
                                <div class="w-16 h-16 bg-muted rounded-md"></div>
                                <div class="flex-1">
                                    <p class="font-medium">Wireless Mouse</p>
                                    <p class="text-sm text-muted-foreground">$79.00</p>
                                </div>
                                <Button Variant="ghost" Size="sm">Remove</Button>
                            </div>
                            <Separator />
                            <div class="flex justify-between font-medium">
                                <span>Total</span>
                                <span>$378.00</span>
                            </div>
                        </div>
                        <DrawerFooter>
                            <Button class="w-full">Checkout</Button>
                            <DrawerClose>
                                <Button Variant="outline" class="w-full">Continue Shopping</Button>
                            </DrawerClose>
                        </DrawerFooter>
                    </DrawerContent>
                </Drawer>
            </div>
        </section>

        <!-- Responsive Dialog (Dialog on Desktop, Drawer on Mobile) -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Responsive Dialog</h2>
            <p class="text-sm text-muted-foreground mb-4">Shows Dialog on desktop (&gt;768px), Drawer on mobile (≤768px). Resize your browser to see the transition.</p>
            <div class="p-6 border rounded-lg">
                <ResponsiveDialog @bind-IsOpen="_responsiveDialogOpen" DrawerDirection="bottom">
                    <ResponsiveDialogTrigger>
                        <Button>Open Responsive Dialog</Button>
                    </ResponsiveDialogTrigger>
                    <ResponsiveDialogContent>
                        <ResponsiveDialogHeader>
                            <ResponsiveDialogTitle>Edit Profile</ResponsiveDialogTitle>
                            <ResponsiveDialogDescription>Make changes to your profile here. This dialog adapts to your screen size.</ResponsiveDialogDescription>
                        </ResponsiveDialogHeader>
                        <div class="p-4 space-y-4">
                            <Field>
                                <FieldLabel>Name</FieldLabel>
                                <Input Value="John Doe" />
                            </Field>
                            <Field>
                                <FieldLabel>Email</FieldLabel>
                                <Input Value="john@example.com" />
                            </Field>
                            <Field>
                                <FieldLabel>Bio</FieldLabel>
                                <Input Value="Software developer passionate about UI design." />
                            </Field>
                        </div>
                        <ResponsiveDialogFooter>
                            <Button @onclick="() => _responsiveDialogOpen = false">Save Changes</Button>
                            <ResponsiveDialogClose>
                                <Button Variant="outline">Cancel</Button>
                            </ResponsiveDialogClose>
                        </ResponsiveDialogFooter>
                    </ResponsiveDialogContent>
                </ResponsiveDialog>
            </div>
        </section>

        <!-- Responsive Dialog (Side Drawer on Mobile) -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Responsive Dialog (Right Drawer on Mobile)</h2>
            <p class="text-sm text-muted-foreground mb-4">Shows Dialog on desktop, right-side Drawer on mobile.</p>
            <div class="p-6 border rounded-lg">
                <ResponsiveDialog @bind-IsOpen="_responsiveDialog2Open" DrawerDirection="right">
                    <ResponsiveDialogTrigger>
                        <Button>Open Responsive Dialog (Right)</Button>
                    </ResponsiveDialogTrigger>
                    <ResponsiveDialogContent>
                        <ResponsiveDialogHeader>
                            <ResponsiveDialogTitle>Settings</ResponsiveDialogTitle>
                            <ResponsiveDialogDescription>Configure your application preferences.</ResponsiveDialogDescription>
                        </ResponsiveDialogHeader>
                        <div class="p-4 space-y-4">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="font-medium">Dark Mode</p>
                                    <p class="text-sm text-muted-foreground">Toggle dark mode theme</p>
                                </div>
                                <Switch />
                            </div>
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="font-medium">Notifications</p>
                                    <p class="text-sm text-muted-foreground">Enable push notifications</p>
                                </div>
                                <Switch />
                            </div>
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="font-medium">Auto-save</p>
                                    <p class="text-sm text-muted-foreground">Auto-save your work</p>
                                </div>
                                <Switch />
                            </div>
                        </div>
                        <ResponsiveDialogFooter>
                            <Button @onclick="() => _responsiveDialog2Open = false">Save Settings</Button>
                            <ResponsiveDialogClose>
                                <Button Variant="outline">Cancel</Button>
                            </ResponsiveDialogClose>
                        </ResponsiveDialogFooter>
                    </ResponsiveDialogContent>
                </ResponsiveDialog>
            </div>
        </section>
    </div>
</div>

@code {
    private bool _drawer1Open = false;
    private bool _drawer2Open = false;
    private bool _drawer3Open = false;
    private bool _drawer4Open = false;
    private bool _responsiveDialogOpen = false;
    private bool _responsiveDialog2Open = false;
}
