@page "/visual/item"
@using LowlandTech.Components.Item
@using LowlandTech.Components.Avatar
@using LowlandTech.Components.Badge
@using LowlandTech.Components.Button
@using LowlandTech.Components.Icon

<PageTitle>Item - Visual Test</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Item</h1>
    
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Item</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Item>
                <ItemContent>Simple item content</ItemContent>
            </Item>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Item with Header and Title</h2>
        <div class="space-y-2 p-6 border rounded-lg bg-card">
            <Item>
                <ItemHeader>
                    <ItemTitle>Item Title</ItemTitle>
                </ItemHeader>
                <ItemContent>Item content goes here</ItemContent>
            </Item>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Item with Description</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Item>
                <ItemHeader>
                    <ItemTitle>Product Name</ItemTitle>
                </ItemHeader>
                <ItemDescription>This is a detailed description of the product that provides more information.</ItemDescription>
                <ItemContent>Additional content can go here</ItemContent>
            </Item>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Item with Media</h2>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <Item>
                <ItemMedia>
                    <Avatar>
                        <AvatarImage Src="https://github.com/shadcn.png" Alt="shadcn" />
                        <AvatarFallback>CN</AvatarFallback>
                    </Avatar>
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>John Doe</ItemTitle>
                    <ItemDescription>Software Engineer</ItemDescription>
                </ItemContent>
            </Item>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Item with Actions</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Item>
                <ItemContent>
                    <ItemTitle>Notification</ItemTitle>
                    <ItemDescription>You have a new message</ItemDescription>
                </ItemContent>
                <ItemActions>
                    <Button Size="sm" Variant="ghost">
                        <Icon Name="check" Size="16" />
                    </Button>
                    <Button Size="sm" Variant="ghost">
                        <Icon Name="close" Size="16" />
                    </Button>
                </ItemActions>
            </Item>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Item with Footer</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Item>
                <ItemHeader>
                    <ItemTitle>Blog Post</ItemTitle>
                </ItemHeader>
                <ItemContent>
                    <ItemDescription>This is an excerpt from the blog post content...</ItemDescription>
                </ItemContent>
                <ItemFooter>
                    <span class="text-sm text-muted-foreground">Posted 2 hours ago</span>
                    <Badge Variant="outline">Draft</Badge>
                </ItemFooter>
            </Item>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Item Group</h2>
        <div class="p-6 border rounded-lg bg-card">
            <ItemGroup>
                <Item>
                    <ItemContent>
                        <ItemTitle>First Item</ItemTitle>
                    </ItemContent>
                </Item>
                <ItemSeparator />
                <Item>
                    <ItemContent>
                        <ItemTitle>Second Item</ItemTitle>
                    </ItemContent>
                </Item>
                <ItemSeparator />
                <Item>
                    <ItemContent>
                        <ItemTitle>Third Item</ItemTitle>
                    </ItemContent>
                </Item>
            </ItemGroup>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Complete Item Example</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Item>
                <ItemMedia>
                    <Avatar>
                        <AvatarFallback>JD</AvatarFallback>
                    </Avatar>
                </ItemMedia>
                <ItemContent>
                    <ItemHeader>
                        <ItemTitle>Jane Doe</ItemTitle>
                        <ItemDescription>Product Manager</ItemDescription>
                    </ItemHeader>
                </ItemContent>
                <ItemActions>
                    <Button Size="sm" Variant="outline">Message</Button>
                    <Button Size="sm">Follow</Button>
                </ItemActions>
            </Item>
        </div>
    </section>
</div>
