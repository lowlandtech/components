@page "/visual/resizable"
@using LowlandTech.Components.Resizable

<PageTitle>Resizable - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Resizable</h1>

    <div class="space-y-12">
        <!-- Basic Horizontal Resizable -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Horizontal Panels</h2>
            <div class="h-64 border rounded-lg overflow-hidden">
                <Resizable Direction="horizontal">
                    <ResizablePanel Id="panel1" DefaultSize="33">
                        <div class="h-full flex items-center justify-center bg-muted p-4">
                            <p class="text-center">Panel 1 (33%)</p>
                        </div>
                    </ResizablePanel>
                    <ResizableHandle />
                    <ResizablePanel Id="panel2" DefaultSize="33">
                        <div class="h-full flex items-center justify-center bg-muted/70 p-4">
                            <p class="text-center">Panel 2 (33%)</p>
                        </div>
                    </ResizablePanel>
                    <ResizableHandle />
                    <ResizablePanel Id="panel3" DefaultSize="34">
                        <div class="h-full flex items-center justify-center bg-muted/50 p-4">
                            <p class="text-center">Panel 3 (34%)</p>
                        </div>
                    </ResizablePanel>
                </Resizable>
            </div>
        </section>

        <!-- Vertical Resizable -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Vertical Panels</h2>
            <div class="h-96 border rounded-lg overflow-hidden">
                <Resizable Direction="vertical">
                    <ResizablePanel Id="top-panel" DefaultSize="40">
                        <div class="h-full flex items-center justify-center bg-muted p-4">
                            <p>Top Panel (40%)</p>
                        </div>
                    </ResizablePanel>
                    <ResizableHandle />
                    <ResizablePanel Id="bottom-panel" DefaultSize="60">
                        <div class="h-full flex items-center justify-center bg-muted/70 p-4">
                            <p>Bottom Panel (60%)</p>
                        </div>
                    </ResizablePanel>
                </Resizable>
            </div>
        </section>

        <!-- With Handle Indicator -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Handle Indicators</h2>
            <div class="h-64 border rounded-lg overflow-hidden">
                <Resizable Direction="horizontal">
                    <ResizablePanel Id="left" DefaultSize="50">
                        <div class="h-full flex items-center justify-center bg-muted p-4">
                            <p>Left Panel</p>
                        </div>
                    </ResizablePanel>
                    <ResizableHandle WithHandle="true" />
                    <ResizablePanel Id="right" DefaultSize="50">
                        <div class="h-full flex items-center justify-center bg-muted/70 p-4">
                            <p>Right Panel</p>
                        </div>
                    </ResizablePanel>
                </Resizable>
            </div>
        </section>

        <!-- With Min/Max Sizes -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Size Constraints</h2>
            <div class="h-64 border rounded-lg overflow-hidden">
                <Resizable Direction="horizontal">
                    <ResizablePanel Id="constrained-left" DefaultSize="30" MinSize="20" MaxSize="60">
                        <div class="h-full flex items-center justify-center bg-muted p-4">
                            <p class="text-center">Min 20%, Max 60%</p>
                        </div>
                    </ResizablePanel>
                    <ResizableHandle />
                    <ResizablePanel Id="constrained-right" DefaultSize="70">
                        <div class="h-full flex items-center justify-center bg-muted/70 p-4">
                            <p>Flexible Panel</p>
                        </div>
                    </ResizablePanel>
                </Resizable>
            </div>
        </section>

        <!-- Nested Layout -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Complex Layout</h2>
            <div class="h-96 border rounded-lg overflow-hidden">
                <Resizable Direction="horizontal">
                    <ResizablePanel Id="sidebar" DefaultSize="25">
                        <div class="h-full flex items-center justify-center bg-muted p-4">
                            <p>Sidebar (25%)</p>
                        </div>
                    </ResizablePanel>
                    <ResizableHandle />
                    <ResizablePanel Id="main" DefaultSize="75">
                        <Resizable Direction="vertical">
                            <ResizablePanel Id="header" DefaultSize="30">
                                <div class="h-full flex items-center justify-center bg-muted/70 p-4">
                                    <p>Header Area (30%)</p>
                                </div>
                            </ResizablePanel>
                            <ResizableHandle />
                            <ResizablePanel Id="content" DefaultSize="70">
                                <div class="h-full flex items-center justify-center bg-muted/50 p-4">
                                    <p>Content Area (70%)</p>
                                </div>
                            </ResizablePanel>
                        </Resizable>
                    </ResizablePanel>
                </Resizable>
            </div>
        </section>
    </div>
</div>
