@page "/visual/collapsible"
@using LowlandTech.Components.Slider
@using LowlandTech.Components.Select

<PageTitle>Collapsible - Visual Test</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Collapsible</h1>
    
    <div class="space-y-12">
        <!-- Default Collapsible -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Default</h2>
            <div class="p-6 border rounded-lg">
                <Collapsible @bind-IsOpen="_isOpen1">
                    <CollapsibleTrigger class="flex items-center gap-2 text-sm font-medium hover:underline">
                        <span>Toggle Content</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform" style="transform: rotate(@(_isOpen1 ? "180deg" : "0deg"))">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </CollapsibleTrigger>
                    <CollapsibleContent class="mt-2 text-sm text-muted-foreground">
                        <p>This content can be collapsed and expanded by clicking the trigger above.</p>
                    </CollapsibleContent>
                </Collapsible>
            </div>
        </section>

        <!-- With Card -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Card</h2>
            <div class="p-6 border rounded-lg">
                <Collapsible @bind-IsOpen="_isOpen2">
                    <Card>
                        <CardHeader>
                            <div class="flex items-center justify-between">
                                <CardTitle>Advanced Settings</CardTitle>
                                <CollapsibleTrigger class="p-2 hover:bg-muted rounded-md">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform" style="transform: rotate(@(_isOpen2 ? "180deg" : "0deg"))">
                                        <path d="m6 9 6 6 6-6" />
                                    </svg>
                                </CollapsibleTrigger>
                            </div>
                            <CardDescription>Configure advanced options for your account</CardDescription>
                        </CardHeader>
                        <CollapsibleContent>
                            <CardContent class="space-y-4">
                                <Field>
                                    <FieldLabel>API Key</FieldLabel>
                                    <Input Placeholder="Enter your API key" />
                                </Field>
                                <Field>
                                    <FieldLabel>Webhook URL</FieldLabel>
                                    <Input Placeholder="https://example.com/webhook" />
                                </Field>
                            </CardContent>
                        </CollapsibleContent>
                    </Card>
                </Collapsible>
            </div>
        </section>

        <!-- FAQ Style -->
        <section>
            <h2 class="text-xl font-semibold mb-4">FAQ Style</h2>
            <div class="p-6 border rounded-lg space-y-2">
                <Collapsible @bind-IsOpen="_faqOpen1">
                    <div class="border rounded-lg px-4 py-3">
                        <CollapsibleTrigger class="flex items-center justify-between w-full text-left font-medium">
                            <span>What is your return policy?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform" style="transform: rotate(@(_faqOpen1 ? "45deg" : "0deg"))">
                                <path d="M5 12h14" />
                                <path d="M12 5v14" />
                            </svg>
                        </CollapsibleTrigger>
                        <CollapsibleContent class="mt-2 text-sm text-muted-foreground">
                            <p>We accept returns within 30 days of purchase. Items must be in original condition with all tags attached.</p>
                        </CollapsibleContent>
                    </div>
                </Collapsible>

                <Collapsible @bind-IsOpen="_faqOpen2">
                    <div class="border rounded-lg px-4 py-3">
                        <CollapsibleTrigger class="flex items-center justify-between w-full text-left font-medium">
                            <span>How do I track my order?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform" style="transform: rotate(@(_faqOpen2 ? "45deg" : "0deg"))">
                                <path d="M5 12h14" />
                                <path d="M12 5v14" />
                            </svg>
                        </CollapsibleTrigger>
                        <CollapsibleContent class="mt-2 text-sm text-muted-foreground">
                            <p>You can track your order using the tracking number provided in your shipping confirmation email.</p>
                        </CollapsibleContent>
                    </div>
                </Collapsible>

                <Collapsible @bind-IsOpen="_faqOpen3">
                    <div class="border rounded-lg px-4 py-3">
                        <CollapsibleTrigger class="flex items-center justify-between w-full text-left font-medium">
                            <span>Do you ship internationally?</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform" style="transform: rotate(@(_faqOpen3 ? "45deg" : "0deg"))">
                                <path d="M5 12h14" />
                                <path d="M12 5v14" />
                            </svg>
                        </CollapsibleTrigger>
                        <CollapsibleContent class="mt-2 text-sm text-muted-foreground">
                            <p>Yes, we ship to over 100 countries worldwide. Shipping costs and delivery times vary by location.</p>
                        </CollapsibleContent>
                    </div>
                </Collapsible>
            </div>
        </section>

        <!-- Settings Panel -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Settings Panel</h2>
            <div class="p-6 border rounded-lg">
                <div class="max-w-md space-y-4">
                    <!-- Appearance Settings -->
                    <Collapsible @bind-IsOpen="_settingsOpen1">
                        <div class="border rounded-lg">
                            <CollapsibleTrigger class="flex items-center justify-between w-full px-4 py-3 text-left hover:bg-muted/50 rounded-t-lg">
                                <div class="flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                                        <circle cx="12" cy="12" r="4"></circle>
                                        <path d="M12 2v2"></path>
                                        <path d="M12 20v2"></path>
                                        <path d="m4.93 4.93 1.41 1.41"></path>
                                        <path d="m17.66 17.66 1.41 1.41"></path>
                                        <path d="M2 12h2"></path>
                                        <path d="M20 12h2"></path>
                                        <path d="m6.34 17.66-1.41 1.41"></path>
                                        <path d="m19.07 4.93-1.41 1.41"></path>
                                    </svg>
                                    <span class="font-medium">Appearance</span>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform text-muted-foreground" style="transform: rotate(@(_settingsOpen1 ? "180deg" : "0deg"))">
                                    <path d="m6 9 6 6 6-6"></path>
                                </svg>
                            </CollapsibleTrigger>
                            <CollapsibleContent>
                                <div class="px-4 pb-4 pt-2 space-y-4">
                                    <div>
                                        <div class="flex justify-between mb-2">
                                            <label class="text-sm font-medium">Border Radius</label>
                                            <span class="text-sm text-muted-foreground">@(_radiusValue)px</span>
                                        </div>
                                        <Slider @bind-Value="_radiusValue" Min="0" Max="24" Step="1">
                                            <SliderTrack>
                                                <SliderRange />
                                            </SliderTrack>
                                            <SliderThumb />
                                        </Slider>
                                    </div>
                                    <div>
                                        <label class="text-sm font-medium mb-2 block">Theme</label>
                                        <Select @bind-Value="_themeValue">
                                            <SelectTrigger class="w-full">
                                                <SelectValue Placeholder="Select theme..." />
                                            </SelectTrigger>
                                            <SelectContent>
                                                <SelectItem Value="light" Text="Light">☀️ Light</SelectItem>
                                                <SelectItem Value="dark" Text="Dark">🌙 Dark</SelectItem>
                                                <SelectItem Value="system" Text="System">💻 System</SelectItem>
                                            </SelectContent>
                                        </Select>
                                    </div>
                                </div>
                            </CollapsibleContent>
                        </div>
                    </Collapsible>

                    <!-- Notifications Settings -->
                    <Collapsible @bind-IsOpen="_settingsOpen2">
                        <div class="border rounded-lg">
                            <CollapsibleTrigger class="flex items-center justify-between w-full px-4 py-3 text-left hover:bg-muted/50 rounded-t-lg">
                                <div class="flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                                        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                                        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                                    </svg>
                                    <span class="font-medium">Notifications</span>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform text-muted-foreground" style="transform: rotate(@(_settingsOpen2 ? "180deg" : "0deg"))">
                                    <path d="m6 9 6 6 6-6"></path>
                                </svg>
                            </CollapsibleTrigger>
                            <CollapsibleContent>
                                <div class="px-4 pb-4 pt-2 space-y-4">
                                    <div>
                                        <label class="text-sm font-medium mb-2 block">Email Frequency</label>
                                        <Select @bind-Value="_emailFreqValue">
                                            <SelectTrigger class="w-full">
                                                <SelectValue Placeholder="Select frequency..." />
                                            </SelectTrigger>
                                            <SelectContent>
                                                <SelectItem Value="realtime" Text="Real-time">⚡ Real-time</SelectItem>
                                                <SelectItem Value="daily" Text="Daily Digest">📅 Daily</SelectItem>
                                                <SelectItem Value="weekly" Text="Weekly Summary">📊 Weekly</SelectItem>
                                                <SelectItem Value="never" Text="Never">🚫 Never</SelectItem>
                                            </SelectContent>
                                        </Select>
                                    </div>
                                    <div class="flex items-center justify-between py-2">
                                        <div>
                                            <p class="text-sm font-medium">Push Notifications</p>
                                            <p class="text-xs text-muted-foreground">Receive push notifications on your device</p>
                                        </div>
                                        <div class="relative inline-flex h-6 w-11 items-center rounded-full bg-primary">
                                            <span class="translate-x-6 inline-block h-4 w-4 transform rounded-full bg-white transition"></span>
                                        </div>
                                    </div>
                                </div>
                            </CollapsibleContent>
                        </div>
                    </Collapsible>

                    <!-- Privacy Settings -->
                    <Collapsible @bind-IsOpen="_settingsOpen3">
                        <div class="border rounded-lg">
                            <CollapsibleTrigger class="flex items-center justify-between w-full px-4 py-3 text-left hover:bg-muted/50 rounded-t-lg">
                                <div class="flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                                        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                    <span class="font-medium">Privacy</span>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform text-muted-foreground" style="transform: rotate(@(_settingsOpen3 ? "180deg" : "0deg"))">
                                    <path d="m6 9 6 6 6-6"></path>
                                </svg>
                            </CollapsibleTrigger>
                            <CollapsibleContent>
                                <div class="px-4 pb-4 pt-2 space-y-4">
                                    <div>
                                        <label class="text-sm font-medium mb-2 block">Profile Visibility</label>
                                        <Select @bind-Value="_privacyValue">
                                            <SelectTrigger class="w-full">
                                                <SelectValue Placeholder="Select visibility..." />
                                            </SelectTrigger>
                                            <SelectContent>
                                                <SelectItem Value="public" Text="Public">🌍 Public</SelectItem>
                                                <SelectItem Value="friends" Text="Friends Only">👥 Friends Only</SelectItem>
                                                <SelectItem Value="private" Text="Private">🔒 Private</SelectItem>
                                            </SelectContent>
                                        </Select>
                                    </div>
                                    <div class="flex items-center justify-between py-2">
                                        <div>
                                            <p class="text-sm font-medium">Activity Status</p>
                                            <p class="text-xs text-muted-foreground">Show when you're online</p>
                                        </div>
                                        <div class="relative inline-flex h-6 w-11 items-center rounded-full bg-muted">
                                            <span class="translate-x-1 inline-block h-4 w-4 transform rounded-full bg-white transition"></span>
                                        </div>
                                    </div>
                                </div>
                            </CollapsibleContent>
                        </div>
                    </Collapsible>
                </div>
            </div>
        </section>

        <!-- Nested Content -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Nested Content</h2>
            <div class="p-6 border rounded-lg">
                <Collapsible @bind-IsOpen="_nestedOpen">
                    <CollapsibleTrigger class="flex items-center gap-2 px-4 py-2 bg-muted rounded-md hover:bg-muted/80">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 20h16a2 2 0 0 0 2-8V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2v3" />
                            <path d="M6 10h12" />
                        </svg>
                        <span>Comments (3)</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto transition-transform" style="transform: rotate(@(_nestedOpen ? "180deg" : "0deg"))">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </CollapsibleTrigger>
                    <CollapsibleContent class="mt-2 space-y-2">
                        <div class="p-3 bg-muted/50 rounded-md text-sm">
                            <p class="font-medium">John Doe</p>
                            <p class="text-muted-foreground">Great work on this feature!</p>
                        </div>
                        <div class="p-3 bg-muted/50 rounded-md text-sm">
                            <p class="font-medium">Jane Smith</p>
                            <p class="text-muted-foreground">Could we add more customization options?</p>
                        </div>
                        <div class="p-3 bg-muted/50 rounded-md text-sm">
                            <p class="font-medium">Bob Johnson</p>
                            <p class="text-muted-foreground">LGTM 👍</p>
                        </div>
                    </CollapsibleContent>
                </Collapsible>
            </div>
        </section>
    </div>
</div>

@code {
    private bool _isOpen1 = false;
    private bool _isOpen2 = false;
    private bool _faqOpen1 = false;
    private bool _faqOpen2 = false;
    private bool _faqOpen3 = false;
    private bool _nestedOpen = true;

    // Settings Panel
    private bool _settingsOpen1 = true;
    private bool _settingsOpen2 = false;
    private bool _settingsOpen3 = false;
    private double _radiusValue = 8;
    private string? _themeValue = "system";
    private string? _emailFreqValue = "daily";
    private string? _privacyValue = "friends";
}
