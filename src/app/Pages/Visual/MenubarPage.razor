@page "/visual/menubar"
@using LowlandTech.Components.Menubar
@using LowlandTech.Components.Icon

<PageTitle>Menubar - Visual Test</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Menubar</h1>
    
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Menubar</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>File</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem>New File</MenubarItem>
                        <MenubarItem>Open File</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem>Save</MenubarItem>
                        <MenubarItem>Save As...</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Edit</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem>Undo</MenubarItem>
                        <MenubarItem>Redo</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem>Cut</MenubarItem>
                        <MenubarItem>Copy</MenubarItem>
                        <MenubarItem>Paste</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>View</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem>Zoom In</MenubarItem>
                        <MenubarItem>Zoom Out</MenubarItem>
                        <MenubarItem>Reset Zoom</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Icons</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>
                        <Icon Name="home" Size="16" class="mr-2" />
                        Home
                    </MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem>Dashboard</MenubarItem>
                        <MenubarItem>Profile</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>
                        <Icon Name="settings" Size="16" class="mr-2" />
                        Settings
                    </MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem>General</MenubarItem>
                        <MenubarItem>Security</MenubarItem>
                        <MenubarItem>Notifications</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Groups and Labels</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>Actions</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>Create</MenubarLabel>
                        <MenubarGroup>
                            <MenubarItem>New Document</MenubarItem>
                            <MenubarItem>New Folder</MenubarItem>
                        </MenubarGroup>
                        <MenubarSeparator />
                        <MenubarLabel>Manage</MenubarLabel>
                        <MenubarGroup>
                            <MenubarItem>Duplicate</MenubarItem>
                            <MenubarItem>Rename</MenubarItem>
                            <MenubarItem>Delete</MenubarItem>
                        </MenubarGroup>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Checkbox Items</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>View</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>Toggle Options</MenubarLabel>
                        <MenubarGroup>
                            <MenubarCheckboxItem @bind-Checked="_showToolbar">Show Toolbar</MenubarCheckboxItem>
                            <MenubarCheckboxItem @bind-Checked="_showStatusBar">Show Status Bar</MenubarCheckboxItem>
                            <MenubarCheckboxItem @bind-Checked="_showSidebar">Show Sidebar</MenubarCheckboxItem>
                            <MenubarCheckboxItem @bind-Checked="_wordWrap" Disabled="true">Word Wrap (Disabled)</MenubarCheckboxItem>
                        </MenubarGroup>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Edit</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>Preferences</MenubarLabel>
                        <MenubarGroup>
                            <MenubarCheckboxItem @bind-Checked="_autoSave">Auto Save</MenubarCheckboxItem>
                            <MenubarCheckboxItem @bind-Checked="_autoFormat">Auto Format</MenubarCheckboxItem>
                        </MenubarGroup>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>
            <div class="mt-4 p-4 bg-muted rounded text-sm">
                <p><strong>State:</strong></p>
                <p>Show Toolbar: @_showToolbar | Show Status Bar: @_showStatusBar | Show Sidebar: @_showSidebar</p>
                <p>Auto Save: @_autoSave | Auto Format: @_autoFormat</p>
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Radio Items</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>Zoom</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>Zoom Level</MenubarLabel>
                        <MenubarRadioGroup @bind-Value="_zoomLevel">
                            <MenubarRadioItem Value="@("50%")">50%</MenubarRadioItem>
                            <MenubarRadioItem Value="@("75%")">75%</MenubarRadioItem>
                            <MenubarRadioItem Value="@("100%")">100%</MenubarRadioItem>
                            <MenubarRadioItem Value="@("125%")">125%</MenubarRadioItem>
                            <MenubarRadioItem Value="@("150%")">150%</MenubarRadioItem>
                            <MenubarRadioItem Value="@("200%")">200%</MenubarRadioItem>
                        </MenubarRadioGroup>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Theme</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>Color Theme</MenubarLabel>
                        <MenubarRadioGroup @bind-Value="_colorTheme">
                            <MenubarRadioItem Value="@("light")">Light</MenubarRadioItem>
                            <MenubarRadioItem Value="@("dark")">Dark</MenubarRadioItem>
                            <MenubarRadioItem Value="@("system")">System</MenubarRadioItem>
                            <MenubarRadioItem Value="@("high-contrast")" Disabled="true">High Contrast (Disabled)</MenubarRadioItem>
                        </MenubarRadioGroup>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Alignment</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>Text Alignment</MenubarLabel>
                        <MenubarRadioGroup @bind-Value="_textAlignment">
                            <MenubarRadioItem Value="@("left")">Left</MenubarRadioItem>
                            <MenubarRadioItem Value="@("center")">Center</MenubarRadioItem>
                            <MenubarRadioItem Value="@("right")">Right</MenubarRadioItem>
                            <MenubarRadioItem Value="@("justify")">Justify</MenubarRadioItem>
                        </MenubarRadioGroup>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>
            <div class="mt-4 p-4 bg-muted rounded text-sm">
                <p><strong>State:</strong></p>
                <p>Zoom Level: @_zoomLevel | Color Theme: @_colorTheme | Text Alignment: @_textAlignment</p>
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Combined: Checkbox and Radio Items</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>Preferences</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>View Options</MenubarLabel>
                        <MenubarGroup>
                            <MenubarCheckboxItem @bind-Checked="_showGrid">Show Grid</MenubarCheckboxItem>
                            <MenubarCheckboxItem @bind-Checked="_showRulers">Show Rulers</MenubarCheckboxItem>
                            <MenubarCheckboxItem @bind-Checked="_snapToGrid">Snap to Grid</MenubarCheckboxItem>
                        </MenubarGroup>
                        <MenubarSeparator />
                        <MenubarLabel>Grid Size</MenubarLabel>
                        <MenubarRadioGroup @bind-Value="_gridSize">
                            <MenubarRadioItem Value="@("small")">Small (8px)</MenubarRadioItem>
                            <MenubarRadioItem Value="@("medium")">Medium (16px)</MenubarRadioItem>
                            <MenubarRadioItem Value="@("large")">Large (32px)</MenubarRadioItem>
                        </MenubarRadioGroup>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>
            <div class="mt-4 p-4 bg-muted rounded text-sm">
                <p><strong>State:</strong></p>
                <p>Show Grid: @_showGrid | Show Rulers: @_showRulers | Snap to Grid: @_snapToGrid | Grid Size: @_gridSize</p>
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Multiple Menus</h2>
        <div class="p-6 border rounded-lg bg-card">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>File</MenubarTrigger>
                    <MenubarContent IsOpen="true">
                        <MenubarItem>New</MenubarItem>
                        <MenubarItem>Open</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem>Recent Files</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem>Exit</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Edit</MenubarTrigger>
                    <MenubarContent IsOpen="true">
                        <MenubarItem>Undo</MenubarItem>
                        <MenubarItem>Redo</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem>Cut</MenubarItem>
                        <MenubarItem>Copy</MenubarItem>
                        <MenubarItem>Paste</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem>Select All</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Help</MenubarTrigger>
                    <MenubarContent IsOpen="true">
                        <MenubarItem>Documentation</MenubarItem>
                        <MenubarItem>Keyboard Shortcuts</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem>About</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>
        </div>
    </section>
</div>

@code {
    // Checkbox states
    private bool _showToolbar = true;
    private bool _showStatusBar = true;
    private bool _showSidebar = false;
    private bool _wordWrap = false;
    private bool _autoSave = true;
    private bool _autoFormat = false;
    
    // Radio states
    private string _zoomLevel = "100%";
    private string _colorTheme = "system";
    private string _textAlignment = "left";
    
    // Combined states
    private bool _showGrid = true;
    private bool _showRulers = false;
    private bool _snapToGrid = true;
    private string _gridSize = "medium";
}
