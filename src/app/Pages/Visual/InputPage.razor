@page "/visual/input"
@using LowlandTech.Components.Input
@using LowlandTech.Components.Label
@using LowlandTech.Components.Icon
@using LowlandTech.Components.Button
@using LowlandTech.Components.InputGroup
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Input - Visual Test</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Input</h1>
    
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Input Types</h2>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Text</Label>
                <Input Type="text" Placeholder="Enter text..." />
            </div>
            <div>
                <Label>Email</Label>
                <Input Type="email" Placeholder="email@example.com" />
            </div>
            <div>
                <Label>Password</Label>
                <Input Type="password" Placeholder="Enter password..." />
            </div>
            <div>
                <Label>Number</Label>
                <Input Type="number" Placeholder="123" />
            </div>
            <div>
                <Label>Search</Label>
                <Input Type="search" Placeholder="Search..." />
            </div>
            <div>
                <Label>URL</Label>
                <Input Type="url" Placeholder="https://example.com" />
            </div>
            <div>
                <Label>Tel</Label>
                <Input Type="tel" Placeholder="+1 234 567 890" />
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Sizes</h2>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Small</Label>
                <Input Size="sm" Placeholder="Small input..." />
            </div>
            <div>
                <Label>Default</Label>
                <Input Placeholder="Default input..." />
            </div>
            <div>
                <Label>Large</Label>
                <Input Size="lg" Placeholder="Large input..." />
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">States</h2>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Default</Label>
                <Input Placeholder="Default state..." />
            </div>
            <div>
                <Label>Disabled</Label>
                <Input Disabled="true" Placeholder="Disabled input..." />
            </div>
            <div>
                <Label>Read Only</Label>
                <Input ReadOnly="true" Value="Read only value" />
            </div>
            <div>
                <Label>Destructive (Variant)</Label>
                <Input Variant="destructive" Placeholder="Error state..." />
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Validation States</h2>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label Required="true">Valid Input</Label>
                <Input Value="valid@example.com" />
                <p class="text-sm text-muted-foreground mt-1">This input has no validation errors.</p>
            </div>
            <div>
                <Label Required="true">Invalid Input (Error)</Label>
                <Input Invalid="true" Value="invalid-email" />
                <p class="text-sm text-red-500 mt-1">Please enter a valid email address.</p>
            </div>
            <div>
                <Label>Required Field Missing</Label>
                <Input Invalid="true" Placeholder=" " />
                <p class="text-sm text-red-500 mt-1">This field is required.</p>
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Form Validation Example</h2>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label Required="true" Description="Must be at least 3 characters.">Username</Label>
                <Input Invalid="@_usernameInvalid" 
                       Value="@_username" 
                       @oninput="e => _username = e.Value?.ToString()"
                       Placeholder="Enter username" />
                @if (_usernameInvalid)
                {
                    <p class="text-sm text-red-500 mt-1">Username is required.</p>
                }
            </div>
            <div>
                <Label Required="true">Password</Label>
                <Input Type="password" 
                       Invalid="@_passwordInvalid"
                       Value="@_password"
                       @oninput="e => _password = e.Value?.ToString()"
                       Placeholder="Enter password" />
                @if (_passwordInvalid)
                {
                    <p class="text-sm text-red-500 mt-1">Password must be at least 8 characters.</p>
                }
            </div>
            <div class="flex gap-2 pt-2">
                <button @onclick="ValidateForm" class="px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium">
                    Validate
                </button>
                <button @onclick="ClearValidation" class="px-4 py-2 border rounded-md text-sm font-medium">
                    Clear
                </button>
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Value</h2>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Prefilled</Label>
                <Input Value="Hello World" />
            </div>
            <div>
                <Label>Email</Label>
                <Input Type="email" Value="user@example.com" />
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Input Groups (SPEC1025)</h2>
        
        <h3 class="text-lg font-medium mb-3 text-muted-foreground">Leading Icon</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Search with Icon</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <Icon Name="search" />
                    </InputGroupAddon>
                    <Input placeholder="Search..." />
                </InputGroup>
            </div>
            <div>
                <Label>Email with User Icon</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <Icon Name="user" />
                    </InputGroupAddon>
                    <Input Type="email" placeholder="user@example.com" />
                </InputGroup>
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">Trailing Text/Icon</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>With Keyboard Shortcut</Label>
                <InputGroup>
                    <Input placeholder="Search commands..." />
                    <InputGroupAddon Align="inline-end">
                        <kbd class="font-sans text-xs bg-background border rounded px-1.5 py-0.5">⌘K</kbd>
                    </InputGroupAddon>
                </InputGroup>
            </div>
            <div>
                <Label>With Unit</Label>
                <InputGroup>
                    <Input Type="number" placeholder="0.00" />
                    <InputGroupAddon Align="inline-end">
                        <span class="text-sm">USD</span>
                    </InputGroupAddon>
                </InputGroup>
            </div>
            <div>
                <Label>With Settings Icon</Label>
                <InputGroup>
                    <Input placeholder="Configuration..." />
                    <InputGroupAddon Align="inline-end">
                        <Icon Name="settings" />
                    </InputGroupAddon>
                </InputGroup>
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">Both Sides</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>URL with Protocol and TLD</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <span class="text-sm">https://</span>
                    </InputGroupAddon>
                    <Input placeholder="example" />
                    <InputGroupAddon Align="inline-end">
                        <span class="text-sm">.com</span>
                    </InputGroupAddon>
                </InputGroup>
            </div>
            <div>
                <Label>Price with Currency</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <span class="text-sm">$</span>
                    </InputGroupAddon>
                    <Input Type="number" placeholder="0.00" />
                    <InputGroupAddon Align="inline-end">
                        <span class="text-sm">USD</span>
                    </InputGroupAddon>
                </InputGroup>
            </div>
            <div>
                <Label>Search with Both Icons</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <Icon Name="search" />
                    </InputGroupAddon>
                    <Input placeholder="Search..." />
                    <InputGroupAddon Align="inline-end">
                        <kbd class="font-sans text-xs bg-background border rounded px-1.5 py-0.5">⌘K</kbd>
                    </InputGroupAddon>
                </InputGroup>
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">With Buttons</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Search with Action Button</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <Icon Name="search" />
                    </InputGroupAddon>
                    <Input placeholder="Search..." />
                    <InputGroupAddon Align="inline-end">
                        <Button>Search</Button>
                    </InputGroupAddon>
                </InputGroup>
            </div>
            <div>
                <Label>Email with Subscribe Button</Label>
                <InputGroup>
                    <Input Type="email" placeholder="Enter your email" />
                    <InputGroupAddon Align="inline-end">
                        <Button>Subscribe</Button>
                    </InputGroupAddon>
                </InputGroup>
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">Sizes</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Small</Label>
                <InputGroup data-size="sm">
                    <InputGroupAddon>
                        <Icon Name="search" Size="16" />
                    </InputGroupAddon>
                    <Input Size="sm" placeholder="Small search..." />
                </InputGroup>
            </div>
            <div>
                <Label>Default</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <Icon Name="search" />
                    </InputGroupAddon>
                    <Input placeholder="Default search..." />
                </InputGroup>
            </div>
            <div>
                <Label>Large</Label>
                <InputGroup data-size="lg">
                    <InputGroupAddon>
                        <Icon Name="search" Size="24" />
                    </InputGroupAddon>
                    <Input Size="lg" placeholder="Large search..." />
                </InputGroup>
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">States</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Disabled</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <Icon Name="user" />
                    </InputGroupAddon>
                    <Input Disabled="true" Value="Disabled input" />
                </InputGroup>
            </div>
            <div>
                <Label>Invalid</Label>
                <InputGroup>
                    <InputGroupAddon>
                        <Icon Name="user" />
                    </InputGroupAddon>
                    <Input Invalid="true" placeholder="Invalid input..." />
                </InputGroup>
            </div>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">File Input (SPEC1025)</h2>
        
        <h3 class="text-lg font-medium mb-3 text-muted-foreground">Basic File Input</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Single File</Label>
                <LowlandTech.Components.Input.InputFile OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Multiple Files</Label>
                <LowlandTech.Components.Input.InputFile Multiple="true" 
                           ButtonText="Choose Files" 
                           Placeholder="No files chosen" 
                           OnFilesSelected="HandleFilesSelected" />
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">Variants</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Default (Primary)</Label>
                <LowlandTech.Components.Input.InputFile Variant="default" OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Secondary</Label>
                <LowlandTech.Components.Input.InputFile Variant="secondary" OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Outline</Label>
                <LowlandTech.Components.Input.InputFile Variant="outline" OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Ghost</Label>
                <LowlandTech.Components.Input.InputFile Variant="ghost" OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Destructive</Label>
                <LowlandTech.Components.Input.InputFile Variant="destructive" OnFilesSelected="HandleFilesSelected" />
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">Sizes</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Small</Label>
                <LowlandTech.Components.Input.InputFile Size="sm" OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Default</Label>
                <LowlandTech.Components.Input.InputFile OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Large</Label>
                <LowlandTech.Components.Input.InputFile Size="lg" OnFilesSelected="HandleFilesSelected" />
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">Custom Text & Icons</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Custom Button Text</Label>
                <LowlandTech.Components.Input.InputFile ButtonText="Upload Document" 
                           ButtonIcon="file-text" 
                           OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Image Upload</Label>
                <LowlandTech.Components.Input.InputFile ButtonText="Select Image" 
                           ButtonIcon="image" 
                           Accept="image/*" 
                           OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>PDF Only</Label>
                <LowlandTech.Components.Input.InputFile ButtonText="Select PDF" 
                           ButtonIcon="file" 
                           Accept=".pdf" 
                           OnFilesSelected="HandleFilesSelected" />
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">States</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Disabled</Label>
                <LowlandTech.Components.Input.InputFile Disabled="true" OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>No Clear Button</Label>
                <LowlandTech.Components.Input.InputFile AllowClear="false" OnFilesSelected="HandleFilesSelected" />
            </div>
            <div>
                <Label>Hidden File List</Label>
                <LowlandTech.Components.Input.InputFile ShowSelectedFiles="false" OnFilesSelected="HandleFilesSelected" />
            </div>
        </div>

        <h3 class="text-lg font-medium mb-3 mt-6 text-muted-foreground">File Selection Feedback</h3>
        <div class="space-y-4 p-6 border rounded-lg bg-card">
            <div>
                <Label>Select Files to See Feedback</Label>
                <LowlandTech.Components.Input.InputFile Multiple="true" OnFilesSelected="HandleFilesSelected" />
            </div>
            @if (_lastSelectedFiles?.Count > 0)
            {
                <div class="mt-4 p-4 bg-muted rounded-md">
                    <p class="text-sm font-medium mb-2">Selected Files:</p>
                    <ul class="space-y-1">
                        @foreach (var file in _lastSelectedFiles)
                        {
                            <li class="text-sm text-muted-foreground flex items-center gap-2">
                                <Icon Name="file" Size="14" />
                                <span>@file.Name</span>
                                <span class="text-xs">(@FormatFileSize(file.Size))</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private string? _username;
    private string? _password;
    private bool _usernameInvalid;
    private bool _passwordInvalid;
    private IReadOnlyList<IBrowserFile>? _lastSelectedFiles;

    private void ValidateForm()
    {
        _usernameInvalid = string.IsNullOrWhiteSpace(_username);
        _passwordInvalid = string.IsNullOrWhiteSpace(_password) || (_password?.Length ?? 0) < 8;
    }

    private void ClearValidation()
    {
        _usernameInvalid = false;
        _passwordInvalid = false;
        _username = null;
        _password = null;
    }

    private void HandleFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        _lastSelectedFiles = files;
    }

    private static string FormatFileSize(long bytes)
    {
        return bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
            < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):F1} MB",
            _ => $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} GB"
        };
    }
}
