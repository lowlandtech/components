@page "/visual/aspect-ratio"
@using LowlandTech.Components.AspectRatio

<PageTitle>Aspect Ratio - Visual Test</PageTitle>

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold">Aspect Ratio</h1>
        <p class="text-muted-foreground">Displays content within a desired ratio.</p>
    </div>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">16:9 Aspect Ratio</h2>
        <p class="text-sm text-muted-foreground">Commonly used for video content.</p>
        <div class="w-full max-w-md overflow-hidden rounded-md border">
            <AspectRatio ratio="16/9">
                <div class="flex h-full w-full items-center justify-center bg-muted">
                    <span class="text-muted-foreground">16:9 Ratio</span>
                </div>
            </AspectRatio>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">4:3 Aspect Ratio</h2>
        <p class="text-sm text-muted-foreground">Standard TV and monitor ratio.</p>
        <div class="w-full max-w-md overflow-hidden rounded-md border">
            <AspectRatio ratio="4/3">
                <div class="flex h-full w-full items-center justify-center bg-muted">
                    <span class="text-muted-foreground">4:3 Ratio</span>
                </div>
            </AspectRatio>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">1:1 Aspect Ratio (Square)</h2>
        <p class="text-sm text-muted-foreground">Perfect for profile pictures and thumbnails.</p>
        <div class="w-64 overflow-hidden rounded-md border">
            <AspectRatio ratio="1/1">
                <div class="flex h-full w-full items-center justify-center bg-muted">
                    <span class="text-muted-foreground">1:1 Ratio</span>
                </div>
            </AspectRatio>
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">21:9 Aspect Ratio (Ultrawide)</h2>
        <p class="text-sm text-muted-foreground">Cinematic widescreen format.</p>
        <div class="w-full max-w-2xl overflow-hidden rounded-md border">
            <AspectRatio ratio="21/9">
                <div class="flex h-full w-full items-center justify-center bg-muted">
                    <span class="text-muted-foreground">21:9 Ratio</span>
                </div>
            </AspectRatio>
        </div>
    </section>
</div>
