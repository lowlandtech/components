@page "/visual/sidebar"
@using LowlandTech.Components.Sidebar
@using LowlandTech.Components.Icon

<PageTitle>Sidebar - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Sidebar</h1>

    <div class="space-y-12">
        <!-- Basic Sidebar -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Sidebar</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-80 border rounded-lg overflow-hidden flex">
                    <Sidebar class="w-64 border-r bg-muted/30">
                        <SidebarHeader class="p-4 border-b">
                            <h3 class="font-semibold">My App</h3>
                        </SidebarHeader>
                        <SidebarContent class="p-2">
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton IsActive="true">
                                        <Icon class="mr-2" />
                                        <span>Dashboard</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <Icon class="mr-2" />
                                        <span>Projects</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <Icon class="mr-2" />
                                        <span>Tasks</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <Icon class="mr-2" />
                                        <span>Calendar</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarContent>
                        <SidebarFooter class="p-4 border-t mt-auto">
                            <p class="text-xs text-muted-foreground">© 2026 My App</p>
                        </SidebarFooter>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Main content area</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- With Grouped Navigation -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Grouped Navigation</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-96 border rounded-lg overflow-hidden flex">
                    <Sidebar class="w-64 border-r bg-muted/30">
                        <SidebarHeader class="p-4 border-b">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded bg-primary"></div>
                                <span class="font-semibold">Workspace</span>
                            </div>
                        </SidebarHeader>
                        <SidebarContent class="p-2 space-y-4">
                            <div>
                                <p class="px-3 py-2 text-xs font-medium text-muted-foreground uppercase">Overview</p>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton IsActive="true">
                                            <span>Home</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <span>Analytics</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <span>Reports</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </div>
                            <div>
                                <p class="px-3 py-2 text-xs font-medium text-muted-foreground uppercase">Management</p>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <span>Users</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <span>Teams</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <span>Settings</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </div>
                        </SidebarContent>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Main content area</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Compact Sidebar -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Compact Sidebar</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-80 border rounded-lg overflow-hidden flex">
                    <Sidebar class="w-16 border-r bg-muted/30">
                        <SidebarHeader class="p-2 border-b flex justify-center">
                            <div class="w-8 h-8 rounded bg-primary"></div>
                        </SidebarHeader>
                        <SidebarContent class="p-2">
                            <SidebarMenu class="space-y-2">
                                <SidebarMenuItem>
                                    <SidebarMenuButton IsActive="true" class="justify-center">
                                        <span class="sr-only">Dashboard</span>
                                        <span class="text-lg">D</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton class="justify-center">
                                        <span class="sr-only">Projects</span>
                                        <span class="text-lg">P</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton class="justify-center">
                                        <span class="sr-only">Tasks</span>
                                        <span class="text-lg">T</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton class="justify-center">
                                        <span class="sr-only">Calendar</span>
                                        <span class="text-lg">C</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarContent>
                        <SidebarFooter class="p-2 border-t mt-auto">
                            <SidebarMenuButton class="justify-center">
                                <span class="sr-only">Settings</span>
                                <span class="text-lg">S</span>
                            </SidebarMenuButton>
                        </SidebarFooter>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Main content area</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- With User Profile -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With User Profile</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-80 border rounded-lg overflow-hidden flex">
                    <Sidebar class="w-64 border-r bg-muted/30">
                        <SidebarHeader class="p-4 border-b">
                            <h3 class="font-semibold">Navigation</h3>
                        </SidebarHeader>
                        <SidebarContent class="p-2">
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton IsActive="true">
                                        <span>Inbox</span>
                                        <span class="ml-auto text-xs bg-primary text-primary-foreground px-2 py-0.5 rounded-full">12</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <span>Sent</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <span>Drafts</span>
                                        <span class="ml-auto text-xs text-muted-foreground">3</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <span>Trash</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarContent>
                        <SidebarFooter class="p-4 border-t">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-sm font-medium">
                                    JD
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium truncate">John Doe</p>
                                    <p class="text-xs text-muted-foreground truncate">john@example.com</p>
                                </div>
                            </div>
                        </SidebarFooter>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Main content area</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Floating Sidebar -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Floating Style</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-80 border rounded-lg overflow-hidden flex bg-muted/20">
                    <Sidebar class="w-56 m-3 rounded-xl bg-background shadow-lg border">
                        <SidebarHeader class="p-4 border-b">
                            <h3 class="font-semibold">Menu</h3>
                        </SidebarHeader>
                        <SidebarContent class="p-2">
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton IsActive="true">
                                        <span>Overview</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <span>Customers</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <span>Products</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <span>Orders</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarContent>
                        <SidebarFooter class="p-4 border-t">
                            <p class="text-xs text-muted-foreground">v2.0.0</p>
                        </SidebarFooter>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Main content area</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Right-aligned Sidebar -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Right-aligned</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-80 border rounded-lg overflow-hidden flex">
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Main content area</p>
                    </div>
                    <Sidebar class="w-64 border-l bg-muted/30">
                        <SidebarHeader class="p-4 border-b">
                            <h3 class="font-semibold">Properties</h3>
                        </SidebarHeader>
                        <SidebarContent class="p-4 space-y-4">
                            <div>
                                <label class="text-sm font-medium">Name</label>
                                <input type="text" class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm" value="Untitled" />
                            </div>
                            <div>
                                <label class="text-sm font-medium">Status</label>
                                <select class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm">
                                    <option>Active</option>
                                    <option>Draft</option>
                                    <option>Archived</option>
                                </select>
                            </div>
                        </SidebarContent>
                        <SidebarFooter class="p-4 border-t">
                            <button class="w-full px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium">Save Changes</button>
                        </SidebarFooter>
                    </Sidebar>
                </div>
            </div>
        </section>

        <!-- SidebarTrigger - Hamburger Toggle Button -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">SidebarTrigger - Toggle Button</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-80 border rounded-lg overflow-hidden flex">
                    <Sidebar class="@GetTriggerClass()">
                        <SidebarHeader class="p-4 border-b min-w-[16rem]">
                            <h3 class="font-semibold">Collapsible Menu</h3>
                        </SidebarHeader>
                        <SidebarContent class="p-2 min-w-[16rem]">
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton IsActive="true">
                                        <Icon class="mr-2" />
                                        <span>Home</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <Icon class="mr-2" />
                                        <span>Documents</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <Icon class="mr-2" />
                                        <span>Settings</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarContent>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <SidebarTrigger class="p-2 rounded-md hover:bg-muted transition-colors" OnClick="() => _triggerExpanded = !_triggerExpanded">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="3" y1="12" x2="21" y2="12"></line>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <line x1="3" y1="18" x2="21" y2="18"></line>
                            </svg>
                            <span class="sr-only">Toggle Sidebar</span>
                        </SidebarTrigger>
                        <p class="text-muted-foreground mt-4">Click the hamburger button to toggle the sidebar</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SidebarRail - Collapsible Rail with Icons -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">SidebarRail - Collapsible Rail</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-80 border rounded-lg overflow-hidden flex">
                    <div class="relative flex">
                        <Sidebar class="@GetRailClass()">
                            <SidebarHeader class="@GetRailHeaderClass()">
                                @if (_railExpanded)
                                {
                                    <h3 class="font-semibold">Rail Mode</h3>
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded bg-primary flex items-center justify-center text-primary-foreground font-bold">R</div>
                                }
                            </SidebarHeader>
                            <SidebarContent class="p-2">
                                <SidebarMenu class="space-y-1">
                                    <SidebarMenuItem>
                                        <SidebarMenuButton IsActive="true" class="@(_railExpanded ? "" : "justify-center px-2")">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                                                <rect x="3" y="3" width="7" height="7"></rect>
                                                <rect x="14" y="3" width="7" height="7"></rect>
                                                <rect x="14" y="14" width="7" height="7"></rect>
                                                <rect x="3" y="14" width="7" height="7"></rect>
                                            </svg>
                                            @if (_railExpanded)
                                            {
                                                <span class="ml-2">Dashboard</span>
                                            }
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton class="@(_railExpanded ? "" : "justify-center px-2")">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                                <polyline points="10 9 9 9 8 9"></polyline>
                                            </svg>
                                            @if (_railExpanded)
                                            {
                                                <span class="ml-2">Documents</span>
                                            }
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton class="@(_railExpanded ? "" : "justify-center px-2")">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                                                <circle cx="12" cy="12" r="3"></circle>
                                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                            </svg>
                                            @if (_railExpanded)
                                            {
                                                <span class="ml-2">Settings</span>
                                            }
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarContent>
                            <SidebarFooter class="p-4 border-t mt-auto">
                                @if (_railExpanded)
                                {
                                    <p class="text-xs text-muted-foreground">v2.0.0</p>
                                }
                                else
                                {
                                    <div class="w-2 h-2 rounded-full bg-green-500 mx-auto"></div>
                                }
                            </SidebarFooter>
                        </Sidebar>
                        <SidebarRail class="absolute right-0 top-0 bottom-0 w-1 hover:w-2 hover:bg-primary/20 cursor-pointer transition-all duration-200" OnClick="() => _railExpanded = !_railExpanded" />
                    </div>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Hover over the right edge of the sidebar to see the rail trigger. Click to toggle between expanded and collapsed rail view.</p>
                        <p class="text-sm text-muted-foreground mt-2">State: <span class="font-mono bg-muted px-2 py-1 rounded">@(_railExpanded ? "expanded" : "collapsed")</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SidebarInput - Search Input -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">SidebarInput - Search Field</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-96 border rounded-lg overflow-hidden flex">
                    <Sidebar class="w-64 border-r bg-muted/30">
                        <SidebarHeader class="p-4 border-b">
                            <h3 class="font-semibold">Searchable Menu</h3>
                        </SidebarHeader>
                        <SidebarContent class="p-2">
                            <div class="px-2 py-2">
                                <div class="relative">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                    <SidebarInput @bind-Value="_searchQuery" placeholder="Search..." class="w-full pl-9 pr-4 py-2 text-sm bg-background border rounded-md" />
                                </div>
                            </div>
                            <SidebarMenu class="mt-2">
                                @foreach (var item in GetFilteredItems())
                                {
                                    <SidebarMenuItem>
                                        <SidebarMenuButton IsActive="item.IsActive">
                                            <Icon class="mr-2" />
                                            <span>@item.Name</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                }
                            </SidebarMenu>
                        </SidebarContent>
                        <SidebarFooter class="p-4 border-t">
                            <p class="text-xs text-muted-foreground">@GetFilteredItems().Count items found</p>
                        </SidebarFooter>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Type in the search input to filter the menu items</p>
                        <p class="text-sm text-muted-foreground mt-2">Current query: <span class="font-mono bg-muted px-2 py-1 rounded">@(_searchQuery ?? "(empty)")</span></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Collapsible Submenu with Chevron -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Collapsible Submenu</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-96 border rounded-lg overflow-hidden flex">
                    <Sidebar class="w-64 border-r bg-muted/30">
                        <SidebarHeader class="p-4 border-b">
                            <h3 class="font-semibold">Nested Navigation</h3>
                        </SidebarHeader>
                        <SidebarContent class="p-2">
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton IsActive="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                            <rect x="3" y="3" width="7" height="7"></rect>
                                            <rect x="14" y="3" width="7" height="7"></rect>
                                            <rect x="14" y="14" width="7" height="7"></rect>
                                            <rect x="3" y="14" width="7" height="7"></rect>
                                        </svg>
                                        <span>Dashboard</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>

                                <!-- Collapsible Submenu -->
                                <SidebarMenuItem>
                                    <SidebarMenuSubTrigger IsExpanded="_submenuExpanded" OnClick="() => _submenuExpanded = !_submenuExpanded">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                        <span>Documents</span>
                                    </SidebarMenuSubTrigger>
                                    <SidebarMenuSub IsOpen="_submenuExpanded">
                                        <SidebarMenuSubItem>
                                            <SidebarMenuSubButton>
                                                <span>All Documents</span>
                                            </SidebarMenuSubButton>
                                        </SidebarMenuSubItem>
                                        <SidebarMenuSubItem>
                                            <SidebarMenuSubButton IsActive="true">
                                                <span>Recent</span>
                                            </SidebarMenuSubButton>
                                        </SidebarMenuSubItem>
                                        <SidebarMenuSubItem>
                                            <SidebarMenuSubButton>
                                                <span>Shared</span>
                                            </SidebarMenuSubButton>
                                        </SidebarMenuSubItem>
                                        <SidebarMenuSubItem>
                                            <SidebarMenuSubButton>
                                                <span>Trash</span>
                                            </SidebarMenuSubButton>
                                        </SidebarMenuSubItem>
                                    </SidebarMenuSub>
                                </SidebarMenuItem>

                                <SidebarMenuItem>
                                    <SidebarMenuButton>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="9" cy="7" r="4"></circle>
                                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                        </svg>
                                        <span>Users</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>

                                <!-- Another Collapsible Submenu -->
                                <SidebarMenuItem>
                                    <SidebarMenuSubTrigger IsExpanded="_settingsExpanded" OnClick="() => _settingsExpanded = !_settingsExpanded">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                            <circle cx="12" cy="12" r="3"></circle>
                                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                        </svg>
                                        <span>Settings</span>
                                    </SidebarMenuSubTrigger>
                                    <SidebarMenuSub IsOpen="_settingsExpanded">
