                                            <SidebarMenuSubButton>
                                                <span>General</span>
                                            </SidebarMenuSubButton>
                                        </SidebarMenuSubItem>
                                        <SidebarMenuSubItem>
                                            <SidebarMenuSubButton>
                                                <span>Security</span>
                                            </SidebarMenuSubButton>
                                        </SidebarMenuSubItem>
                                        <SidebarMenuSubItem>
                                            <SidebarMenuSubButton>
                                                <span>Notifications</span>
                                            </SidebarMenuSubButton>
                                        </SidebarMenuSubItem>
                                    </SidebarMenuSub>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarContent>
                        <SidebarFooter class="p-4 border-t">
                            <p class="text-xs text-muted-foreground">Click chevrons to expand/collapse</p>
                        </SidebarFooter>
                    </Sidebar>
                    <div class="flex-1 p-6">
                        <p class="text-muted-foreground">Submenus with chevron indicators. Click on "Documents" or "Settings" to toggle submenus.</p>
                        <div class="mt-4 space-y-2 text-sm">
                            <p>Documents submenu: <span class="font-mono bg-muted px-2 py-1 rounded">@(_submenuExpanded ? "expanded" : "collapsed")</span></p>
                            <p>Settings submenu: <span class="font-mono bg-muted px-2 py-1 rounded">@(_settingsExpanded ? "expanded" : "collapsed")</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Combined Demo - All Features -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Complete Sidebar - All Features</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="h-[500px] border rounded-lg overflow-hidden flex">
                    <SidebarProvider>
                        <div class="relative flex">
                            <Sidebar class="@GetCompleteClass()">
                                <SidebarHeader class="@GetCompleteHeaderClass()">
                                    @if (_completeExpanded)
                                    {
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded bg-primary flex items-center justify-center text-primary-foreground font-bold">A</div>
                                            <h3 class="font-semibold">Acme Corp</h3>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-8 h-8 rounded bg-primary flex items-center justify-center text-primary-foreground font-bold">A</div>
                                    }
                                </SidebarHeader>
                                <SidebarContent class="p-2">
                                    @if (_completeExpanded)
                                    {
                                        <div class="px-2 py-2">
                                            <div class="relative">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                </svg>
                                                <SidebarInput placeholder="Search..." class="w-full pl-9 pr-4 py-2 text-sm bg-background border rounded-md" />
                                            </div>
                                        </div>
                                    }
                                    <SidebarMenu class="mt-2 space-y-1">
                                        <SidebarMenuItem>
                                            <SidebarMenuButton IsActive="true" class="@(_completeExpanded ? "" : "justify-center px-2")">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                                                    <rect x="3" y="3" width="7" height="7"></rect>
                                                    <rect x="14" y="3" width="7" height="7"></rect>
                                                    <rect x="14" y="14" width="7" height="7"></rect>
                                                    <rect x="3" y="14" width="7" height="7"></rect>
                                                </svg>
                                                @if (_completeExpanded)
                                                {
                                                    <span class="ml-2">Dashboard</span>
                                                }
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>

                                        @if (_completeExpanded)
                                        {
                                            <SidebarMenuItem>
                                                <SidebarMenuSubTrigger IsExpanded="_completeSubmenu1" OnClick="() => _completeSubmenu1 = !_completeSubmenu1">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                        <polyline points="14 2 14 8 20 8"></polyline>
                                                    </svg>
                                                    <span>Projects</span>
                                                </SidebarMenuSubTrigger>
                                                <SidebarMenuSub IsOpen="_completeSubmenu1">
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Active</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Archived</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                </SidebarMenuSub>
                                            </SidebarMenuItem>
                                        }
                                        else
                                        {
                                            <SidebarMenuItem>
                                                <SidebarMenuButton class="justify-center px-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                        <polyline points="14 2 14 8 20 8"></polyline>
                                                    </svg>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                        }

                                        <SidebarMenuItem>
                                            <SidebarMenuButton class="@(_completeExpanded ? "" : "justify-center px-2")">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="9" cy="7" r="4"></circle>
                                                </svg>
                                                @if (_completeExpanded)
                                                {
                                                    <span class="ml-2">Team</span>
                                                }
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>

                                        @if (_completeExpanded)
                                        {
                                            <SidebarMenuItem>
                                                <SidebarMenuSubTrigger IsExpanded="_completeSubmenu2" OnClick="() => _completeSubmenu2 = !_completeSubmenu2">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                                        <circle cx="12" cy="12" r="3"></circle>
                                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                                    </svg>
                                                    <span>Settings</span>
                                                </SidebarMenuSubTrigger>
                                                <SidebarMenuSub IsOpen="_completeSubmenu2">
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Profile</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Preferences</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton>Billing</SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                </SidebarMenuSub>
                                            </SidebarMenuItem>
                                        }
                                        else
                                        {
                                            <SidebarMenuItem>
                                                <SidebarMenuButton class="justify-center px-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="3"></circle>
                                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                                    </svg>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                        }
                                    </SidebarMenu>
                                </SidebarContent>
                                <SidebarFooter class="p-4 border-t">
                                    @if (_completeExpanded)
                                    {
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-sm font-medium">
                                                JD
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-medium truncate">John Doe</p>
                                                <p class="text-xs text-muted-foreground truncate">john@example.com</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-sm font-medium mx-auto">
                                            JD
                                        </div>
                                    }
                                </SidebarFooter>
                                <SidebarRail OnClick="() => _completeExpanded = !_completeExpanded" />
                            </Sidebar>
                        </div>
                    </SidebarProvider>
                    <div class="flex-1 p-6 bg-muted/5">
                        <div class="flex items-center gap-4 mb-4">
                            <SidebarTrigger class="p-2 rounded-md hover:bg-muted transition-colors" OnClick="() => _completeExpanded = !_completeExpanded">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="3" y1="12" x2="21" y2="12"></line>
                                    <line x1="3" y1="6" x2="21" y2="6"></line>
                                    <line x1="3" y1="18" x2="21" y2="18"></line>
                                </svg>
                            </SidebarTrigger>
                            <h3 class="font-semibold">Main Content</h3>
                        </div>
                        <p class="text-muted-foreground">This demo combines all Sidebar features:</p>
                        <ul class="list-disc list-inside mt-2 text-sm text-muted-foreground space-y-1">
                            <li><strong>SidebarTrigger</strong> - Hamburger menu button to toggle</li>
                            <li><strong>SidebarRail</strong> - Edge trigger for expanding/collapsing</li>
                            <li><strong>SidebarInput</strong> - Search input field (visible when expanded)</li>
                            <li><strong>Collapsible Submenus</strong> - With chevron indicators</li>
                            <li><strong>Smooth Animations</strong> - CSS transitions for all state changes</li>
                        </ul>
                        <div class="mt-4 p-4 bg-muted rounded-lg">
                            <p class="text-sm">State: <span class="font-mono bg-background px-2 py-1 rounded">@(_completeExpanded ? "expanded" : "collapsed")</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    // SidebarTrigger state
    private bool _triggerExpanded = true;

    // SidebarRail state
    private bool _railExpanded = true;

    // SidebarInput state
    private string? _searchQuery;

    private readonly List<MenuItem> _menuItems = new()
    {
        new("Dashboard", true),
        new("Projects", false),
        new("Tasks", false),
        new("Calendar", false),
        new("Documents", false),
        new("Messages", false),
        new("Settings", false),
        new("Help", false)
    };

    private List<MenuItem> GetFilteredItems()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return _menuItems;

        return _menuItems.Where(i => i.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    // Collapsible Submenu state
    private bool _submenuExpanded = true;
    private bool _settingsExpanded;

    // Complete demo state
    private bool _completeExpanded = true;
    private bool _completeSubmenu1;
    private bool _completeSubmenu2;

    private record MenuItem(string Name, bool IsActive);

    private string GetTriggerClass() => _triggerExpanded ? "w-64 border-r bg-muted/30 overflow-hidden transition-all duration-300 ease-in-out" : "w-0 border-r bg-muted/30 overflow-hidden transition-all duration-300 ease-in-out";

    private string GetRailClass() => _railExpanded ? "w-64 border-r bg-muted/30 transition-all duration-300 ease-in-out overflow-hidden" : "w-16 border-r bg-muted/30 transition-all duration-300 ease-in-out overflow-hidden";

    private string GetRailHeaderClass() => _railExpanded ? "p-4 border-b flex items-center h-16" : "p-4 border-b flex justify-center items-center h-16";

    private string GetCompleteClass() => _completeExpanded ? "w-72 border-r bg-muted/30 transition-all duration-300 ease-in-out" : "w-16 border-r bg-muted/30 transition-all duration-300 ease-in-out";

    private string GetCompleteHeaderClass() => _completeExpanded ? "p-4 border-b flex items-center h-16" : "p-4 border-b flex justify-center items-center h-16";
}
