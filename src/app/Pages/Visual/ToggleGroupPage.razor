@page "/visual/toggle-group"
@using LowlandTech.Components.ToggleGroup

<PageTitle>Toggle Group - Visual Testing</PageTitle>

<div class="max-w-4xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Toggle Group</h1>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Default Toggle Group</h2>
        <ToggleGroup>
            <ToggleGroupItem>Bold</ToggleGroupItem>
            <ToggleGroupItem>Italic</ToggleGroupItem>
            <ToggleGroupItem>Underline</ToggleGroupItem>
        </ToggleGroup>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Icons</h2>
        <ToggleGroup>
            <ToggleGroupItem>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h8a4 4 0 0 0 0-8H6v8Z"/><path d="M6 20h10a4 4 0 0 0 0-8H6v8Z"/></svg>
            </ToggleGroupItem>
            <ToggleGroupItem>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
            </ToggleGroupItem>
            <ToggleGroupItem>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v6a6 6 0 0 0 12 0V4"/><line x1="4" x2="20" y1="20" y2="20"/></svg>
            </ToggleGroupItem>
        </ToggleGroup>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Size Variants</h2>
        <div class="space-y-4">
            <ToggleGroup size="sm">
                <ToggleGroupItem>Small</ToggleGroupItem>
                <ToggleGroupItem>Size</ToggleGroupItem>
            </ToggleGroup>
            <ToggleGroup size="default">
                <ToggleGroupItem>Default</ToggleGroupItem>
                <ToggleGroupItem>Size</ToggleGroupItem>
            </ToggleGroup>
            <ToggleGroup size="lg">
                <ToggleGroupItem>Large</ToggleGroupItem>
                <ToggleGroupItem>Size</ToggleGroupItem>
            </ToggleGroup>
        </div>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Variant Styles</h2>
        <div class="space-y-4">
            <ToggleGroup variant="default">
                <ToggleGroupItem>Default</ToggleGroupItem>
                <ToggleGroupItem>Variant</ToggleGroupItem>
            </ToggleGroup>
            <ToggleGroup variant="outline">
                <ToggleGroupItem>Outline</ToggleGroupItem>
                <ToggleGroupItem>Variant</ToggleGroupItem>
            </ToggleGroup>
            <ToggleGroup variant="ghost">
                <ToggleGroupItem>Ghost</ToggleGroupItem>
                <ToggleGroupItem>Variant</ToggleGroupItem>
            </ToggleGroup>
        </div>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Vertical Orientation</h2>
        <ToggleGroup Orientation="vertical">
            <ToggleGroupItem>Option 1</ToggleGroupItem>
            <ToggleGroupItem>Option 2</ToggleGroupItem>
            <ToggleGroupItem>Option 3</ToggleGroupItem>
        </ToggleGroup>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Text Alignment Example</h2>
        <div class="p-4 rounded-lg border bg-card space-y-4">
            <ToggleGroup variant="outline">
                <ToggleGroupItem>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="15" x2="3" y1="12" y2="12"/><line x1="17" x2="3" y1="18" y2="18"/></svg>
                </ToggleGroupItem>
                <ToggleGroupItem>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="17" x2="7" y1="12" y2="12"/><line x1="19" x2="5" y1="18" y2="18"/></svg>
                </ToggleGroupItem>
                <ToggleGroupItem>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="21" x2="9" y1="12" y2="12"/><line x1="21" x2="7" y1="18" y2="18"/></svg>
                </ToggleGroupItem>
                <ToggleGroupItem>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="21" x2="3" y1="12" y2="12"/><line x1="21" x2="3" y1="18" y2="18"/></svg>
                </ToggleGroupItem>
            </ToggleGroup>
            <p class="text-sm text-muted-foreground">Select text alignment option</p>
        </div>
    </section>

    <section class="mb-12">
        <h2 class="text-xl font-semibold mb-4 text-muted-foreground">View Options Example</h2>
        <div class="p-4 rounded-lg border bg-card space-y-4">
            <ToggleGroup variant="outline">
                <ToggleGroupItem>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                    <span class="ml-2">Grid</span>
                </ToggleGroupItem>
                <ToggleGroupItem>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
                    <span class="ml-2">List</span>
                </ToggleGroupItem>
            </ToggleGroup>
            <p class="text-sm text-muted-foreground">Switch between grid and list view</p>
        </div>
    </section>
</div>
