@page "/visual/hover-card"

<PageTitle>Hover Card - Visual Test</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Hover Card</h1>
    
    <div class="space-y-12">
        <!-- Default Hover Card -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Default</h2>
            <div class="p-6 border rounded-lg">
                <HoverCard class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="link">@@nextjs</Button>
                    </HoverCardTrigger>
                    <HoverCardContent class="w-80">
                        <div class="flex gap-4">
                            <Avatar class="h-12 w-12">
                                <AvatarImage Src="https://github.com/vercel.png" />
                                <AvatarFallback>VC</AvatarFallback>
                            </Avatar>
                            <div class="space-y-1">
                                <h4 class="text-sm font-semibold">@@nextjs</h4>
                                <p class="text-sm text-muted-foreground">The React Framework for the Web. Used by some of the world's largest companies.</p>
                                <div class="flex items-center pt-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 text-muted-foreground">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                    <span class="text-xs text-muted-foreground">Joined December 2021</span>
                                </div>
                            </div>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </section>

        <!-- With Open Delay -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Open Delay (500ms)</h2>
            <p class="text-sm text-muted-foreground mb-4">Hover and wait 500ms before the card appears.</p>
            <div class="p-6 border rounded-lg">
                <HoverCard Delay="500" class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="outline">Hover me (delayed open)</Button>
                    </HoverCardTrigger>
                    <HoverCardContent class="w-72">
                        <div class="space-y-3">
                            <p class="font-semibold">Delayed Open</p>
                            <p class="text-sm text-muted-foreground">This card appears 500ms after you hover over the trigger, preventing accidental popups.</p>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </section>

        <!-- With Close Delay -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Close Delay (1000ms)</h2>
            <p class="text-sm text-muted-foreground mb-4">The card stays visible for 1 second after you move the mouse away.</p>
            <div class="p-6 border rounded-lg">
                <HoverCard DelayHide="1000" class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="outline">Hover me (delayed close)</Button>
                    </HoverCardTrigger>
                    <HoverCardContent class="w-72">
                        <div class="space-y-3">
                            <p class="font-semibold">Delayed Close</p>
                            <p class="text-sm text-muted-foreground">This card stays open for 1 second after you move away, giving you time to interact with the content.</p>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </section>

        <!-- With Both Delays -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Open & Close Delay (300ms / 600ms)</h2>
            <p class="text-sm text-muted-foreground mb-4">Combines both delays for a controlled experience.</p>
            <div class="p-6 border rounded-lg">
                <HoverCard Delay="300" DelayHide="600" class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="outline">Hover me (both delays)</Button>
                    </HoverCardTrigger>
                    <HoverCardContent class="w-72">
                        <div class="space-y-3">
                            <p class="font-semibold">Dual Delays</p>
                            <p class="text-sm text-muted-foreground">Opens after 300ms, closes 600ms after mouse leave. Useful for complex hover cards with interactive content.</p>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </section>

        <!-- With Avatar Trigger -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Avatar Trigger</h2>
            <div class="p-6 border rounded-lg">
                <div class="flex items-center gap-4">
                    <HoverCard Delay="200" class="inline-block">
                        <HoverCardTrigger>
                            <Avatar class="cursor-pointer">
                                <AvatarImage Src="https://github.com/shadcn.png" />
                                <AvatarFallback>JD</AvatarFallback>
                            </Avatar>
                        </HoverCardTrigger>
                        <HoverCardContent class="w-72">
                            <div class="space-y-3">
                                <div class="flex items-center gap-3">
                                    <Avatar>
                                        <AvatarImage Src="https://github.com/shadcn.png" />
                                        <AvatarFallback>JD</AvatarFallback>
                                    </Avatar>
                                    <div>
                                        <p class="font-semibold">John Doe</p>
                                        <p class="text-sm text-muted-foreground">Software Engineer</p>
                                    </div>
                                </div>
                                <Separator />
                                <div class="space-y-1 text-sm">
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                        </svg>
                                        <span>john@example.com</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        <span>San Francisco, CA</span>
                                    </div>
                                </div>
                            </div>
                        </HoverCardContent>
                    </HoverCard>
                    <span class="text-sm text-muted-foreground">Hover over the avatar (200ms delay)</span>
                </div>
            </div>
        </section>

        <!-- Team Members -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Team Members</h2>
            <div class="p-6 border rounded-lg">
                <div class="flex -space-x-2">
                    @foreach (var member in _teamMembers)
                    {
                        <HoverCard Delay="250" DelayHide="500" class="relative inline-block">
                            <HoverCardTrigger>
                                <Avatar class="border-2 border-background cursor-pointer hover:z-10 hover:scale-110 transition-transform">
                                    <AvatarImage Src="@member.Avatar" />
                                    <AvatarFallback>@member.Initials</AvatarFallback>
                                </Avatar>
                            </HoverCardTrigger>
                            <HoverCardContent class="w-64">
                                <div class="flex items-start gap-3">
                                    <Avatar>
                                        <AvatarImage Src="@member.Avatar" />
                                        <AvatarFallback>@member.Initials</AvatarFallback>
                                    </Avatar>
                                    <div>
                                        <p class="font-semibold">@member.Name</p>
                                        <p class="text-sm text-muted-foreground">@member.Role</p>
                                        <Badge Variant="secondary" class="mt-2">@member.Status</Badge>
                                    </div>
                                </div>
                            </HoverCardContent>
                        </HoverCard>
                    }
                </div>
            </div>
        </section>

        <!-- Product Preview -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Product Preview</h2>
            <div class="p-6 border rounded-lg">
                <HoverCard Delay="400" DelayHide="800" class="inline-block">
                    <HoverCardTrigger>
                        <div class="flex items-center gap-3 p-3 border rounded-lg hover:bg-muted/50 cursor-pointer transition-colors">
                            <div class="w-12 h-12 bg-primary/10 rounded-md flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                    <path d="M3 6h18"/>
                                    <path d="M16 10a4 4 0 0 1-8 0"/>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium">Premium Backpack</p>
                                <p class="text-sm text-muted-foreground">$129.00</p>
                            </div>
                        </div>
                    </HoverCardTrigger>
                    <HoverCardContent class="w-72">
                        <div class="space-y-3">
                            <div class="aspect-video bg-muted rounded-md flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                    <path d="M3 6h18"/>
                                    <path d="M16 10a4 4 0 0 1-8 0"/>
                                </svg>
                            </div>
                            <div>
                                <p class="font-semibold">Premium Backpack</p>
                                <p class="text-sm text-muted-foreground">Water-resistant laptop backpack with USB charging port.</p>
                            </div>
                            <div class="flex gap-2">
                                <Badge>Free Shipping</Badge>
                                <Badge Variant="secondary">In Stock</Badge>
                            </div>
                            <Button class="w-full" Size="sm">Add to Cart</Button>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </section>

        <!-- Position Variants -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Position Variants</h2>
            <div class="p-6 border rounded-lg flex justify-center gap-4">
                <HoverCard Delay="200" class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="outline" Size="sm">Top</Button>
                    </HoverCardTrigger>
                    <HoverCardContent Side="top" class="w-48">
                        <p class="text-sm">This content appears above the trigger.</p>
                    </HoverCardContent>
                </HoverCard>

                <HoverCard Delay="200" class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="outline" Size="sm">Right</Button>
                    </HoverCardTrigger>
                    <HoverCardContent Side="right" class="w-48">
                        <p class="text-sm">This content appears to the right.</p>
                    </HoverCardContent>
                </HoverCard>

                <HoverCard Delay="200" class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="outline" Size="sm">Bottom</Button>
                    </HoverCardTrigger>
                    <HoverCardContent Side="bottom" class="w-48">
                        <p class="text-sm">This content appears below the trigger.</p>
                    </HoverCardContent>
                </HoverCard>

                <HoverCard Delay="200" class="inline-block">
                    <HoverCardTrigger>
                        <Button Variant="outline" Size="sm">Left</Button>
                    </HoverCardTrigger>
                    <HoverCardContent Side="left" class="w-48">
                        <p class="text-sm">This content appears to the left.</p>
                    </HoverCardContent>
                </HoverCard>
            </div>
        </section>
    </div>
</div>

@code {
    private List<TeamMember> _teamMembers = new()
    {
        new("Alice Johnson", "Product Manager", "Online", "https://github.com/alice.png", "AJ"),
        new("Bob Smith", "Developer", "In a meeting", "https://github.com/bob.png", "BS"),
        new("Carol White", "Designer", "Away", "https://github.com/carol.png", "CW"),
        new("David Brown", "Developer", "Online", "https://github.com/david.png", "DB"),
    };

    private record TeamMember(string Name, string Role, string Status, string Avatar, string Initials);
}
