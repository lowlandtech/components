@page "/visual/calendar"
@using LowlandTech.Components.Calendar

<PageTitle>Calendar - Visual Test</PageTitle>

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold">Calendar</h1>
        <p class="text-muted-foreground">A date field component that allows users to enter and edit date.</p>
    </div>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Single Date Selection</h2>
        <p class="text-sm text-muted-foreground">Select a single date.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar @bind-SelectedDate="_selectedDate" Mode="CalendarMode.Single" />
        </div>
        <p class="text-sm text-muted-foreground">
            Selected: @(_selectedDate?.ToString("yyyy-MM-dd") ?? "None")
        </p>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Range Selection</h2>
        <p class="text-sm text-muted-foreground">Select a date range.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar @bind-SelectedRange="_selectedRange" Mode="CalendarMode.Range" />
        </div>
        <p class="text-sm text-muted-foreground">
            Selected Range: @(_selectedRange?.Start.ToString("yyyy-MM-dd") ?? "None") to @(_selectedRange?.End.ToString("yyyy-MM-dd") ?? "None")
        </p>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Multiple Selection</h2>
        <p class="text-sm text-muted-foreground">Select multiple dates.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar @bind-SelectedDates="_selectedDates" Mode="CalendarMode.Multiple" />
        </div>
        <p class="text-sm text-muted-foreground">
            Selected Dates: @string.Join(", ", _selectedDates.Select(d => d.ToString("yyyy-MM-dd")))
        </p>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">With Dropdown Navigation</h2>
        <p class="text-sm text-muted-foreground">Navigate using month and year dropdowns.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar ShowMonthDropdown="true" ShowYearDropdown="true" />
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Without Outside Days</h2>
        <p class="text-sm text-muted-foreground">Days from other months are hidden.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar ShowOutsideDays="false" />
        </div>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">With Presets - Vertical (Default)</h2>
        <p class="text-sm text-muted-foreground">Quick-select buttons for common dates in vertical layout.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar 
                @bind-SelectedDate="_presetDate1" 
                Mode="CalendarMode.Single"
                ShowPresets="true"
                Presets="_defaultPresets" />
        </div>
        <p class="text-sm text-muted-foreground">
            Selected: @(_presetDate1?.ToString("yyyy-MM-dd") ?? "None")
        </p>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">With Presets - Horizontal</h2>
        <p class="text-sm text-muted-foreground">Quick-select buttons in horizontal layout with outline variant.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar 
                @bind-SelectedDate="_presetDate2" 
                Mode="CalendarMode.Single"
                ShowPresets="true"
                Presets="_defaultPresets"
                PresetsOrientation="horizontal"
                PresetsVariant="outline" />
        </div>
        <p class="text-sm text-muted-foreground">
            Selected: @(_presetDate2?.ToString("yyyy-MM-dd") ?? "None")
        </p>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Standalone CalendarPresets Component</h2>
        <p class="text-sm text-muted-foreground">Use CalendarPresets independently to control a Calendar.</p>
        <div class="flex gap-4">
            <div class="w-fit rounded-md border p-4">
                <CalendarPresets 
                    Items="_customPresets"
                    OnSelect="HandleCustomPresetSelected"
                    Orientation="vertical"
                    Variant="ghost" />
            </div>
            <div class="w-fit rounded-md border p-4">
                <Calendar 
                    @ref="_standaloneCalendar"
                    @bind-SelectedDate="_presetDate3" 
                    Mode="CalendarMode.Single" />
            </div>
        </div>
        <p class="text-sm text-muted-foreground">
            Selected: @(_presetDate3?.ToString("yyyy-MM-dd") ?? "None")
        </p>
    </section>

    <section class="space-y-4">
        <h2 class="text-lg font-semibold">Range Selection with Range Presets</h2>
        <p class="text-sm text-muted-foreground">Presets tailored for date range selection.</p>
        <div class="w-fit rounded-md border p-4">
            <Calendar 
                @bind-SelectedRange="_presetRange" 
                Mode="CalendarMode.Range"
                ShowPresets="true"
                Presets="_rangePresets"
                PresetsOrientation="vertical" />
        </div>
        <p class="text-sm text-muted-foreground">
            Selected Range: @(_presetRange?.Start.ToString("yyyy-MM-dd") ?? "None") to @(_presetRange?.End.ToString("yyyy-MM-dd") ?? "None")
        </p>
    </section>
</div>

@code {
    private DateTime? _selectedDate = DateTime.Today;
    private DateRange? _selectedRange;
    private List<DateTime> _selectedDates = new();

    // Preset examples
    private DateTime? _presetDate1;
    private DateTime? _presetDate2;
    private DateTime? _presetDate3;
    private DateRange? _presetRange;
    private Calendar? _standaloneCalendar;

    private List<CalendarPresetItem> _defaultPresets = CalendarPresets.GetDefaultPresets();
    private List<CalendarPresetItem> _rangePresets = CalendarPresets.GetRangePresets();
    
    private List<CalendarPresetItem> _customPresets = new()
    {
        new() { Label = "Today", Date = DateTime.Today },
        new() { Label = "Next Monday", Date = GetNextMonday() },
        new() { Label = "End of Month", Date = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month)) },
        new() { Label = "New Year", Date = new DateTime(DateTime.Today.Year + 1, 1, 1) }
    };

    private static DateTime GetNextMonday()
    {
        var today = DateTime.Today;
        int daysUntilMonday = ((int)DayOfWeek.Monday - (int)today.DayOfWeek + 7) % 7;
        return today.AddDays(daysUntilMonday == 0 ? 7 : daysUntilMonday);
    }

    private async Task HandleCustomPresetSelected(CalendarPresetItem preset)
    {
        if (_standaloneCalendar != null)
        {
            await _standaloneCalendar.HandlePresetSelected(preset);
        }
        _presetDate3 = preset.Date;
    }
}
