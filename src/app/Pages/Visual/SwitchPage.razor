@page "/visual/switch"
@using LowlandTech.Components.Switch
@using LowlandTech.Components.Label

<PageTitle>Switch - Visual Test</PageTitle>

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Switch</h1>

    <div class="space-y-12">
        <!-- Basic Switch -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Basic Switch</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex items-center gap-4">
                    <Switch @bind-IsChecked="_basicValue" />
                    <span class="text-sm">@(_basicValue ? "On" : "Off")</span>
                </div>
            </div>
        </section>

        <!-- Default Checked -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Default Checked</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex items-center gap-4">
                    <Switch @bind-IsChecked="_defaultChecked" />
                    <span class="text-sm">@(_defaultChecked ? "Enabled" : "Disabled")</span>
                </div>
            </div>
        </section>

        <!-- Sizes -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Sizes</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex items-center gap-8">
                    <div class="flex items-center gap-2">
                        <Switch Size="sm" @bind-IsChecked="_smallValue" />
                        <span class="text-sm">Small</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <Switch @bind-IsChecked="_defaultSizeValue" />
                        <span class="text-sm">Default</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Disabled State -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Disabled States</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex items-center gap-8">
                    <div class="flex items-center gap-2">
                        <Switch Disabled="true" IsChecked="false" />
                        <span class="text-sm text-muted-foreground">Disabled Off</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <Switch Disabled="true" IsChecked="true" />
                        <span class="text-sm text-muted-foreground">Disabled On</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Validation States -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Validation States</h2>
            <div class="p-6 border rounded-lg bg-background space-y-6">
                <div class="flex items-center gap-4">
                    <Switch @bind-IsChecked="_validSwitch" />
                    <div>
                        <span class="text-sm font-medium">Valid Switch</span>
                        <p class="text-xs text-muted-foreground">This switch has no validation errors.</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <Switch Invalid="true" IsChecked="false" />
                    <div>
                        <span class="text-sm font-medium">Invalid Switch (Error)</span>
                        <p class="text-xs text-red-500">You must accept the terms to continue.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Choice Card Pattern -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Choice Card Pattern</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="max-w-md space-y-3">
                    <Switch ChoiceCard="true"
                            Title="Airplane Mode"
                            Description="Disable all wireless connections"
                            @bind-IsChecked="_airplaneMode" />
                    <Switch ChoiceCard="true"
                            Title="Wi-Fi"
                            Description="Connect to wireless networks"
                            @bind-IsChecked="_wifiEnabled" />
                    <Switch ChoiceCard="true"
                            Title="Bluetooth"
                            Description="Connect to Bluetooth devices"
                            @bind-IsChecked="_bluetoothEnabled" />
                </div>
            </div>
        </section>

        <!-- Choice Card with Validation -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Choice Card with Validation</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="max-w-md space-y-3">
                    <Switch ChoiceCard="true"
                            Title="Terms of Service"
                            Description="I agree to the terms and conditions"
                            Invalid="@_termsInvalid"
                            @bind-IsChecked="_agreeToTerms" />
                    @if (_termsInvalid)
                    {
                        <p class="text-sm text-red-500 ml-4">You must accept the terms to continue.</p>
                    }
                    <div class="pt-2">
                        <button @onclick="ValidateTerms" class="px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium">
                            Validate
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- With Labels -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">With Labels</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="space-y-4 max-w-sm">
                    <label class="flex items-center justify-between p-3 border rounded-lg cursor-pointer hover:bg-muted/50">
                        <div>
                            <p class="font-medium">Airplane Mode</p>
                            <p class="text-sm text-muted-foreground">Disable all wireless connections</p>
                        </div>
                        <Switch @bind-IsChecked="_airplaneMode2" />
                    </label>
                    <label class="flex items-center justify-between p-3 border rounded-lg cursor-pointer hover:bg-muted/50">
                        <div>
                            <p class="font-medium">Wi-Fi</p>
                            <p class="text-sm text-muted-foreground">Connect to wireless networks</p>
                        </div>
                        <Switch @bind-IsChecked="_wifiEnabled2" />
                    </label>
                    <label class="flex items-center justify-between p-3 border rounded-lg cursor-pointer hover:bg-muted/50">
                        <div>
                            <p class="font-medium">Bluetooth</p>
                            <p class="text-sm text-muted-foreground">Connect to Bluetooth devices</p>
                        </div>
                        <Switch @bind-IsChecked="_bluetoothEnabled2" />
                    </label>
                </div>
            </div>
        </section>

        <!-- Settings Example -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Settings Panel Example</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="max-w-lg space-y-6">
                    <div>
                        <h3 class="text-lg font-semibold mb-4">Notifications</h3>
                        <div class="space-y-3">
                            <label class="flex items-center justify-between py-2">
                                <span class="text-sm">Email notifications</span>
                                <Switch @bind-IsChecked="_emailNotifications" />
                            </label>
                            <label class="flex items-center justify-between py-2">
                                <span class="text-sm">Push notifications</span>
                                <Switch @bind-IsChecked="_pushNotifications" />
                            </label>
                            <label class="flex items-center justify-between py-2">
                                <span class="text-sm">SMS notifications</span>
                                <Switch @bind-IsChecked="_smsNotifications" />
                            </label>
                        </div>
                    </div>
                    <div class="border-t pt-6">
                        <h3 class="text-lg font-semibold mb-4">Privacy</h3>
                        <div class="space-y-3">
                            <label class="flex items-center justify-between py-2">
                                <span class="text-sm">Make profile public</span>
                                <Switch @bind-IsChecked="_publicProfile" />
                            </label>
                            <label class="flex items-center justify-between py-2">
                                <span class="text-sm">Show online status</span>
                                <Switch @bind-IsChecked="_showOnlineStatus" />
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Form Integration -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Form Integration</h2>
            <div class="p-6 border rounded-lg bg-background">
                <form class="max-w-md space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1">First Name</label>
                            <input type="text" class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="John" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Last Name</label>
                            <input type="text" class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Doe" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Email</label>
                        <input type="email" class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="john@example.com" />
                    </div>
                    <div class="flex items-center gap-3 pt-2">
                        <Switch @bind-IsChecked="_agreeToTerms2" Name="terms" Value="accepted" Invalid="@(!_agreeToTerms2 && _triedSubmit)" />
                        <label class="text-sm">
                            I agree to the <a href="#" class="text-primary hover:underline">terms and conditions</a>
                        </label>
                    </div>
                    <div class="flex items-center gap-3">
                        <Switch @bind-IsChecked="_subscribeNewsletter" Name="newsletter" Value="subscribed" />
                        <label class="text-sm">
                            Subscribe to newsletter
                        </label>
                    </div>
                    <button type="button" @onclick="TrySubmit" class="w-full px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium" disabled="@(!_agreeToTerms2 && _triedSubmit)">
                        Create Account
                    </button>
                </form>
            </div>
        </section>

        <!-- Compact Row Layout -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Compact Row Layout</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="flex flex-wrap gap-6">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <Switch @bind-IsChecked="_monday" />
                        <span class="text-sm font-medium">Mon</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <Switch @bind-IsChecked="_tuesday" />
                        <span class="text-sm font-medium">Tue</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <Switch @bind-IsChecked="_wednesday" />
                        <span class="text-sm font-medium">Wed</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <Switch @bind-IsChecked="_thursday" />
                        <span class="text-sm font-medium">Thu</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <Switch @bind-IsChecked="_friday" />
                        <span class="text-sm font-medium">Fri</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <Switch @bind-IsChecked="_saturday" />
                        <span class="text-sm font-medium">Sat</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <Switch @bind-IsChecked="_sunday" />
                        <span class="text-sm font-medium">Sun</span>
                    </label>
                </div>
                <p class="mt-4 text-sm text-muted-foreground">Select your preferred working days</p>
            </div>
        </section>

        <!-- Status Summary -->
        <section>
            <h2 class="text-xl font-semibold mb-4 text-muted-foreground">Status Summary</h2>
            <div class="p-6 border rounded-lg bg-background">
                <div class="max-w-md p-4 bg-muted/30 rounded-lg">
                    <h4 class="font-medium mb-3">Current Settings</h4>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Airplane Mode:</span>
                            <span class="@(_airplaneMode ? "text-green-600" : "text-red-600")">@(_airplaneMode ? "On" : "Off")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Wi-Fi:</span>
                            <span class="@(_wifiEnabled ? "text-green-600" : "text-red-600")">@(_wifiEnabled ? "On" : "Off")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Notifications:</span>
                            <span class="@(_emailNotifications ? "text-green-600" : "text-red-600")">@(_emailNotifications ? "Enabled" : "Disabled")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Dark Mode:</span>
                            <span class="@(_darkMode ? "text-green-600" : "text-red-600")">@(_darkMode ? "On" : "Off")</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private bool _basicValue;
    private bool _defaultChecked = true;
    private bool _smallValue;
    private bool _defaultSizeValue = true;
    private bool _validSwitch = true;

    // Settings
    private bool _airplaneMode;
    private bool _wifiEnabled = true;
    private bool _bluetoothEnabled;
    private bool _emailNotifications = true;
    private bool _pushNotifications = true;
    private bool _smsNotifications;
    private bool _publicProfile;
    private bool _showOnlineStatus = true;

    // Settings duplicates for different sections
    private bool _airplaneMode2;
    private bool _wifiEnabled2 = true;
    private bool _bluetoothEnabled2;

    // Features (used in Choice Card)
    private bool _darkMode;

    // Form
    private bool _agreeToTerms;
    private bool _agreeToTerms2;
    private bool _subscribeNewsletter;
    private bool _triedSubmit;
    private bool _termsInvalid;

    // Days
    private bool _monday = true;
    private bool _tuesday = true;
    private bool _wednesday = true;
    private bool _thursday = true;
    private bool _friday = true;
    private bool _saturday;
    private bool _sunday;

    private void ValidateTerms()
    {
        _termsInvalid = !_agreeToTerms;
    }

    private void TrySubmit()
    {
        _triedSubmit = true;
    }
}
