@page "/visual/empty"

<PageTitle>Empty - Visual Test</PageTitle>

<div class="container mx-auto px-4 py-8">
            <h1 class="text-3xl font-bold mb-8">Empty</h1>
    
    <div class="space-y-12">
        <!-- Default Empty -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Default</h2>
            <div class="p-6 border rounded-lg">
                <Empty>
                    <EmptyHeader>
                        <EmptyMedia>
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                            </svg>
                        </EmptyMedia>
                        <EmptyTitle>No messages</EmptyTitle>
                        <EmptyDescription>You don't have any messages yet. Start a conversation to get started.</EmptyDescription>
                    </EmptyHeader>
                </Empty>
            </div>
        </section>

        <!-- With Action -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Action</h2>
            <div class="p-6 border rounded-lg">
                <Empty>
                    <EmptyHeader>
                        <EmptyMedia>
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                                <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                                <path d="M12 12v6"/>
                                <path d="M9 15h6"/>
                            </svg>
                        </EmptyMedia>
                        <EmptyTitle>No documents</EmptyTitle>
                        <EmptyDescription>Get started by creating your first document.</EmptyDescription>
                    </EmptyHeader>
                    <EmptyContent>
                        <Button>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                <path d="M5 12h14"/>
                                <path d="M12 5v14"/>
                            </svg>
                            Create Document
                        </Button>
                    </EmptyContent>
                </Empty>
            </div>
        </section>

        <!-- Search Results -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Search Results</h2>
            <div class="p-6 border rounded-lg">
                <Empty>
                    <EmptyHeader>
                        <EmptyMedia>
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.3-4.3"/>
                            </svg>
                        </EmptyMedia>
                        <EmptyTitle>No results found</EmptyTitle>
                        <EmptyDescription>Your search for "project alpha" did not match any documents.</EmptyDescription>
                    </EmptyHeader>
                    <EmptyContent>
                        <div class="flex gap-2">
                            <Button Variant="outline">Clear Search</Button>
                            <Button>Advanced Search</Button>
                        </div>
                    </EmptyContent>
                </Empty>
            </div>
        </section>

        <!-- Error State -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Error State</h2>
            <div class="p-6 border rounded-lg">
                <Empty>
                    <EmptyHeader>
                        <EmptyMedia Variant="icon" class="text-destructive">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" x2="12" y1="8" y2="12"/>
                                <line x1="12" x2="12.01" y1="16" y2="16"/>
                            </svg>
                        </EmptyMedia>
                        <EmptyTitle>Something went wrong</EmptyTitle>
                        <EmptyDescription>We couldn't load the data. Please try again later.</EmptyDescription>
                    </EmptyHeader>
                    <EmptyContent>
                        <Button Variant="outline">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                                <path d="M21 3v5h-5"/>
                                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                                <path d="M8 16H3v5"/>
                            </svg>
                            Try Again
                        </Button>
                    </EmptyContent>
                </Empty>
            </div>
        </section>

        <!-- With Multiple Actions -->
        <section>
            <h2 class="text-xl font-semibold mb-4">With Multiple Actions</h2>
            <div class="p-6 border rounded-lg">
                <Empty>
                    <EmptyHeader>
                        <EmptyMedia>
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </EmptyMedia>
                        <EmptyTitle>No team members</EmptyTitle>
                        <EmptyDescription>You haven't added any team members yet.</EmptyDescription>
                    </EmptyHeader>
                    <EmptyContent>
                        <div class="flex flex-col gap-2 w-full max-w-xs">
                            <Button class="w-full">Invite Team Member</Button>
                            <Button Variant="outline" class="w-full">Import from CSV</Button>
                        </div>
                    </EmptyContent>
                </Empty>
            </div>
        </section>

        <!-- Compact -->
        <section>
            <h2 class="text-xl font-semibold mb-4">Compact</h2>
            <div class="p-6 border rounded-lg">
                <Card>
                    <CardContent class="pt-6">
                        <Empty>
                            <EmptyHeader>
                                <EmptyMedia class="w-10 h-10">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                                    </svg>
                                </EmptyMedia>
                                <EmptyTitle class="text-base">No activity</EmptyTitle>
                                <EmptyDescription class="text-sm">Recent activity will appear here.</EmptyDescription>
                            </EmptyHeader>
                        </Empty>
                    </CardContent>
                </Card>
            </div>
        </section>
    </div>
</div>
