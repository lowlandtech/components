@page "/"
@layout ShowcodeLayout
@inject ShowcodeState State
@implements IDisposable

<PageTitle>LowlandTech Components</PageTitle>

@if (State.Current is not null)
{
    <div class="mb-6">
        <h1 class="text-2xl font-bold tracking-tight">@State.Current.Name</h1>
    </div>
    <DynamicComponent Type="@State.Current.Type" />
}
else
{
    <div class="flex h-full items-center justify-center text-muted-foreground">
        <p>Select a component from the sidebar to preview it.</p>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        if (State.Current is null) State.SelectFirst();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= Refresh;
}
