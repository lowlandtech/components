<div class="flex h-14 items-center border-b border-sidebar-border px-4">
    <a class="text-sm font-semibold text-sidebar-foreground" href="">LowlandTech Components</a>
    <div class="ml-auto flex items-center gap-2">
        <ThemeToggle Variant="ghost" AdditionalClasses="text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground" />
        <button title="Navigation menu" class="rounded-md p-2 text-sidebar-foreground hover:bg-sidebar-accent md:hidden" @onclick="ToggleNavMenu">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
            </svg>
        </button>
    </div>
</div>

<nav class="@NavMenuCssClass flex flex-col gap-1 overflow-y-auto p-3 md:block md:h-[calc(100vh-3.5rem)]">
