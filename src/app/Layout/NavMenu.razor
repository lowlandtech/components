    <div class="pt-4 pb-2">
        <h3 class="px-3 text-xs font-semibold text-sidebar-foreground/60 uppercase tracking-wider">Getting Started</h3>
    </div>
    <NavLink class="@GetNavLinkClass()" href="counter">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2zm6.5 4.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3a.5.5 0 0 1 1 0z"/></svg>
