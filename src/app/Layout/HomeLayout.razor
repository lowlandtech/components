@namespace LowlandTech.Components.App.Layout
@inherits LayoutComponentBase

<div class="min-h-screen bg-background text-foreground">
    <header class="sticky top-0 z-50 border-b border-border bg-background">
        <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
            <a href="/" class="flex items-center gap-2 text-sm font-semibold tracking-tight hover:opacity-80 transition-opacity">
                <div class="flex size-6 items-center justify-center rounded-md bg-primary text-[11px] font-bold text-primary-foreground select-none">LT</div>
                <span><span class="text-primary">Tiny</span>Components</span>
            </a>
            <nav class="flex items-center gap-6">
                <a href="https://github.com/lowlandtech/foundry"
                   target="_blank" rel="noopener noreferrer"
                   class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                    GitHub
                </a>
                <a href="/components"
                   class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
                    Browse Components
                </a>
            </nav>
        </div>
    </header>
    @Body
</div>
