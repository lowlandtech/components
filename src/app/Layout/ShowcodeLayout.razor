@namespace LowlandTech.Components.App.Layout
@inherits LayoutComponentBase
@inject ShowcodeState State
@implements IDisposable

<SidebarProvider class="group/sidebar-wrapper flex h-svh min-h-0 w-full overflow-hidden">
    <ShowcodeNav />
    <SidebarInset class="min-h-0">
        <header class="flex h-12 shrink-0 items-center justify-between border-b border-border px-4 bg-background">
            <SidebarTrigger />
            <button type="button" class="text-sm font-semibold text-foreground tracking-tight hover:text-primary transition-colors cursor-pointer" @onclick="() => State.Clear()">LowlandTech Components</button>
            <ThemeToggle />
        </header>
        <main class="min-h-0 flex-1 overflow-y-auto bg-background">
            <div class="grid min-h-full" style="grid-template-columns: 1fr min(860px, 100%) 1fr;">
                <div class="col-start-2 py-8 px-6">
                    @Body
                </div>
            </div>
        </main>
    </SidebarInset>
</SidebarProvider>

@code {
    protected override void OnInitialized()
    {
        State.Changed += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= Refresh;
}
