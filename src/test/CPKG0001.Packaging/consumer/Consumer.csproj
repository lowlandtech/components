<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Reference consumer for the CPKG0001 packaging acceptance. It deliberately
       has no ProjectReference and no reference to the Components source tree:
       everything it renders comes from the three NuGet packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LowlandTech.Components.Consumer</RootNamespace>
    <AssemblyName>LowlandTech.Components.Consumer</AssemblyName>
    <ComponentsPackageVersion Condition="'$(ComponentsPackageVersion)' == ''">0.0.0-unset</ComponentsPackageVersion>
    <!-- The contracts package keeps the published version that the Core
         package pins, so it is referenced at its own version. -->
    <ComponentsContractsVersion Condition="'$(ComponentsContractsVersion)' == ''">$(ComponentsPackageVersion)</ComponentsContractsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LowlandTech.Components.Core" Version="[$(ComponentsContractsVersion)]" />
    <PackageReference Include="LowlandTech.Components" Version="[$(ComponentsPackageVersion)]" />
    <PackageReference Include="LowlandTech.Components.Blocks" Version="[$(ComponentsPackageVersion)]" />
  </ItemGroup>

</Project>
