<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<!-- The vendored host sources under Fixtures are test *inputs* for the
		     drift-guard Facts, not components of the test assembly. The Razor SDK
		     derives RazorComponent from the default **/*.razor Content glob, so the
		     folder is excluded through DefaultItemExcludes, which that glob honours.
		     The files are still embedded explicitly below, and this excludes only
		     those host inputs - no scenario, Fact or acceptance criterion is
		     excluded by it.
		     CPKG0001.Packaging\consumer is the reference consumer application for
		     the packaging acceptance. It is a separate project that is copied to a
		     temporary directory and built there, so its sources must not be
             compiled into the test assembly either.
		     CPAN0001.Integration\consumer is the reference consumer application for
		     the session panel acceptance. It is a separate project that is copied
		     to a temporary directory and built there, so its sources must not be
		     compiled into the test assembly either. No Fact, scenario or
		     acceptance criterion of it is excluded by this. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);Fixtures\**;CPKG0001.Packaging\consumer\**;CPAN0001.Integration\consumer\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Bunit" />
		<Using Include="Bunit.TestDoubles" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Xunit" />
		<Using Include="Shouldly" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="bunit" Version="2.7.2" />
		<PackageReference Include="LowlandTech.Plugins" Version="2026.10.1-20261024190755988902385" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.8" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Shouldly" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\stories\LowlandTech.Components.Stories.csproj" />
		<ProjectReference Include="..\lib\LowlandTech.Components.csproj" />
		<ProjectReference Include="..\blocks\LowlandTech.Components.Blocks.csproj" />
		<!-- The opt-in feature package under test is referenced from source, so
		     the acceptance exercises the shipped registration and manifest. -->
		<ProjectReference Include="..\features\LowlandTech.Components.Features.Session\LowlandTech.Components.Features.Session.csproj" />
	</ItemGroup>

	<!-- Embed sources used by textual drift-guard tests so they survive NCrunch
	     shadow-copy (which doesn't copy the lib project's source into the test
	     workspace). Read in tests via Assembly.GetManifestResourceStream. -->
	<ItemGroup>
		<EmbeddedResource Include="..\lib\ContainerGrid\ContainerGrid.razor.cs">
			<LogicalName>ContainerGrid.razor.cs</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\lib\ContainerGrid\ContainerGridSection.razor.cs">
			<LogicalName>ContainerGridSection.razor.cs</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\lib\wwwroot\css\explorer-layout.css">
			<LogicalName>explorer-layout.css</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\lib\Explorer\ExplorerLayout.razor">
			<LogicalName>ExplorerLayout.razor</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Fixtures\web\App.razor">
			<LogicalName>web.App.razor</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Fixtures\shell\App.razor">
			<LogicalName>shell.App.razor</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Fixtures\shell\input.css">
			<LogicalName>shell.input.css</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Fixtures\app\App.razor">
			<LogicalName>app.App.razor</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\lib\wwwroot\js\sessionContextTree.js">
			<LogicalName>sessionContextTree.js</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\lib\wwwroot\css\input.css">
			<LogicalName>components.input.css</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\lib\wwwroot\css\components.css">
			<LogicalName>components.css</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\app\wwwroot\index.html">
			<LogicalName>components.app.index.html</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Fixtures\desktop\index.html">
			<LogicalName>desktop.index.html</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Exclude unfinished / broken test files from other agents -->
	<ItemGroup>
		<Compile Remove="SPEC1071.ComponentThemes\**\*.cs" />
		<Compile Remove="SPEC1009.Calendar\US02.Modes\**\*.cs" />
		<Compile Remove="SPEC1009.Calendar\US03.Navigation\**\*.cs" />
		<Compile Remove="SPEC1009.Calendar\US04.DayAttributes\**\*.cs" />
		<Compile Remove="SPEC1017.ContextMenu\US02.Interaction\**\*.cs" />
		<Compile Remove="SPEC1017.ContextMenu\US03.SubMenu\**\*.cs" />
		<Compile Remove="SPEC1038.Resizable\US02.Behavior\**\*.cs" />
		<Compile Remove="TestResults\**" />
		<Compile Remove="SPEC1043.Sidebar\US02.State\SC02_SidebarMenuSubBehavior.cs" />
		<Compile Remove="SPEC1043.Sidebar\US02.State\SC03_SidebarMenuSubTriggerBehavior.cs" />
		<Compile Remove="SPEC1043.Sidebar\US02.State\SC04_SidebarMobileSheetBehavior.cs" />
		<Compile Remove="SPEC1043.Sidebar\US02.State\SC06_SidebarDataStateBehavior.cs" />
		<Compile Remove="SPEC1073.AppLayout\**\*.cs" />
		<Content Remove="TestResults\**" />
		<EmbeddedResource Remove="TestResults\**" />
		<None Remove="TestResults\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="LowlandTech.Components.Tests.csproj.lscache" />
	  <None Remove="LowlandTech.Components.Tests.v3.ncrunchproject" />
	</ItemGroup>

</Project>
