<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CPKG0006 residual-trim consumer. The harness publishes it trimmed against a private
    feed and checks that the suppressed reflection of the components still works after
    the trimmer removed what nothing proved was needed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <RootNamespace>Cpkg0006.Consumer</RootNamespace>
    <AssemblyName>Cpkg0006.Consumer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The renderer instantiates the probe components reflectively, so the probe keeps
         its own assembly whole; the assemblies under measurement stay trimmable. -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="LowlandTech.Components" Version="$(ComponentsBatchVersion)" />
    <PackageReference Include="LowlandTech.Components.Blocks" Version="$(ComponentsBatchVersion)" />
  </ItemGroup>

</Project>
