<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Reference consumer for the CPAN0001 session panel acceptance. It
       deliberately has no ProjectReference and no reference to the Components
       source tree: everything it renders comes from the NuGet packages, and it
       never references the Components demo host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LowlandTech.Components.SessionConsumer</RootNamespace>
    <AssemblyName>LowlandTech.Components.SessionConsumer</AssemblyName>
    <ComponentsPackageVersion Condition="'$(ComponentsPackageVersion)' == ''">0.0.0-unset</ComponentsPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LowlandTech.Components.Core" Version="[$(ComponentsPackageVersion)]" />
    <PackageReference Include="LowlandTech.Components" Version="[$(ComponentsPackageVersion)]" />
    <PackageReference Include="LowlandTech.Components.Blocks" Version="[$(ComponentsPackageVersion)]" />
  </ItemGroup>

</Project>
