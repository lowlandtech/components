<!DOCTYPE html>
<html lang="en" class="@HtmlClass">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/LowlandTech.Components/css/components.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components/css/container-grid.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components/css/property-grid.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components/css/style-editor.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components/css/canvas-bezel.css" />
    <link rel="stylesheet" href="_content/LowlandTech.Components/css/explorer-layout.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="lib/xterm/xterm.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css" />
    @if (SidebarWidthCookie is not null)
    {
        <style id="sidebar-width-init">.app-shell{--sidebar-width:@(SidebarWidthCookie)px!important}</style>
    }
    <script>
        (function() {
            function applyTheme() {
                var stored = localStorage.getItem('app-theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                var isDark = stored === 'dark' || (stored !== 'light' && prefersDark);
                document.documentElement.classList.toggle('dark', isDark);
                document.cookie = 'app-theme=' + (isDark ? 'dark' : 'light') + ';path=/;max-age=31536000;SameSite=Lax';
            }

            window.toggleTheme = function() {
                var isDark = document.documentElement.classList.contains('dark');
                var value = isDark ? 'light' : 'dark';
                localStorage.setItem('app-theme', value);
                document.documentElement.classList.toggle('dark', !isDark);
                document.cookie = 'app-theme=' + value + ';path=/;max-age=31536000;SameSite=Lax';
            };

            window.toggleSidebarCollapse = function() {
                var isCollapsed = document.documentElement.classList.contains('sidebar-collapsed');
                document.documentElement.classList.toggle('sidebar-collapsed', !isCollapsed);
                var value = !isCollapsed ? 'true' : 'false';
                localStorage.setItem('sidebar-collapsed', value);
                document.cookie = 'sidebar-collapsed=' + value + ';path=/;max-age=31536000;SameSite=Lax';
            };

            applyTheme();

            var savedWidth = localStorage.getItem('sidebar-width');
            if (savedWidth) {
                document.cookie = 'sidebar-width=' + savedWidth + ';path=/;max-age=31536000;SameSite=Lax';
            }

            var savedCollapsed = localStorage.getItem('sidebar-collapsed');
            if (savedCollapsed) {
                document.documentElement.classList.toggle('sidebar-collapsed', savedCollapsed === 'true');
                document.cookie = 'sidebar-collapsed=' + savedCollapsed + ';path=/;max-age=31536000;SameSite=Lax';
            }

            function initSplitter() {
                var splitter = document.getElementById('sidebar-splitter');
                if (!splitter || splitter._jsBound) return;
                splitter._jsBound = true;
                splitter.addEventListener('mousedown', function(e) {
                    if (window.sidebarSplitter) return;
                    e.preventDefault();
                    var shell = document.querySelector('.app-shell');
                    var sidebar = document.getElementById('sidebar');
                    if (!shell || !sidebar) return;
                    var initStyle = document.getElementById('sidebar-width-init');
                    if (initStyle) {
                        shell.style.setProperty('--sidebar-width', getComputedStyle(shell).getPropertyValue('--sidebar-width'));
                        initStyle.remove();
                    }
                    sidebar.style.transition = 'none';
                    document.body.style.cursor = 'grabbing';
                    document.body.style.userSelect = 'none';
                    function onMove(ev) {
                        var w = Math.max(200, Math.min(600, ev.clientX));
                        shell.style.setProperty('--sidebar-width', w + 'px');
                    }
                    function onUp() {
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                        sidebar.style.transition = '';
                        document.body.style.cursor = '';
                        document.body.style.userSelect = '';
                        var w = parseInt(shell.style.getPropertyValue('--sidebar-width'));
                        if (w) {
                            localStorage.setItem('sidebar-width', w);
                            document.cookie = 'sidebar-width=' + w + ';path=/;max-age=31536000;SameSite=Lax';
                        }
                    }
                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });
            }

            document.addEventListener('DOMContentLoaded', initSplitter);
            document.addEventListener('blazor:enhancedload', function() {
                applyTheme();
                initSplitter();
                var sc = localStorage.getItem('sidebar-collapsed');
                if (sc) {
                    document.documentElement.classList.toggle('sidebar-collapsed', sc === 'true');
                }
            });
        })();
    </script>
    <link rel="stylesheet" href="@Assets["LowlandTech.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
<Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/LowlandTech.Components/js/portal.js"></script>
    <script src="_content/LowlandTech.Components/js/sessionContextTree.js"></script>
    <script src="_content/LowlandTech.Auth.Frontend/auth.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
    <script>
        hljs.configure({ ignoreUnescapedHTML: true });
        window.highlightCode = function() {
            document.querySelectorAll('.markdown-content pre code').forEach(function(el) {
                if (el.dataset.highlighted) return;
                try { hljs.highlightElement(el); } catch(e) {}
            });
        };
    </script>
    <script src="lib/xterm/xterm.js"></script>
    <script src="lib/xterm/addon-fit.js"></script>
    <script src="lib/xterm/addon-web-links.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string HtmlClass
    {
        get
        {
            var classes = new List<string>();
            if (HttpContext.Request.Cookies["app-theme"] == "dark") classes.Add("dark");
            if (HttpContext.Request.Cookies["sidebar-collapsed"] == "true") classes.Add("sidebar-collapsed");
            return string.Join(" ", classes);
        }
    }

    private string? SidebarWidthCookie => HttpContext.Request.Cookies["sidebar-width"];

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.GetEndpoint()?.Metadata.GetMetadata<ExcludeFromInteractiveRoutingAttribute>() is not null
            ? null
            : InteractiveServer;
}
