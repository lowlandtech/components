<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Reference consumer for the CBLK0002 and CBLK0003 session surface
       acceptance. It deliberately has no ProjectReference and no reference to
       the Components source tree: everything it renders comes from the NuGet
       packages, so the browser proves the published packages and not the
       sources of this repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LowlandTech.Components.SessionRouteConsumer</RootNamespace>
    <AssemblyName>LowlandTech.Components.SessionRouteConsumer</AssemblyName>
    <ComponentsPackageVersion Condition="'$(ComponentsPackageVersion)' == ''">0.0.0-unset</ComponentsPackageVersion>
    <!-- The contracts package keeps the published version that the Core
         package pins, so it is referenced at its own version. -->
    <ComponentsContractsVersion Condition="'$(ComponentsContractsVersion)' == ''">$(ComponentsPackageVersion)</ComponentsContractsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LowlandTech.Components.Core" Version="[$(ComponentsContractsVersion)]" />
    <PackageReference Include="LowlandTech.Components" Version="[$(ComponentsPackageVersion)]" />
    <PackageReference Include="LowlandTech.Components.Blocks" Version="[$(ComponentsPackageVersion)]" />
  </ItemGroup>

</Project>
