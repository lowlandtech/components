<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CPKG0007 trimmed consumer. The harness points it at a private feed that carries a
    freshly packed batch, publishes it trimmed and measures whether the shared
    assemblies are trimmed or copied verbatim.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <RootNamespace>Cpkg0007.Consumer</RootNamespace>
    <AssemblyName>Cpkg0007.Consumer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="LowlandTech.Components" Version="$(ComponentsBatchVersion)" />
    <PackageReference Include="LowlandTech.Components.Blocks" Version="$(ComponentsBatchVersion)" />
  </ItemGroup>

</Project>
