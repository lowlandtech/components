<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CTRM0001 trim preservation probe consumer. The probe harness packs this
    repository's components into a private feed and publishes this application
    trimmed, so the trimmed-host preservation probe executes the paths that the
    trim suppressions of the components cover. The batch version travels as an
    MSBuild property so the harness selects the version it just packed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <RootNamespace>Ctrm0001.Probe</RootNamespace>
    <AssemblyName>Ctrm0001.Probe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="LowlandTech.Components" Version="$(ComponentsBatchVersion)" />
    <PackageReference Include="LowlandTech.Components.Blocks" Version="$(ComponentsBatchVersion)" />
  </ItemGroup>

</Project>
