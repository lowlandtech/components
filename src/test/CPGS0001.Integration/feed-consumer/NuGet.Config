<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The published LowlandTech packages of the workspace live in the local
         feed next to the repositories. The relative path keeps the proof
         portable inside the workspace. -->
    <add key="lowlandtech-local" value="..\..\..\..\..\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
