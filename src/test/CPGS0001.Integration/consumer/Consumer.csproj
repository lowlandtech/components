<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Reference consumer for the CPGS0001 active plugin page acceptance. It
       deliberately has no ProjectReference and no reference to the Components
       source tree: everything it renders comes from the NuGet packages, and it
       never references the Components demo host.

       The root namespace sits outside LowlandTech.Components on purpose, so the
       consumer types never compete with the component types of the base
       packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LowlandTech.PageConsumer</RootNamespace>
    <AssemblyName>LowlandTech.PageConsumer</AssemblyName>
    <ComponentsPackageVersion Condition="'$(ComponentsPackageVersion)' == ''">0.0.0-unset</ComponentsPackageVersion>
    <!-- The contracts package keeps the published version that the Core
         package pins, so it is referenced at its own version. -->
    <ComponentsContractsVersion Condition="'$(ComponentsContractsVersion)' == ''">$(ComponentsPackageVersion)</ComponentsContractsVersion>
    <PluginsPackageVersion Condition="'$(PluginsPackageVersion)' == ''">2026.10.1-20261024190755988902385</PluginsPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LowlandTech.Components.Core" Version="[$(ComponentsContractsVersion)]" />
    <PackageReference Include="LowlandTech.Components.Features.Pages" Version="[$(ComponentsPackageVersion)]" />
    <!-- The route gateway of the shell is a host concern, so the consumer
         references the Plugins package itself. -->
    <PackageReference Include="LowlandTech.Plugins.Blazor" Version="[$(PluginsPackageVersion)]" />
  </ItemGroup>

</Project>
