@namespace LandlandTech.Theme.DemoComponents

@using LowlandTech.Components.Badge

<div class="card border-border bg-card text-card-foreground rounded-lg shadow-sm p-5">
    <h3 class="text-lg font-semibold mb-4">Date Range Filter</h3>
    <div class="space-y-4">
        <div class="flex items-center gap-3">
            <span class="text-sm text-muted-foreground">Column:</span>
            <select class="input" @bind="SelectedColumn">
                @foreach (var option in ColumnOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <span class="text-sm text-muted-foreground">From:</span>
                <input type="date" class="input" @bind="FromValue" />
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs text-muted-foreground">To:</span>
                <input type="date" class="input" @bind="ToValue" />
            </div>
        </div>
    </div>
    <div class="flex justify-end mt-6">
        <button class="btn btn-default">Apply Filter</button>
    </div>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public string TemplateType { get; set; } = "date";

    [Parameter]
    public string? SelectedColumn { get; set; }

    [Parameter]
    public DateTime? FromValue { get; set; }

    [Parameter]
    public DateTime? ToValue { get; set; }

    private static string[] ColumnOptions { get; } = ["Created", "Updated", "Expiry"];

    private static string GetTemplateType()
    {
        return "date";
    }
}
