@page "/demo2"
@rendermode InteractiveServer
@using LowlandTech.Components.Badge
@using LowlandTech.Components.Components.Button
@using LowlandTech.Components.Components.Input
@using LowlandTech.Components.Components.Label
@using LowlandTech.Components.Components.Skeleton
@using LandlandTech.Theme.DemoComponents

<div class="grid gap-5 lg:gap-7.5">
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        @* Options Component *@
        <div class="lg:col-span-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Options</h3>
                </div>
                <div class="card-content">
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="field">
                            <Label>General</Label>
                            <Input Type="text" Placeholder="General settings..." />
                        </div>
                        <div class="field">
                            <Label>Appearance</Label>
                            <Input Type="text" Placeholder="Theme settings..." />
                        </div>
                        <div class="field">
                            <Label>Notifications</Label>
                            <Input Type="text" Placeholder="Notification settings..." />
                        </div>
                        <div class="field">
                            <Label>Advanced</Label>
                            <Input Type="text" Placeholder="Advanced options..." />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* My Balance Component *@
            <div class="card h-full">
                <div class="card-header">
                    <h3 class="card-title">My Balance</h3>
                </div>
                <div class="card-content">
                    <div class="flex flex-col gap-2">
                        <Label>Current Balance</Label>
                        <Input Type="text" Placeholder="$12,450.00" />
                        <div class="flex items-center gap-2 mt-4">
                            <Badge Variant="BadgeVariants.Success" Class="text-xs">+2.5%</Badge>
                            <span class="text-sm text-muted-foreground">vs last month</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <Button Class="btn btn-default w-full">View Transactions</Button>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-3">
            @* Loading State Demo *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Loading State Example</h3>
                </div>
                <div class="card-content">
                    <div class="grid md:grid-cols-3 gap-4">
                        <div class="space-y-3">
                            <Skeleton Variant="circle" Width="48px" Height="48px" />
                            <Skeleton Variant="text" Height="20px" Class="w-3/4" />
                            <Skeleton Variant="text" Height="16px" Class="w-1/2" />
                            <Skeleton Variant="rect" Height="40px" />
                        </div>
                        <div class="space-y-3">
                            <Skeleton Variant="text" Height="24px" Class="w-full" />
                            <Skeleton Variant="text" Height="16px" Class="w-full" />
                            <Skeleton Variant="text" Height="16px" Class="w-5/6" />
                            <Skeleton Variant="rect" Height="80px" />
                        </div>
                        <div class="space-y-3">
                            <Skeleton Variant="circle" Width="40px" Height="40px" />
                            <Skeleton Variant="text" Height="20px" Class="w-2/3" />
                            <Skeleton Variant="rect" Height="60px" />
                            <Skeleton Variant="text" Height="16px" Class="w-4/5" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        @* Options Component with Interactive Cards *@
        <div class="lg:col-span-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Quick Actions</h3>
                </div>
                <div class="card-content">
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">⚙️</span>
                                    <span class="font-medium text-foreground">Settings</span>
                                </div>
                            </div>
                        </div>
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">📊</span>
                                    <span class="font-medium text-foreground">Analytics</span>
                                </div>
                            </div>
                        </div>
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">🔔</span>
                                    <span class="font-medium text-foreground">Notifications</span>
                                </div>
                            </div>
                        </div>
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">📁</span>
                                    <span class="font-medium text-foreground">Files</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* My Balance Summary *@
            <div class="card h-full">
                <div class="card-header">
                    <h3 class="card-title">My Balance</h3>
                </div>
                <div class="card-content">
                    <div class="flex flex-col gap-2">
                        <span class="text-3xl font-semibold text-mono">$12,450.00</span>
                        <div class="flex items-center gap-2">
                            <Badge Variant="BadgeVariants.Success" Class="text-xs">+2.5%</Badge>
                            <span class="text-sm text-muted-foreground">vs last month</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-link">View Transactions</button>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-2">
            @* Entry Callout (reuse from demo1) *@
            <EntryCallout 
                Headline="Connect Today & Join"
                Description="Enhance your projects with premium themes and templates. Join the KeenThemes community today for top-quality designs and resources."
                LinkText="KeenThemes Network"
                LinkUrl="#"
                ActionText="Get Started"
                ActionUrl="#"
                Class="h-full" />
        </div>
        <div class="lg:col-span-1">
            @* Report Settings Placeholder *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Report Settings</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Report settings placeholder</p>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-2">
            @* Integrations Placeholder *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Integrations</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Integrations placeholder</p>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* Block List Placeholder *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Block List</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Block list placeholder</p>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-2">
            @* Teams Table (reuse from demo1) *@
            <Teams />
        </div>
        <div class="lg:col-span-1">
            @* Manage Data Placeholder *@
            <div class="card h-full">
                <div class="card-header">
                    <h3 class="card-title">Manage Data</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Manage data placeholder</p>
                </div>
            </div>
        </div>
    </div>
</div>

