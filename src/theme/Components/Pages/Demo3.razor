@page "/demo3"
@rendermode InteractiveServer
@using LowlandTech.Components.Components.Stepper
@using LandlandTech.Theme.DemoComponents

<div class="grid gap-5 lg:gap-7.5">
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        @* Create Team Component *@
        <div class="lg:col-span-2">
            <div class="card h-full">
                <div class="card-content flex flex-col justify-center items-center text-center gap-4 p-10">
                    <div class="size-16 rounded-full bg-primary/20"></div>
                    <h2 class="card-title text-2xl">Swift Setup for New Teams</h2>
                    <p class="card-description leading-6">
                        Create and customize your team with our simple yet powerful setup wizard
                    </p>
                </div>
                <div class="card-footer justify-center">
                    <button class="btn btn-default">Create Team</button>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* Highlights Component (reuse from demo1) *@
            <Highlights Limit="3" />
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-2">
            @* Create Team Stepper *@
            <div class="card h-full">
                <div class="card-header">
                    <h2 class="card-title">Swift Setup for New Teams</h2>
                    <p class="card-description">
                        Create and customize your team with our simple yet powerful setup wizard
                    </p>
                </div>
                <div class="card-content">
                    <Stepper ActiveIndex="0" DefaultIndex="0">
                        <Step Label="Team Info" Completed="false">
                            <div class="mt-4 p-4 border border-border rounded-lg bg-muted/20">
                                <p class="text-sm text-muted-foreground">Enter your team name, description, and category</p>
                            </div>
                        </Step>
                        <Step Label="Members" Completed="false">
                            <div class="mt-4 p-4 border border-border rounded-lg bg-muted/20">
                                <p class="text-sm text-muted-foreground">Add team members and assign roles</p>
                            </div>
                        </Step>
                        <Step Label="Permissions" Completed="false">
                            <div class="mt-4 p-4 border border-border rounded-lg bg-muted/20">
                                <p class="text-sm text-muted-foreground">Configure team permissions and access levels</p>
                            </div>
                        </Step>
                        <Step Label="Settings" Completed="false">
                            <div class="mt-4 p-4 border border-border rounded-lg bg-muted/20">
                                <p class="text-sm text-muted-foreground">Customize team settings and notifications</p>
                            </div>
                        </Step>
                    </Stepper>
                </div>
                <div class="card-footer justify-center">
                    <button class="btn btn-default">Create Team</button>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* Block List Placeholder *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Block List</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Block list placeholder</p>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-2">
            @* Integrations Placeholder *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Integrations</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Integrations placeholder</p>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* Manage Data (reuse from demo2) *@
            <div class="card h-full">
                <div class="card-header">
                    <h3 class="card-title">Manage Data</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Manage data placeholder</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

}
