@page "/"
@rendermode InteractiveServer
@using LandlandTech.Theme.DemoComponents

<div class="grid gap-5 lg:gap-7.5">
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-1">
            <ChannelStats Items="stats" />
        </div>
        <div class="lg:col-span-2">
            <EntryCallout 
                Headline="Connect Today & Join"
                Description="Enhance your projects with premium themes and templates. Join the KeenThemes community today for top-quality designs and resources."
                LinkText="KeenThemes Network"
                LinkUrl="#"
                ActionText="Get Started"
                ActionUrl="#"
                Class="h-full" />
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-1">
            <Highlights Limit="3" />
        </div>
        <div class="lg:col-span-2">
            @* Earnings Chart Placeholder *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Earnings Chart</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Chart placeholder - implement with chart library</p>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-1">
            @* Team Meeting Component - Placeholder until component is created *@
            <div class="card">
                <div class="card-header">
                    <div class="flex items-center justify-between flex-wrap gap-5">
                        <div class="flex flex-col gap-1">
                            <span class="card-title">Team Meeting</span>
                            <span class="text-sm font-semibold text-foreground">09:00 - 09:30</span>
                        </div>
                        <div>
                            <img src="/media/brand-logos/zoom.svg" class="size-7" alt="Zoom" />
                        </div>
                    </div>
                </div>
                <div class="card-content">
                    <p class="text-sm font-normal text-foreground leading-5.5 mb-6">
                        Team meeting to discuss strategies, outline project milestones, define key goals, and establish clear timelines.
                    </p>
                    <div class="flex rounded-lg bg-accent/50 gap-10 p-5">
                        <div class="flex flex-col gap-5">
                            <div class="flex items-center gap-1.5 text-sm font-normal text-foreground">
                                <span>📍</span>
                                <span>Location</span>
                            </div>
                            <div class="text-sm font-medium text-foreground pt-1.5">Amsterdam</div>
                        </div>
                        <div class="flex flex-col gap-5">
                            <div class="flex items-center gap-1.5 text-sm font-normal text-foreground">
                                <span>👥</span>
                                <span>Team</span>
                            </div>
                            <div class="flex -space-x-2">
                                <div class="avatar">
                                    <div class="avatar-fallback bg-primary"></div>
                                </div>
                                <div class="avatar">
                                    <div class="avatar-fallback bg-secondary"></div>
                                </div>
                                <div class="avatar">
                                    <div class="avatar-fallback bg-accent"></div>
                                </div>
                                <div class="avatar">
                                    <div class="avatar-fallback bg-destructive-foreground"></div>
                                </div>
                                <span class="text-xs font-medium text-foreground">+10</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer justify-center">
                    <button class="btn btn-default">Join Meeting</button>
                </div>
            </div>
        </div>
        <div class="lg:col-span-2">
            @* Teams Table Component *@
            <Teams />
        </div>
    </div>
</div>

@code {
    private List<ChannelStats.ChannelStatsItem> stats = new()
    {
        new() { IconClass = "📘", Value = "9.3k", Description = "Amazing mates" },
        new() { IconClass = "▶️", Value = "24k", Description = "Lessons Views" },
        new() { IconClass = "📸", Value = "608", Description = "New subscribers" },
        new() { IconClass = "🎵", Value = "2.5k", Description = "Stream audience" }
    };
}

