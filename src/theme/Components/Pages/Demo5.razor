@page "/demo5"
@rendermode InteractiveServer
@using LowlandTech.Components.Badge
@using LowlandTech.Components.Components.Avatar
@using LowlandTech.Components.Components.Timeline

<div class="grid gap-5 lg:gap-7.5">
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-2">
            @* Team Info Component *@
            <div class="card">
                <div class="card-header">
                    <div class="flex items-center gap-4">
                        <Avatar>
                            <AvatarFallback>DT</AvatarFallback>
                        </Avatar>
                        <div class="flex flex-col">
                            <h3 class="card-title">Design Team</h3>
                            <p class="card-description">Creative design and marketing team</p>
                        </div>
                    </div>
                </div>
                <div class="card-content">
                    <div class="flex gap-2 mb-4">
                        <button class="btn btn-default btn-sm">Settings</button>
                        <button class="btn btn-outline btn-sm">Members</button>
                    </div>
                    <div class="flex flex-col gap-2 border-t border-border pt-4">
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-muted-foreground">Team Members</span>
                            <span class="text-sm font-medium text-foreground">24</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-muted-foreground">Active Projects</span>
                            <span class="text-sm font-medium text-foreground">12</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-muted-foreground">Completion Rate</span>
                            <Badge Variant="BadgeVariants.Success" Class="text-xs">92%</Badge>
                        </div>
                    </div>
                    <div class="border-t border-border pt-4 mt-4">
                        <h4 class="text-sm font-medium text-foreground mb-3">Team Leads</h4>
                        <div class="flex items-center gap-3">
                            <Avatar>
                                <AvatarFallback class="bg-primary text-primary-foreground">JD</AvatarFallback>
                            </Avatar>
                            <Avatar>
                                <AvatarFallback class="bg-secondary text-secondary-foreground">AS</AvatarFallback>
                            </Avatar>
                            <Avatar>
                                <AvatarFallback class="bg-accent text-accent-foreground">MK</AvatarFallback>
                            </Avatar>
                            <div class="avatar">
                                <div class="avatar-fallback bg-muted text-muted-foreground">+21</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* Options Component *@
            <div class="card h-full">
                <div class="card-header">
                    <h3 class="card-title">Options</h3>
                </div>
                <div class="card-content">
                    <div class="grid gap-3">
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">⚙️</span>
                                    <span class="font-medium text-foreground">General</span>
                                </div>
                            </div>
                        </div>
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">👥</span>
                                    <span class="font-medium text-foreground">Permissions</span>
                                </div>
                            </div>
                        </div>
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">📁</span>
                                    <span class="font-medium text-foreground">Projects</span>
                                </div>
                            </div>
                        </div>
                        <div class="card hover:bg-accent/50 cursor-pointer transition-colors">
                            <div class="card-content">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">📊</span>
                                    <span class="font-medium text-foreground">Analytics</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-2">
            @* Teams Table (reuse from demo1) *@
            <div class="card h-full">
                <div class="card-header">
                    <h3 class="card-title">Teams</h3>
                </div>
                <div class="card-content">
                    <p class="text-sm text-muted-foreground">Teams table placeholder - implement with DataGrid component</p>
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            @* FAQ Component *@
            <div class="card h-full">
                <div class="card-header">
                    <h3 class="card-title">Frequently Asked Questions</h3>
                </div>
                <div class="card-content">
                    <div class="space-y-3">
                        <details class="group">
                            <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-foreground list-none">
                                <span>How do I create a new team?</span>
                                <span class="transform group-open:rotate-180 transition-transform">▼</span>
                            </summary>
                            <div class="mt-2 pl-4 text-sm text-muted-foreground">
                                Go to the teams section in your dashboard and click the "Create Team" button. Follow the setup wizard to configure your team settings.
                            </div>
                        </details>
                        <details class="group">
                            <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-foreground list-none">
                                <span>How do I invite members?</span>
                                <span class="transform group-open:rotate-180 transition-transform">▼</span>
                            </summary>
                            <div class="mt-2 pl-4 text-sm text-muted-foreground">
                                Navigate to your team settings and use the "Invite" button to send invitations to new members via email.
                            </div>
                        </details>
                        <details class="group">
                            <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-foreground list-none">
                                <span>How do I manage permissions?</span>
                                <span class="transform group-open:rotate-180 transition-transform">▼</span>
                            </summary>
                            <div class="mt-2 pl-4 text-sm text-muted-foreground">
                                Use the Permissions section in team settings to configure what each team member can do.
                            </div>
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="grid lg:grid-cols-3 gap-5 lg:gap-7.5 items-stretch">
        <div class="lg:col-span-3">
            @* Team Activity Timeline *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Recent Team Activity</h3>
                </div>
                <div class="card-content">
                    <Timeline Orientation="vertical">
                        <TimelineItem>
                            <div class="flex gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-sm font-medium text-foreground">New project created</span>
                                        <Badge Variant="BadgeVariants.Success" Class="text-xs">Completed</Badge>
                                    </div>
                                    <p class="text-sm text-muted-foreground">Website Redesign project was created by John Doe</p>
                                    <p class="text-xs text-muted-foreground mt-1">2 hours ago</p>
                                </div>
                            </div>
                        </TimelineItem>
                        <TimelineItem>
                            <div class="flex gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-sm font-medium text-foreground">Team member added</span>
                                        <Badge Variant="BadgeVariants.Default" Class="text-xs">In Progress</Badge>
                                    </div>
                                    <p class="text-sm text-muted-foreground">Jane Smith joined the Design Team</p>
                                    <p class="text-xs text-muted-foreground mt-1">5 hours ago</p>
                                </div>
                            </div>
                        </TimelineItem>
                        <TimelineItem>
                            <div class="flex gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-sm font-medium text-foreground">Task completed</span>
                                        <Badge Variant="BadgeVariants.Success" Class="text-xs">Done</Badge>
                                    </div>
                                    <p class="text-sm text-muted-foreground">Design review for homepage completed</p>
                                    <p class="text-xs text-muted-foreground mt-1">Yesterday</p>
                                </div>
                            </div>
                        </TimelineItem>
                    </Timeline>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

