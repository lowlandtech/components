@inherits LayoutComponentBase

<div class="flex min-h-screen">
    <div class="sidebar border-border bg-card fixed top-0 bottom-0 left-0 z-50 flex flex-col w-16 border-r transition-all duration-200">
        <div class="p-4">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span>🏠</span>
            </NavLink>
        </div>
        <div class="flex-1 overflow-y-auto px-1 pt-1">
            <nav class="flex flex-col space-y-1">
                <NavLink class="nav-link" href="dark-sidebar" Match="NavLinkMatch.All">
                    <span class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors">Dark Sidebar</span>
                </NavLink>
            </nav>
        </div>
    </div>

    <main class="flex-1 flex flex-col ml-16">
        <header class="border-b border-border bg-background sticky top-0 z-10 px-4 h-14 flex items-center">
            <h1 class="text-lg font-semibold text-foreground">Dashboard</h1>
        </header>

        <article class="flex-1 p-6 bg-background">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="bg-destructive text-destructive-foreground p-4 fixed bottom-0 left-0 w-full z-50">
    An unhandled error has occurred.
    <a href="." class="reload text-destructive-foreground underline">Reload</a>
    <button class="dismiss absolute right-4 top-4 text-destructive-foreground">🗙</button>
</div>
